' The purpose of this object is to allow us to execute the smoke tests from
' a Java class.

静态 过程 RunSmokeTests()
	' 验证 GUID 的全局与限定名调用，运行时细节由 Java 测试覆盖。
	断言真(取字符数(生成GUID()) = 36)
	断言真(取字符数(simple.runtime.其它操作.生成GUID()) = 36)

	' 对象操作保留全局短名，并支持新的完整限定名与两种调用重载。
	变量 局_反射对象 为 对象
	局_反射对象 = 创建对象("java.util.Date")
	断言真(取对象名(局_反射对象) = "Date")
	断言真(simple.runtime.对象操作.取对象名(局_反射对象) = "Date")
	断言真(取对象类名(局_反射对象) = "java.util.Date")
	断言真(simple.runtime.对象操作.取对象类名(局_反射对象) = "java.util.Date")
	断言真(取对象哈希码(局_反射对象) = simple.runtime.对象操作.取对象哈希码(局_反射对象))
	变量 局_反射参数 为 变体型(1)
	局_反射参数(0) = 123
	变量 局_反射结果 为 变体型
	局_反射结果 = 调用方法(局_反射对象, "setTime", 局_反射参数)
	断言真(simple.runtime.对象操作.调用方法(局_反射对象, "getTime") = 123)
	局_反射结果 = simple.runtime.对象操作.调用方法(局_反射对象, "setTime", 局_反射参数)
	断言真(调用方法(局_反射对象, "getTime") = 123)
	置成员值(局_反射对象, "setTime", 456)
	断言真(simple.runtime.对象操作.取成员值(局_反射对象, "getTime") = 456)
	simple.runtime.对象操作.置成员值(局_反射对象, "setTime", 789)
	断言真(取成员值(局_反射对象, "getTime") = 789)
	局_反射对象 = simple.runtime.对象操作.创建对象("java.util.Date")
	断言真(取对象名(局_反射对象) = "Date")

	' 验证运行库导出的线程状态常量可被 Simple 解析并取得约定值。
	断言真(simple.runtime.collections.线程.状态_新建 = 0)
	断言真(simple.runtime.collections.线程.状态_可运行 = 1)
	断言真(simple.runtime.collections.线程.状态_阻塞 = 2)
	断言真(simple.runtime.collections.线程.状态_无限等待 = 3)
	断言真(simple.runtime.collections.线程.状态_限时等待 = 4)
	断言真(simple.runtime.collections.线程.状态_结束 = 5)

	' 验证新增数学函数的全局与限定名调用，并执行固定结果断言。
	断言真(求反正弦(1) = PI / 2)
	断言真(求反余弦(1) = 0)
	断言真(求立方根(-8) = -2)
	断言真(求斜边(3, 4) = 5)
	断言真(simple.runtime.数值运算.求反正弦(-1) = -PI / 2)
	断言真(simple.runtime.数值运算.求反余弦(-1) = PI)
	断言真(simple.runtime.数值运算.求立方根(27) = 3)
	断言真(simple.runtime.数值运算.求斜边(-3, 4) = 5)

	' 验证进制转换独立后的全局短名及完整限定名调用。
	断言真(十六进制(42) = "2A")
	断言真(simple.runtime.进制转换.十六进制(-1) = "FFFFFFFFFFFFFFFF")
	断言真(十六进制到长整数("FF") = 255)
	断言真(simple.runtime.进制转换.十六进制到长整数("-FF") = -255)
	断言真(整数到二进制(10) = "1010")
	断言真(simple.runtime.进制转换.整数到二进制(-1) = "11111111111111111111111111111111")
	断言真(二进制到长整数("1010") = 10)
	断言真(simple.runtime.进制转换.二进制到长整数("-1010") = -10)
	断言真(十六进制到长整数("0xFF") = 0)
	断言真(二进制到长整数("0b10") = 0)

	' 验证字节无符号值的新名称，返回值仍为普通整数型。
	变量 单字节 为 字节型
	单字节 = -1
	断言真(取字节无符号值(单字节) = 255)
	断言真(simple.runtime.数据转换.取字节无符号值(单字节) = 255)

	' 核对文本接口迁移后的全局短名和完整限定名。
	断言真(代码("A") = 65)
	断言真(simple.runtime.文本操作.代码("A") = 65)
	断言真(字符(65) = "A")
	断言真(simple.runtime.文本操作.字符(65) = "A")
	变量 局_归属片段 为 文本型()
	局_归属片段 = simple.runtime.文本操作.分割文本("a||", "|")
	断言真(取数组成员数(局_归属片段) = 3)
	断言真(连接数组文本(局_归属片段, "|") = "a||")
	局_归属片段 = 分割文本("a|b|c", "|", 2)
	断言真(simple.runtime.文本操作.连接数组文本(局_归属片段, ",") = "a,b|c")
	局_归属片段 = simple.runtime.文本操作.分割文本("a|b|c", "|", 2)
	断言真(取数组成员数(局_归属片段) = 2)
	断言真(科学转普通计数("1E-3") = "0.001")
	断言真(simple.runtime.文本操作.科学转普通计数("1.23E5") = "123000")
	断言真(字节集到十六进制(合并字节集(十六进制到字节集("01"), 十六进制到字节集("02"))) = "0102")
	断言真(字节集到十六进制(simple.runtime.字节集操作.合并字节集(十六进制到字节集("01"), 十六进制到字节集("02"))) = "0102")

	' 验证金额格式化的全局、限定名调用及 Simple 错误分支。
	断言真(格式化金额("1.005") = "1.01")
	断言真(simple.runtime.文本操作.格式化金额("9007199254740993.005") = "9007199254740993.01")
	断言真(格式化金额("-0.004") = "0.00")
	断言真(非法金额会报错())

	' 随机整数使用闭区间；单点范围和舍入结果采用固定断言。
	断言真(取随机数(-3, -3) = -3)
	变量 随机整数 为 整数型
	随机整数 = simple.runtime.数值运算.取随机数(-3, 4)
	断言真(随机整数 >= -3 且 随机整数 <= 4)
	断言真(四舍五入(1.005, 2) = 1.01)
	断言真(simple.runtime.数值运算.四舍五入(-145, -1) = -150)
	断言真(随机范围反转会报错())

	' 像素解析统一使用新名称，验证全局及完整限定名调用。
	断言真(解析为像素(42) = 42)
	断言真(simple.runtime.像素转换.解析为像素("10px") = 10)

	变量 tests 为 集合
	tests = 创建 集合

	' Conversion tests
	tests.加入(创建 simple.smoketest.conversions.BooleanConversionsTest)
	tests.加入(创建 simple.smoketest.conversions.ByteConversionsTest)
	tests.加入(创建 simple.smoketest.conversions.ShortConversionsTest)
	tests.加入(创建 simple.smoketest.conversions.IntegerConversionsTest)
	tests.加入(创建 simple.smoketest.conversions.LongConversionsTest)

	' Expression tests
	tests.加入(创建 simple.smoketest.expressions.AdditionExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.AndExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.ArrayExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.CallExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.ConcatenationExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.IdentityExpressionsTest)
	' 验证未初始化变体值的相等和不等比较 xhwsd@qq.com 2026-9-4
	tests.加入(创建 simple.smoketest.expressions.VariantEqualityExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.IntegerDivisionExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.LikeExpressionsTest)
	' 验证百分号求模运算符 xhwsd@qq.com 2026-9-4
	tests.加入(创建 simple.smoketest.expressions.ModuloExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.NewExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.OrExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.TypeOfExpressionsTest)
	tests.加入(创建 simple.smoketest.expressions.XorExpressionsTest)

	' Scopes tests
	tests.加入(创建 simple.smoketest.scopes.ScopesTest)

	' Statement tests
	tests.加入(创建 simple.smoketest.statements.DoUntilStatementsTest)
	tests.加入(创建 simple.smoketest.statements.DoWhileStatementsTest)
	tests.加入(创建 simple.smoketest.statements.ExitStatementsTest)
	tests.加入(创建 simple.smoketest.statements.IfThenElseIfElseStatementsTest)
	tests.加入(创建 simple.smoketest.statements.ForNextStatementsTest)
	tests.加入(创建 simple.smoketest.statements.ForEachStatementsTest)
	tests.加入(创建 simple.smoketest.statements.OnErrorStatementsTest)
	tests.加入(创建 simple.smoketest.statements.RaiseEventStatementsTest)
	tests.加入(创建 simple.smoketest.statements.SelectStatementsTest)
	tests.加入(创建 simple.smoketest.statements.WhileDoStatementsTest)

	' Run all tests
	变量 t 为 Test
	循环 每个 t 从 tests
		t.Run()
	下个 t
结束 过程

''' 验证无效金额在 Simple 中转换为非法参数错误，调用者可明确处理失败。
静态 函数 非法金额会报错() 为 逻辑型
	变量 结果 为 文本型
	结果 = 格式化金额("abc")

	位于 错误
		分支 非法参数错误
			非法金额会报错 = 真
	结束 错误
结束 函数

''' 验证最小值大于最大值时可由 Simple 的非法参数错误分支处理。
静态 函数 随机范围反转会报错() 为 逻辑型
	变量 结果 为 整数型
	结果 = 取随机数(2, 1)

	位于 错误
		分支 非法参数错误
			随机范围反转会报错 = 真
	结束 错误
结束 函数

''' 在测试指定的区域下验证数值格式化的全局、限定名调用及错误转换。
静态 过程 RunNumberFormattingTests()
	断言真(格式化数值("0000", 42) = "0042")
	断言真(simple.runtime.文本操作.格式化数值("#,##0.00", 1234.5) = "1,234.50")
	断言真(格式化数值("0%", 0.1251) = "13%")
	断言真(格式化数值("0", 2.5) = "2")
	断言真(格式化数值("0", 3.5) = "4")
	断言真(非法数值格式会报错())
结束 过程

''' 验证非法格式在 Simple 中转换为非法参数错误。
静态 函数 非法数值格式会报错() 为 逻辑型
	变量 结果 为 文本型
	结果 = 格式化数值("0.0.0", 1)

	位于 错误
		分支 非法参数错误
			非法数值格式会报错 = 真
	结束 错误
结束 函数

$属性
	$资源 $对象
$结束 $属性
