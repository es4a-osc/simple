''' 绝对布局测试。
''' 按钮初始位于 (20,20)px，移动后应位于 (100,100)px、尺寸 180×80px。
''' 读回位置和尺寸，并在移动后的按钮上点击验证命中；
''' 恢复后再次核对。

事件 绝对布局测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	子项1.移动("100px", "100px", "180px", "80px")
	操作结果标签.文本 = "已请求移动，布局后读回"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：移动并调整尺寸；请检查权限、状态和运行日志"
			输出错误("设备测试/绝对布局：移动并调整尺寸失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	子项1.移动("20px", "20px", "140px", "70px")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：恢复位置；请检查权限、状态和运行日志"
			输出错误("设备测试/绝对布局：恢复位置失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	操作结果标签.文本 = "左=" & 子项1.左边 & "；顶=" & 子项1.顶边 & 字符(10) & "宽=" & 子项1.宽度 & "；高=" & 子项1.高度

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取位置尺寸；请检查权限、状态和运行日志"
			输出错误("设备测试/绝对布局：读取位置尺寸失败")
	结束 错误
结束 事件

事件 子项1.被单击()
	操作结果标签.文本 = "移动按钮收到点击"
结束 事件

$属性
	$资源 $窗口
	$定义 绝对布局测试 $为 窗口
		标题 = "绝对布局测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "移动按钮并改变尺寸，核对实际位置、宽高和点击区域，再恢复原位置。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "移动并调整尺寸"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "恢复位置"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "读取位置尺寸"
			$结束 $定义
		$结束 $定义
		$定义 布局面板 $为 面板
			布局 = 布局_绝对
			宽度 = 长度_匹配父级
			高度 = "260px"
			背景颜色 = &HFFE0F0FF
			$定义 子项1 $为 按钮
				文本 = "可移动按钮"
				左边 = 20
				顶边 = 20
				宽度 = 140
				高度 = 70
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
