''' 图片按钮测试。
''' 单击、长按、双击、水平拖动图片按钮，检查全部触摸及焦点事件。
''' 禁用时不应再有单击/长按，恢复后可操作；
''' 切换缩放及两种图片来源，核对真实图像与属性。

变量 回调次数 为 整数型

事件 图片按钮测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	图片按钮1.启用 = 取反 图片按钮1.启用
	操作结果标签.文本 = "启用=" & 图片按钮1.启用

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换启用；请检查权限、状态和运行日志"
			输出错误("设备测试/图片按钮：切换启用失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	图片按钮1.显示方式 = 图片按钮1.显示方式 % 3 + 1
	操作结果标签.文本 = "显示方式=" & 图片按钮1.显示方式

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换显示方式；请检查权限、状态和运行日志"
			输出错误("设备测试/图片按钮：切换显示方式失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	操作结果标签.文本 = "焦点请求=" & 图片按钮1.获取焦点()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求焦点；请检查权限、状态和运行日志"
			输出错误("设备测试/图片按钮：请求焦点失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	图片按钮1.清除焦点()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：清除焦点；请检查权限、状态和运行日志"
			输出错误("设备测试/图片按钮：清除焦点失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	图片按钮1.图片 = "simple.png"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：加载资产图片；请检查权限、状态和运行日志"
			输出错误("设备测试/图片按钮：加载资产图片失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	图片按钮1.图片 = "@drawable/icon"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：加载资源图片；请检查权限、状态和运行日志"
			输出错误("设备测试/图片按钮：加载资源图片失败")
	结束 错误
结束 事件

事件 图片按钮1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 图片按钮1.获得焦点()
	回调次数 = 回调次数 + 1
	记录事件("获得焦点：回调=" & 回调次数)
结束 事件

事件 图片按钮1.失去焦点()
	回调次数 = 回调次数 + 1
	记录事件("失去焦点：回调=" & 回调次数)
结束 事件

事件 图片按钮1.被按下(参数1 为 整数型, 参数2 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("被按下：回调=" & 回调次数 & "；X=" & 参数1 & "；Y=" & 参数2)
结束 事件

事件 图片按钮1.被弹起(参数1 为 整数型, 参数2 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("被弹起：回调=" & 回调次数 & "；X=" & 参数1 & "；Y=" & 参数2)
结束 事件

事件 图片按钮1.触摸移动(参数1 为 整数型, 参数2 为 整数型, 参数3 为 整数型, 参数4 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("触摸移动：回调=" & 回调次数 & "；前次X=" & 参数1 & 字符(10) & "前次Y=" & 参数2 & "；当前X=" & 参数3 _
		& 字符(10) & "当前Y=" & 参数4)
结束 事件

事件 图片按钮1.触摸手势(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("触摸手势：回调=" & 回调次数 & "；方向=" & 参数1)
结束 事件

事件 图片按钮1.被单击()
	回调次数 = 回调次数 + 1
	记录事件("被单击：回调=" & 回调次数)
结束 事件

事件 图片按钮1.被长按()
	回调次数 = 回调次数 + 1
	记录事件("被长按：回调=" & 回调次数)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("图片按钮测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 图片按钮测试 $为 窗口
		标题 = "图片按钮测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "在图片按钮上单击、长按、双击和拖动，核对触摸及焦点事件。切换启用、显示方式和图片来源，观察显示效果。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "切换启用"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "切换显示方式"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "请求焦点"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "清除焦点"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "加载资产图片"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "加载资源图片"
			$结束 $定义
		$结束 $定义
		$定义 图片按钮1 $为 图片按钮
			图片 = "simple.png"
			宽度 = "240px"
			高度 = "180px"
			显示方式 = 图片组件.显示方式_居中缩放
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
