''' 颜色操作测试。
''' 验证实际依赖 Android Color 的颜色合成/分量读取，并把颜色设置到标签核对视觉效果。
''' 字符串解析等纯 Java 逻辑不在本页重复铺设。

事件 颜色操作测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	变量 颜色 为 整数型
	颜色 = 到颜色(12, 34, 56)
	颜色标签.背景颜色 = 颜色
	操作结果标签.文本 = "A=" & 取透明度(颜色) & "；R=" & 取红色(颜色) & 字符(10) & "G=" & 取绿色(颜色) _
		& "；B=" & 取蓝色(颜色) & 字符(10) & "预期=255/12/34/56"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：合成不透明颜色；请检查权限、状态和运行日志"
			输出错误("设备测试/颜色操作：合成不透明颜色失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	变量 颜色 为 整数型
	颜色 = 到颜色(128, 255, 0, 0)
	颜色标签.背景颜色 = 颜色
	操作结果标签.文本 = "A=" & 取透明度(颜色) & "；R=" & 取红色(颜色) & 字符(10) & "G=" & 取绿色(颜色) _
		& "；B=" & 取蓝色(颜色)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：合成透明颜色；请检查权限、状态和运行日志"
			输出错误("设备测试/颜色操作：合成透明颜色失败")
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 颜色操作测试 $为 窗口
		标题 = "颜色操作测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "合成颜色并读回各分量，再观察下方标签的颜色；分别测试不透明和带透明度的颜色。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "合成不透明颜色"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "合成透明颜色"
			$结束 $定义
		$结束 $定义
		$定义 颜色标签 $为 标签
			文本 = "颜色显示区"
			宽度 = 长度_匹配父级
			高度 = "100px"
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
