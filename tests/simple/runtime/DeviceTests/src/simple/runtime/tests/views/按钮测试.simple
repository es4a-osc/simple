''' 按钮测试窗口。

变量 单击次数 为 整数型
变量 长按次数 为 整数型

变量 按下次数 为 整数型
变量 弹起次数 为 整数型
变量 移动次数 为 整数型
变量 手势次数 为 整数型

事件 按钮测试.切换完毕()
	准备测试()
结束 事件

事件 按钮测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 按钮1.被单击()
	单击次数 = 单击次数 + 1
	刷新事件计数()
	操作结果标签.文本 = "单击=" & 单击次数 & "；长按=" & 长按次数
结束 事件

事件 按钮1.被长按()
	长按次数 = 长按次数 + 1
	刷新事件计数()
	操作结果标签.文本 = "单击=" & 单击次数 & "；长按=" & 长按次数
结束 事件

事件 按钮1.获得焦点()
	焦点标签.文本 = "焦点测试按钮：获得焦点"
结束 事件

事件 按钮1.失去焦点()
	焦点标签.文本 = "焦点测试按钮：失去焦点"
结束 事件

事件 按钮4.被单击()
	操作结果标签.文本 = "异常：禁用按钮触发了单击事件"
结束 事件

事件 读取属性按钮.被单击()
	操作结果标签.文本 = "禁用按钮启用=" & 按钮4.启用 & "；粗体=" & 按钮5.字体加粗 & 字符(10) & "斜体=" & 按钮6.字体倾斜 _
		& "；字号=" & 按钮7.字体大小
结束 事件

事件 按钮1.被按下(横坐标 为 整数型, 纵坐标 为 整数型)
	按下次数 = 按下次数 + 1
	触摸标签.文本 = "按下：" & 横坐标 & ", " & 纵坐标
	刷新事件计数()
结束 事件

事件 按钮1.被弹起(横坐标 为 整数型, 纵坐标 为 整数型)
	弹起次数 = 弹起次数 + 1
	触摸标签.文本 = "弹起：" & 横坐标 & ", " & 纵坐标
	刷新事件计数()
结束 事件

事件 按钮1.触摸移动(上次横坐标 为 整数型, 上次纵坐标 为 整数型, 横坐标 为 整数型, 纵坐标 为 整数型)
	移动次数 = 移动次数 + 1
	触摸标签.文本 = "移动：" & 上次横坐标 & ", " & 上次纵坐标 & " → " & 横坐标 & ", " & 纵坐标
	刷新事件计数()
结束 事件

事件 按钮1.触摸手势(方向 为 整数型)
	手势次数 = 手势次数 + 1
	触摸标签.文本 = "触摸手势：" & 方向
	刷新事件计数()
结束 事件

事件 切换禁用按钮.被单击()
	按钮1.启用 = 取反 按钮1.启用
	操作结果标签.文本 = "待测按钮启用=" & 按钮1.启用 & "；禁用后操作不应增加单击和长按计数"
结束 事件

事件 请求焦点按钮.被单击()
	变量 已获焦点 为 逻辑型
	已获焦点 = 按钮1.获取焦点()
	操作结果标签.文本 = "请求焦点返回=" & 已获焦点
结束 事件

事件 清除焦点按钮.被单击()
	按钮1.清除焦点()
结束 事件

''' 配置图标并显示实际属性。
过程 准备测试()
	按钮10.置左边图标("simple.png", 32)
	操作结果标签.文本 = "单击=" & 单击次数 & "；长按=" & 长按次数
结束 过程

''' 显示控件实际触发的事件次数；触摸参数单独显示，避免覆盖属性读回结果。
过程 刷新事件计数()
	事件标签.文本 = "单击=" & 单击次数 & "；长按=" & 长按次数 & 字符(10) & "按下=" & 按下次数 & "；弹起=" & 弹起次数 _
		& 字符(10) & "移动=" & 移动次数 & "；手势=" & 手势次数
结束 过程

$属性
	$资源 $窗口
	$定义 按钮测试 $为 窗口
		滚动 = 真
		标题 = "按钮测试"
		$定义 测试说明标签 $为 标签
			文本 = "“焦点测试”按钮用于单击、长按、双击、拖动及焦点事件。切换禁用后核对计数，其它按钮对照文字、颜色、字体和图标。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 读取属性按钮 $为 按钮
			文本 = "读取按钮属性"
		$结束 $定义
		$定义 按钮1 $为 按钮
			文本 = "焦点测试"
		$结束 $定义
		$定义 补充操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换禁用按钮 $为 按钮
				文本 = "切换待测按钮启用"
			$结束 $定义
			$定义 请求焦点按钮 $为 按钮
				文本 = "请求焦点"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 清除焦点按钮 $为 按钮
				文本 = "清除焦点"
			$结束 $定义
		$结束 $定义
		$定义 焦点标签 $为 标签
			文本 = "焦点事件：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "事件次数：单击=0；长按=0；按下=0；弹起=0；移动=0；手势=0"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 触摸标签 $为 标签
			文本 = "触摸参数：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 按钮2 $为 按钮
			文本 = "右对齐"
			内容对齐 = 对齐_右
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 按钮3 $为 按钮
			文本 = "绿色背景"
			背景颜色 = 颜色_绿
		$结束 $定义
		$定义 按钮4 $为 按钮
			文本 = "已禁用"
			启用 = 假
		$结束 $定义
		$定义 按钮5 $为 按钮
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 按钮6 $为 按钮
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 按钮7 $为 按钮
			文本 = "大字号"
			字体大小 = 20
		$结束 $定义
		$定义 按钮8 $为 按钮
			文本 = "等宽字体：wiwiw"
			字体类型 = 字体类型_等宽
		$结束 $定义
		$定义 按钮9 $为 按钮
			文本 = "绿色文字"
			文本颜色 = 颜色_绿
		$结束 $定义
		$定义 按钮10 $为 按钮
			文本 = "带图标"
		$结束 $定义
	$结束 $定义
$结束 $属性
