''' 视频播放器测试。
''' 默认播放本测试 APK 内的独立视频素材，也可输入网络地址。
''' 播放后读取真实时长、位置与缓冲，覆盖暂停、继续、定位、控制条和播放完毕；
''' 离页停止。
''' 无有效素材时不能以播放请求已调用认定通过。

变量 回调次数 为 整数型

事件 视频播放器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 视频播放器测试.即将切换()
	视频播放器1.停止播放()
结束 事件

事件 视频播放器测试.程序被停止()
	视频播放器1.停止播放()
结束 事件

事件 操作按钮1.被单击()
	视频播放器1.播放视频(视频地址框.文本)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：播放视频；请检查权限、状态和运行日志"
			输出错误("设备测试/视频播放器：播放视频失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	视频播放器1.暂停播放()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：暂停；请检查权限、状态和运行日志"
			输出错误("设备测试/视频播放器：暂停失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	视频播放器1.继续播放()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：继续；请检查权限、状态和运行日志"
			输出错误("设备测试/视频播放器：继续失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	视频播放器1.停止播放()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：停止；请检查权限、状态和运行日志"
			输出错误("设备测试/视频播放器：停止失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	视频播放器1.置播放位置(视频播放器1.取视频时长() / 2)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：跳到中间；请检查权限、状态和运行日志"
			输出错误("设备测试/视频播放器：跳到中间失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	视频播放器1.置控制条状态(真)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：显示控制条；请检查权限、状态和运行日志"
			输出错误("设备测试/视频播放器：显示控制条失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	视频播放器1.置控制条状态(假)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：隐藏控制条；请检查权限、状态和运行日志"
			输出错误("设备测试/视频播放器：隐藏控制条失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	操作结果标签.文本 = "播放=" & 视频播放器1.取播放状态() & "；时长=" & 视频播放器1.取视频时长() _
		& 字符(10) & "位置=" & 视频播放器1.取播放位置() & "；缓冲=" & 视频播放器1.取缓冲进度()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取状态；请检查权限、状态和运行日志"
			输出错误("设备测试/视频播放器：读取状态失败")
	结束 错误
结束 事件

事件 视频播放器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 视频播放器1.播放完毕()
	回调次数 = 回调次数 + 1
	记录事件("播放完毕：回调=" & 回调次数)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("视频播放器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 视频播放器测试 $为 窗口
		标题 = "视频播放器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "播放自带测试视频，也可输入网络地址。核对暂停、继续、定位、控制条及结束事件；离页停止。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 视频地址框 $为 编辑框
			文本 = "android.resource://simple.runtime.tests/raw/device_video"
			宽度 = 长度_匹配父级
			提示文本 = "自带视频或网络视频地址"
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "播放视频"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "暂停"
			$结束 $定义
		$结束 $定义
		$定义 视频播放器1 $为 视频播放器
			宽度 = 长度_匹配父级
			高度 = "320px"
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "继续"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "停止"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "跳到中间"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "显示控制条"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "隐藏控制条"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "读取状态"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
