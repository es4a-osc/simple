''' NFC读写器测试。
''' 先读取初始化状态；
''' 具备 NFC 且开启后，将自有测试标签贴近设备，核对文本和卡号事件。
''' 写入只使用可擦写的专用测试标签；
''' 写后切回读取模式核对，不以模式设置调用代表写入成功。

变量 回调次数 为 整数型

事件 NFC读写器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	操作结果标签.文本 = "初始化状态=" & NFC读写器1.初始化NFC()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：初始化NFC；请检查权限、状态和运行日志"
			输出错误("设备测试/NFC读写器：初始化NFC失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	NFC读写器1.置读取模式()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取模式；请检查权限、状态和运行日志"
			输出错误("设备测试/NFC读写器：读取模式失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	NFC读写器1.置写入模式(NFC文本框.文本)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：写入测试标签；请检查权限、状态和运行日志"
			输出错误("设备测试/NFC读写器：写入测试标签失败")
	结束 错误
结束 事件

事件 NFC读写器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 NFC读写器1.读取到信息(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("读取到信息：回调=" & 回调次数 & "；文本=" & 参数1)
结束 事件

事件 NFC读写器1.读取到卡号(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("读取到卡号：回调=" & 回调次数 & "；卡号=" & 参数1)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("NFC读写器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 NFC读写器测试 $为 窗口
		标题 = "NFC读写器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "需要已开启 NFC 的设备和专用测试标签。初始化后读取文本、卡号；写入后切回读取模式核对。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 NFC文本框 $为 编辑框
			文本 = "NFC设备测试"
			宽度 = 长度_匹配父级
			提示文本 = "要写入测试标签的文本"
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "初始化NFC"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "读取模式"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "写入测试标签"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 NFC读写器1 $为 NFC读写器
		$结束 $定义
	$结束 $定义
$结束 $属性
