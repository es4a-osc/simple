''' 应用操作测试。
''' 读取当前应用名称、包名、版本及显示/内容区域。
''' 保存并重新读回专用设置键，返回桌面后恢复，核对前后台与当前配置；
''' 不覆盖应用其它设置。

事件 应用操作测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	操作结果标签.文本 = "应用=" & 取应用名() & "；包=" & 取包名() & "；版本=" & 取版本名() & "/" & 取版本号()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取应用信息；请检查权限、状态和运行日志"
			输出错误("设备测试/应用操作：读取应用信息失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "显示=" & 取显示宽度() & "×" & 取显示高度() _
		& 字符(10) & "内容=" & 取内容宽度() & "×" & 取内容高度() & 字符(10) & "密度=" & 取显示密度() & "；状态栏=" & 取状态栏高度() _
		& 字符(10) & "竖屏=" & 是否为竖屏() & "；前台=" & 是否在前台()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取显示区域；请检查权限、状态和运行日志"
			输出错误("设备测试/应用操作：读取显示区域失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	保存设置("device-test-setting", 设置输入框.文本)
	操作结果标签.文本 = "保存后读回=" & 读取设置("device-test-setting")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：保存专用设置；请检查权限、状态和运行日志"
			输出错误("设备测试/应用操作：保存专用设置失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	变量 值 为 变体型
	值 = 读取设置("device-test-setting")
	如果 值 = 空 则
		操作结果标签.文本 = "尚未保存测试键"
	否则
		操作结果标签.文本 = "读取设置=" & 值
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：重新读取设置；请检查权限、状态和运行日志"
			输出错误("设备测试/应用操作：重新读取设置失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	返回桌面()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：返回桌面；请检查权限、状态和运行日志"
			输出错误("设备测试/应用操作：返回桌面失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	返回应用()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：返回应用；请检查权限、状态和运行日志"
			输出错误("设备测试/应用操作：返回应用失败")
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 应用操作测试 $为 窗口
		标题 = "应用操作测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "读取应用及显示区域信息。保存专用测试设置后重新读取，核对内容；返回桌面后可重新进入应用。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 设置输入框 $为 编辑框
			文本 = "settings-中文42"
			宽度 = 长度_匹配父级
			提示文本 = "专用测试设置内容"
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "读取应用信息"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "读取显示区域"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "保存专用设置"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "重新读取设置"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "返回桌面"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "返回应用"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
