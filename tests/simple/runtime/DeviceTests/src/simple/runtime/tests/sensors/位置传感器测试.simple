''' 位置传感器测试窗口。

变量 位置次数 为 整数型
变量 已有位置 为 逻辑型
变量 停止时次数 为 整数型

事件 位置传感器测试.切换完毕()
	准备测试()
结束 事件

事件 位置传感器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 位置传感器测试.即将切换()
	停止测试()
结束 事件

事件 位置传感器测试.程序被停止()
	停止测试()
结束 事件

事件 权限按钮.被单击()
	变量 权限 为 文本型(2)
	权限(0) = "android.permission.ACCESS_FINE_LOCATION"
	权限(1) = "android.permission.ACCESS_COARSE_LOCATION"
	权限请求1.请求权限(权限, "定位测试")
结束 事件

事件 权限请求1.请求结果(权限 为 文本型(), 授权结果 为 整数型(), 请求标记 为 文本型)
	回调参数标签.文本 = "权限请求标记=" & 请求标记 & "；权限数=" & 取数组成员数(权限) _
		& "；结果数=" & 取数组成员数(授权结果)
	刷新状态()
结束 事件

事件 启动按钮.被单击()
	如果 权限请求1.是否授权("android.permission.ACCESS_FINE_LOCATION") _
		或 权限请求1.是否授权("android.permission.ACCESS_COARSE_LOCATION") 则
		位置传感器1.启用 = 真
		刷新状态()
	否则
		定位信息标签.文本 = "未授予请求定位权限；请先请求权限，拒绝时不会开始定位"
	结束 如果
结束 事件

事件 停止按钮.被单击()
	停止测试()
结束 事件

事件 查询地址按钮.被单击()
	如果 已有位置 则
		如果 位置传感器1.请求地址() 则
			地址标签.文本 = "地址查询已发起，等待回调"
		否则
			地址标签.文本 = "地址查询未发起：" & 位置传感器1.错误信息
		结束 如果
	否则
		地址标签.文本 = "尚未收到位置，不能验证地址查询"
	结束 如果
结束 事件

事件 位置传感器1.位置改变(纬度 为 双精度小数型, 经度 为 双精度小数型, 海拔 为 双精度小数型)
	位置次数 = 位置次数 + 1
	已有位置 = 真
	回调参数标签.文本 = "事件/属性一致=" _
		& (纬度 = 位置传感器1.纬度 且 经度 = 位置传感器1.经度 且 海拔 = 位置传感器1.海拔)
	纬度标签.文本 = "纬度：" & 纬度
	经度标签.文本 = "经度：" & 经度
	海拔标签.文本 = "海拔：" & 海拔 & "；具备海拔=" & 位置传感器1.具备海拔
	刷新状态()
结束 事件

事件 位置传感器1.定位状态改变(正在定位 为 逻辑型, 信息 为 文本型)
	回调参数标签.文本 = "定位回调=" & 正在定位 & 字符(10) & "信息=" & 信息
	刷新状态()
结束 事件

事件 位置传感器1.地址查询完毕(纬度 为 双精度小数型, 经度 为 双精度小数型, 地址 为 文本型)
	地址标签.文本 = "地址回调：" & 地址 & "；回调坐标=" & 纬度 & ", " & 经度 & "；属性读回=" & 位置传感器1.当前地址
结束 事件

事件 位置传感器1.操作失败(操作 为 文本型, 信息 为 文本型)
	定位信息标签.文本 = 操作 & "失败：" & 信息
结束 事件

事件 核对停止按钮.被单击()
	如果 位置传感器1.启用 则
		回调参数标签.文本 = "仍处于启用状态，请先停止，再等待后核对计数"
	否则如果 停止时次数 = 0 则
		回调参数标签.文本 = "尚无有效采样后的停止记录，不能验证停止后的回调行为"
	否则
		回调参数标签.文本 = "停止时事件=" & 停止时次数 & "；当前事件=" & 位置次数 _
			& "；停止后未增加=" & (停止时次数 = 位置次数)
	结束 如果
结束 事件

事件 读取位置按钮.被单击()
	回调参数标签.文本 = "经纬度=" & 位置传感器1.经度 & ", " & 位置传感器1.纬度 & "；海拔=" & 位置传感器1.海拔 _
		& 字符(10) & "具备海拔=" & 位置传感器1.具备海拔 & 字符(10) & "精度=" & 位置传感器1.精度 _
		& "；具备精度=" & 位置传感器1.具备精度 & 字符(10) & "当前地址=" & 位置传感器1.当前地址
	刷新状态()
结束 事件

''' 仅检查权限和状态，不自动弹出权限请求。
过程 准备测试()
	刷新状态()
结束 过程

''' 离页或后台停止定位订阅。
过程 停止测试()
	位置传感器1.启用 = 假
	停止时次数 = 位置次数
	刷新状态()
结束 过程

''' 显示实际授权与定位结果，避免把启动请求视为定位成功。
过程 刷新状态()
	权限标签.文本 = "精确定位=" & 权限请求1.是否授权("android.permission.ACCESS_FINE_LOCATION") _
		& "；大致定位=" & 权限请求1.是否授权("android.permission.ACCESS_COARSE_LOCATION")
	操作结果标签.文本 = "可用=" & 位置传感器1.是否可用 & "；正在定位=" & 位置传感器1.正在定位 _
		& "；位置事件=" & 位置次数
	定位信息标签.文本 = "定位信息：" & 位置传感器1.错误信息
结束 过程

$属性
	$资源 $窗口
	$定义 位置传感器测试 $为 窗口
		标题 = "位置传感器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "授权并开启系统定位后启动，核对经纬度、海拔和精度，再查询地址。停止后等待并核对事件次数；地址查询需要可用的地址服务。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 定位操作面板 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 权限按钮 $为 按钮
				文本 = "请求定位权限"
			$结束 $定义
			$定义 启动按钮 $为 按钮
				文本 = "启动定位"
			$结束 $定义
			$定义 停止按钮 $为 按钮
				文本 = "停止定位"
			$结束 $定义
		$结束 $定义
		$定义 查询地址按钮 $为 按钮
			文本 = "查询当前位置地址"
		$结束 $定义
		$定义 补充操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 核对停止按钮 $为 按钮
				文本 = "核对停止后事件"
			$结束 $定义
		$结束 $定义
		$定义 读取位置按钮 $为 按钮
			文本 = "读取位置属性"
		$结束 $定义
		$定义 位置传感器1 $为 位置传感器
			启用 = 假
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 权限标签 $为 标签
			文本 = "权限状态：待检查"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 回调参数标签 $为 标签
			文本 = "回调参数：尚未收到事件"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 定位信息标签 $为 标签
			文本 = "定位信息：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 纬度标签 $为 标签
			文本 = "纬度：暂无数据"
		$结束 $定义
		$定义 经度标签 $为 标签
			文本 = "经度：暂无数据"
		$结束 $定义
		$定义 海拔标签 $为 标签
			文本 = "海拔：暂无数据"
		$结束 $定义
		$定义 地址标签 $为 标签
			文本 = "地址："
		$结束 $定义
	$结束 $定义
$结束 $属性
