''' SQLite数据库测试。
''' 在后台运行真实 Android SQLite：私有测试库、建表、插入、修改、条件/范围查询、记录数、
''' 最大值、字段/表列表、删除和关闭。
''' 收到消息才显示结果；
''' 仅操作 device-tests.db 的专用测试表，不接触应用其它数据。

变量 回调次数 为 整数型
变量 后台线程 为 线程

事件 SQLite数据库测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	后台线程 = 启动线程(本对象, "执行数据库用例")
	操作结果标签.文本 = "后台已启动，等待实际数据库结果"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：运行数据库用例；请检查权限、状态和运行日志"
			输出错误("设备测试/SQLite数据库：运行数据库用例失败")
	结束 错误
结束 事件

事件 消息传递器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 消息传递器1.收到消息(参数1 为 整数型, 参数2 为 变体型)
	记录事件("数据库结果=" & 参数2 & "；UI线程标识=" & 取线程标识())
结束 事件

过程 执行数据库用例()
	变量 数据库 为 SQLite数据库
	数据库 = 创建 SQLite数据库
	数据库.打开数据库("device-tests.db")
	数据库.数据库执行("DROP TABLE IF EXISTS device_records")
	数据库.创建数据表("device_records", "id integer, name text")
	数据库.插入记录("device_records", "1,'甲'")
	数据库.插入记录("device_records", "2,'乙'")
	数据库.修改记录("device_records", "name='改名'", "id=2")
	变量 结果 为 文本型
	结果 = "记录数=" & 数据库.取记录数("device_records") _
		& "；最大值=" & 数据库.查询最大值("device_records", "id") _
		& "；有字段=" & 数据库.字段是否存在("device_records", "name") _
		& "；表数=" & 取数组成员数(数据库.取所有数据表()) _
		& "；查询=" & 数据库.数据库查询("SELECT id,name FROM device_records ORDER BY id", ",", ";") _
		& "；条件=" & 数据库.条件查询("device_records", "id=2", ",", ";") _
		& "；范围=" & 数据库.范围查询("device_records", 0, 1, ",", ";") & "；后台线程标识=" & 取线程标识()
	数据库.删除记录("device_records", "id=1")
	结果 = 结果 & "；删除后=" & 数据库.取记录数("device_records")
	数据库.删除数据表("device_records")
	结果 = 结果 & "；表已删除=" & (取反 数据库.数据表是否存在("device_records"))
	数据库.关闭数据库()
	数据库.关闭数据库()
	消息传递器1.发送消息(1, 结果)

	位于 错误
		分支 否则
			数据库.关闭数据库()
			消息传递器1.发送消息(2, "数据库用例失败，请检查运行日志")
	结束 错误
结束 过程

过程 记录事件(内容 为 文本型)
	输出信息("SQLite数据库测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 SQLite数据库测试 $为 窗口
		标题 = "SQLite数据库测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "运行本应用专用数据库用例，核对建表、增删改查、事务和错误处理。执行结果在下方显示，详细步骤写入日志。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "运行数据库用例"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 消息传递器1 $为 消息传递器
		$结束 $定义
	$结束 $定义
$结束 $属性
