''' 音效播放器测试。
''' 初始化后加载自生成 tone.wav，必须收到载入完毕再播放并保存声音/流标识。
''' 覆盖循环、暂停、继续、停止、卸载、重复释放和重新初始化；
''' 缺失音效应有失败结果，不混用声音标识与播放流标识。

变量 回调次数 为 整数型
变量 声音标识 为 整数型
变量 流标识 为 整数型
变量 已就绪 为 逻辑型

事件 音效播放器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 音效播放器测试.即将切换()
	音效播放器1.释放播放器()
	已就绪 = 假
结束 事件

事件 音效播放器测试.程序被停止()
	音效播放器1.释放播放器()
	已就绪 = 假
结束 事件

事件 操作按钮1.被单击()
	音效播放器1.初始化播放器(2)
	已就绪 = 假

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：初始化；请检查权限、状态和运行日志"
			输出错误("设备测试/音效播放器：初始化失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	声音标识 = 音效播放器1.载入音效("tone.wav")
	操作结果标签.文本 = "声音标识=" & 声音标识

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：载入音效；请检查权限、状态和运行日志"
			输出错误("设备测试/音效播放器：载入音效失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	如果 已就绪 则
		流标识 = 音效播放器1.播放音效(声音标识)
		操作结果标签.文本 = "流标识=" & 流标识
	否则
		操作结果标签.文本 = "请先等待载入完毕"
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：播放一次；请检查权限、状态和运行日志"
			输出错误("设备测试/音效播放器：播放一次失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	如果 已就绪 则
		流标识 = 音效播放器1.播放音效(声音标识, 2)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：循环播放；请检查权限、状态和运行日志"
			输出错误("设备测试/音效播放器：循环播放失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	音效播放器1.暂停播放(流标识)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：暂停播放；请检查权限、状态和运行日志"
			输出错误("设备测试/音效播放器：暂停播放失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	音效播放器1.继续播放(流标识)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：继续播放；请检查权限、状态和运行日志"
			输出错误("设备测试/音效播放器：继续播放失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	音效播放器1.停止播放(流标识)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：停止播放；请检查权限、状态和运行日志"
			输出错误("设备测试/音效播放器：停止播放失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	操作结果标签.文本 = "卸载=" & 音效播放器1.卸载音效(声音标识)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：卸载音效；请检查权限、状态和运行日志"
			输出错误("设备测试/音效播放器：卸载音效失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	音效播放器1.释放播放器()
	已就绪 = 假

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：释放播放器；请检查权限、状态和运行日志"
			输出错误("设备测试/音效播放器：释放播放器失败")
	结束 错误
结束 事件

事件 音效播放器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 音效播放器1.载入完毕(参数1 为 整数型)
	已就绪 = 参数1 = 声音标识
	记录事件("载入完毕声音标识=" & 参数1)
结束 事件

事件 音效播放器1.载入失败(参数1 为 整数型, 参数2 为 整数型)
	已就绪 = 假
	记录事件("载入失败=" & 参数1 & "；状态=" & 参数2)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("音效播放器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 音效播放器测试 $为 窗口
		标题 = "音效播放器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "初始化并载入测试音效，收到载入完毕事件后播放。核对循环、暂停、继续、停止及卸载；声音标识与播放流标识分别读取。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "初始化"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "载入音效"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "播放一次"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "循环播放"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "暂停播放"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "继续播放"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "停止播放"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "卸载音效"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "释放播放器"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 音效播放器1 $为 音效播放器
		$结束 $定义
	$结束 $定义
$结束 $属性
