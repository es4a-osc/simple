''' 音频播放器测试。
''' 独立生成的短音频 tone.wav。
''' 打开后等待播放就绪再播放；
''' 核对时长、位置、暂停/继续、定位、循环与结束事件；
''' 音量仅设置播放器自身，离页停止。
''' 缺失文件应返回失败或错误事件，之后仍可重新打开。

变量 回调次数 为 整数型

事件 音频播放器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 音频播放器测试.即将切换()
	音频播放器1.停止()
结束 事件

事件 音频播放器测试.程序被停止()
	音频播放器1.停止()
结束 事件

事件 操作按钮1.被单击()
	操作结果标签.文本 = "打开返回=" & 音频播放器1.打开("tone.wav")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：打开测试音频；请检查权限、状态和运行日志"
			输出错误("设备测试/音频播放器：打开测试音频失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "播放返回=" & 音频播放器1.播放()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：播放；请检查权限、状态和运行日志"
			输出错误("设备测试/音频播放器：播放失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	操作结果标签.文本 = "暂停返回=" & 音频播放器1.暂停()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：暂停；请检查权限、状态和运行日志"
			输出错误("设备测试/音频播放器：暂停失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	操作结果标签.文本 = "停止返回=" & 音频播放器1.停止()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：停止；请检查权限、状态和运行日志"
			输出错误("设备测试/音频播放器：停止失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	音频播放器1.位置 = 音频播放器1.时长 / 2

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：跳到中间；请检查权限、状态和运行日志"
			输出错误("设备测试/音频播放器：跳到中间失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	音频播放器1.循环 = 取反 音频播放器1.循环

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换循环；请检查权限、状态和运行日志"
			输出错误("设备测试/音频播放器：切换循环失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	音频播放器1.置音量(0.2)
	音频播放器1.置音量(0.2, 0.2)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换播放音量；请检查权限、状态和运行日志"
			输出错误("设备测试/音频播放器：切换播放音量失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	操作结果标签.文本 = "播放=" & 音频播放器1.是否正在播放() & "；时长=" & 音频播放器1.时长 _
		& 字符(10) & "位置=" & 音频播放器1.位置 & "；循环=" & 音频播放器1.循环

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取状态；请检查权限、状态和运行日志"
			输出错误("设备测试/音频播放器：读取状态失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	操作结果标签.文本 = "缺失打开返回=" & 音频播放器1.打开("device-missing.wav")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：打开缺失音频；请检查权限、状态和运行日志"
			输出错误("设备测试/音频播放器：打开缺失音频失败")
	结束 错误
结束 事件

事件 音频播放器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 音频播放器1.错误通知(参数1 为 整数型, 参数2 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("错误通知：回调=" & 回调次数 & "；主代码=" & 参数1 & "；附加代码=" & 参数2)
结束 事件

事件 音频播放器1.信息通知(参数1 为 整数型, 参数2 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("信息通知：回调=" & 回调次数 & "；主代码=" & 参数1 & "；附加代码=" & 参数2)
结束 事件

事件 音频播放器1.缓冲更新(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("缓冲更新：回调=" & 回调次数 & "；缓冲百分比=" & 参数1)
结束 事件

事件 音频播放器1.播放就绪()
	回调次数 = 回调次数 + 1
	记录事件("播放就绪：回调=" & 回调次数)
结束 事件

事件 音频播放器1.位置改变()
	回调次数 = 回调次数 + 1
	记录事件("位置改变：回调=" & 回调次数)
结束 事件

事件 音频播放器1.播放结束()
	回调次数 = 回调次数 + 1
	记录事件("播放结束：回调=" & 回调次数)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("音频播放器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 音频播放器测试 $为 窗口
		标题 = "音频播放器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "打开测试音频，等待就绪后播放。核对暂停、继续、定位、循环和结束事件；离页停止。可打开缺失文件检查错误后恢复。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "打开测试音频"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "播放"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "暂停"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "停止"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "跳到中间"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "切换循环"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "切换播放音量"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "读取状态"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "打开缺失音频"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 音频播放器1 $为 音频播放器
		$结束 $定义
	$结束 $定义
$结束 $属性
