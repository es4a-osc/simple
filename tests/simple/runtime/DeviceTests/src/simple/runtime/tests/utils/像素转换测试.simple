''' 像素转换测试。
''' 按设备真实密度转换 dp、px、sp，并将 10dp/10px 置给可视标签后读回实际宽度。
''' 核对同设备的换算关系，不能假定密度固定为 1；
''' 布局后再次读取。

事件 像素转换测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	操作结果标签.文本 = "密度=" & 取显示密度() & "；10dp=" & 到绝对像素(10) _
		& 字符(10) & "10px=" & 转绝对像素(10, 像素_绝对) & "；20px转dp=" & 到相对像素(20) & 字符(10) & "20px转sp=" & 到缩放像素(20) _
		& "；解析10dp=" & 解析为像素("10dp")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取转换结果；请检查权限、状态和运行日志"
			输出错误("设备测试/像素转换：读取转换结果失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	像素标签.宽度 = "10dp"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：宽度设为 10dp；请检查权限、状态和运行日志"
			输出错误("设备测试/像素转换：宽度设为 10dp失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	像素标签.宽度 = "10px"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：宽度设为 10px；请检查权限、状态和运行日志"
			输出错误("设备测试/像素转换：宽度设为 10px失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	操作结果标签.文本 = "布局后宽度px=" & 像素标签.宽度

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取实际宽度；请检查权限、状态和运行日志"
			输出错误("设备测试/像素转换：读取实际宽度失败")
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 像素转换测试 $为 窗口
		标题 = "像素转换测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "读取 dp 与 px 转换结果，再分别设置 10dp、10px 宽度，核对控件实际宽度及单位差异。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "读取转换结果"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "宽度设为 10dp"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "宽度设为 10px"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "读取实际宽度"
			$结束 $定义
		$结束 $定义
		$定义 像素标签 $为 标签
			宽度 = "10dp"
			高度 = "80px"
			背景颜色 = 颜色_红
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
