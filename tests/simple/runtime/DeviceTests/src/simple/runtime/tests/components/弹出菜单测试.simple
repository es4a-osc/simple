''' 弹出菜单测试。
''' 创建两个菜单项和一个子项，核对父项、分组及排序；
''' 选择需回调相同的项目标识，点击菜单外应回调关闭。
''' 删除/清空后重新添加仍应能弹出；
''' 仅影响本组件。

变量 回调次数 为 整数型
变量 首项 为 整数型
变量 次项 为 整数型
变量 子项 为 整数型

事件 弹出菜单测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	弹出菜单1.清空()
	首项 = 弹出菜单1.添加("菜单甲")
	次项 = 弹出菜单1.添加("菜单乙")
	子项 = 弹出菜单1.添加("子菜单")
	弹出菜单1.置父项(子项, 首项)
	弹出菜单1.置分组(次项, 7)
	弹出菜单1.置排序(次项, 2)
	操作结果标签.文本 = "父=" & 弹出菜单1.取父项(子项) & "；分组=" & 弹出菜单1.取分组(次项) _
		& "；排序=" & 弹出菜单1.取排序(次项)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：重建菜单；请检查权限、状态和运行日志"
			输出错误("设备测试/弹出菜单：重建菜单失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	弹出菜单1.弹出(操作按钮2)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：弹出菜单；请检查权限、状态和运行日志"
			输出错误("设备测试/弹出菜单：弹出菜单失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	弹出菜单1.删除(次项)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：删除第二项；请检查权限、状态和运行日志"
			输出错误("设备测试/弹出菜单：删除第二项失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	弹出菜单1.清空()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：清空菜单；请检查权限、状态和运行日志"
			输出错误("设备测试/弹出菜单：清空菜单失败")
	结束 错误
结束 事件

事件 弹出菜单1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 弹出菜单1.被选中(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("被选中：回调=" & 回调次数 & "；项目标识=" & 参数1)
结束 事件

事件 弹出菜单1.被关闭()
	回调次数 = 回调次数 + 1
	记录事件("被关闭：回调=" & 回调次数)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("弹出菜单测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 弹出菜单测试 $为 窗口
		标题 = "弹出菜单测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "重建后弹出菜单，选择项目核对标识，点击菜单外核对关闭事件。删除或清空后可重新添加。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "重建菜单"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "弹出菜单"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "删除第二项"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "清空菜单"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 弹出菜单1 $为 弹出菜单
		$结束 $定义
	$结束 $定义
$结束 $属性
