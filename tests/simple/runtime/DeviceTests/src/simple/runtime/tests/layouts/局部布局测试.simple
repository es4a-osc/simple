''' 局部布局测试。
''' 外层为垂直线性布局，内层分别为水平线性及单帧布局。
''' 切换上部局部方向不应改变下部的叠放规则；
''' 核对嵌套容器、边距和子组件事件。

变量 局部实例 为 线性布局

事件 局部布局测试.切换完毕()
	局部实例 = 上部面板.布局
结束 事件

事件 局部布局测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	局部实例.方向 = 1 - 局部实例.方向
	操作结果标签.文本 = "上部方向=" & 局部实例.方向

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换上部方向；请检查权限、状态和运行日志"
			输出错误("设备测试/局部布局：切换上部方向失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	上部面板.可视 = 取反 上部面板.可视

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换上部可见性；请检查权限、状态和运行日志"
			输出错误("设备测试/局部布局：切换上部可见性失败")
	结束 错误
结束 事件

事件 局部按钮1.被单击()
	操作结果标签.文本 = "局部按钮1收到点击"
结束 事件

事件 局部按钮2.被单击()
	操作结果标签.文本 = "局部按钮2收到点击"
结束 事件

事件 局部按钮3.被单击()
	操作结果标签.文本 = "局部按钮3收到点击"
结束 事件

$属性
	$资源 $窗口
	$定义 局部布局测试 $为 窗口
		标题 = "局部布局测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "只切换上部面板的方向和可见性，观察下部面板是否保持原布局，并点击各区域按钮。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "切换上部方向"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "切换上部可见性"
			$结束 $定义
		$结束 $定义
		$定义 外层面板 $为 面板
			宽度 = 长度_匹配父级
			$定义 上部面板 $为 面板
				布局.方向 = 布局_方向_水平
				宽度 = 长度_匹配父级
				$定义 局部按钮1 $为 按钮
					文本 = "局部1"
				$结束 $定义
				$定义 局部按钮2 $为 按钮
					文本 = "局部2"
				$结束 $定义
			$结束 $定义
			$定义 下部面板 $为 面板
				布局 = 布局_单帧
				宽度 = 长度_匹配父级
				高度 = "160px"
				$定义 下层标签 $为 标签
					文本 = "下部单帧层"
					宽度 = 长度_匹配父级
				$结束 $定义
				$定义 局部按钮3 $为 按钮
					文本 = "下部按钮"
					宽度 = "180px"
					高度 = "80px"
					对齐 = 对齐_居中
				$结束 $定义
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
