''' 面板测试窗口。

变量 内部点击次数 为 整数型
变量 已放大 为 逻辑型
变量 适应模式 为 逻辑型
变量 已设边距 为 逻辑型
变量 背景已切换 为 逻辑型

事件 面板测试.切换完毕()
	准备测试()
结束 事件

事件 面板测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 内部按钮.被单击()
	内部点击次数 = 内部点击次数 + 1
	刷新状态()
结束 事件

事件 切换面板按钮.被单击()
	面板1.可视 = 取反 面板1.可视
	刷新状态()
结束 事件

事件 切换尺寸按钮.被单击()
	适应模式 = 假
	已放大 = 取反 已放大
	如果 已放大 则
		面板1.宽度 = 240
		面板1.高度 = 150
	否则
		面板1.宽度 = 200
		面板1.高度 = 100
	结束 如果
	操作结果标签.文本 = "尺寸已设置；布局完成后点读取尺寸核对"
结束 事件

事件 读取尺寸按钮.被单击()
	刷新状态()
结束 事件

事件 切换背景按钮.被单击()
	背景已切换 = 取反 背景已切换
	如果 背景已切换 则
		面板1.背景颜色 = 颜色_黄
	否则
		面板1.背景颜色 = 颜色_绿
	结束 如果
	刷新状态()
结束 事件

事件 设置边距按钮.被单击()
	已设边距 = 取反 已设边距
	如果 已设边距 则
		面板1.左边距 = "12px"
		面板1.顶边距 = "12px"
		面板1.右边距 = "12px"
		面板1.底边距 = "12px"
	否则
		面板1.左边距 = 0
		面板1.顶边距 = 0
		面板1.右边距 = 0
		面板1.底边距 = 0
	结束 如果
	刷新状态()
结束 事件

事件 适应内容按钮.被单击()
	适应模式 = 真
	面板1.宽度 = 长度_适应内容
	面板1.高度 = 长度_适应内容
	操作结果标签.文本 = "已设适应内容；请核对子组件完整显示，布局完成后读取尺寸"
结束 事件

事件 恢复尺寸按钮.被单击()
	适应模式 = 假
	已放大 = 假
	面板1.宽度 = "200px"
	面板1.高度 = "100px"
	操作结果标签.文本 = "已设 200×100px；请等待布局后读取尺寸"
结束 事件

''' 保留容器当前尺寸和可见状态。
过程 准备测试()
	刷新状态()
结束 过程

''' 显示容器实际属性与子组件事件。
过程 刷新状态()
	变量 目标宽度 为 整数型, 目标高度 为 整数型
	目标宽度 = 200
	目标高度 = 100
	如果 已放大 则
		目标宽度 = 240
		目标高度 = 150
	结束 如果
	变量 尺寸一致 为 逻辑型
	尺寸一致 = 面板1.宽度 = 目标宽度 且 面板1.高度 = 目标高度
	容器属性标签.文本 = "可视=" & 面板1.可视 & "；背景=" & 面板1.背景颜色 _
		& "；四边距=" & 面板1.左边距 & ", " & 面板1.顶边距 & ", " & 面板1.右边距 & ", " & 面板1.底边距
	如果 适应模式 则
		操作结果标签.文本 = "适应内容；实测=" & 面板1.宽度 & " × " & 面板1.高度 & "；内部点击=" & 内部点击次数 _
			& "；请核对子组件排布"
	否则
		操作结果标签.文本 = "固定目标=" & 目标宽度 & " × " & 目标高度 & "；实测=" & 面板1.宽度 & " × " & 面板1.高度 _
			& 字符(10) & "尺寸一致=" & 尺寸一致 & "；内部点击=" & 内部点击次数
	结束 如果
结束 过程

$属性
	$资源 $窗口
	$定义 面板测试 $为 窗口
		滚动 = 真
		标题 = "面板测试"
		$定义 测试说明标签 $为 标签
			文本 = "切换面板可见性、尺寸、背景和边距，读回属性并观察子项位置。适应内容后可恢复固定尺寸；点击面板内按钮核对事件。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 容器操作面板 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换面板按钮 $为 按钮
				文本 = "切换可见"
			$结束 $定义
			$定义 切换尺寸按钮 $为 按钮
				文本 = "切换尺寸"
			$结束 $定义
			$定义 读取尺寸按钮 $为 按钮
				文本 = "读取尺寸"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换背景按钮 $为 按钮
				文本 = "切换面板背景"
			$结束 $定义
			$定义 设置边距按钮 $为 按钮
				文本 = "切换边距"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 适应内容按钮 $为 按钮
				文本 = "尺寸适应内容"
			$结束 $定义
			$定义 恢复尺寸按钮 $为 按钮
				文本 = "恢复 200×100px"
			$结束 $定义
		$结束 $定义
		$定义 标签1 $为 标签
			文本 = "绿色面板：高 100、宽 200"
		$结束 $定义
		$定义 面板1 $为 面板
			背景颜色 = 颜色_绿
			高度 = 100
			宽度 = 200
			$定义 内部标签 $为 标签
				文本 = "面板内标签"
				宽度 = 长度_匹配父级
			$结束 $定义
			$定义 内部按钮 $为 按钮
				文本 = "面板内按钮"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 容器属性标签 $为 标签
			文本 = "容器属性：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
