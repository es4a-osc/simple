''' 电话测试。
''' 查询电话能力和 SIM 状态，授权后监听系统通话状态并停止监听。
''' 拨号只打开界面；
''' 真实呼叫需要输入自有测试号码，自动化不拨打真实号码。
''' 振动为短测试，删除仅允许输入本次测试产生的通话记录标识。

变量 回调次数 为 整数型

事件 电话测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 电话测试.即将切换()
	电话1.停止监听()
结束 事件

事件 电话测试.程序被停止()
	电话1.停止监听()
结束 事件

事件 操作按钮1.被单击()
	变量 权限 为 文本型(2)
	权限(0) = "android.permission.READ_PHONE_STATE"
	权限(1) = "android.permission.CALL_PHONE"
	操作结果标签.文本 = "权限请求已提交=" & 权限请求1.请求权限(权限, "电话")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求所需权限；请检查权限、状态和运行日志"
			输出错误("设备测试/电话：请求所需权限失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "可用=" & 电话1.可用 & "；监听=" & 电话1.监听中 & 字符(10) & "状态=" & 电话1.通话状态 _
		& "；SIM=" & 电话1.取SIM卡状态()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：查询电话能力；请检查权限、状态和运行日志"
			输出错误("设备测试/电话：查询电话能力失败")
	结束 错误
结束 事件

事件 查询卡槽按钮.被单击()
	操作结果标签.文本 = "卡槽0=" & 电话1.取SIM卡状态(0)

	位于 错误
		分支 否则
			操作结果标签.文本 = "卡槽查询失败：需要 Android 8.0 或更高版本及电话能力"
			输出错误("设备测试/电话：指定卡槽查询失败，请核对系统版本和电话能力")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	电话1.开始监听()
	操作结果标签.文本 = "监听=" & 电话1.监听中

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开始监听；请检查权限、状态和运行日志"
			输出错误("设备测试/电话：开始监听失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	电话1.停止监听()
	操作结果标签.文本 = "监听=" & 电话1.监听中

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：停止监听；请检查权限、状态和运行日志"
			输出错误("设备测试/电话：停止监听失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	电话1.启动拨号界面(测试号码框.文本)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：打开拨号界面；请检查权限、状态和运行日志"
			输出错误("设备测试/电话：打开拨号界面失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	电话1.振动(100)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：短暂振动；请检查权限、状态和运行日志"
			输出错误("设备测试/电话：短暂振动失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	如果 测试号码框.文本 <> "" 则
		电话1.呼叫(测试号码框.文本)
	否则
		操作结果标签.文本 = "尚未提供自有测试号码，未发起呼叫"
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：呼叫自有测试号码；请检查权限、状态和运行日志"
			输出错误("设备测试/电话：呼叫自有测试号码失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	操作结果标签.文本 = "本机号码=" & 电话1.取本机号码()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：查询本机号码；请检查权限、状态和运行日志"
			输出错误("设备测试/电话：查询本机号码失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	如果 通话记录框.文本 <> "" 则
		操作结果标签.文本 = "删除返回=" & 电话1.删除通话记录(通话记录框.文本)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：清理本次通话记录；请检查权限、状态和运行日志"
			输出错误("设备测试/电话：清理本次通话记录失败")
	结束 错误
结束 事件

事件 电话1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 电话1.通话状态改变(参数1 为 整数型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("通话状态改变：回调=" & 回调次数 & "；状态=" & 参数1 & "；号码=" & 参数2)
结束 事件

事件 权限请求1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 权限请求1.请求结果(参数1 为 文本型(), 参数2 为 整数型(), 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("请求结果：回调=" & 回调次数 & "；权限项数=" & 取数组成员数(参数1) _
		& 字符(10) & "授权结果项数=" & 取数组成员数(参数2) & "；请求标记=" & 参数3)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("电话测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 电话测试 $为 窗口
		标题 = "电话测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "授权后查询电话、SIM 状态并监听通话。卡槽查询需 Android 8.0 起；拨号只打开界面，真实呼叫只用自有号码。清理仅限本次测试的通话记录。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 测试号码框 $为 编辑框
			提示文本 = "自有测试号码，默认不填"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 通话记录框 $为 编辑框
			提示文本 = "本次测试通话记录ID，默认不填"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作按钮1 $为 按钮
			文本 = "请求所需权限"
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮2 $为 按钮
				文本 = "查询电话能力"
			$结束 $定义
			$定义 查询卡槽按钮 $为 按钮
				文本 = "查询卡槽状态"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "开始监听"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "停止监听"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "打开拨号界面"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "短暂振动"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "呼叫自有测试号码"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "查询本机号码"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "清理本次通话记录"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 电话1 $为 电话
		$结束 $定义
	$结束 $定义
$结束 $属性
