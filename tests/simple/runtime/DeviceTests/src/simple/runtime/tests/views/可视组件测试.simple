''' 可视组件共用属性测试，分别观察基础样本、相对规则、绝对位置、权重和表格坐标。

变量 间距模式 为 整数型
变量 规则索引 为 整数型 = -1
变量 通用规则步骤 为 整数型
变量 尺寸已放大 为 逻辑型
变量 位置已移动 为 逻辑型
变量 对齐索引 为 整数型
变量 预期宽度 为 整数型 = 160
变量 预期高度 为 整数型 = 80

事件 可视组件测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 读取属性按钮.被单击()
	' 尺寸在单独的用户操作中读回，给 Android 完成布局的机会。
	基础结果标签.文本 = "标识=" & 基础样本.标识 & "；可视=" & 基础样本.可视 _
		& 字符(10) & "尺寸=" & 基础样本.宽度 & "×" & 基础样本.高度 _
		& "；符合预期=" & (基础样本.宽度 = 预期宽度 且 基础样本.高度 = 预期高度) _
		& 字符(10) & "背景图片=" & 基础样本.背景图片 & "；背景颜色=" & 基础样本.背景颜色 _
		& "；对齐=" & 基础样本.对齐
结束 事件

事件 切换尺寸按钮.被单击()
	尺寸已放大 = 取反 尺寸已放大
	预期宽度 = 160
	预期高度 = 80
	如果 尺寸已放大 则
		预期宽度 = 240
		预期高度 = 120
	结束 如果
	基础样本.宽度 = 预期宽度 & "px"
	基础样本.高度 = 预期高度 & "px"
	基础结果标签.文本 = "目标尺寸=" & 预期宽度 & "×" & 预期高度 & "px，布局后读取属性"
结束 事件

事件 切换可视按钮.被单击()
	基础样本.可视 = 取反 基础样本.可视
	基础结果标签.文本 = "样本可视=" & 基础样本.可视 & "，核对蓝色区域内样本是否显示"
结束 事件

事件 背景按钮.被单击()
	如果 基础样本.背景图片 = "simple.png" 则
		基础样本.背景图片 = ""
		基础样本.背景颜色 = 颜色_黄
	否则
		基础样本.背景图片 = "simple.png"
	结束 如果
	基础结果标签.文本 = "背景图片=" & 基础样本.背景图片 & "；背景颜色=" & 基础样本.背景颜色
结束 事件

事件 标识按钮.被单击()
	变量 原标识 为 整数型, 新标识 为 整数型
	原标识 = 基础样本.标识
	新标识 = 15700001
	基础样本.标识 = 新标识
	基础结果标签.文本 = "设置标识读回一致=" & (基础样本.标识 = 新标识)
	基础样本.标识 = 原标识
	基础结果标签.文本 = 基础结果标签.文本 & "；原标识已恢复=" & (基础样本.标识 = 原标识)
结束 事件

事件 对齐按钮.被单击()
	对齐索引 = (对齐索引 + 1) % 3
	基础样本.对齐 = 对齐索引
	基础结果标签.文本 = "对齐读回一致=" & (基础样本.对齐 = 对齐索引) & "；0左、1中、2右"
结束 事件

事件 间距按钮.被单击()
	变量 左值 为 整数型, 顶值 为 整数型, 右值 为 整数型, 底值 为 整数型
	判断 间距模式
		分支 0
			左值 = 4
			顶值 = 8
			右值 = 12
			底值 = 16
			基础样本.左边距 = "4px"
			基础样本.顶边距 = "8px"
			基础样本.右边距 = "12px"
			基础样本.底边距 = "16px"
			基础样本.左填充 = "4px"
			基础样本.顶填充 = "8px"
			基础样本.右填充 = "12px"
			基础样本.底填充 = "16px"
		分支 1
			左值 = 10
			顶值 = 10
			右值 = 10
			底值 = 10
			基础样本.置边距("10px")
			基础样本.置填充("10px")
		分支 2
			左值 = 14
			顶值 = 6
			右值 = 14
			底值 = 6
			基础样本.置边距("14px", "6px")
			基础样本.置填充("14px", "6px")
		分支 3
			左值 = 16
			顶值 = 12
			右值 = 8
			底值 = 4
			基础样本.置边距("16px", "12px", "8px", "4px")
			基础样本.置填充("16px", "12px", "8px", "4px")
	结束 判断

	变量 边距一致 为 逻辑型, 填充一致 为 逻辑型
	边距一致 = 基础样本.左边距 = 左值 且 基础样本.顶边距 = 顶值 且 基础样本.右边距 = 右值 且 基础样本.底边距 = 底值
	填充一致 = 基础样本.左填充 = 左值 且 基础样本.顶填充 = 顶值 且 基础样本.右填充 = 右值 且 基础样本.底填充 = 底值
	基础结果标签.文本 = "间距方案=" & 间距模式 & "；预期左上右下=" & 左值 & "," & 顶值 & "," & 右值 & "," & 底值 _
		& 字符(10) & "边距读回一致=" & 边距一致 & "；填充读回一致=" & 填充一致
	间距模式 = (间距模式 + 1) % 4
结束 事件

事件 相对规则按钮.被单击()
	清除相对规则()
	规则索引 = (规则索引 + 1) % 22
	变量 实际 为 整数型, 预期 为 整数型
	变量 规则名称 为 文本型
	判断 规则索引
		分支 0
			规则名称 = "位于左边"
			相对目标.位于左边 = 相对锚点.标识
			实际 = 相对目标.位于左边
			预期 = 相对锚点.标识
		分支 1
			规则名称 = "位于右边"
			相对目标.位于右边 = 相对锚点.标识
			实际 = 相对目标.位于右边
			预期 = 相对锚点.标识
		分支 2
			规则名称 = "位于顶边"
			相对目标.位于顶边 = 相对锚点.标识
			实际 = 相对目标.位于顶边
			预期 = 相对锚点.标识
		分支 3
			规则名称 = "位于底边"
			相对目标.位于底边 = 相对锚点.标识
			实际 = 相对目标.位于底边
			预期 = 相对锚点.标识
		分支 4
			规则名称 = "对齐基线"
			相对目标.对齐基线 = 相对锚点.标识
			实际 = 相对目标.对齐基线
			预期 = 相对锚点.标识
		分支 5
			规则名称 = "对齐左边"
			相对目标.对齐左边 = 相对锚点.标识
			实际 = 相对目标.对齐左边
			预期 = 相对锚点.标识
		分支 6
			规则名称 = "对齐顶边"
			相对目标.对齐顶边 = 相对锚点.标识
			实际 = 相对目标.对齐顶边
			预期 = 相对锚点.标识
		分支 7
			规则名称 = "对齐右边"
			相对目标.对齐右边 = 相对锚点.标识
			实际 = 相对目标.对齐右边
			预期 = 相对锚点.标识
		分支 8
			规则名称 = "对齐底边"
			相对目标.对齐底边 = 相对锚点.标识
			实际 = 相对目标.对齐底边
			预期 = 相对锚点.标识
		分支 9
			规则名称 = "对齐父左边"
			相对目标.对齐父左边 = 真
			预期 = 布局_规则_真
			如果 相对目标.对齐父左边 则
				实际 = 布局_规则_真
			结束 如果
		分支 10
			规则名称 = "对齐父顶边"
			相对目标.对齐父顶边 = 真
			预期 = 布局_规则_真
			如果 相对目标.对齐父顶边 则
				实际 = 布局_规则_真
			结束 如果
		分支 11
			规则名称 = "对齐父右边"
			相对目标.对齐父右边 = 真
			预期 = 布局_规则_真
			如果 相对目标.对齐父右边 则
				实际 = 布局_规则_真
			结束 如果
		分支 12
			规则名称 = "对齐父底边"
			相对目标.对齐父底边 = 真
			预期 = 布局_规则_真
			如果 相对目标.对齐父底边 则
				实际 = 布局_规则_真
			结束 如果
		分支 13
			规则名称 = "居中于父"
			相对目标.居中于父 = 真
			预期 = 布局_规则_真
			如果 相对目标.居中于父 则
				实际 = 布局_规则_真
			结束 如果
		分支 14
			规则名称 = "居中水平"
			相对目标.居中水平 = 真
			预期 = 布局_规则_真
			如果 相对目标.居中水平 则
				实际 = 布局_规则_真
			结束 如果
		分支 15
			规则名称 = "居中垂直"
			相对目标.居中垂直 = 真
			预期 = 布局_规则_真
			如果 相对目标.居中垂直 则
				实际 = 布局_规则_真
			结束 如果
		分支 16
			规则名称 = "位于开始"
			相对目标.位于开始 = 相对锚点.标识
			实际 = 相对目标.位于开始
			预期 = 相对锚点.标识
		分支 17
			规则名称 = "位于结束"
			相对目标.位于结束 = 相对锚点.标识
			实际 = 相对目标.位于结束
			预期 = 相对锚点.标识
		分支 18
			规则名称 = "对齐开始"
			相对目标.对齐开始 = 相对锚点.标识
			实际 = 相对目标.对齐开始
			预期 = 相对锚点.标识
		分支 19
			规则名称 = "对齐结束"
			相对目标.对齐结束 = 相对锚点.标识
			实际 = 相对目标.对齐结束
			预期 = 相对锚点.标识
		分支 20
			规则名称 = "对齐父开始"
			相对目标.对齐父开始 = 真
			预期 = 布局_规则_真
			如果 相对目标.对齐父开始 则
				实际 = 布局_规则_真
			结束 如果
		分支 21
			规则名称 = "对齐父结束"
			相对目标.对齐父结束 = 真
			预期 = 布局_规则_真
			如果 相对目标.对齐父结束 则
				实际 = 布局_规则_真
			结束 如果
	结束 判断
	规则结果标签.文本 = "规则 " & (规则索引 + 1) & "/22：" & 规则名称 _
		& 字符(10) & "属性读回一致=" & (实际 = 预期) & "；规则瞄点一致=" & (相对目标.取瞄点(规则索引) = 预期) _
		& 字符(10) & "观察黄色目标相对于蓝色锚点和灰色父容器的位置"
结束 事件

事件 通用规则按钮.被单击()
	清除相对规则()
	判断 通用规则步骤
		分支 0
			相对目标.添加规则(布局_规则_右, 相对锚点.标识)
			规则结果标签.文本 = "添加锚点规则正确=" & (相对目标.取瞄点(布局_规则_右) = 相对锚点.标识)
		分支 1
			相对目标.添加规则(布局_规则_右, 相对锚点.标识)
			相对目标.删除规则(布局_规则_右)
			规则结果标签.文本 = "删除锚点规则正确=" & (相对目标.取瞄点(布局_规则_右) = 0)
		分支 2
			相对目标.添加规则(布局_规则_对齐_父_底)
			规则结果标签.文本 = "添加父级规则正确=" & (相对目标.取瞄点(布局_规则_对齐_父_底) = 布局_规则_真)
		分支 3
			相对目标.添加规则(布局_规则_对齐_父_底)
			相对目标.删除规则(布局_规则_对齐_父_底)
			规则结果标签.文本 = "删除父级规则正确=" & (相对目标.取瞄点(布局_规则_对齐_父_底) = 0)
	结束 判断
	通用规则步骤 = (通用规则步骤 + 1) % 4
结束 事件

''' 每个方案开始前移除其它约束，避免规则相互覆盖。
过程 清除相对规则()
	变量 索引 为 整数型
	循环 索引 = 0 至 21
		相对目标.删除规则(索引)
	下个
结束 过程

事件 位置按钮.被单击()
	位置已移动 = 取反 位置已移动
	如果 位置已移动 则
		绝对样本.移动("88px", "56px", "180px", "72px")
		位置结果标签.文本 = "移动读回一致=" & (绝对样本.左边 = 88 且 绝对样本.顶边 = 56 且 绝对样本.宽度 = 180 且 绝对样本.高度 = 72)
	否则
		绝对样本.左边 = "24px"
		绝对样本.顶边 = "32px"
		绝对样本.宽度 = "120px"
		绝对样本.高度 = "64px"
		位置结果标签.文本 = "单项位置读回一致=" & (绝对样本.左边 = 24 且 绝对样本.顶边 = 32 且 绝对样本.宽度 = 120 且 绝对样本.高度 = 64)
	结束 如果
结束 事件

事件 绝对样本.被单击()
	位置结果标签.文本 = "移动后的实际点击已收到"
结束 事件

事件 权重按钮.被单击()
	变量 原权重 为 单精度小数型
	原权重 = 权重样本1.权重
	权重样本1.权重 = 权重样本2.权重
	权重样本2.权重 = 原权重
	权重结果标签.文本 = "权重=" & 权重样本1.权重 & ":" & 权重样本2.权重 & "，布局后读取实际宽度"
结束 事件

事件 权重读回按钮.被单击()
	变量 左宽 为 整数型, 右宽 为 整数型
	左宽 = 权重样本1.宽度
	右宽 = 权重样本2.宽度
	权重结果标签.文本 = "实际宽度=" & 左宽 & ":" & 右宽 _
		& 字符(10) & "宽度有效且填满容器=" & (左宽 > 0 且 右宽 > 0 且 左宽 + 右宽 = 权重面板.宽度) _
		& 字符(10) & "比例误差不超过2px=" & (取绝对值(左宽 * 权重样本2.权重 - 右宽 * 权重样本1.权重) <= 2)
结束 事件

事件 表格按钮.被单击()
	表格结果标签.文本 = "左上行列正确=" & (表格样本1.行 = 0 且 表格样本1.列 = 0) _
		& "；右下行列正确=" & (表格样本2.行 = 1 且 表格样本2.列 = 1)
结束 事件

事件 重设行按钮.被单击()
	表格样本1.行 = 1
	表格结果标签.文本 = "失败：重复设置行未被拒绝"

	位于 错误
		分支 索引超出界限错误
			表格结果标签.文本 = "已拒绝重复设置行；原行仍为0=" & (表格样本1.行 = 0)
	结束 错误
结束 事件

事件 重设列按钮.被单击()
	表格样本1.列 = 1
	表格结果标签.文本 = "失败：重复设置列未被拒绝"

	位于 错误
		分支 索引超出界限错误
			表格结果标签.文本 = "已拒绝重复设置列；原列仍为0=" & (表格样本1.列 = 0)
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 可视组件测试 $为 窗口
		标题 = "可视组件测试"
		滚动 = 真
		$定义 说明标签 $为 标签
			文本 = "先设置后读回尺寸，并观察样本。向下滚动可逐条检查22种相对规则、绝对位置、权重和表格行列。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 读取属性按钮 $为 按钮
			文本 = "读取可视组件属性"
		$结束 $定义
		$定义 切换尺寸按钮 $为 按钮
			文本 = "切换样本尺寸"
		$结束 $定义
		$定义 切换可视按钮 $为 按钮
			文本 = "切换样本可视"
		$结束 $定义
		$定义 间距按钮 $为 按钮
			文本 = "下一组边距和填充"
		$结束 $定义
		$定义 背景按钮 $为 按钮
			文本 = "切换图片和颜色背景"
		$结束 $定义
		$定义 标识按钮 $为 按钮
			文本 = "设置并读取标识"
		$结束 $定义
		$定义 对齐按钮 $为 按钮
			文本 = "切换样本对齐"
		$结束 $定义
		$定义 基础面板 $为 面板
			宽度 = 长度_匹配父级
			高度 = "140dp"
			背景颜色 = &HFFE0F0FF
			$定义 基础样本 $为 标签
				文本 = "间距样本"
				宽度 = "160px"
				高度 = "80px"
				背景颜色 = 颜色_黄
			$结束 $定义
		$结束 $定义
		$定义 基础结果标签 $为 标签
			文本 = "基础属性：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 相对规则按钮 $为 按钮
			文本 = "下一条相对规则"
		$结束 $定义
		$定义 通用规则按钮 $为 按钮
			文本 = "下一步添加或删除规则"
		$结束 $定义
