''' 数据表格测试。
''' 初始化 2 列 2 行，核对表头、单元格、行标记和点击行号。
''' 修改单元格、添加/删除、清空后重建；
''' 切换缩略、颜色及图片模式后数据不应错位。

变量 回调次数 为 整数型
变量 已建表 为 逻辑型

事件 数据表格测试.切换完毕()
	如果 取反 已建表 则
		重置表格()
		已建表 = 真
	结束 如果
结束 事件

事件 数据表格测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	重置表格()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：重建表格；请检查权限、状态和运行日志"
			输出错误("设备测试/数据表格：重建表格失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	数据表格1.置单元格内容(0, 1, "已修改")
	操作结果标签.文本 = "文本格=" & 数据表格1.取单元格内容(0, 1)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：修改文本格；请检查权限、状态和运行日志"
			输出错误("设备测试/数据表格：修改文本格失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	变量 内容 为 文本型(2)
	内容(0) = "simple.png"
	内容(1) = "新行"
	数据表格1.添加一行(内容, 颜色_黄)
	操作结果标签.文本 = "行数=" & 数据表格1.取行数()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：新增一行；请检查权限、状态和运行日志"
			输出错误("设备测试/数据表格：新增一行失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	如果 数据表格1.取行数() > 0 则
		数据表格1.删除一行(0)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：删除首行；请检查权限、状态和运行日志"
			输出错误("设备测试/数据表格：删除首行失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	操作结果标签.文本 = "行=" & 数据表格1.取行数() & "；列=" & 数据表格1.取列数() _
		& "；首行标记=" & 数据表格1.取表格行标记(0)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取表格；请检查权限、状态和运行日志"
			输出错误("设备测试/数据表格：读取表格失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	数据表格1.最大字长 = 4
	数据表格1.置缩略显示内容(真)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换缩略显示；请检查权限、状态和运行日志"
			输出错误("设备测试/数据表格：切换缩略显示失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	数据表格1.表头背景颜色 = 颜色_蓝
	数据表格1.表头字体颜色 = 颜色_白
	数据表格1.表头字体大小 = 18
	数据表格1.单元格字体颜色 = 颜色_黑
	数据表格1.单元格字体大小 = 16
	数据表格1.分割线颜色 = 颜色_红
	数据表格1.分割线宽度 = 2
	数据表格1.拉伸列 = 1
	数据表格1.置表格行背景色(0, &HFFCCFFCC)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：调整样式；请检查权限、状态和运行日志"
			输出错误("设备测试/数据表格：调整样式失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	数据表格1.显示图片 = 取反 数据表格1.显示图片
	操作结果标签.文本 = "图片模式=" & 数据表格1.显示图片 & "；行数=" & 数据表格1.取行数()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换图片模式；请检查权限、状态和运行日志"
			输出错误("设备测试/数据表格：切换图片模式失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	数据表格1.清空表格()
	操作结果标签.文本 = "清空后行=" & 数据表格1.取行数() & "；列=" & 数据表格1.取列数()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：清空表格；请检查权限、状态和运行日志"
			输出错误("设备测试/数据表格：清空表格失败")
	结束 错误
结束 事件

事件 数据表格1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 数据表格1.表格行被单击(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("表格行被单击：回调=" & 回调次数 & "；行索引=" & 参数1)
结束 事件

过程 重置表格()
	数据表格1.显示图片 = 假
	数据表格1.清空表格()
	变量 内容 为 文本型(2)
	内容(0) = "图片"
	内容(1) = "内容"
	数据表格1.添加表头(内容)
	内容(0) = "simple.png"
	内容(1) = "第一行"
	数据表格1.添加一行(内容)
	内容(0) = "@drawable/icon"
	内容(1) = "第二行很长的文字"
	数据表格1.添加一行(内容)
	数据表格1.置表格行标记(0, "row-one")
	操作结果标签.文本 = "重置后行=" & 数据表格1.取行数() & "；列=" & 数据表格1.取列数()
结束 过程

过程 记录事件(内容 为 文本型)
	输出信息("数据表格测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 数据表格测试 $为 窗口
		标题 = "数据表格测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "重建后有 2 列 2 行。修改、增删或清空后核对内容和行标记；切换缩略、样式及图片模式，再点击行核对索引。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "重建表格"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "修改文本格"
			$结束 $定义
		$结束 $定义
		$定义 数据表格1 $为 数据表格
			宽度 = 长度_匹配父级
			高度 = "360px"
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "新增一行"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "删除首行"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "读取表格"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "切换缩略显示"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "调整样式"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "切换图片模式"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "清空表格"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
