''' 定时任务测试。
''' 使用本测试服务和应用启动任务，任务编号 92001/92002。
''' 分别安排、取消和重复替换，再核对服务日志或程序被启动的意图参数。
''' 受系统后台与闹钟调度限制，调用完成不等于准时执行；
''' 离页取消剩余任务。

变量 回调次数 为 整数型

事件 定时任务测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 定时任务测试.即将切换()
	定时任务1.取消启动任务(92001)
	定时任务1.取消服务任务(92002, "simple.runtime.tests.objects.测试服务")
结束 事件

事件 定时任务测试.程序被停止()
	定时任务1.取消启动任务(92001)
	定时任务1.取消服务任务(92002, "simple.runtime.tests.objects.测试服务")
结束 事件

事件 定时任务测试.程序被启动(启动意图 为 意图)
	记录事件("启动任务编号=" & 启动意图.取附加("任务编号") & "；参数=" & 启动意图.取附加("参数"))
结束 事件

事件 操作按钮1.被单击()
	保存设置("device-service-log", "")
	定时任务1.设置服务任务(92002, "simple.runtime.tests.objects.测试服务", 1000, "alarm-service")
	操作结果标签.文本 = "已安排，稍后读取实际服务日志"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：安排服务任务；请检查权限、状态和运行日志"
			输出错误("设备测试/定时任务：安排服务任务失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	定时任务1.设置启动任务(92001, 1500, "alarm-activity")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：安排启动任务；请检查权限、状态和运行日志"
			输出错误("设备测试/定时任务：安排启动任务失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	定时任务1.取消启动任务(92001)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：取消启动任务；请检查权限、状态和运行日志"
			输出错误("设备测试/定时任务：取消启动任务失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	定时任务1.取消服务任务(92002, "simple.runtime.tests.objects.测试服务")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：取消服务任务；请检查权限、状态和运行日志"
			输出错误("设备测试/定时任务：取消服务任务失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	变量 记录 为 变体型
	记录 = 读取设置("device-service-log")
	如果 记录 <> 空 则
		操作结果标签.文本 = 记录
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取服务日志；请检查权限、状态和运行日志"
			输出错误("设备测试/定时任务：读取服务日志失败")
	结束 错误
结束 事件

事件 定时任务1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("定时任务测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 定时任务测试 $为 窗口
		标题 = "定时任务测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "安排本应用的服务或启动任务，再读取服务日志或启动参数。可取消、重复安排；任务可能受系统调度延迟，离页取消剩余任务。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "安排服务任务"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "安排启动任务"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "取消启动任务"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "取消服务任务"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "读取服务日志"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 定时任务1 $为 定时任务
		$结束 $定义
	$结束 $定义
$结束 $属性
