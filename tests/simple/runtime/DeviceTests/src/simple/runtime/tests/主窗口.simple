
常量 子项前缀 为 文本型 = " - "

静态 变量 窗口实例 为 窗口

变量 成_按下时间 为 长整数型
变量 成_窗口列表 为 哈希表

事件 主窗口.加载()

结束 事件

事件 主窗口.初始化()
	窗口实例 = 本对象
	成_窗口列表 = 创建 哈希表

	' 组件 - components
	列表框1.添加项目("组件")
	列表框1.添加项目(子项前缀 & "计时器")
	列表框1.添加项目(子项前缀 & "定时任务")
	列表框1.添加项目(子项前缀 & "权限请求")
	列表框1.添加项目(子项前缀 & "文件选择器")
	列表框1.添加项目(子项前缀 & "弹出菜单")
	列表框1.添加项目(子项前缀 & "消息传递器")
	列表框1.添加项目(子项前缀 & "广播接收器")
	列表框1.添加项目(子项前缀 & "TCP服务端")
	列表框1.添加项目(子项前缀 & "TCP客户端")
	列表框1.添加项目(子项前缀 & "UDP数据报")
	列表框1.添加项目(子项前缀 & "HTTP客户端")
	列表框1.添加项目(子项前缀 & "WIFI管理器")
	列表框1.添加项目(子项前缀 & "蓝牙通信器")
	列表框1.添加项目(子项前缀 & "NFC读写器")
	列表框1.添加项目(子项前缀 & "音频播放器")
	列表框1.添加项目(子项前缀 & "音效播放器")
	列表框1.添加项目(子项前缀 & "音量管理器")
	列表框1.添加项目(子项前缀 & "语音处理器")
	列表框1.添加项目(子项前缀 & "相机")
	列表框1.添加项目(子项前缀 & "电池监视器")
	列表框1.添加项目(子项前缀 & "电话")
	列表框1.添加项目(子项前缀 & "通讯录")
	列表框1.添加项目(子项前缀 & "指纹验证")
	列表框1.添加项目(子项前缀 & "红外发射器")

	' 传感器 - sensors
	列表框1.添加项目("传感器")
	列表框1.添加项目(子项前缀 & "加速度传感器")
	列表框1.添加项目(子项前缀 & "方向传感器")
	列表框1.添加项目(子项前缀 & "位置传感器")
	列表框1.添加项目(子项前缀 & "光线传感器")
	列表框1.添加项目(子项前缀 & "距离传感器")

	' 布局 - layouts
	列表框1.添加项目("布局")
	列表框1.添加项目(子项前缀 & "线性布局")
	列表框1.添加项目(子项前缀 & "单帧布局")
	列表框1.添加项目(子项前缀 & "表格布局")
	列表框1.添加项目(子项前缀 & "相对布局")
	列表框1.添加项目(子项前缀 & "绝对布局")
	列表框1.添加项目(子项前缀 & "局部布局")
	列表框1.添加项目(子项前缀 & "布局对照")

	' 容器 - containers
	列表框1.添加项目("容器")
	列表框1.添加项目(子项前缀 & "窗口")
	列表框1.添加项目(子项前缀 & "面板")
	列表框1.添加项目(子项前缀 & "垂直滚动框")
	列表框1.添加项目(子项前缀 & "水平滚动框")

	' 视图 - views
	列表框1.添加项目("视图")
	' 文本组件
	列表框1.添加项目(子项前缀 & "标签")
	列表框1.添加项目(子项前缀 & "按钮")
	列表框1.添加项目(子项前缀 & "编辑框")
	列表框1.添加项目(子项前缀 & "密码编辑框")
	列表框1.添加项目(子项前缀 & "邮箱选择器")
	列表框1.添加项目(子项前缀 & "富文本框")
	列表框1.添加项目(子项前缀 & "单选框")
	列表框1.添加项目(子项前缀 & "复选框")
	' 图片组件
	列表框1.添加项目(子项前缀 & "图片框")
	列表框1.添加项目(子项前缀 & "图片按钮")
	' 进度组件
	列表框1.添加项目(子项前缀 & "水平进度条")
	列表框1.添加项目(子项前缀 & "进度圈")
	列表框1.添加项目(子项前缀 & "水平滑块条")
	列表框1.添加项目(子项前缀 & "垂直滑块条")
	' 列表组件
	列表框1.添加项目(子项前缀 & "列表框")
	列表框1.添加项目(子项前缀 & "下拉列表框")
	列表框1.添加项目(子项前缀 & "单选列表框")
	列表框1.添加项目(子项前缀 & "多选列表框")
	列表框1.添加项目(子项前缀 & "数据表格")
	' 其它组件
	列表框1.添加项目(子项前缀 & "网页浏览框")
	列表框1.添加项目(子项前缀 & "画板")
	列表框1.添加项目(子项前缀 & "摄像框")
	列表框1.添加项目(子项前缀 & "视频播放器")

	' 对象 - objects
	列表框1.添加项目("对象")
	列表框1.添加项目(子项前缀 & "意图")
	列表框1.添加项目(子项前缀 & "服务")
	列表框1.添加项目(子项前缀 & "SQLite数据库")
	列表框1.添加项目(子项前缀 & "录音器")

	' 辅助 - utils
	列表框1.添加项目("辅助")
	列表框1.添加项目(子项前缀 & "应用操作")
	列表框1.添加项目(子项前缀 & "日志输出")
	列表框1.添加项目(子项前缀 & "文件操作")
	列表框1.添加项目(子项前缀 & "资产操作")
	列表框1.添加项目(子项前缀 & "资源操作")
	列表框1.添加项目(子项前缀 & "编码转换")
	列表框1.添加项目(子项前缀 & "剪贴板操作")
	列表框1.添加项目(子项前缀 & "对话框操作")
	列表框1.添加项目(子项前缀 & "像素转换")
	列表框1.添加项目(子项前缀 & "颜色操作")

	' 其它 - others
	列表框1.添加项目("其它")
结束 事件

事件 主窗口.切换完毕()
	' 列表框需要焦点，否则无法响应事件
	列表框1.获取焦点()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		如果 取现行时间戳() - 成_按下时间 > 2000 则
			成_按下时间 = 取现行时间戳()
			显示提示框("再按一次退出...")
		否则
			终止()
		结束 如果
	结束 如果
结束 事件

事件 列表框1.项目被单击(索引 为 整数型)
	' 取子项文本
	变量 局_子项文本 为 文本型
	局_子项文本 = 列表框1.取项目文本(索引)
	如果 取反 (局_子项文本 匹配 子项前缀 & ".*") 则
		显示提示框("请点击具体测试项！")
		退出 事件
	结束 如果
	局_子项文本 = 取文本中间(局_子项文本, 取字符数(子项前缀))

	' 取对应窗口
	变量 局_切换窗口 为 变体型
	如果 成_窗口列表.是否包含键(局_子项文本) 则
		局_切换窗口 = 成_窗口列表.取值(局_子项文本)
	否则
		' 实例化窗口
		判断 局_子项文本
			' 组件 - components
			分支 "计时器"
				局_切换窗口 = 创建 components.计时器测试
			分支 "定时任务"
				局_切换窗口 = 创建 components.定时任务测试
			分支 "权限请求"
				局_切换窗口 = 创建 components.权限请求测试
			分支 "文件选择器"
				局_切换窗口 = 创建 components.文件选择器测试
			分支 "弹出菜单"
				局_切换窗口 = 创建 components.弹出菜单测试
			分支 "消息传递器"
				局_切换窗口 = 创建 components.消息传递器测试
			分支 "广播接收器"
				局_切换窗口 = 创建 components.广播接收器测试
			分支 "TCP服务端"
				局_切换窗口 = 创建 components.TCP服务端测试
			分支 "TCP客户端"
				局_切换窗口 = 创建 components.TCP客户端测试
			分支 "UDP数据报"
				局_切换窗口 = 创建 components.UDP数据报测试
			分支 "HTTP客户端"
				局_切换窗口 = 创建 components.HTTP客户端测试
			分支 "WIFI管理器"
				局_切换窗口 = 创建 components.WIFI管理器测试
			分支 "蓝牙通信器"
				局_切换窗口 = 创建 components.蓝牙通信器测试
			分支 "NFC读写器"
				局_切换窗口 = 创建 components.NFC读写器测试
			分支 "音频播放器"
				局_切换窗口 = 创建 components.音频播放器测试
			分支 "音效播放器"
				局_切换窗口 = 创建 components.音效播放器测试
			分支 "音量管理器"
				局_切换窗口 = 创建 components.音量管理器测试
			分支 "语音处理器"
				局_切换窗口 = 创建 components.语音处理器测试
			分支 "相机"
				局_切换窗口 = 创建 components.相机测试
			分支 "电池监视器"
				局_切换窗口 = 创建 components.电池监视器测试
			分支 "电话"
				局_切换窗口 = 创建 components.电话测试
			分支 "通讯录"
				局_切换窗口 = 创建 components.通讯录测试
			分支 "指纹验证"
				局_切换窗口 = 创建 components.指纹验证测试
			分支 "红外发射器"
				局_切换窗口 = 创建 components.红外发射器测试

			' 传感器 - sensors
			分支 "加速度传感器"
				局_切换窗口 = 创建 sensors.加速度传感器测试
			分支 "方向传感器"
				局_切换窗口 = 创建 sensors.方向传感器测试
			分支 "位置传感器"
				局_切换窗口 = 创建 sensors.位置传感器测试
			分支 "光线传感器"
				局_切换窗口 = 创建 sensors.光线传感器测试
			分支 "距离传感器"
				局_切换窗口 = 创建 sensors.距离传感器测试

			' 布局 - layouts
			分支 "线性布局"
				局_切换窗口 = 创建 layouts.线性布局测试
			分支 "单帧布局"
				局_切换窗口 = 创建 layouts.单帧布局测试
			分支 "表格布局"
				局_切换窗口 = 创建 layouts.表格布局测试
			分支 "相对布局"
				局_切换窗口 = 创建 layouts.相对布局测试
			分支 "绝对布局"
				局_切换窗口 = 创建 layouts.绝对布局测试
			分支 "局部布局"
				局_切换窗口 = 创建 layouts.局部布局测试
			分支 "布局对照"
				局_切换窗口 = 创建 layouts.布局对照测试

			' 容器 - containers
			分支 "窗口"
				局_切换窗口 = 创建 containers.窗口测试
			分支 "面板"
				局_切换窗口 = 创建 containers.面板测试
			分支 "垂直滚动框"
				局_切换窗口 = 创建 containers.垂直滚动框测试
			分支 "水平滚动框"
				局_切换窗口 = 创建 containers.水平滚动框测试

			' 视图 - views
			' 文本组件
			分支 "标签"
				局_切换窗口 = 创建 views.标签测试
			分支 "按钮"
				局_切换窗口 = 创建 views.按钮测试
			分支 "编辑框"
				局_切换窗口 = 创建 views.编辑框测试
			分支 "密码编辑框"
				局_切换窗口 = 创建 views.密码编辑框测试
			分支 "邮箱选择器"
				局_切换窗口 = 创建 views.邮箱选择器测试
			分支 "富文本框"
				局_切换窗口 = 创建 views.富文本框测试
			分支 "单选框"
				局_切换窗口 = 创建 views.单选框测试
			分支 "复选框"
				局_切换窗口 = 创建 views.复选框测试
			' 图片组件
			分支 "图片框"
				局_切换窗口 = 创建 views.图片框测试
			分支 "图片按钮"
				局_切换窗口 = 创建 views.图片按钮测试
			' 进度组件
			分支 "水平进度条"
				局_切换窗口 = 创建 views.水平进度条测试
			分支 "进度圈"
				局_切换窗口 = 创建 views.进度圈测试
			分支 "水平滑块条"
				局_切换窗口 = 创建 views.水平滑块条测试
			分支 "垂直滑块条"
				局_切换窗口 = 创建 views.垂直滑块条测试
			' 列表组件
			分支 "列表框"
				局_切换窗口 = 创建 views.列表框测试
			分支 "下拉列表框"
				局_切换窗口 = 创建 views.下拉列表框测试
			分支 "单选列表框"
				局_切换窗口 = 创建 views.单选列表框测试
			分支 "多选列表框"
				局_切换窗口 = 创建 views.多选列表框测试
			分支 "数据表格"
				局_切换窗口 = 创建 views.数据表格测试
			' 其它组件
			分支 "网页浏览框"
				局_切换窗口 = 创建 views.网页浏览框测试
			分支 "画板"
				局_切换窗口 = 创建 views.画板测试
			分支 "摄像框"
				局_切换窗口 = 创建 views.摄像框测试
			分支 "视频播放器"
				局_切换窗口 = 创建 views.视频播放器测试
			分支 "自定义组件"

			' 对象 - objects
			分支 "意图"
				局_切换窗口 = 创建 objects.意图测试
			分支 "服务"
				局_切换窗口 = 创建 objects.服务测试
			分支 "SQLite数据库"
				局_切换窗口 = 创建 objects.SQLite数据库测试
			分支 "录音器"
				局_切换窗口 = 创建 objects.录音器测试

			' 辅助 - utils
			分支 "应用操作"
				局_切换窗口 = 创建 utils.应用操作测试
			分支 "日志输出"
				局_切换窗口 = 创建 utils.日志输出测试
			分支 "文件操作"
				局_切换窗口 = 创建 utils.文件操作测试
			分支 "资产操作"
				局_切换窗口 = 创建 utils.资产操作测试
			分支 "资源操作"
				局_切换窗口 = 创建 utils.资源操作测试
			分支 "编码转换"
				局_切换窗口 = 创建 utils.编码转换测试
			分支 "剪贴板操作"
				局_切换窗口 = 创建 utils.剪贴板操作测试
			分支 "对话框操作"
				局_切换窗口 = 创建 utils.对话框操作测试
			分支 "像素转换"
				局_切换窗口 = 创建 utils.像素转换测试
			分支 "颜色操作"
				局_切换窗口 = 创建 utils.颜色操作测试

			' 其它 - others
			分支 "重载"
			分支 "跨空间"
			分支 "其它"
		结束 判断

		如果 局_切换窗口 = 空 则
			显示提示框("“" & 局_子项文本 & "”该测试项尚未注册！")
			退出 事件
		结束 如果

		' 记录窗口
		成_窗口列表.加入(局_子项文本, 局_切换窗口)
	结束 如果

	' 切换到窗口
	切换窗口(局_切换窗口)
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "设备测试"
		$定义 列表框1 $为 列表框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
