''' 文件选择器测试。
''' 使用系统文档选择器，分别确认与取消文件、多个文件、创建和目录选择。
''' 后续读写只操作专用测试文件/目录；
''' 核对 URI、名称、大小、类型、字节及持久授权。
''' 不要选择个人文件执行写入。

变量 回调次数 为 整数型
变量 文件URI 为 文本型
变量 本页创建URI 为 文本型
变量 目录URI 为 文本型

事件 文件选择器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	文件选择器1.选择文件("text/plain")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：选择一个文件；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：选择一个文件失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	文件选择器1.选择文件("*/*", 真)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：选择多个文件；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：选择多个文件失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	文件选择器1.创建文件("device-tests-document.txt", "text/plain")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：创建测试文件；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：创建测试文件失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	文件选择器1.选择目录()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：选择测试目录；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：选择测试目录失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	如果 文件URI <> "" 则
		操作结果标签.文本 = "名称=" & 文件选择器1.取名称(文件URI) & "；大小=" & 文件选择器1.取文件大小(文件URI) _
			& "；类型=" & 文件选择器1.取文件类型(文件URI)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取文件信息；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：读取文件信息失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	如果 本页创建URI <> "" 则
		文件选择器1.写出字节集(本页创建URI, 文本到字节("document-中文42"))
		操作结果标签.文本 = "读回=" & 字节到文本(文件选择器1.读入字节集(本页创建URI))
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：写入本页文件；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：写入本页文件失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	如果 文件URI <> "" 则
		文件选择器1.复制到文件(文件URI, "/data/data/" & 取包名() _
			& "/files/device-document-copy.txt")
		操作结果标签.文本 = "副本读回=" & 读入文本文件("device-document-copy.txt")
		删除文件("device-document-copy.txt")
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：复制到私有目录；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：复制到私有目录失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	如果 文件URI <> "" 则
		操作结果标签.文本 = "保留授权=" & 文件选择器1.保留访问授权(文件URI)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：保留访问授权；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：保留访问授权失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	如果 文件URI <> "" 则
		操作结果标签.文本 = "释放授权=" & 文件选择器1.释放访问授权(文件URI)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：释放访问授权；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：释放访问授权失败")
	结束 错误
结束 事件

事件 操作按钮10.被单击()
	如果 目录URI <> "" 则
		操作结果标签.文本 = "子项数=" & 取数组成员数(文件选择器1.取子项(目录URI))
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：列出目录子项；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：列出目录子项失败")
	结束 错误
结束 事件

事件 操作按钮11.被单击()
	如果 目录URI <> "" 则
		本页创建URI = 文件选择器1.创建子文件(目录URI, "device-tests-child.txt", "text/plain")
		操作结果标签.文本 = 本页创建URI
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：在目录创建文件；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：在目录创建文件失败")
	结束 错误
结束 事件

事件 操作按钮12.被单击()
	操作结果标签.文本 = "选择中=" & 文件选择器1.正在选择 & 字符(10) & "错误=" & 文件选择器1.错误信息

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：查询选择状态；请检查权限、状态和运行日志"
			输出错误("设备测试/文件选择器：查询选择状态失败")
	结束 错误
结束 事件

事件 文件选择器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 文件选择器1.文件选择完毕(参数1 为 文本型())
	如果 取数组成员数(参数1) > 0 则
		文件URI = 参数1(0)
	结束 如果
	记录事件("选择数量=" & 取数组成员数(参数1) & "；首项=" & 文件URI)
结束 事件

事件 文件选择器1.文件创建完毕(参数1 为 文本型)
	本页创建URI = 参数1
	文件URI = 参数1
	记录事件("创建URI=" & 文件URI)
结束 事件

事件 文件选择器1.目录选择完毕(参数1 为 文本型)
	目录URI = 参数1
	记录事件("目录URI=" & 目录URI)
结束 事件

事件 文件选择器1.取消选择()
	回调次数 = 回调次数 + 1
	记录事件("取消选择：回调=" & 回调次数)
结束 事件

事件 文件选择器1.选择失败(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("选择失败：回调=" & 回调次数 & 字符(10) & "信息=" & 参数1)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("文件选择器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 文件选择器测试 $为 窗口
		标题 = "文件选择器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "通过系统界面选择、创建文件或目录，并核对取消操作。写入只用本页创建的测试文件；可检查内容 URI、文件信息和访问授权。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "选择一个文件"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "选择多个文件"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "创建测试文件"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "选择测试目录"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "读取文件信息"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "写入本页文件"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "复制到私有目录"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "保留访问授权"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "释放访问授权"
			$结束 $定义
			$定义 操作按钮10 $为 按钮
				文本 = "列出目录子项"
			$结束 $定义
		$结束 $定义
		$定义 操作面板6 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮11 $为 按钮
				文本 = "在目录创建文件"
			$结束 $定义
			$定义 操作按钮12 $为 按钮
				文本 = "查询选择状态"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 文件选择器1 $为 文件选择器
		$结束 $定义
	$结束 $定义
$结束 $属性
