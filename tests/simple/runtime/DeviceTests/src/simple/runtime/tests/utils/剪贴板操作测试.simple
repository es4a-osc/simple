''' 剪贴板操作测试。
''' 只测试剪贴板文本。
''' 首次写入前保存原文本，测试中文、空文本、读取和有文本判断，最后恢复；
''' 离开本页也恢复。
''' 此接口不能无损备份原有非文本剪贴项。

变量 原文本 为 文本型
变量 已保存 为 逻辑型

事件 剪贴板操作测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 剪贴板操作测试.即将切换()
	如果 已保存 则
		置剪贴板文本(原文本)
	结束 如果
结束 事件

事件 剪贴板操作测试.程序被停止()
	如果 已保存 则
		置剪贴板文本(原文本)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	如果 取反 已保存 则
		原文本 = 取剪贴板文本()
		已保存 = 真
	结束 如果
	置剪贴板文本(剪贴文本框.文本)
	操作结果标签.文本 = "读回=" & 取剪贴板文本() & "；有文本=" & 剪贴板是否有文本()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：写入测试文本；请检查权限、状态和运行日志"
			输出错误("设备测试/剪贴板操作：写入测试文本失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	如果 取反 已保存 则
		原文本 = 取剪贴板文本()
		已保存 = 真
	结束 如果
	置剪贴板文本("")
	操作结果标签.文本 = "空文本长度=" & 取字符数(取剪贴板文本()) & "；有文本=" & 剪贴板是否有文本()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：写入空文本；请检查权限、状态和运行日志"
			输出错误("设备测试/剪贴板操作：写入空文本失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	如果 已保存 则
		置剪贴板文本(原文本)
	结束 如果
	操作结果标签.文本 = "恢复后=" & 取剪贴板文本()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：恢复原文本；请检查权限、状态和运行日志"
			输出错误("设备测试/剪贴板操作：恢复原文本失败")
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 剪贴板操作测试 $为 窗口
		标题 = "剪贴板操作测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "写入测试文本或空文本，再读取核对。测试前保存原文本，恢复或离页时还原。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 剪贴文本框 $为 编辑框
			文本 = "clipboard-中文42"
			宽度 = 长度_匹配父级
			提示文本 = "要写入剪贴板的测试文本"
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "写入测试文本"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "写入空文本"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "恢复原文本"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
