''' 布局对照测试。
''' 同样的两个标签分别放在线性、表格、单帧、相对、绝对布局中，按各布局规则排列。
''' 每块有明确的边界和标题；
''' 隐藏/恢复第二个子项后核对其它子项排布，避免只验证某一种布局。

事件 布局对照测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	对照子项12.可视 = 取反 对照子项12.可视
	对照子项22.可视 = 取反 对照子项22.可视
	对照子项32.可视 = 取反 对照子项32.可视
	对照子项42.可视 = 取反 对照子项42.可视
	对照子项52.可视 = 取反 对照子项52.可视

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换第二子项可见性；请检查权限、状态和运行日志"
			输出错误("设备测试/布局对照：切换第二子项可见性失败")
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 布局对照测试 $为 窗口
		标题 = "布局对照测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "对照各布局中相同尺寸的子项。切换第二个子项可见性，观察排列、占位和相邻控件的位置变化。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "切换第二子项可见性"
			$结束 $定义
		$结束 $定义
		$定义 对照标题1 $为 标签
			文本 = "线性"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 对照面板1 $为 面板
			宽度 = 长度_匹配父级
			高度 = "130px"
			背景颜色 = &HFFE0F0FF
			布局.方向 = 布局_方向_水平
			$定义 对照子项11 $为 标签
				文本 = "甲"
				宽度 = "100px"
				高度 = "60px"
			$结束 $定义
			$定义 对照子项12 $为 标签
				文本 = "乙"
				宽度 = "100px"
				高度 = "60px"
				背景颜色 = 颜色_黄
			$结束 $定义
		$结束 $定义
		$定义 对照标题2 $为 标签
			文本 = "表格"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 对照面板2 $为 面板
			布局 = 布局_表格
			宽度 = 长度_匹配父级
			高度 = "130px"
			背景颜色 = &HFFE0F0FF
			布局.行数 = 1
			布局.列数 = 2
			$定义 对照子项21 $为 标签
				行 = 0
				列 = 0
				文本 = "甲"
				宽度 = "100px"
				高度 = "60px"
			$结束 $定义
			$定义 对照子项22 $为 标签
				行 = 0
				列 = 1
				文本 = "乙"
				宽度 = "100px"
				高度 = "60px"
				背景颜色 = 颜色_黄
			$结束 $定义
		$结束 $定义
		$定义 对照标题3 $为 标签
			文本 = "单帧"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 对照面板3 $为 面板
			布局 = 布局_单帧
			宽度 = 长度_匹配父级
			高度 = "130px"
			背景颜色 = &HFFE0F0FF
			$定义 对照子项31 $为 标签
				文本 = "甲"
				宽度 = "100px"
				高度 = "60px"
			$结束 $定义
			$定义 对照子项32 $为 标签
				文本 = "乙"
				宽度 = "100px"
				高度 = "60px"
				背景颜色 = 颜色_黄
			$结束 $定义
		$结束 $定义
		$定义 对照标题4 $为 标签
			文本 = "相对"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 对照面板4 $为 面板
			布局 = 布局_相对
			宽度 = 长度_匹配父级
			高度 = "130px"
			背景颜色 = &HFFE0F0FF
			$定义 对照子项41 $为 标签
				文本 = "甲"
				宽度 = "100px"
				高度 = "60px"
				标识 = 201
			$结束 $定义
			$定义 对照子项42 $为 标签
				文本 = "乙"
				宽度 = "100px"
				高度 = "60px"
				背景颜色 = 颜色_黄
				位于右边 = 201
			$结束 $定义
		$结束 $定义
		$定义 对照标题5 $为 标签
			文本 = "绝对"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 对照面板5 $为 面板
			布局 = 布局_绝对
			宽度 = 长度_匹配父级
			高度 = "130px"
			背景颜色 = &HFFE0F0FF
			$定义 对照子项51 $为 标签
				文本 = "甲"
				宽度 = "100px"
				高度 = "60px"
				左边 = 0
				顶边 = 0
			$结束 $定义
			$定义 对照子项52 $为 标签
				文本 = "乙"
				宽度 = "100px"
				高度 = "60px"
				背景颜色 = 颜色_黄
				左边 = 120
				顶边 = 40
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
