''' 垂直滑块条测试。
''' 分别设置 0、50、最大值以及超界位置，检查实际读回和视觉位置。
''' 改变最大值后再次设置，滑块还需手动拖动，检查开始/改变/停止事件及回调位置。

变量 回调次数 为 整数型

事件 垂直滑块条测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	垂直滑块条1.可视 = 取反 垂直滑块条1.可视
	操作结果标签.文本 = "可视=" & 垂直滑块条1.可视

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：隐藏/显示；请检查权限、状态和运行日志"
			输出错误("设备测试/垂直滑块条：隐藏/显示失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	垂直滑块条1.位置 = 0
	操作结果标签.文本 = "设定=0；读回=" & 垂直滑块条1.位置 & "；最大=" & 垂直滑块条1.最大位置

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：设置位置 0；请检查权限、状态和运行日志"
			输出错误("设备测试/垂直滑块条：设置位置 0失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	垂直滑块条1.位置 = 50
	操作结果标签.文本 = "设定=50；读回=" & 垂直滑块条1.位置 & "；最大=" & 垂直滑块条1.最大位置

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：设置位置 50；请检查权限、状态和运行日志"
			输出错误("设备测试/垂直滑块条：设置位置 50失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	垂直滑块条1.位置 = 100
	操作结果标签.文本 = "设定=100；读回=" & 垂直滑块条1.位置 & "；最大=" & 垂直滑块条1.最大位置

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：设置位置 100；请检查权限、状态和运行日志"
			输出错误("设备测试/垂直滑块条：设置位置 100失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	垂直滑块条1.位置 = -1
	操作结果标签.文本 = "设定=-1；读回=" & 垂直滑块条1.位置 & "；最大=" & 垂直滑块条1.最大位置

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：设置位置 -1；请检查权限、状态和运行日志"
			输出错误("设备测试/垂直滑块条：设置位置 -1失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	垂直滑块条1.位置 = 999
	操作结果标签.文本 = "设定=999；读回=" & 垂直滑块条1.位置 & "；最大=" & 垂直滑块条1.最大位置

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：设置位置 999；请检查权限、状态和运行日志"
			输出错误("设备测试/垂直滑块条：设置位置 999失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	如果 垂直滑块条1.最大位置 = 100 则
		垂直滑块条1.最大位置 = 80
	否则
		垂直滑块条1.最大位置 = 100
	结束 如果
	操作结果标签.文本 = "最大=" & 垂直滑块条1.最大位置 & "；位置=" & 垂直滑块条1.位置

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换最大值；请检查权限、状态和运行日志"
			输出错误("设备测试/垂直滑块条：切换最大值失败")
	结束 错误
结束 事件

事件 垂直滑块条1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 垂直滑块条1.开始拖动()
	回调次数 = 回调次数 + 1
	记录事件("开始拖动：回调=" & 回调次数)
结束 事件

事件 垂直滑块条1.停止拖动()
	回调次数 = 回调次数 + 1
	记录事件("停止拖动：回调=" & 回调次数 & "；位置=" & 垂直滑块条1.位置)
结束 事件

事件 垂直滑块条1.位置被改变(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("位置被改变：回调=" & 回调次数 & "；位置=" & 参数1)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("垂直滑块条测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 垂直滑块条测试 $为 窗口
		标题 = "垂直滑块条测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "拖动滑块，核对开始、位置改变和停止事件。可设置边界及越界位置，再改变最大值核对读回和显示。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "隐藏/显示"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "设置位置 0"
			$结束 $定义
		$结束 $定义
		$定义 垂直滑块条1 $为 垂直滑块条
			宽度 = "100px"
			高度 = "400px"
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "设置位置 50"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "设置位置 100"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "设置位置 -1"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "设置位置 999"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "切换最大值"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
