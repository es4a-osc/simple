''' HTTP客户端测试。
''' 需要独立本机测试服务，并将设备 18763 端口映射到服务。
''' 覆盖 GET、POST、表单、文件、响应头/数据、大小上限、取消与超时；
''' 只按完成/失败/取消事件判断结果，提交返回值不是网络成功。

常量 慢请求地址 为 文本型 = "http://127.0.0.1:18763/slow"
常量 上传文件名 为 文本型 = "device-http-upload.txt"

变量 回调次数 为 整数型
变量 表单 为 哈希表

事件 HTTP客户端测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 HTTP客户端测试.即将切换()
	释放测试资源()
结束 事件

事件 HTTP客户端测试.程序被停止()
	释放测试资源()
结束 事件

事件 操作按钮1.被单击()
	HTTP客户端1.清空提交内容()
	HTTP客户端1.置请求头("X-Device-Test", "header-ok")
	操作结果标签.文本 = "GET受理=" & HTTP客户端1.发送请求(地址输入框.文本)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：发送 GET 请求；请检查权限、状态和运行日志"
			输出错误("设备测试/HTTP客户端：发送 GET 请求失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	HTTP客户端1.置提交文本("HTTP中文42")
	操作结果标签.文本 = "POST受理=" & HTTP客户端1.发送请求("POST", 地址输入框.文本)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：发送 POST 文本；请检查权限、状态和运行日志"
			输出错误("设备测试/HTTP客户端：发送 POST 文本失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	表单 = 创建 哈希表
	表单.加入("name", "设备测试")
	表单.加入("value", "42")
	HTTP客户端1.置提交表单(表单)
	操作结果标签.文本 = "表单受理=" & HTTP客户端1.发送请求("POST", 地址输入框.文本)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：发送 POST 表单；请检查权限、状态和运行日志"
			输出错误("设备测试/HTTP客户端：发送 POST 表单失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	HTTP客户端1.清空提交内容()
	HTTP客户端1.发送请求(慢请求地址)
	操作结果标签.文本 = "取消返回=" & HTTP客户端1.取消请求()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：取消请求；请检查权限、状态和运行日志"
			输出错误("设备测试/HTTP客户端：取消请求失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	HTTP客户端1.清空提交内容()
	HTTP客户端1.读入超时 = 200
	操作结果标签.文本 = "请求受理=" & HTTP客户端1.发送请求(慢请求地址)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：测试请求超时；请检查权限、状态和运行日志"
			输出错误("设备测试/HTTP客户端：测试请求超时失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	HTTP客户端1.连接超时 = 3000
	HTTP客户端1.读入超时 = 3000
	HTTP客户端1.响应大小上限 = 1048576

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：恢复请求限制；请检查权限、状态和运行日志"
			输出错误("设备测试/HTTP客户端：恢复请求限制失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	HTTP客户端1.清空提交内容()
	HTTP客户端1.响应大小上限 = 8
	操作结果标签.文本 = "请求受理=" & HTTP客户端1.发送请求(地址输入框.文本)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：测试响应上限；请检查权限、状态和运行日志"
			输出错误("设备测试/HTTP客户端：测试响应上限失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	操作结果标签.文本 = "状态=" & HTTP客户端1.响应代码 & "；字节=" & 取数组成员数(HTTP客户端1.响应数据) _
		& 字符(10) & "响应头=" & HTTP客户端1.取响应头("Content-Type") & 字符(10) & "内容=" & HTTP客户端1.响应文本 _
		& 字符(10) & "错误=" & HTTP客户端1.错误信息

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取响应；请检查权限、状态和运行日志"
			输出错误("设备测试/HTTP客户端：读取响应失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	HTTP客户端1.清空请求头()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：清空请求头；请检查权限、状态和运行日志"
			输出错误("设备测试/HTTP客户端：清空请求头失败")
	结束 错误
结束 事件

事件 提交字节按钮.被单击()
	HTTP客户端1.置提交数据(文本到字节("HTTP字节42"))
	操作结果标签.文本 = "字节受理=" & HTTP客户端1.发送请求("POST", 地址输入框.文本)
结束 事件

事件 提交文件按钮.被单击()
	写出文本文件(上传文件名, "upload-中文42")
	HTTP客户端1.置提交文件(上传文件名)
	操作结果标签.文本 = "文件受理=" & HTTP客户端1.发送请求("POST", 地址输入框.文本)
结束 事件

事件 提交文件表单按钮.被单击()
	写出文本文件(上传文件名, "upload-中文42")
	表单 = 创建 哈希表
	表单.加入("name", "设备测试")
	HTTP客户端1.置提交文件表单("file", 上传文件名, 表单)
	操作结果标签.文本 = "文件表单受理=" & HTTP客户端1.发送请求("POST", 地址输入框.文本)
结束 事件

事件 HTTP客户端1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 HTTP客户端1.发送进度(参数1 为 长整数型, 参数2 为 长整数型)
	回调次数 = 回调次数 + 1
	记录事件("发送进度：回调=" & 回调次数 & "；已发送字节数=" & 参数1 & "；总字节数=" & 参数2)
结束 事件

事件 HTTP客户端1.接收进度(参数1 为 长整数型, 参数2 为 长整数型)
	回调次数 = 回调次数 + 1
	记录事件("接收进度：回调=" & 回调次数 & "；已接收字节数=" & 参数1 & "；总字节数=" & 参数2)
结束 事件

事件 HTTP客户端1.请求完成(参数1 为 整数型)
	记录事件("HTTP完成=" & 参数1 & 字符(10) & "内容=" & HTTP客户端1.响应文本)
结束 事件

事件 HTTP客户端1.请求失败(参数1 为 文本型)
	记录事件("HTTP失败=" & 参数1 & 字符(10) & "错误=" & HTTP客户端1.错误信息)
结束 事件

事件 HTTP客户端1.请求取消()
	回调次数 = 回调次数 + 1
	记录事件("请求取消：回调=" & 回调次数)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("HTTP客户端测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

''' 离页或进入后台时取消请求，只清理本单元创建的上传文件。
过程 释放测试资源()
	HTTP客户端1.取消请求()
	如果 文件是否存在(上传文件名) 则
		删除文件(上传文件名)
	结束 如果
结束 过程

$属性
	$资源 $窗口
	$定义 HTTP客户端测试 $为 窗口
		标题 = "HTTP客户端测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "先启动电脑端测试服务，并映射设备的 18763 端口。测试请求、上传、取消、超时及响应上限；以完成或失败事件核对结果。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 地址输入框 $为 编辑框
			文本 = "http://127.0.0.1:18763/echo"
			宽度 = 长度_匹配父级
			提示文本 = "测试服务地址（需先启动电脑端服务）"
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "发送 GET 请求"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "发送 POST 文本"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "发送 POST 表单"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "取消请求"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "测试请求超时"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "恢复请求限制"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "测试响应上限"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "读取响应"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "清空请求头"
			$结束 $定义
		$结束 $定义
		$定义 提交操作面板 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 提交字节按钮 $为 按钮
				文本 = "提交字节"
			$结束 $定义
			$定义 提交文件按钮 $为 按钮
				文本 = "提交文件"
			$结束 $定义
			$定义 提交文件表单按钮 $为 按钮
				文本 = "提交文件表单"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 HTTP客户端1 $为 HTTP客户端
			连接超时 = 3000
			读入超时 = 3000
		$结束 $定义
	$结束 $定义
$结束 $属性
