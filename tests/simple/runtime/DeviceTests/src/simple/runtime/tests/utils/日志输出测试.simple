''' 日志输出测试。
''' 向 Android 日志写入唯一设备测试标记。
''' 界面显示调用内容，实际落入 logcat 必须由设备日志核对；
''' 不能只凭按钮已执行认定日志通过。

事件 日志输出测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	输出错误("DEVICE_TEST_LOG_ERROR")
	输出警告("DEVICE_TEST_LOG_WARNING")
	输出信息("DEVICE_TEST_LOG_INFO")
	输出调试("DEVICE_TEST_LOG_DEBUG")
	操作结果标签.文本 = "已调用四级日志，请核对 logcat 中 DEVICE_TEST_LOG 标记"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：写入四级日志；请检查权限、状态和运行日志"
			输出错误("设备测试/日志输出：写入四级日志失败")
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 日志输出测试 $为 窗口
		标题 = "日志输出测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "分别写入四级测试日志，并通过 logcat 核对级别、模块和内容；页面只显示提交结果。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "写入四级日志"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
