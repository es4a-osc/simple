''' 蓝牙通信器测试。
''' 需要真实蓝牙及另一个专用测试设备。
''' 查询、申请开启、发现和停止搜索；
''' 填写对端地址后连接，核对名称/地址、收发字节和断开。
''' 无硬件时不能算连接通过；
''' 不自动改设备名称或关闭原有蓝牙。

变量 回调次数 为 整数型

事件 蓝牙通信器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 蓝牙通信器测试.即将切换()
	蓝牙通信器1.停止搜索()
	蓝牙通信器1.断开连接()
结束 事件

事件 蓝牙通信器测试.程序被停止()
	蓝牙通信器1.停止搜索()
	蓝牙通信器1.断开连接()
结束 事件

事件 操作按钮1.被单击()
	变量 权限 为 文本型(1)
	权限(0) = "android.permission.ACCESS_FINE_LOCATION"
	操作结果标签.文本 = "权限请求已提交=" & 权限请求1.请求权限(权限, "蓝牙通信器")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求所需权限；请检查权限、状态和运行日志"
			输出错误("设备测试/蓝牙通信器：请求所需权限失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "硬件=" & 蓝牙通信器1.是否存在() & "；开启=" & 蓝牙通信器1.是否已开启() _
		& 字符(10) & "本机=" & 蓝牙通信器1.取本机名称() & "；地址=" & 蓝牙通信器1.取本机地址()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取蓝牙状态；请检查权限、状态和运行日志"
			输出错误("设备测试/蓝牙通信器：读取蓝牙状态失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	蓝牙通信器1.开启蓝牙()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求开启蓝牙；请检查权限、状态和运行日志"
			输出错误("设备测试/蓝牙通信器：请求开启蓝牙失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	蓝牙通信器1.打开蓝牙设置()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：打开蓝牙设置；请检查权限、状态和运行日志"
			输出错误("设备测试/蓝牙通信器：打开蓝牙设置失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	蓝牙通信器1.搜索设备()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：搜索设备；请检查权限、状态和运行日志"
			输出错误("设备测试/蓝牙通信器：搜索设备失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	蓝牙通信器1.停止搜索()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：停止搜索；请检查权限、状态和运行日志"
			输出错误("设备测试/蓝牙通信器：停止搜索失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	如果 设备地址框.文本 = "" 则
		操作结果标签.文本 = "先填专用测试设备地址"
		退出 事件
	结束 如果
	蓝牙通信器1.置工作模式(0)
	蓝牙通信器1.置UUID("00001101-0000-1000-8000-00805F9B34FB")
	蓝牙通信器1.连接设备(设备地址框.文本)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：连接测试对端；请检查权限、状态和运行日志"
			输出错误("设备测试/蓝牙通信器：连接测试对端失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	蓝牙通信器1.发送数据(文本到字节(蓝牙文本框.文本))

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：发送数据；请检查权限、状态和运行日志"
			输出错误("设备测试/蓝牙通信器：发送数据失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	蓝牙通信器1.断开连接()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：断开连接；请检查权限、状态和运行日志"
			输出错误("设备测试/蓝牙通信器：断开连接失败")
	结束 错误
结束 事件

事件 操作按钮10.被单击()
	操作结果标签.文本 = "名称=" & 蓝牙通信器1.取已连接设备名称() & "；地址=" & 蓝牙通信器1.取已连接设备地址()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取对端信息；请检查权限、状态和运行日志"
			输出错误("设备测试/蓝牙通信器：读取对端信息失败")
	结束 错误
结束 事件

事件 蓝牙通信器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 蓝牙通信器1.蓝牙设置完毕(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("蓝牙设置完毕：回调=" & 回调次数 & "；系统结果码=" & 参数1)
结束 事件

事件 蓝牙通信器1.发现设备(参数1 为 文本型, 参数2 为 文本型, 参数3 为 逻辑型)
	回调次数 = 回调次数 + 1
	记录事件("发现设备：回调=" & 回调次数 & "；名称=" & 参数1 & 字符(10) & "地址=" & 参数2 & "；已配对=" & 参数3)
结束 事件

事件 蓝牙通信器1.连接完毕(参数1 为 逻辑型, 参数2 为 文本型, 参数3 为 文本型, 参数4 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("连接完毕：回调=" & 回调次数 & "；成功=" & 参数1 & 字符(10) & "名称=" & 参数2 & "；地址=" & 参数3 _
		& 字符(10) & "模式=" & 参数4)
结束 事件

事件 蓝牙通信器1.收到数据(参数1 为 字节型(), 参数2 为 文本型, 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("收到数据：回调=" & 回调次数 & "；数据字节数=" & 取数组成员数(参数1) & 字符(10) & "名称=" & 参数2 _
		& "；地址=" & 参数3)
结束 事件

事件 蓝牙通信器1.发送完毕(参数1 为 字节型(), 参数2 为 文本型, 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("发送完毕：回调=" & 回调次数 & "；数据字节数=" & 取数组成员数(参数1) & 字符(10) & "名称=" & 参数2 _
		& "；地址=" & 参数3)
结束 事件

事件 蓝牙通信器1.连接断开()
	回调次数 = 回调次数 + 1
	记录事件("连接断开：回调=" & 回调次数)
结束 事件

事件 权限请求1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 权限请求1.请求结果(参数1 为 文本型(), 参数2 为 整数型(), 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("请求结果：回调=" & 回调次数 & "；权限项数=" & 取数组成员数(参数1) _
		& 字符(10) & "授权结果项数=" & 取数组成员数(参数2) & "；请求标记=" & 参数3)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("蓝牙通信器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 蓝牙通信器测试 $为 窗口
		标题 = "蓝牙通信器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "需要蓝牙硬件和另一台测试设备。授权后搜索、连接对端，核对名称、地址、收发内容及断开事件。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 设备地址框 $为 编辑框
			提示文本 = "专用蓝牙对端地址"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 蓝牙文本框 $为 编辑框
			文本 = "bluetooth-test"
			宽度 = 长度_匹配父级
			提示文本 = "发送给测试设备的文本"
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "请求所需权限"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "读取蓝牙状态"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "请求开启蓝牙"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "打开蓝牙设置"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "搜索设备"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "停止搜索"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "连接测试对端"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "发送数据"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "断开连接"
			$结束 $定义
			$定义 操作按钮10 $为 按钮
				文本 = "读取对端信息"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 蓝牙通信器1 $为 蓝牙通信器
		$结束 $定义
	$结束 $定义
$结束 $属性
