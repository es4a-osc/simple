''' WIFI管理器测试。
''' 扫描需要位置权限及系统定位，操作受当前系统限制。
''' 查询状态、扫描和系统设置；
''' 新增/连接/删除网络只使用输入的专用测试网络与本次返回的标识。
''' 热点需等待名称/密码或失败事件，离页关闭本页热点并释放锁。

变量 回调次数 为 整数型
变量 需要关闭热点 为 逻辑型

事件 WIFI管理器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 WIFI管理器测试.即将切换()
	释放资源()
结束 事件

事件 WIFI管理器测试.程序被停止()
	释放资源()
结束 事件

事件 操作按钮1.被单击()
	变量 权限 为 文本型(1)
	权限(0) = "android.permission.ACCESS_FINE_LOCATION"
	操作结果标签.文本 = "权限请求已提交=" & 权限请求1.请求权限(权限, "WIFI管理器")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求定位权限；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：请求定位权限失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "WIFI=" & WIFI管理器1.是否已开启() & "；SSID=" & WIFI管理器1.取当前SSID() _
		& 字符(10) & "网络标识=" & WIFI管理器1.取当前网络标识() & "；IP=" & WIFI管理器1.取内网IP() _
		& 字符(10) & "网关=" & WIFI管理器1.取网关() & "；DNS=" & WIFI管理器1.取DNS1() & "/" & WIFI管理器1.取DNS2() _
		& 字符(10) & "信号=" & WIFI管理器1.取当前信号强度() & "；速度=" & WIFI管理器1.取当前连接速度()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：查询连接信息；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：查询连接信息失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	操作结果标签.文本 = "扫描受理=" & WIFI管理器1.开始扫描()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：扫描网络；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：扫描网络失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	操作结果标签.文本 = WIFI管理器1.获取扫描结果()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取扫描结果；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：读取扫描结果失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	WIFI管理器1.打开WIFI设置()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：打开WIFI设置；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：打开WIFI设置失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	操作结果标签.文本 = "开启返回=" & WIFI管理器1.置WIFI状态(真)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求开启WIFI；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：请求开启WIFI失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	如果 网络名称框.文本 = "" 则
		操作结果标签.文本 = "先填写专用测试SSID"
		退出 事件
	结束 如果
	操作结果标签.文本 = "添加受理=" & WIFI管理器1.添加网络(网络名称框.文本, 网络密码框.文本, 3)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：添加测试网络；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：添加测试网络失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	操作结果标签.文本 = "保存网络数=" & 取数组成员数(WIFI管理器1.取已保存网络列表()) _
		& "；指定标识=" & WIFI管理器1.取已保存网络标识(网络名称框.文本)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：查询保存网络；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：查询保存网络失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	变量 标识 为 整数型
	标识 = 网络标识框.文本
	如果 标识 >= 0 则
		操作结果标签.文本 = "连接返回=" & WIFI管理器1.置指定WIFI状态(标识, 真) _
			& "；状态=" & WIFI管理器1.取连接状态(标识)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：连接测试网络；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：连接测试网络失败")
	结束 错误
结束 事件

事件 操作按钮10.被单击()
	变量 标识 为 整数型
	标识 = 网络标识框.文本
	如果 标识 >= 0 则
		操作结果标签.文本 = "删除返回=" & WIFI管理器1.删除网络(标识)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：删除本次网络；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：删除本次网络失败")
	结束 错误
结束 事件

事件 操作按钮11.被单击()
	' 请求可能尚未回调，离页时也需要取消。
	需要关闭热点 = 真
	WIFI管理器1.创建本地热点()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：创建本地热点；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：创建本地热点失败")
	结束 错误
结束 事件

事件 操作按钮12.被单击()
	变量 已受理 为 逻辑型
	如果 网络名称框.文本 <> "" 则
		已受理 = WIFI管理器1.创建热点(网络名称框.文本, 网络密码框.文本)
		如果 已受理 则
			需要关闭热点 = 真
		结束 如果
		操作结果标签.文本 = "热点返回=" & 已受理
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：创建指定热点；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：创建指定热点失败")
	结束 错误
结束 事件

事件 操作按钮13.被单击()
	变量 已关闭 为 逻辑型
	已关闭 = WIFI管理器1.关闭热点()
	如果 已关闭 则
		需要关闭热点 = 假
	结束 如果
	操作结果标签.文本 = "关闭返回=" & 已关闭

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：关闭热点；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：关闭热点失败")
	结束 错误
结束 事件

事件 操作按钮14.被单击()
	WIFI管理器1.锁定WIFI()
	WIFI管理器1.解锁WIFI()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：加锁后解锁；请检查权限、状态和运行日志"
			输出错误("设备测试/WIFI管理器：加锁后解锁失败")
	结束 错误
结束 事件

事件 WIFI管理器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 WIFI管理器1.扫描完毕(参数1 为 逻辑型)
	回调次数 = 回调次数 + 1
	记录事件("扫描完毕：回调=" & 回调次数 & "；结果已更新=" & 参数1)
结束 事件

事件 WIFI管理器1.开启状态改变(参数1 为 逻辑型)
	回调次数 = 回调次数 + 1
	记录事件("开启状态改变：回调=" & 回调次数 & "；已开启=" & 参数1)
结束 事件

事件 WIFI管理器1.网络状态改变(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("网络状态改变：回调=" & 回调次数 & "；状态=" & 参数1)
结束 事件

事件 WIFI管理器1.密码错误()
	回调次数 = 回调次数 + 1
	记录事件("密码错误：回调=" & 回调次数)
结束 事件

事件 WIFI管理器1.网络添加结果(参数1 为 文本型, 参数2 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("网络添加结果：回调=" & 回调次数 & "；网络名称=" & 参数1 & "；结果码=" & 参数2)
结束 事件

事件 WIFI管理器1.本地热点创建成功(参数1 为 文本型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("本地热点创建成功：回调=" & 回调次数 & "；网络名称=" & 参数1 & "；密码=" & 参数2)
结束 事件

事件 WIFI管理器1.本地热点创建失败(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("本地热点创建失败：回调=" & 回调次数 & "；错误码=" & 参数1)
结束 事件

事件 权限请求1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 权限请求1.请求结果(参数1 为 文本型(), 参数2 为 整数型(), 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("请求结果：回调=" & 回调次数 & "；权限项数=" & 取数组成员数(参数1) _
		& 字符(10) & "授权结果项数=" & 取数组成员数(参数2) & "；请求标记=" & 参数3)
结束 事件

过程 释放资源()
	' 仅清理本页请求的热点，不因查询或扫描而关闭系统热点。
	如果 需要关闭热点 则
		需要关闭热点 = 取反 WIFI管理器1.关闭热点()
	结束 如果
	WIFI管理器1.解锁WIFI()
结束 过程

过程 记录事件(内容 为 文本型)
	输出信息("WIFI管理器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 WIFI管理器测试 $为 窗口
		标题 = "WIFI管理器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "扫描前授权并开启系统定位。网络操作只用专用测试网络；本地热点通过事件返回名称和密码，指定热点受系统权限限制。离页清理本页热点和锁。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 网络名称框 $为 编辑框
			提示文本 = "专用测试SSID"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 网络密码框 $为 编辑框
			提示文本 = "测试密码"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 网络标识框 $为 编辑框
			文本 = "-1"
			提示文本 = "只填写本次测试网络ID"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "请求定位权限"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "查询连接信息"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "扫描网络"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "读取扫描结果"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "打开WIFI设置"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "请求开启WIFI"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "添加测试网络"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "查询保存网络"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "连接测试网络"
			$结束 $定义
			$定义 操作按钮10 $为 按钮
				文本 = "删除本次网络"
			$结束 $定义
		$结束 $定义
		$定义 操作面板6 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮11 $为 按钮
				文本 = "创建本地热点"
			$结束 $定义
			$定义 操作按钮12 $为 按钮
				文本 = "创建指定热点"
			$结束 $定义
		$结束 $定义
		$定义 操作面板7 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮13 $为 按钮
				文本 = "关闭热点"
			$结束 $定义
			$定义 操作按钮14 $为 按钮
				文本 = "加锁后解锁"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 WIFI管理器1 $为 WIFI管理器
		$结束 $定义
	$结束 $定义
$结束 $属性
