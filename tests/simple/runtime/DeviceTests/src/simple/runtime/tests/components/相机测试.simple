''' 相机测试。
''' 先请求相机权限及旧系统拍摄所需的存储权限。
''' 拍照、录像和系统选择器是异步操作，需分别确认完成及取消事件；
''' 只写本应用私有测试文件。
''' 相册与闪光灯依赖设备能力，缺失时检查失败原因；
''' 不把打开界面当作完成。

变量 回调次数 为 整数型

事件 相机测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	变量 权限 为 文本型(2)
	权限(0) = "android.permission.CAMERA"
	权限(1) = "android.permission.WRITE_EXTERNAL_STORAGE"
	操作结果标签.文本 = "权限请求已提交=" & 权限请求1.请求权限(权限, "相机")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求所需权限；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：请求所需权限失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "拍照受理=" & 相机1.开始拍照("/data/data/" & 取包名() & "/files/device-photo.jpg")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：拍照；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：拍照失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	操作结果标签.文本 = "录像受理=" & 相机1.开始录像("/data/data/" & 取包名() & "/files/device-camera.mp4", 1)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：录像；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：录像失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	操作结果标签.文本 = "选择受理=" & 相机1.浏览相册()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：选择图片；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：选择图片失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	操作结果标签.文本 = "选择受理=" & 相机1.浏览相册视频()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：选择视频；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：选择视频失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	操作结果标签.文本 = "剪裁受理=" & 相机1.浏览相册并剪裁()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：选择并剪裁；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：选择并剪裁失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	操作结果标签.文本 = "存在闪光灯=" & 相机1.是否存在闪光灯()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：检查闪光灯；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：检查闪光灯失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	操作结果标签.文本 = "开启返回=" & 相机1.开启闪光灯()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开启闪光灯；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：开启闪光灯失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	操作结果标签.文本 = "关闭返回=" & 相机1.关闭闪光灯()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：关闭闪光灯；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：关闭闪光灯失败")
	结束 错误
结束 事件

事件 操作按钮10.被单击()
	操作结果标签.文本 = "处理中=" & 相机1.正在处理 & 字符(10) & "错误=" & 相机1.错误信息

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取处理状态；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：读取处理状态失败")
	结束 错误
结束 事件

事件 操作按钮11.被单击()
	操作结果标签.文本 = "旋转=" & 相机1.取照片旋转角度("/data/data/" & 取包名() & "/files/device-photo.jpg")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取照片旋转角度；请检查权限、状态和运行日志"
			输出错误("设备测试/相机：读取照片旋转角度失败")
	结束 错误
结束 事件

事件 相机1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 相机1.拍摄完毕(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("拍摄完毕：回调=" & 回调次数 & 字符(10) & "文件路径=" & 参数1)
结束 事件

事件 相机1.录像完毕(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("录像完毕：回调=" & 回调次数 & 字符(10) & "文件路径=" & 参数1)
结束 事件

事件 相机1.浏览完毕(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("浏览完毕：回调=" & 回调次数 & 字符(10) & "文件路径=" & 参数1)
结束 事件

事件 相机1.剪裁完毕(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("剪裁完毕：回调=" & 回调次数 & 字符(10) & "文件路径=" & 参数1)
结束 事件

事件 相机1.操作取消(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("操作取消：回调=" & 回调次数 & "；操作=" & 参数1)
结束 事件

事件 相机1.操作失败(参数1 为 文本型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("操作失败：回调=" & 回调次数 & "；操作=" & 参数1 & 字符(10) & "信息=" & 参数2)
结束 事件

事件 相机1.相册更新完毕(参数1 为 文本型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("相册更新完毕：回调=" & 回调次数 & 字符(10) & "文件路径=" & 参数1 & "；内容URI=" & 参数2)
结束 事件

事件 权限请求1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 权限请求1.请求结果(参数1 为 文本型(), 参数2 为 整数型(), 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("请求结果：回调=" & 回调次数 & "；权限项数=" & 取数组成员数(参数1) _
		& 字符(10) & "授权结果项数=" & 取数组成员数(参数2) & "；请求标记=" & 参数3)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("相机测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 相机测试 $为 窗口
		标题 = "相机测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "先授权，再调用系统拍照、录像或文件选择。Android 9 及以下还需存储权限；拍照、录像和裁剪需设备提供处理应用。核对完成、取消及失败事件。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "请求所需权限"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "拍照"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "录像"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "选择图片"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "选择视频"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "选择并剪裁"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "检查闪光灯"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "开启闪光灯"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "关闭闪光灯"
			$结束 $定义
			$定义 操作按钮10 $为 按钮
				文本 = "读取处理状态"
			$结束 $定义
		$结束 $定义
		$定义 操作面板6 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮11 $为 按钮
				文本 = "读取照片旋转角度"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 相机1 $为 相机
		$结束 $定义
	$结束 $定义
$结束 $属性
