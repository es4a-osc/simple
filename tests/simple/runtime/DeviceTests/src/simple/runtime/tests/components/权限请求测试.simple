''' 权限请求测试。
''' 只显式请求相机权限，核对标记、权限数组和授权结果；
''' 覆盖允许、拒绝、已授权重复请求及设置返回后的查询。
''' 系统可能不再显示已永久拒绝的权限，应按实际状态报告。

变量 回调次数 为 整数型

事件 权限请求测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	操作结果标签.文本 = "是否授权=" & 权限请求1.是否授权("android.permission.CAMERA") _
		& "；需要理由=" & 权限请求1.需要理由("android.permission.CAMERA")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：查询相机权限；请检查权限、状态和运行日志"
			输出错误("设备测试/权限请求：查询相机权限失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	变量 权限 为 文本型(1)
	权限(0) = "android.permission.CAMERA"
	操作结果标签.文本 = "请求返回=" & 权限请求1.请求权限(权限, "camera-only")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求相机权限；请检查权限、状态和运行日志"
			输出错误("设备测试/权限请求：请求相机权限失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	权限请求1.打开设置()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：打开应用设置；请检查权限、状态和运行日志"
			输出错误("设备测试/权限请求：打开应用设置失败")
	结束 错误
结束 事件

事件 权限请求1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 权限请求1.请求结果(参数1 为 文本型(), 参数2 为 整数型(), 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("请求结果：回调=" & 回调次数 & "；权限项数=" & 取数组成员数(参数1) _
		& 字符(10) & "授权结果项数=" & 取数组成员数(参数2) & "；请求标记=" & 参数3)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("权限请求测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 权限请求测试 $为 窗口
		标题 = "权限请求测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "查询并请求相机权限，核对允许、拒绝和重复请求的结果。可从应用设置返回后重新查询。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "查询相机权限"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "请求相机权限"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "打开应用设置"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
	$结束 $定义
$结束 $属性
