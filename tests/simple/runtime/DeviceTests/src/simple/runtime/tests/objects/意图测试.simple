''' 意图测试。
''' 创建真实 Android Intent，核对动作、包名、文本、整数、逻辑、数组及缺失附加值。
''' 另在广播接收器单元验证跨系统派发；
''' 这里不调用外部应用。

变量 测试意图 为 意图

事件 意图测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	测试意图 = 创建 意图
	变量 空意图 为 意图
	空意图 = 创建 意图
	如果 空意图.取附加("不存在") <> 空 则
		操作结果标签.文本 = "空意图的缺失附加值错误"
		退出 事件
	结束 如果
	测试意图.置动作("simple.runtime.tests.INTENT")
	测试意图.置包名(取包名())
	测试意图.置附加("文字", "intent-中文")
	测试意图.置附加("整数", 42)
	测试意图.置附加("逻辑", 真)
	操作结果标签.文本 = "动作=" & 测试意图.取动作() & "；包=" & 测试意图.取包名() _
		& 字符(10) & "文字=" & 测试意图.取附加("文字") & "；整数=" & 测试意图.取附加("整数") _
		& 字符(10) & "逻辑=" & 测试意图.取附加("逻辑")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：创建并读回；请检查权限、状态和运行日志"
			输出错误("设备测试/意图：创建并读回失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	变量 内容 为 文本型(2)
	内容(0) = "甲"
	内容(1) = "乙"
	测试意图.置附加("数组", 内容)
	变量 读回 为 文本型()
	读回 = 测试意图.取附加("数组")
	操作结果标签.文本 = "数组长度=" & 取数组成员数(读回) & "；首项=" & 读回(0)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：数组附加；请检查权限、状态和运行日志"
			输出错误("设备测试/意图：数组附加失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	变量 值 为 变体型
	值 = 测试意图.取附加("不存在")
	操作结果标签.文本 = "缺失值为空=" & (值 = 空)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：缺失附加值；请检查权限、状态和运行日志"
			输出错误("设备测试/意图：缺失附加值失败")
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 意图测试 $为 窗口
		标题 = "意图测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "创建意图并设置动作、类别及附加值，再读回核对。分别测试数组和缺失附加值。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "创建并读回"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "数组附加"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "缺失附加值"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
