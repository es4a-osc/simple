''' 摄像框测试。
''' 授权后开启后置/前置预览，等待预览就绪再对焦、拍照及录像。
''' 核对尺寸列表、照片路径或字节回调，录像需分别验证有声/无声；
''' 切换窗口和进入后台关闭摄像头，返回后由按钮重新开启。

变量 回调次数 为 整数型
变量 正在录像 为 逻辑型

事件 摄像框测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 摄像框测试.即将切换()
	释放测试资源()
结束 事件

事件 摄像框测试.程序被停止()
	释放测试资源()
结束 事件

事件 操作按钮1.被单击()
	变量 权限 为 文本型(2)
	权限(0) = "android.permission.CAMERA"
	权限(1) = "android.permission.RECORD_AUDIO"
	操作结果标签.文本 = "权限请求已提交=" & 权限请求1.请求权限(权限, "摄像框")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求所需权限；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：请求所需权限失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	摄像框1.开启摄像头(2, 640, 480)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开启后置预览；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：开启后置预览失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	摄像框1.开启摄像头(1, 640, 480)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开启前置预览；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：开启前置预览失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	摄像框1.开始对焦()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开始对焦；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：开始对焦失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	删除文件("device-preview.jpg")
	摄像框1.拍摄照片("/data/data/" & 取包名() & "/files/device-preview.jpg", 1, 90)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：拍照保存文件；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：拍照保存文件失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	摄像框1.拍摄照片2(2, 90)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：拍照返回字节；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：拍照返回字节失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	删除文件("device-preview.mp4")
	摄像框1.开始录像("/data/data/" & 取包名() & "/files/device-preview.mp4", 1, 假)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开始无声录像；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：开始无声录像失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	删除文件("device-preview-sound.mp4")
	摄像框1.开始录像("/data/data/" & 取包名() & "/files/device-preview-sound.mp4", 1, 真)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开始有声录像；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：开始有声录像失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	摄像框1.停止录像()
	正在录像 = 假

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：停止录像；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：停止录像失败")
	结束 错误
结束 事件

事件 操作按钮10.被单击()
	摄像框1.开启闪光灯()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开启闪光灯；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：开启闪光灯失败")
	结束 错误
结束 事件

事件 操作按钮11.被单击()
	摄像框1.关闭闪光灯()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：关闭闪光灯；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：关闭闪光灯失败")
	结束 错误
结束 事件

事件 操作按钮12.被单击()
	摄像框1.关闭摄像头()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：关闭摄像头；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：关闭摄像头失败")
	结束 错误
结束 事件

事件 操作按钮13.被单击()
	操作结果标签.文本 = 摄像框1.错误信息

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取错误；请检查权限、状态和运行日志"
			输出错误("设备测试/摄像框：读取错误失败")
	结束 错误
结束 事件

事件 摄像框1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 摄像框1.对焦完毕(参数1 为 逻辑型)
	回调次数 = 回调次数 + 1
	记录事件("对焦完毕：回调=" & 回调次数 & "；成功=" & 参数1)
结束 事件

事件 摄像框1.被单击()
	回调次数 = 回调次数 + 1
	记录事件("被单击：回调=" & 回调次数)
结束 事件

事件 摄像框1.拍照完毕(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("拍照完毕：回调=" & 回调次数 & 字符(10) & "文件路径=" & 参数1)
	如果 文件是否存在(参数1) 则
		操作结果标签.文本 = "生成文件字节=" & 取文件尺寸(参数1)
	否则
		操作结果标签.文本 = "回调文件不存在：" & 参数1
	结束 如果
结束 事件

事件 摄像框1.拍照完毕2(参数1 为 字节型())
	回调次数 = 回调次数 + 1
	记录事件("拍照完毕2：回调=" & 回调次数 & "；数据字节数=" & 取数组成员数(参数1))
结束 事件

事件 摄像框1.获得预览尺寸列表(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("获得预览尺寸列表：回调=" & 回调次数 & "；尺寸列表=" & 参数1)
结束 事件

事件 摄像框1.获得照片尺寸列表(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("获得照片尺寸列表：回调=" & 回调次数 & "；尺寸列表=" & 参数1)
结束 事件

事件 摄像框1.预览就绪()
	回调次数 = 回调次数 + 1
	记录事件("预览就绪：回调=" & 回调次数)
结束 事件

事件 摄像框1.录像开始()
	正在录像 = 真
	回调次数 = 回调次数 + 1
	记录事件("录像开始：回调=" & 回调次数)
结束 事件

事件 摄像框1.录像完毕(参数1 为 文本型)
	正在录像 = 假
	回调次数 = 回调次数 + 1
	记录事件("录像完毕：回调=" & 回调次数 & 字符(10) & "文件路径=" & 参数1)
	如果 文件是否存在(参数1) 则
		操作结果标签.文本 = "生成文件字节=" & 取文件尺寸(参数1)
	否则
		操作结果标签.文本 = "回调文件不存在：" & 参数1
	结束 如果
结束 事件

事件 摄像框1.操作失败(参数1 为 文本型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("操作失败：回调=" & 回调次数 & "；操作=" & 参数1 & 字符(10) & "信息=" & 参数2)
结束 事件

事件 权限请求1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 权限请求1.请求结果(参数1 为 文本型(), 参数2 为 整数型(), 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("请求结果：回调=" & 回调次数 & "；权限项数=" & 取数组成员数(参数1) _
		& 字符(10) & "授权结果项数=" & 取数组成员数(参数2) & "；请求标记=" & 参数3)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("摄像框测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

''' 离页或后台时结束本页录制，只清理本页生成的文件。
过程 释放测试资源()
	如果 正在录像 则
		摄像框1.停止录像()
		正在录像 = 假
	结束 如果
	摄像框1.关闭摄像头()
	删除文件("device-preview.jpg")
	删除文件("device-preview.mp4")
	删除文件("device-preview-sound.mp4")
结束 过程

$属性
	$资源 $窗口
	$定义 摄像框测试 $为 窗口
		标题 = "摄像框测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "授权并开启预览，等待就绪后对焦、拍照或录像。核对文件、字节及完成事件；有声录像需麦克风权限，离页或后台关闭摄像头。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "请求所需权限"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "开启后置预览"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "开启前置预览"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "开始对焦"
			$结束 $定义
		$结束 $定义
		$定义 摄像框1 $为 摄像框
			宽度 = 长度_匹配父级
			高度 = "320px"
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "拍照保存文件"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "拍照返回字节"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "开始无声录像"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "开始有声录像"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "停止录像"
			$结束 $定义
			$定义 操作按钮10 $为 按钮
				文本 = "开启闪光灯"
			$结束 $定义
		$结束 $定义
		$定义 操作面板6 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮11 $为 按钮
				文本 = "关闭闪光灯"
			$结束 $定义
			$定义 操作按钮12 $为 按钮
				文本 = "关闭摄像头"
			$结束 $定义
		$结束 $定义
		$定义 操作面板7 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮13 $为 按钮
				文本 = "读取错误"
			$结束 $定义
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
