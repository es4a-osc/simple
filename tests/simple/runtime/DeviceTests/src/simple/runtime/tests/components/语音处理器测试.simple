''' 语音处理器测试。
''' 查询系统识别服务，分别确认识别结果和取消；
''' 朗读需等待就绪事件后调用，释放后重新初始化仍可使用。
''' 没有识别或 TTS 服务时检查操作失败信息，不当作已完成语音测试。

变量 回调次数 为 整数型

事件 语音处理器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 语音处理器测试.即将切换()
	语音处理器1.释放语音朗读()
结束 事件

事件 语音处理器测试.程序被停止()
	语音处理器1.释放语音朗读()
结束 事件

事件 操作按钮1.被单击()
	变量 权限 为 文本型(1)
	权限(0) = "android.permission.RECORD_AUDIO"
	操作结果标签.文本 = "权限请求已提交=" & 权限请求1.请求权限(权限, "语音处理器")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求录音权限；请检查权限、状态和运行日志"
			输出错误("设备测试/语音处理器：请求录音权限失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "支持识别=" & 语音处理器1.是否支持语音识别()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：查询识别能力；请检查权限、状态和运行日志"
			输出错误("设备测试/语音处理器：查询识别能力失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	操作结果标签.文本 = "识别受理=" & 语音处理器1.语音识别()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开始识别；请检查权限、状态和运行日志"
			输出错误("设备测试/语音处理器：开始识别失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	操作结果标签.文本 = "初始化受理=" & 语音处理器1.初始化语音朗读()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：初始化朗读；请检查权限、状态和运行日志"
			输出错误("设备测试/语音处理器：初始化朗读失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	操作结果标签.文本 = "朗读受理=" & 语音处理器1.语音朗读(朗读输入框.文本)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：朗读文本；请检查权限、状态和运行日志"
			输出错误("设备测试/语音处理器：朗读文本失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	语音处理器1.释放语音朗读()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：释放朗读；请检查权限、状态和运行日志"
			输出错误("设备测试/语音处理器：释放朗读失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	操作结果标签.文本 = "识别中=" & 语音处理器1.正在识别 & "；朗读就绪=" & 语音处理器1.朗读就绪 _
		& 字符(10) & "错误=" & 语音处理器1.错误信息

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取状态；请检查权限、状态和运行日志"
			输出错误("设备测试/语音处理器：读取状态失败")
	结束 错误
结束 事件

事件 语音处理器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 语音处理器1.语音识别完毕(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("语音识别完毕：回调=" & 回调次数 & "；结果=" & 参数1)
结束 事件

事件 语音处理器1.语音识别取消()
	回调次数 = 回调次数 + 1
	记录事件("语音识别取消：回调=" & 回调次数)
结束 事件

事件 语音处理器1.语音朗读就绪()
	回调次数 = 回调次数 + 1
	记录事件("语音朗读就绪：回调=" & 回调次数)
结束 事件

事件 语音处理器1.操作失败(参数1 为 文本型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("操作失败：回调=" & 回调次数 & "；操作=" & 参数1 & 字符(10) & "信息=" & 参数2)
结束 事件

事件 权限请求1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 权限请求1.请求结果(参数1 为 文本型(), 参数2 为 整数型(), 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("请求结果：回调=" & 回调次数 & "；权限项数=" & 取数组成员数(参数1) _
		& 字符(10) & "授权结果项数=" & 取数组成员数(参数2) & "；请求标记=" & 参数3)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("语音处理器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 语音处理器测试 $为 窗口
		标题 = "语音处理器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "授权后测试语音识别及取消。朗读需先初始化并等待就绪；释放后可重新初始化。需要系统识别或朗读服务。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 朗读输入框 $为 编辑框
			文本 = "设备测试，Simple 语音。"
			宽度 = 长度_匹配父级
			提示文本 = "待朗读文本"
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "请求录音权限"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "查询识别能力"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "开始识别"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "初始化朗读"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "朗读文本"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "释放朗读"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "读取状态"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 语音处理器1 $为 语音处理器
		$结束 $定义
	$结束 $定义
$结束 $属性
