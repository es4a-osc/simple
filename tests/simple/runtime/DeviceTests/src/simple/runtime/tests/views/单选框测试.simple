''' 单选框测试窗口。

变量 改变次数 为 整数型

事件 单选框测试.切换完毕()
	准备测试()
结束 事件

事件 单选框测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 单选框1.获得焦点()
	焦点标签.文本 = "获得焦点"
结束 事件

事件 单选框1.失去焦点()
	焦点标签.文本 = "失去焦点"
结束 事件

事件 单选框2.状态改变()
	改变次数 = 改变次数 + 1
	刷新状态()
结束 事件

事件 清除选中按钮.被单击()
	单选框2.选中 = 假
	刷新状态()
结束 事件

事件 切换启用按钮.被单击()
	单选框2.启用 = 取反 单选框2.启用
	刷新状态()
结束 事件

事件 读取属性按钮.被单击()
	刷新状态()
结束 事件

事件 设置选中按钮.被单击()
	单选框2.选中 = 真
	刷新状态()
结束 事件

事件 重复赋值按钮.被单击()
	变量 原次数 为 整数型
	原次数 = 改变次数
	单选框2.选中 = 单选框2.选中
	赋值标签.文本 = "相同值赋值前事件=" & 原次数 & "；赋值后=" & 改变次数
	刷新状态()
结束 事件

''' 显示当前状态，不修改待测控件。
过程 准备测试()
	刷新状态()
结束 过程

''' 读回选中、启用与事件计数。
过程 刷新状态()
	操作结果标签.文本 = "选中=" & 单选框2.选中 & "；启用=" & 单选框2.启用 & "；改变事件=" & 改变次数
结束 过程

$属性
	$资源 $窗口
	$定义 单选框测试 $为 窗口
		滚动 = 真
		标题 = "单选框测试"
		$定义 测试说明标签 $为 标签
			文本 = "第二个控件用于切换选中状态，核对状态事件及重复赋值。第一个用于焦点测试；其它控件对照禁用、颜色和字体。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 单选框1 $为 单选框
			文本 = "焦点测试"
		$结束 $定义
		$定义 单选框2 $为 单选框
			文本 = "切换选中状态"
		$结束 $定义
		$定义 状态操作面板 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 清除选中按钮 $为 按钮
				文本 = "清除选中"
			$结束 $定义
			$定义 切换启用按钮 $为 按钮
				文本 = "切换启用"
			$结束 $定义
			$定义 读取属性按钮 $为 按钮
				文本 = "读取状态"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 设置选中按钮 $为 按钮
				文本 = "设置为选中"
			$结束 $定义
			$定义 重复赋值按钮 $为 按钮
				文本 = "重复当前选中值"
			$结束 $定义
		$结束 $定义
		$定义 焦点标签 $为 标签
			文本 = "焦点事件：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 赋值标签 $为 标签
			文本 = "程序赋值：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 单选框3 $为 单选框
			文本 = "右对齐"
			内容对齐 = 对齐_右
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 单选框4 $为 单选框
			文本 = "绿色背景"
			背景颜色 = 颜色_绿
		$结束 $定义
		$定义 单选框5 $为 单选框
			文本 = "已禁用"
			启用 = 假
		$结束 $定义
		$定义 单选框6 $为 单选框
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 单选框7 $为 单选框
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 单选框8 $为 单选框
			文本 = "大字号"
			字体大小 = 20
		$结束 $定义
		$定义 单选框9 $为 单选框
			文本 = "等宽字体：wiwiw"
			字体类型 = 字体类型_等宽
		$结束 $定义
		$定义 单选框10 $为 单选框
			文本 = "绿色文字"
			文本颜色 = 颜色_绿
		$结束 $定义
	$结束 $定义
$结束 $属性
