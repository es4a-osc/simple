''' 网页浏览框测试。
''' 独立本地网页 A/B，无需外网。
''' 加载后检查标题、进度、导航、JS 返回、桥接回调及三种脚本对话框；
''' 拦截框只控制网页链接导航。
''' 刷新、停止及移除接口后再次操作，不能把提交返回真当作脚本完成。

变量 回调次数 为 整数型
变量 已注册 为 逻辑型

事件 网页浏览框测试.切换完毕()
	如果 取反 已注册 则
		网页浏览框1.注册接口("deviceBridge")
		已注册 = 真
	结束 如果
结束 事件

事件 网页浏览框测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 网页浏览框测试.即将切换()
	如果 取反 网页浏览框1.已销毁 则
		网页浏览框1.停止()
	结束 如果
结束 事件

事件 网页浏览框测试.程序被停止()
	如果 取反 网页浏览框1.已销毁 则
		网页浏览框1.停止()
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	网页浏览框1.加载("file:///android_asset/device-web-a.html")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：加载页面A；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：加载页面A失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	网页浏览框1.地址 = "file:///android_asset/device-web-b.html"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：加载页面B；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：加载页面B失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	网页浏览框1.后退()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：后退；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：后退失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	网页浏览框1.前进()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：前进；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：前进失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	网页浏览框1.刷新()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：刷新；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：刷新失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	网页浏览框1.停止()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：停止；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：停止失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	操作结果标签.文本 = "标题=" & 网页浏览框1.标题 & "；进度=" & 网页浏览框1.进度 & 字符(10) & "地址=" & 网页浏览框1.地址 _
		& "；后退=" & 网页浏览框1.可否后退() & 字符(10) & "前进=" & 网页浏览框1.可否前进() & 字符(10) & "错误=" & 网页浏览框1.错误信息

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取页面；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：读取页面失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	操作结果标签.文本 = "提交脚本=" & 网页浏览框1.调用接口("6*7", 真)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：计算 JS 结果；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：计算 JS 结果失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	操作结果标签.文本 = "提交桥接=" & 网页浏览框1.调用接口("deviceBridge.call('bridge-ok')" )

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：调用 JS 桥接；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：调用 JS 桥接失败")
	结束 错误
结束 事件

事件 操作按钮10.被单击()
	操作结果标签.文本 = "提交对话框=" _
		& 网页浏览框1.调用接口("alert('alert-ok');document.title=String(confirm('confirm-ok'))+'/'+prompt('prompt-ok','initial');", 真)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：脚本对话框；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：脚本对话框失败")
	结束 错误
结束 事件

事件 操作按钮11.被单击()
	操作结果标签.文本 = "移除结果=" & 网页浏览框1.移除接口("deviceBridge")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：移除桥接；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：移除桥接失败")
	结束 错误
结束 事件

事件 操作按钮12.被单击()
	网页浏览框1.注册接口("deviceBridge")
	网页浏览框1.刷新()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：重新注册桥接；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：重新注册桥接失败")
	结束 错误
结束 事件

事件 操作按钮13.被单击()
	网页浏览框1.启用JS = 取反 网页浏览框1.启用JS
	网页浏览框1.支持缩放 = 取反 网页浏览框1.支持缩放
	网页浏览框1.启用缩放按钮 = 取反 网页浏览框1.启用缩放按钮
	操作结果标签.文本 = "JS=" & 网页浏览框1.启用JS & "；缩放=" & 网页浏览框1.支持缩放 _
		& "；按钮=" & 网页浏览框1.启用缩放按钮

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换JS/缩放；请检查权限、状态和运行日志"
			输出错误("设备测试/网页浏览框：切换JS/缩放失败")
	结束 错误
结束 事件

事件 网页浏览框1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 网页浏览框1.触摸手势(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("触摸手势：回调=" & 回调次数 & "；方向=" & 参数1)
结束 事件

事件 网页浏览框1.即将跳转(参数1 为 文本型, 传址 参数2 为 逻辑型)
	参数2 = 拦截复选框.选中 且 参数1 = "file:///android_asset/device-web-b.html"
	记录事件("即将跳转=" & 参数1 & "；屏蔽=" & 参数2)
结束 事件

事件 网页浏览框1.开始载入(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("开始载入：回调=" & 回调次数 & "；网址=" & 参数1)
结束 事件

事件 网页浏览框1.载入完毕(参数1 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("载入完毕：回调=" & 回调次数 & "；网址=" & 参数1)
结束 事件

事件 网页浏览框1.载入失败(参数1 为 整数型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("载入失败：回调=" & 回调次数 & "；错误码=" & 参数1 & "；失败网址=" & 参数2)
结束 事件

事件 网页浏览框1.进度改变(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("进度改变：回调=" & 回调次数 & "；进度=" & 参数1)
结束 事件

事件 网页浏览框1.弹出警告框(参数1 为 文本型, 参数2 为 文本型, 传址 参数3 为 逻辑型)
	参数3 = 真
	记录事件("alert参数=" & 参数2)
结束 事件

事件 网页浏览框1.弹出确认框(参数1 为 文本型, 参数2 为 文本型, 传址 参数3 为 整数型)
	参数3 = 网页浏览框.处理方式_确认
	记录事件("confirm参数=" & 参数2 & "；自动确认")
结束 事件

事件 网页浏览框1.弹出输入框(参数1 为 文本型, 参数2 为 文本型, 传址 参数3 为 文本型, 传址 参数4 为 整数型)
	参数3 = "device-result"
	参数4 = 网页浏览框.处理方式_确认
	记录事件("prompt参数=" & 参数2 & "；返回=" & 参数3)
结束 事件

事件 网页浏览框1.开始下载(参数1 为 文本型, 参数2 为 长整数型)
	回调次数 = 回调次数 + 1
	记录事件("开始下载：回调=" & 回调次数 & "；网址=" & 参数1 & "；内容字节数=" & 参数2)
结束 事件

事件 网页浏览框1.接口调用(参数1 为 文本型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("接口调用：回调=" & 回调次数 & "；接口名称=" & 参数1 & "；调用参数=" & 参数2)
结束 事件

事件 网页浏览框1.接口返回(参数1 为 文本型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("接口返回：回调=" & 回调次数 & "；脚本=" & 参数1 & "；结果=" & 参数2)
结束 事件

事件 网页浏览框1.HTTP错误(参数1 为 整数型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("HTTP错误：回调=" & 回调次数 & "；HTTP状态码=" & 参数1 & "；网址=" & 参数2)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("网页浏览框测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 网页浏览框测试 $为 窗口
		标题 = "网页浏览框测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "加载本地页面 A/B，核对导航、标题、进度及脚本结果。可测试桥接、脚本对话框和链接拦截；无需外网。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 拦截复选框 $为 复选框
			文本 = "拦截到页面B的链接"
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "加载页面A"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "加载页面B"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "后退"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "前进"
			$结束 $定义
		$结束 $定义
		$定义 网页浏览框1 $为 网页浏览框
			宽度 = 长度_匹配父级
			高度 = "400px"
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "刷新"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "停止"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "读取页面"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "计算 JS 结果"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "调用 JS 桥接"
			$结束 $定义
			$定义 操作按钮10 $为 按钮
				文本 = "脚本对话框"
			$结束 $定义
		$结束 $定义
		$定义 操作面板6 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮11 $为 按钮
				文本 = "移除桥接"
			$结束 $定义
			$定义 操作按钮12 $为 按钮
				文本 = "重新注册桥接"
			$结束 $定义
		$结束 $定义
		$定义 操作面板7 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮13 $为 按钮
				文本 = "切换JS/缩放"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
