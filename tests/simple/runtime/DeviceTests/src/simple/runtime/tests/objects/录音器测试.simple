''' 录音器测试。
''' 授权后在本应用私有文件录音，至少等待一秒再停止；
''' 核对文件存在及大小。
''' 覆盖重复停止、停止后重录与过短录音失败。
''' 离页尝试停止并释放，只清理本页的测试文件。

变量 回调次数 为 整数型
变量 录音对象 为 录音器
变量 已录音 为 逻辑型

事件 录音器测试.切换完毕()
	如果 录音对象 = 空 则
		录音对象 = 创建 录音器
	结束 如果
结束 事件

事件 录音器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 录音器测试.即将切换()
	如果 已录音 则
		录音对象.停止录音()
		已录音 = 假
	结束 如果
结束 事件

事件 录音器测试.程序被停止()
	如果 已录音 则
		录音对象.停止录音()
		已录音 = 假
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	变量 权限 为 文本型(1)
	权限(0) = "android.permission.RECORD_AUDIO"
	操作结果标签.文本 = "权限请求已提交=" & 权限请求1.请求权限(权限, "录音器")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求所需权限；请检查权限、状态和运行日志"
			输出错误("设备测试/录音器：请求所需权限失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	录音对象.置录音源(1)
	录音对象.开始录音("/data/data/" & 取包名() & "/files/device-recording.3gp")
	已录音 = 真
	操作结果标签.文本 = "已调用开始，等待至少一秒再停止并核对文件"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开始麦克风录音；请检查权限、状态和运行日志"
			输出错误("设备测试/录音器：开始麦克风录音失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	录音对象.停止录音()
	已录音 = 假
	操作结果标签.文本 = "停止后文件存在=" & 文件是否存在("device-recording.3gp") _
		& "；字节=" & 取文件尺寸("device-recording.3gp")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：停止录音；请检查权限、状态和运行日志"
			输出错误("设备测试/录音器：停止录音失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	录音对象.停止录音()
	操作结果标签.文本 = "重复停止返回；之后应仍可再次录音"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：重复停止；请检查权限、状态和运行日志"
			输出错误("设备测试/录音器：重复停止失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	如果 取反 已录音 则
		操作结果标签.文本 = "删除=" & 删除文件("device-recording.3gp")
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：清理录音文件；请检查权限、状态和运行日志"
			输出错误("设备测试/录音器：清理录音文件失败")
	结束 错误
结束 事件

事件 权限请求1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 权限请求1.请求结果(参数1 为 文本型(), 参数2 为 整数型(), 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("请求结果：回调=" & 回调次数 & "；权限项数=" & 取数组成员数(参数1) _
		& 字符(10) & "授权结果项数=" & 取数组成员数(参数2) & "；请求标记=" & 参数3)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("录音器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 录音器测试 $为 窗口
		标题 = "录音器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "授权后开始麦克风录音，再停止并检查生成文件。测试重复停止；清理只删除本页录音文件。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "请求所需权限"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "开始麦克风录音"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "停止录音"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "重复停止"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "清理录音文件"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
	$结束 $定义
$结束 $属性
