''' 画板测试窗口。

变量 触摸次数 为 整数型
变量 按下次数 为 整数型
变量 弹起次数 为 整数型
变量 手势次数 为 整数型

事件 画板测试.切换完毕()
	准备测试()
结束 事件

事件 画板测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 绘制按钮.被单击()
	画板1.清空()
	画板1.画笔类型 = 画板.画笔_填充
	画板1.画笔颜色 = 颜色_蓝
	画板1.画矩形(20, 20, 60, 60)
	画板1.画笔类型 = 画板.画笔_描边
	画板1.画笔颜色 = &HFF00AA00
	画板1.画笔粗细 = 4
	画板1.画直线(100, 20, 180, 80)
	画板1.画圆(220, 50, 25)
	如果 画板1.取点颜色(30, 30) = 颜色_蓝 则
		操作结果标签.文本 = "绘制验色成功：矩形内部为蓝色；请目视检查直线和圆"
	否则
		操作结果标签.文本 = "绘制验色失败：矩形内部不是预期蓝色"
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "绘制或取点失败，请检查布局尺寸与运行日志"
	结束 错误
结束 事件

事件 清空按钮.被单击()
	画板1.清空()
	如果 画板1.取点颜色(30, 30) = 颜色_白 则
		操作结果标签.文本 = "清空验色成功：原矩形位置为白色"
	否则
		操作结果标签.文本 = "清空验色失败：不是预期白色"
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "清空或取点失败，请检查布局尺寸与运行日志"
	结束 错误
结束 事件

事件 画板1.被按下(横坐标 为 整数型, 纵坐标 为 整数型)
	按下次数 = 按下次数 + 1
	画板1.画笔颜色 = &HFFAA0000
	画板1.画笔粗细 = 4
	画板1.画点(横坐标, 纵坐标)
	画板事件标签.文本 = "按下=" & 按下次数 & "；坐标=" & 横坐标 & ", " & 纵坐标
结束 事件

事件 画板1.触摸移动(上次横坐标 为 整数型, 上次纵坐标 为 整数型, 横坐标 为 整数型, 纵坐标 为 整数型)
	画板1.画直线(上次横坐标, 上次纵坐标, 横坐标, 纵坐标)
	触摸次数 = 触摸次数 + 1
	操作结果标签.文本 = "触摸移动事件=" & 触摸次数 & "；当前位置=" & 横坐标 & ", " & 纵坐标
结束 事件

事件 保存图片按钮.被单击()
	保存并检查(画板.图片格式_PNG)
结束 事件

事件 保存照片按钮.被单击()
	保存并检查(画板.图片格式_JPEG)
结束 事件

事件 清理文件按钮.被单击()
	如果 文件是否存在("starttests-canvas.png") 则
		删除文件("starttests-canvas.png")
	结束 如果
	如果 文件是否存在("starttests-canvas.jpg") 则
		删除文件("starttests-canvas.jpg")
	结束 如果
	如果 文件是否存在("device-tests-canvas-default.png") 则
		删除文件("device-tests-canvas-default.png")
	结束 如果
	操作结果标签.文本 = "默认PNG=" & 文件是否存在("device-tests-canvas-default.png") _
		& "；测试文件剩余：PNG=" & 文件是否存在("starttests-canvas.png") _
		& "；JPEG=" & 文件是否存在("starttests-canvas.jpg")
结束 事件

事件 画板1.被弹起(横坐标 为 整数型, 纵坐标 为 整数型)
	弹起次数 = 弹起次数 + 1
	画板事件标签.文本 = "弹起=" & 弹起次数 & "；移动=" & 触摸次数 & "；坐标=" & 横坐标 & ", " & 纵坐标
结束 事件

事件 画板1.触摸手势(方向 为 整数型)
	手势次数 = 手势次数 + 1
	画板事件标签.文本 = "手势事件=" & 手势次数 & "；方向=" & 方向
结束 事件

事件 扩展绘图按钮.被单击()
	画板1.清空()
	画板1.画笔类型 = 画板.画笔_描边
	画板1.画笔颜色 = 颜色_蓝
	画板1.画笔粗细 = 3
	画板1.画圆角矩形(10, 10, 80, 50, 10)
	画板1.画弧形(110, 10, 80, 60, 0, 180, 真)
	画板1.画贝塞尔曲线(10, 120, 90, 60, 180, 150)
	操作结果标签.文本 = "请核对圆角矩形、半圆弧和二次曲线，切换其它绘图后可重复验证"
结束 事件

事件 文字绘图按钮.被单击()
	画板1.清空()
	画板1.字体大小 = 24
	画板1.画笔颜色 = 颜色_黑
	画板1.画文字(10, 30, "中文 Simple 123")
	画板1.画图片("simple.png", 10, 50)
	画板1.画图片("simple.png", 120, 60, 80, 60)
	操作结果标签.文本 = "请核对中文文字、原尺寸图片和缩放图片；保存后重新进入应仍保留画面"
结束 事件

事件 读取画笔按钮.被单击()
	操作结果标签.文本 = "颜色=" & 画板1.画笔颜色 & "；粗细=" & 画板1.画笔粗细 & 字符(10) & "类型=" & 画板1.画笔类型 _
		& "；字号=" & 画板1.字体大小 & 字符(10) & "实际尺寸=" & 画板1.宽度 & " × " & 画板1.高度
结束 事件

事件 保存默认按钮.被单击()
	保存并检查(2)
结束 事件

事件 边界取点按钮.被单击()
	变量 颜色 为 整数型
	颜色 = 画板1.取点颜色(-1, -1)
	操作结果标签.文本 = "测试越界取点未产生预期错误，返回=" & 颜色

	位于 错误
		分支 索引超出界限错误
			操作结果标签.文本 = "测试越界取点收到预期的索引超出界限错误；有效绘图应仍可继续"
		分支 否则
			操作结果标签.文本 = "测试越界取点收到其它异常，不能视为符合预期"
	结束 错误
结束 事件

''' 等待界面布局后由按钮发起绘制与取点。
过程 准备测试()
	操作结果标签.文本 = "画板已显示，点击绘制或在画板内拖动"
结束 过程

''' 保存到应用私有目录，并读取真实文件头检查格式。
过程 保存并检查(格式编号 为 整数型)
	变量 文件名 为 文本型
	如果 格式编号 = 2 则
		文件名 = "device-tests-canvas-default.png"
	否则如果 格式编号 = 画板.图片格式_PNG 则
		文件名 = "starttests-canvas.png"
	否则
		文件名 = "starttests-canvas.jpg"
	结束 如果
	如果 文件是否存在(文件名) 则
		删除文件(文件名)
	结束 如果
	如果 格式编号 = 2 则
		画板1.保存画面(文件名)
	否则
		画板1.保存画面(文件名, 格式编号)
	结束 如果
	如果 文件是否存在(文件名) 且 取文件尺寸(文件名) >= 8 则
		变量 数据 为 字节型()
		数据 = 读入字节文件(文件名)
		变量 格式匹配 为 逻辑型
		如果 格式编号 <> 画板.图片格式_JPEG 则
			格式匹配 = (数据(0) 且 255) = 137 且 数据(1) = 80 且 数据(2) = 78 且 数据(3) = 71
		否则
			格式匹配 = (数据(0) 且 255) = 255 且 (数据(1) 且 255) = 216 且 (数据(2) 且 255) = 255
		结束 如果
		操作结果标签.文本 = "保存 " & 文件名 & "；字节=" & 取文件尺寸(文件名) & "；格式匹配=" & 格式匹配
	否则
		操作结果标签.文本 = "保存失败：文件缺失或过小"
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "保存或读取文件失败，请检查运行日志"
	结束 错误
结束 过程

$属性
	$资源 $窗口
	$定义 画板测试 $为 窗口
		标题 = "画板测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "绘制或清空后核对像素颜色；拖动时观察轨迹和触摸事件。可测试图形、文字、图片及 PNG/JPEG 保存；清理只删除本页文件。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 绘制操作面板 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 绘制按钮 $为 按钮
				文本 = "绘制并验色"
			$结束 $定义
			$定义 清空按钮 $为 按钮
				文本 = "清空并验色"
			$结束 $定义
		$结束 $定义
		$定义 绘图面板 $为 面板
			布局 = 布局_单帧
			高度 = 220
			宽度 = 长度_匹配父级
			$定义 画板1 $为 画板
				画笔颜色 = 颜色_绿
				宽度 = 长度_匹配父级
				高度 = 长度_匹配父级
			$结束 $定义
		$结束 $定义
		$定义 保存操作面板 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 保存图片按钮 $为 按钮
				文本 = "保存 PNG"
			$结束 $定义
			$定义 保存照片按钮 $为 按钮
				文本 = "保存 JPEG"
			$结束 $定义
			$定义 清理文件按钮 $为 按钮
				文本 = "清理文件"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 扩展绘图按钮 $为 按钮
				文本 = "绘制曲线图形"
			$结束 $定义
			$定义 文字绘图按钮 $为 按钮
				文本 = "绘制文字与图片"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 读取画笔按钮 $为 按钮
				文本 = "读取画笔属性"
			$结束 $定义
			$定义 保存默认按钮 $为 按钮
				文本 = "默认保存 PNG"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 边界取点按钮 $为 按钮
				文本 = "测试越界取点"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 画板事件标签 $为 标签
			文本 = "画板事件：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
