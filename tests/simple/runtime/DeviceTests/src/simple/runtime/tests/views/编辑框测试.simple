''' 编辑框测试窗口。

变量 最近有效文本 为 文本型
变量 文本改变次数 为 整数型

事件 编辑框测试.切换完毕()
	准备测试()
结束 事件

事件 编辑框测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 编辑框1.获得焦点()
	焦点标签.文本 = "任意文字框获得焦点"
结束 事件

事件 编辑框1.失去焦点()
	焦点标签.文本 = "任意文字框失去焦点"
结束 事件

事件 编辑框2.文本改变(输入文本 为 文本型, 传址 接受输入 为 逻辑型)
	变量 整数值 为 整数型
	整数值 = 输入文本
	接受输入 = 真
	最近有效文本 = 输入文本
	验证标签.文本 = "接受整数：" & 整数值

	位于 错误
		分支 转换错误
			接受输入 = 假
			验证标签.文本 = "已请求拒绝非整数：" & 输入文本
	结束 错误
结束 事件

事件 读取输入按钮.被单击()
	变量 回滚有效 为 逻辑型
	回滚有效 = 编辑框2.文本 = 最近有效文本
	操作结果标签.文本 = "任意文字=" & 编辑框1.文本 & "；整数框=" & 编辑框2.文本 & "；内容有效=" & 回滚有效
结束 事件

事件 编辑框1.文本改变(输入文本 为 文本型, 传址 接受输入 为 逻辑型)
	文本改变次数 = 文本改变次数 + 1
	编辑属性标签.文本 = "文本改变事件=" & 文本改变次数 & "；本次参数=" & 输入文本
	接受输入 = 真
结束 事件

事件 重置文字按钮.被单击()
	编辑框1.文本 = "abcd"
	读取编辑属性()
结束 事件

事件 追加文字按钮.被单击()
	编辑框1.加入文本("12")
	读取编辑属性()
结束 事件

事件 插入文字按钮.被单击()
	编辑框1.插入文本(0, "XY")
	读取编辑属性()
结束 事件

事件 切换启用按钮.被单击()
	编辑框1.启用 = 取反 编辑框1.启用
	读取编辑属性()
结束 事件

事件 切换光标按钮.被单击()
	编辑框1.光标可视 = 取反 编辑框1.光标可视
	读取编辑属性()
结束 事件

事件 移动光标按钮.被单击()
	编辑框1.光标位置 = 取字符数(编辑框1.文本)
	读取编辑属性()
结束 事件

事件 输入模式按钮.被单击()
	编辑框1.输入模式 = (编辑框1.输入模式 + 1) % 5
	读取编辑属性()
结束 事件

事件 提示文字按钮.被单击()
	编辑框1.提示文本 = "新的中文提示"
	编辑框1.提示颜色 = 颜色_蓝
	编辑框1.文本 = ""
	读取编辑属性()
结束 事件

事件 删除文字按钮.被单击()
	如果 取字符数(编辑框1.文本) >= 2 则
		编辑框1.删除文本(0, 2)
	否则
		编辑框1.删除文本(0, 取字符数(编辑框1.文本))
	结束 如果
	读取编辑属性()
结束 事件

事件 选取文字按钮.被单击()
	如果 取字符数(编辑框1.文本) >= 2 则
		编辑框1.选中文本(0, 2)
	否则
		编辑框1.全选文本()
	结束 如果
	读取编辑属性()
结束 事件

事件 全选文字按钮.被单击()
	编辑框1.全选文本()
	读取编辑属性()
结束 事件

事件 显示键盘按钮.被单击()
	编辑框1.获取焦点()
	编辑框1.显示输入法()
结束 事件

事件 隐藏键盘按钮.被单击()
	编辑框1.隐藏输入法()
结束 事件

事件 请求焦点按钮.被单击()
	变量 已获焦点 为 逻辑型
	已获焦点 = 编辑框1.获取焦点()
	编辑属性标签.文本 = "请求焦点返回=" & 已获焦点
结束 事件

事件 清除焦点按钮.被单击()
	编辑框1.清除焦点()
结束 事件

''' 每次进入显示当前输入，不重置内容。
过程 准备测试()
	如果 最近有效文本 = "" 则
		最近有效文本 = 编辑框2.文本
	结束 如果
	操作结果标签.文本 = "任意文字框内容：" & 编辑框1.文本
结束 过程

''' 显示实际文本、光标、输入模式和提示，供操作前后核对。
过程 读取编辑属性()
	编辑属性标签.文本 = "文字=" & 编辑框1.文本 & "；长度=" & 取字符数(编辑框1.文本) _
		& 字符(10) & "光标=" & 编辑框1.光标位置 & "；光标可视=" & 编辑框1.光标可视 & 字符(10) & "启用=" & 编辑框1.启用 _
		& 字符(10) & "输入模式=" & 编辑框1.输入模式 & "；提示=" & 编辑框1.提示文本 & 字符(10) & "提示颜色=" & 编辑框1.提示颜色 _
		& "；文本事件=" & 文本改变次数
结束 过程

$属性
	$资源 $窗口
	$定义 编辑框测试 $为 窗口
		滚动 = 真
		标题 = "编辑框测试"
		$定义 测试说明标签 $为 标签
			文本 = "第一个框测试追加、插入、删除、选区及输入属性，第二个只接受整数。核对读回内容、文本改变和焦点事件；其它框对照样式。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 编辑框1 $为 编辑框
			提示文本 = "输入任意文字"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 编辑框2 $为 编辑框
			文本 = "123"
			文本颜色 = 颜色_红
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 读取输入按钮 $为 按钮
			文本 = "读取输入"
		$结束 $定义
		$定义 补充操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 重置文字按钮 $为 按钮
				文本 = "重置为 abcd"
			$结束 $定义
			$定义 追加文字按钮 $为 按钮
				文本 = "追加 12"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 插入文字按钮 $为 按钮
				文本 = "开头插入 XY"
			$结束 $定义
			$定义 删除文字按钮 $为 按钮
				文本 = "删除前两字"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 选取文字按钮 $为 按钮
				文本 = "选中前两字"
			$结束 $定义
			$定义 全选文字按钮 $为 按钮
				文本 = "全选"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换启用按钮 $为 按钮
				文本 = "启用/禁用"
			$结束 $定义
			$定义 切换光标按钮 $为 按钮
				文本 = "显示/隐藏光标"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 移动光标按钮 $为 按钮
				文本 = "光标移到末尾"
			$结束 $定义
			$定义 输入模式按钮 $为 按钮
				文本 = "切换输入模式"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板6 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 显示键盘按钮 $为 按钮
				文本 = "显示键盘"
			$结束 $定义
			$定义 隐藏键盘按钮 $为 按钮
				文本 = "隐藏键盘"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板7 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 请求焦点按钮 $为 按钮
				文本 = "请求焦点"
			$结束 $定义
			$定义 清除焦点按钮 $为 按钮
				文本 = "清除焦点"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板8 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 提示文字按钮 $为 按钮
				文本 = "设置提示并清空"
			$结束 $定义
		$结束 $定义
		$定义 焦点标签 $为 标签
			文本 = "焦点事件：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 验证标签 $为 标签
			文本 = "整数框初值为 123"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 编辑属性标签 $为 标签
			文本 = "编辑属性：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 编辑框3 $为 编辑框
			文本 = "右对齐"
			内容对齐 = 对齐_右
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 编辑框4 $为 编辑框
			文本 = "绿色背景"
			背景颜色 = 颜色_绿
		$结束 $定义
		$定义 编辑框5 $为 编辑框
			文本 = "已禁用"
			启用 = 假
		$结束 $定义
		$定义 编辑框6 $为 编辑框
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 编辑框7 $为 编辑框
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 编辑框8 $为 编辑框
			文本 = "大字号"
			字体大小 = 20
		$结束 $定义
		$定义 编辑框9 $为 编辑框
			文本 = "等宽字体：wiwiw"
			字体类型 = 字体类型_等宽
		$结束 $定义
		$定义 编辑框10 $为 编辑框
			文本 = "绿色文字"
			文本颜色 = 颜色_绿
		$结束 $定义
	$结束 $定义
$结束 $属性
