''' 邮箱选择器测试窗口。

事件 邮箱选择器测试.切换完毕()
	准备测试()
结束 事件

事件 邮箱选择器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 权限按钮.被单击()
	变量 权限 为 文本型(1)
	权限(0) = "android.permission.READ_CONTACTS"
	权限请求1.请求权限(权限, "邮箱测试")
结束 事件

事件 权限请求1.请求结果(权限 为 文本型(), 授权结果 为 整数型(), 请求标记 为 文本型)
	选择回调标签.文本 = "权限请求标记=" & 请求标记 & "；权限数=" & 取数组成员数(权限) _
		& "；结果数=" & 取数组成员数(授权结果)
	准备测试()
结束 事件

事件 邮箱选择器1.获得焦点()
	焦点标签.文本 = "第一邮箱框获得焦点"
结束 事件

事件 邮箱选择器1.失去焦点()
	焦点标签.文本 = "第一邮箱框失去焦点"
结束 事件

事件 读取输入按钮.被单击()
	操作结果标签.文本 = "读回邮箱：" & 邮箱选择器1.文本
结束 事件

事件 邮箱选择器1.选择完毕(姓名 为 文本型, 地址 为 文本型)
	选择回调标签.文本 = "姓名=" & 姓名 & "；地址=" & 地址 & 字符(10) & "文本读回=" & 邮箱选择器1.文本
结束 事件

事件 邮箱选择器1.操作失败(信息 为 文本型)
	选择回调标签.文本 = "失败回调：" & 信息 & "；错误属性=" & 邮箱选择器1.错误信息
结束 事件

事件 切换启用按钮.被单击()
	邮箱选择器1.启用 = 取反 邮箱选择器1.启用
	操作结果标签.文本 = "邮箱框启用=" & 邮箱选择器1.启用 & "；请核对能否输入和选择"
结束 事件

事件 清空邮箱按钮.被单击()
	邮箱选择器1.文本 = ""
	操作结果标签.文本 = "已清空；读回长度=" & 取字符数(邮箱选择器1.文本)
结束 事件

事件 读取状态按钮.被单击()
	操作结果标签.文本 = "启用=" & 邮箱选择器1.启用 & "；单行=" & 邮箱选择器1.单行模式 _
		& 字符(10) & "错误=" & 邮箱选择器1.错误信息
结束 事件

''' 显示当前权限，不自动请求联系人授权。
过程 准备测试()
	权限标签.文本 = "读取联系人=" & 权限请求1.是否授权("android.permission.READ_CONTACTS")
结束 过程

$属性
	$资源 $窗口
	$定义 邮箱选择器测试 $为 窗口
		滚动 = 真
		标题 = "邮箱选择器测试"
		$定义 测试说明标签 $为 标签
			文本 = "授权后在第一个框输入联系人邮箱前缀并选择候选，核对姓名、地址及文本。需有带邮箱的联系人；无权限时仍可手动输入。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 邮箱选择器1 $为 邮箱选择器
			文本 = "test@example.com"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 邮箱操作面板 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 权限按钮 $为 按钮
				文本 = "请求联系人权限"
			$结束 $定义
			$定义 读取输入按钮 $为 按钮
				文本 = "读取邮箱"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换启用按钮 $为 按钮
				文本 = "启用/禁用"
			$结束 $定义
			$定义 清空邮箱按钮 $为 按钮
				文本 = "清空邮箱"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 读取状态按钮 $为 按钮
				文本 = "读取错误和模式"
			$结束 $定义
		$结束 $定义
		$定义 权限标签 $为 标签
			文本 = "权限状态：待检查"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 焦点标签 $为 标签
			文本 = "焦点事件：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 选择回调标签 $为 标签
			文本 = "选择回调：等待实际联系人候选"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 邮箱选择器2 $为 邮箱选择器
			文本 = "右对齐"
			内容对齐 = 对齐_右
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 邮箱选择器3 $为 邮箱选择器
			文本 = "绿色背景"
			背景颜色 = 颜色_绿
		$结束 $定义
		$定义 邮箱选择器4 $为 邮箱选择器
			文本 = "已禁用"
			启用 = 假
		$结束 $定义
		$定义 邮箱选择器5 $为 邮箱选择器
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 邮箱选择器6 $为 邮箱选择器
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 邮箱选择器7 $为 邮箱选择器
			文本 = "大字号"
			字体大小 = 20
		$结束 $定义
		$定义 邮箱选择器8 $为 邮箱选择器
			文本 = "等宽字体：wiwiw"
			字体类型 = 字体类型_等宽
		$结束 $定义
		$定义 邮箱选择器9 $为 邮箱选择器
			文本 = "绿色文字"
			文本颜色 = 颜色_绿
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
	$结束 $定义
$结束 $属性
