''' 文件操作测试。
''' 仅测试 Android 应用私有根目录与存储空间集成，不重复普通 JVM 文件算法。
''' 创建、重读、列举和清理本页 device-test-storage 目录，检查读回内容及可用空间。

事件 文件操作测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	创建目录("device-test-storage")
	写出文本文件("device-test-storage/private.txt", "private-中文42")
	操作结果标签.文本 = "读回=" & 读入文本文件("device-test-storage/private.txt") _
		& "；字节=" & 取文件尺寸("device-test-storage/private.txt")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：写入私有文件；请检查权限、状态和运行日志"
			输出错误("设备测试/文件操作：写入私有文件失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "文件数=" & 取数组成员数(取文件列表("device-test-storage")) _
		& "；总空间=" & 取存储总空间() & "；可用=" & 取存储可用空间()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取目录与空间；请检查权限、状态和运行日志"
			输出错误("设备测试/文件操作：读取目录与空间失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	如果 文件是否存在("device-test-storage/private.txt") 则
		删除文件("device-test-storage/private.txt")
	结束 如果
	操作结果标签.文本 = "删除目录=" & 删除目录("device-test-storage")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：清理本页文件；请检查权限、状态和运行日志"
			输出错误("设备测试/文件操作：清理本页文件失败")
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 文件操作测试 $为 窗口
		标题 = "文件操作测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "在应用私有目录写入并读回测试文件，检查目录和存储空间。清理只删除本页创建的文件。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "写入私有文件"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "读取目录与空间"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "清理本页文件"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
