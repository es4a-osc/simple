''' 指纹验证测试。
''' 此单元仅测试指纹。
''' 查询硬件/录入等可用状态，再覆盖正确指纹、错误指纹、提示、用户取消与程序取消；
''' 开始返回真不等于验证成功。
''' 没有指纹硬件或未录入时按真实状态记录。

变量 回调次数 为 整数型

事件 指纹验证测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 指纹验证测试.即将切换()
	指纹验证1.取消验证()
结束 事件

事件 指纹验证测试.程序被停止()
	指纹验证1.取消验证()
结束 事件

事件 操作按钮1.被单击()
	操作结果标签.文本 = "状态=" & 指纹验证1.取可用状态() & "；验证中=" & 指纹验证1.正在验证 _
		& 字符(10) & "错误=" & 指纹验证1.错误信息

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取可用状态；请检查权限、状态和运行日志"
			输出错误("设备测试/指纹验证：读取可用状态失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "开始返回=" & 指纹验证1.开始验证()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：开始指纹验证；请检查权限、状态和运行日志"
			输出错误("设备测试/指纹验证：开始指纹验证失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	指纹验证1.取消验证()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：取消指纹验证；请检查权限、状态和运行日志"
			输出错误("设备测试/指纹验证：取消指纹验证失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	操作结果标签.文本 = "设置打开=" & 指纹验证1.打开设置()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：打开指纹设置；请检查权限、状态和运行日志"
			输出错误("设备测试/指纹验证：打开指纹设置失败")
	结束 错误
结束 事件

事件 指纹验证1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 指纹验证1.验证成功()
	回调次数 = 回调次数 + 1
	记录事件("验证成功：回调=" & 回调次数)
结束 事件

事件 指纹验证1.验证未通过()
	回调次数 = 回调次数 + 1
	记录事件("验证未通过：回调=" & 回调次数)
结束 事件

事件 指纹验证1.验证提示(参数1 为 整数型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("验证提示：回调=" & 回调次数 & "；错误码=" & 参数1 & 字符(10) & "信息=" & 参数2)
结束 事件

事件 指纹验证1.验证取消()
	回调次数 = 回调次数 + 1
	记录事件("验证取消：回调=" & 回调次数)
结束 事件

事件 指纹验证1.验证错误(参数1 为 整数型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("验证错误：回调=" & 回调次数 & "；错误码=" & 参数1 & 字符(10) & "信息=" & 参数2)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("指纹验证测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 指纹验证测试 $为 窗口
		标题 = "指纹验证测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "先检查指纹硬件和录入状态，再测试成功、失败及取消。没有硬件或未录入时显示实际原因。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "读取可用状态"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "开始指纹验证"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "取消指纹验证"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "打开指纹设置"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 指纹验证1 $为 指纹验证
		$结束 $定义
	$结束 $定义
$结束 $属性
