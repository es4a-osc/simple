''' UDP数据报测试。
''' 监听系统分配的本地端口，再向自身 127.0.0.1 发送独立数据报；
''' 核对字节、来源及发送长度事件。
''' 停止后发送不应伪造接收，重新监听后可再次收发。

变量 回调次数 为 整数型

事件 UDP数据报测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 UDP数据报测试.即将切换()
	UDP数据报1.停止监听()
结束 事件

事件 UDP数据报测试.程序被停止()
	UDP数据报1.停止监听()
结束 事件

事件 操作按钮1.被单击()
	UDP数据报1.置接收数据包大小(4096)
	操作结果标签.文本 = "监听受理=" & UDP数据报1.开始监听(0)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：启动监听；请检查权限、状态和运行日志"
			输出错误("设备测试/UDP数据报：启动监听失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "发送受理=" & UDP数据报1.发送数据(文本到字节("UDP中文42"), "127.0.0.1", UDP数据报1.监听端口)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：向自身发送数据；请检查权限、状态和运行日志"
			输出错误("设备测试/UDP数据报：向自身发送数据失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	UDP数据报1.停止监听()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：停止监听；请检查权限、状态和运行日志"
			输出错误("设备测试/UDP数据报：停止监听失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	操作结果标签.文本 = "监听=" & UDP数据报1.正在监听 & "；端口=" & UDP数据报1.监听端口 _
		& 字符(10) & "错误=" & UDP数据报1.错误信息

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取状态；请检查权限、状态和运行日志"
			输出错误("设备测试/UDP数据报：读取状态失败")
	结束 错误
结束 事件

事件 UDP数据报1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 UDP数据报1.启动完毕(参数1 为 逻辑型, 参数2 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("启动完毕：回调=" & 回调次数 & "；启动成功=" & 参数1 & "；监听端口=" & 参数2)
结束 事件

事件 UDP数据报1.收到数据(参数1 为 字节型(), 参数2 为 文本型, 参数3 为 整数型)
	记录事件("收到=" & 字节到文本(参数1) & "；一致=" & (字节到文本(参数1) = "UDP中文42") _
		& 字符(10) & "字节=" & 取数组成员数(参数1) & "；来源=" & 参数2 & ":" & 参数3)
结束 事件

事件 UDP数据报1.发送完毕(参数1 为 整数型, 参数2 为 文本型, 参数3 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("发送完毕：回调=" & 回调次数 & "；字节数=" & 参数1 & 字符(10) & "地址=" & 参数2 & "；端口=" & 参数3)
结束 事件

事件 UDP数据报1.监听停止()
	回调次数 = 回调次数 + 1
	记录事件("监听停止：回调=" & 回调次数)
结束 事件

事件 UDP数据报1.操作失败(参数1 为 文本型, 参数2 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("操作失败：回调=" & 回调次数 & "；操作=" & 参数1 & 字符(10) & "信息=" & 参数2)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("UDP数据报测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 UDP数据报测试 $为 窗口
		标题 = "UDP数据报测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "先启动监听，再向当前设备发送测试数据报。核对接收内容、来源地址和发送字节数；停止后可重新监听。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "启动监听"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "向自身发送数据"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "停止监听"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "读取状态"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 UDP数据报1 $为 UDP数据报
		$结束 $定义
	$结束 $定义
$结束 $属性
