''' 密码编辑框测试窗口。

事件 密码编辑框测试.切换完毕()
	准备测试()
结束 事件

事件 密码编辑框测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 密码编辑框1.获得焦点()
	焦点标签.文本 = "密码框获得焦点"
结束 事件

事件 密码编辑框1.失去焦点()
	焦点标签.文本 = "密码框失去焦点"
结束 事件

事件 提交密码按钮.被单击()
	变量 是否匹配 为 逻辑型
	是否匹配 = 密码编辑框1.文本 = "simple123"
	操作结果标签.文本 = "密码长度=" & 取字符数(密码编辑框1.文本) & "；匹配预设=" & 是否匹配
结束 事件

事件 切换启用按钮.被单击()
	密码编辑框1.启用 = 取反 密码编辑框1.启用
	操作结果标签.文本 = "密码框启用=" & 密码编辑框1.启用 & "；请检查能否输入"
结束 事件

事件 清空密码按钮.被单击()
	密码编辑框1.文本 = ""
	操作结果标签.文本 = "已清空；读回长度=" & 取字符数(密码编辑框1.文本)
结束 事件

事件 设置中文按钮.被单击()
	密码编辑框1.文本 = "中文密码123"
	操作结果标签.文本 = "设定长度=7；读回长度=" & 取字符数(密码编辑框1.文本) & "；请核对遮蔽显示"
结束 事件

''' 保留已输入密码，不在界面回显明文。
过程 准备测试()
	操作结果标签.文本 = "等待提交；仅显示长度和匹配结果"
结束 过程

$属性
	$资源 $窗口
	$定义 密码编辑框测试 $为 窗口
		滚动 = 真
		标题 = "密码编辑框测试"
		$定义 测试说明标签 $为 标签
			文本 = "在第一个框输入 simple123，提交后应显示长度 9、匹配为真；中文测试密码长度为 7。清空、禁用和焦点切换后核对遮蔽及输入状态。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 密码编辑框1 $为 密码编辑框
			宽度 = 长度_匹配父级
			提示 = "输入测试密码"
		$结束 $定义
		$定义 提交密码按钮 $为 按钮
			文本 = "提交密码"
		$结束 $定义
		$定义 补充操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换启用按钮 $为 按钮
				文本 = "启用/禁用"
			$结束 $定义
			$定义 清空密码按钮 $为 按钮
				文本 = "清空密码"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 设置中文按钮 $为 按钮
				文本 = "填入中文密码"
			$结束 $定义
		$结束 $定义
		$定义 焦点标签 $为 标签
			文本 = "焦点事件：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 密码编辑框2 $为 密码编辑框
			文本 = "右对齐"
			内容对齐 = 对齐_右
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 密码编辑框3 $为 密码编辑框
			文本 = "绿色背景"
			背景颜色 = 颜色_绿
		$结束 $定义
		$定义 密码编辑框4 $为 密码编辑框
			文本 = "已禁用"
			启用 = 假
		$结束 $定义
		$定义 密码编辑框5 $为 密码编辑框
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 密码编辑框6 $为 密码编辑框
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 密码编辑框7 $为 密码编辑框
			文本 = "大字号"
			字体大小 = 20
		$结束 $定义
		$定义 密码编辑框8 $为 密码编辑框
			文本 = "等宽字体：wiwiw"
			字体类型 = 字体类型_等宽
		$结束 $定义
		$定义 密码编辑框9 $为 密码编辑框
			文本 = "绿色文字"
			文本颜色 = 颜色_绿
		$结束 $定义
	$结束 $定义
$结束 $属性
