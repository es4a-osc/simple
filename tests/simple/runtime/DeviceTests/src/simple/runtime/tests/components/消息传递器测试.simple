''' 消息传递器测试。
''' 分别发送文本、整数和无载荷消息，核对异步回调标记、载荷及主线程标志。
''' 连续发送两个消息应按实际队列回调，不把发送返回真当作已经收到。

变量 回调次数 为 整数型

事件 消息传递器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	操作结果标签.文本 = "发送返回=" & 消息传递器1.发送消息(1, "message-ok")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：发送文本；请检查权限、状态和运行日志"
			输出错误("设备测试/消息传递器：发送文本失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "发送返回=" & 消息传递器1.发送消息(3, 42)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：发送整数；请检查权限、状态和运行日志"
			输出错误("设备测试/消息传递器：发送整数失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	操作结果标签.文本 = "发送返回=" & 消息传递器1.发送消息(2)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：发送无载荷；请检查权限、状态和运行日志"
			输出错误("设备测试/消息传递器：发送无载荷失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	消息传递器1.发送消息(10, "first")
	消息传递器1.发送消息(11, "second")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：连续发送；请检查权限、状态和运行日志"
			输出错误("设备测试/消息传递器：连续发送失败")
	结束 错误
结束 事件

事件 消息传递器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 消息传递器1.收到消息(参数1 为 整数型, 参数2 为 变体型)
	回调次数 = 回调次数 + 1
	如果 参数1 = 2 则
		记录事件("无载荷回调；标记=" & 参数1 & "；线程标识=" & 取线程标识())
	否则
		记录事件("标记=" & 参数1 & "；载荷=" & 参数2 & 字符(10) & "线程标识=" & 取线程标识() & "；回调=" & 回调次数)
	结束 如果
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("消息传递器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 消息传递器测试 $为 窗口
		标题 = "消息传递器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "发送文本、整数或空消息，核对收到的标记、内容及主线程标志。连续发送时检查回调顺序。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "发送文本"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "发送整数"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "发送无载荷"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "连续发送"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 消息传递器1 $为 消息传递器
		$结束 $定义
	$结束 $定义
$结束 $属性
