''' 资源操作测试。
''' 使用本测试应用的 icon 图片和专用字符串资源，核对名称/类型/路径两种标识与文本。
''' 缺失名称应返回 0，标识 0 的存在查询应为假。

事件 资源操作测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	变量 标识 为 整数型
	标识 = 到资源标识("@drawable/icon")
	操作结果标签.文本 = "路径标识=" & 标识 & "；同名标识=" & 取资源标识("icon", "drawable") _
		& 字符(10) & "存在=" & 资源是否存在(标识) & "；类型=" & 取资源类型(标识) & 字符(10) & "名称=" & 取资源名称(标识)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：核对图标资源；请检查权限、状态和运行日志"
			输出错误("设备测试/资源操作：核对图标资源失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	变量 标识 为 整数型
	标识 = 取资源标识("device_test_text", "string")
	操作结果标签.文本 = "字符串=" & 取资源文本(标识) & "；预期=device-resource-中文42"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取字符串资源；请检查权限、状态和运行日志"
			输出错误("设备测试/资源操作：读取字符串资源失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	操作结果标签.文本 = "缺失标识=" & 取资源标识("device_missing", "string") & "；标识0存在=" & 资源是否存在(0)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：核对缺失资源；请检查权限、状态和运行日志"
			输出错误("设备测试/资源操作：核对缺失资源失败")
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 资源操作测试 $为 窗口
		标题 = "资源操作测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "按名称、类型或路径读取图标及字符串资源。缺失资源标识应为 0，标识 0 不应被报告为存在。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "核对图标资源"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "读取字符串资源"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "核对缺失资源"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
