''' 对话框操作测试。
''' 分别确认、取消和返回关闭系统对话框，核对真实返回值；
''' 进度框由按钮关闭。
''' 日期/时间选择覆盖确认和取消，不自动将取消后的旧值当成新结果。

变量 进度框 为 变体型

事件 对话框操作测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	显示提示框("设备测试Toast")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：显示提示；请检查权限、状态和运行日志"
			输出错误("设备测试/对话框操作：显示提示失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	弹出确认框("设备测试", "确认对话框内容", "知道了")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：确认对话框；请检查权限、状态和运行日志"
			输出错误("设备测试/对话框操作：确认对话框失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	操作结果标签.文本 = "是否返回=" & 弹出是否框("设备测试", "选择是或否")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：是否对话框；请检查权限、状态和运行日志"
			输出错误("设备测试/对话框操作：是否对话框失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	变量 项目 为 文本型(3)
	项目(0) = "甲"
	项目(1) = "乙"
	项目(2) = "丙"
	操作结果标签.文本 = "单选索引=" & 弹出单选框("设备单选", 项目, 1)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：单选对话框；请检查权限、状态和运行日志"
			输出错误("设备测试/对话框操作：单选对话框失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	操作结果标签.文本 = "输入返回=" & 弹出输入框("设备输入", "输入中文", 假)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：输入对话框；请检查权限、状态和运行日志"
			输出错误("设备测试/对话框操作：输入对话框失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	变量 时间 为 日期时间型
	变量 已选择 为 逻辑型
	已选择 = 弹出日期选择框("设备日期", 时间)
	如果 已选择 则
		操作结果标签.文本 = "日期=" & 格式化时间(时间)
	否则
		操作结果标签.文本 = "日期已取消"
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：日期对话框；请检查权限、状态和运行日志"
			输出错误("设备测试/对话框操作：日期对话框失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	变量 时间 为 日期时间型
	变量 已选择 为 逻辑型
	已选择 = 弹出时间选择框("设备时间", 时间)
	如果 已选择 则
		操作结果标签.文本 = "时间=" & 格式化时间(时间)
	否则
		操作结果标签.文本 = "时间已取消"
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：时间对话框；请检查权限、状态和运行日志"
			输出错误("设备测试/对话框操作：时间对话框失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	进度框 = 弹出进度框("设备进度", "测试进度内容")
	置进度框信息(进度框, "已更新")
	关闭进度框(进度框)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：打开并关闭进度框；请检查权限、状态和运行日志"
			输出错误("设备测试/对话框操作：打开并关闭进度框失败")
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 对话框操作测试 $为 窗口
		标题 = "对话框操作测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "逐项打开对话框，测试确认、取消和返回键，核对返回的选择、文字、日期或时间。进度框打开后应能关闭。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "显示提示"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "确认对话框"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "是否对话框"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "单选对话框"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "输入对话框"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "日期对话框"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "时间对话框"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "打开并关闭进度框"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
