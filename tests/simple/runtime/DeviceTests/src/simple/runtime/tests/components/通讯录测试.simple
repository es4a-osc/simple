''' 通讯录测试。
''' 只新增并清理本页创建的设备测试联系人/分组。
''' 异步读取需核对请求标记、集合及错误；
''' 新增后再读确认，删除后再次读确认。
''' 真实联系人不作为删除目标，权限拒绝和空通讯录分别处理。

变量 回调次数 为 整数型
变量 联系人标识 为 文本型
变量 分组标识 为 文本型

事件 通讯录测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	变量 权限 为 文本型(2)
	权限(0) = "android.permission.READ_CONTACTS"
	权限(1) = "android.permission.WRITE_CONTACTS"
	操作结果标签.文本 = "权限请求已提交=" & 权限请求1.请求权限(权限, "通讯录")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求所需权限；请检查权限、状态和运行日志"
			输出错误("设备测试/通讯录：请求所需权限失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	操作结果标签.文本 = "读取受理=" & 通讯录1.异步取联系人("device-contacts")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取联系人；请检查权限、状态和运行日志"
			输出错误("设备测试/通讯录：读取联系人失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	如果 联系人标识 = "" 则
		联系人标识 = 通讯录1.添加联系人("设备测试联系人", "10000000000")
	结束 如果
	操作结果标签.文本 = "本页联系人标识=" & 联系人标识 & 字符(10) & "错误=" & 通讯录1.最近错误

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：创建测试联系人；请检查权限、状态和运行日志"
			输出错误("设备测试/通讯录：创建测试联系人失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	如果 分组标识 = "" 则
		分组标识 = 通讯录1.新建联系人分组("设备测试分组", "", "")
	结束 如果
	操作结果标签.文本 = "分组标识=" & 分组标识

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：创建测试分组；请检查权限、状态和运行日志"
			输出错误("设备测试/通讯录：创建测试分组失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	如果 联系人标识 <> "" 且 分组标识 <> "" 则
		操作结果标签.文本 = "加入=" & 通讯录1.添加分组联系人(分组标识, 联系人标识)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：加入本页分组；请检查权限、状态和运行日志"
			输出错误("设备测试/通讯录：加入本页分组失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	如果 联系人标识 <> "" 且 分组标识 <> "" 则
		操作结果标签.文本 = "移出=" & 通讯录1.移除分组联系人(分组标识, 联系人标识)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：移出本页分组；请检查权限、状态和运行日志"
			输出错误("设备测试/通讯录：移出本页分组失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	如果 联系人标识 <> "" 则
		如果 通讯录1.删除联系人(联系人标识) 则
			联系人标识 = ""
		结束 如果
	结束 如果
	如果 分组标识 <> "" 则
		如果 通讯录1.删除联系人分组(分组标识) 则
			分组标识 = ""
		结束 如果
	结束 如果
	操作结果标签.文本 = "剩余测试联系人=" & 联系人标识 & "；测试分组=" & 分组标识

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：清理本页数据；请检查权限、状态和运行日志"
			输出错误("设备测试/通讯录：清理本页数据失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	操作结果标签.文本 = "读取中=" & 通讯录1.读取中 & 字符(10) & "错误=" & 通讯录1.最近错误

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取状态；请检查权限、状态和运行日志"
			输出错误("设备测试/通讯录：读取状态失败")
	结束 错误
结束 事件

事件 通讯录1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 通讯录1.取联系人完毕(参数1 为 集合, 参数2 为 文本型, 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("取联系人完毕：回调=" & 回调次数 & "；成员数=" & 参数1.计数 & 字符(10) & "请求标记=" & 参数2 & 字符(10) & "错误信息=" & 参数3)
结束 事件

事件 权限请求1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 权限请求1.请求结果(参数1 为 文本型(), 参数2 为 整数型(), 参数3 为 文本型)
	回调次数 = 回调次数 + 1
	记录事件("请求结果：回调=" & 回调次数 & "；权限项数=" & 取数组成员数(参数1) _
		& 字符(10) & "授权结果项数=" & 取数组成员数(参数2) & "；请求标记=" & 参数3)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("通讯录测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 通讯录测试 $为 窗口
		标题 = "通讯录测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "授权后读取联系人，并测试新增、分组和清理。只修改本页创建的测试数据；新增和删除后重新读取核对。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "请求所需权限"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "读取联系人"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "创建测试联系人"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "创建测试分组"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "加入本页分组"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "移出本页分组"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "清理本页数据"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "读取状态"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 通讯录1 $为 通讯录
		$结束 $定义
	$结束 $定义
$结束 $属性
