''' 单选列表框测试。
''' 重置后有 20 项，索引从 0 开始。
''' 检查添加返回值、修改、删除、清空、空列表与重新填充。
''' 手动单击/长按及滚动需触发对应事件；
''' 选择项的索引、文字和选中状态应一致，不以点击成功代替结果。

变量 回调次数 为 整数型
变量 已填充 为 逻辑型

事件 单选列表框测试.切换完毕()
	如果 取反 已填充 则
		填充项目()
		已填充 = 真
	结束 如果
结束 事件

事件 单选列表框测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	填充项目()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：重建 20 项；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：重建 20 项失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	变量 索引 为 整数型
	索引 = 单选列表框1.添加项目("新增项目")
	操作结果标签.文本 = "添加返回=" & 索引 & "；数量=" & 单选列表框1.取项目数()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：添加一项；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：添加一项失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	如果 单选列表框1.取项目数() > 0 则
		单选列表框1.置项目文本(0, "首项已修改")
		操作结果标签.文本 = 单选列表框1.取项目文本(0)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：修改首项；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：修改首项失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	如果 单选列表框1.取项目数() > 0 则
		单选列表框1.删除项目(0)
	结束 如果
	操作结果标签.文本 = "删除后数量=" & 单选列表框1.取项目数()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：删除首项；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：删除首项失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	单选列表框1.清空项目()
	操作结果标签.文本 = "清空列表后数量=" & 单选列表框1.取项目数()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：清空列表；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：清空列表失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	如果 单选列表框1.取项目数() > 1 则
		单选列表框1.选择项目(1)
	结束 如果

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：定位第二项；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：定位第二项失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	单选列表框1.插入项目(0, "插入首项")
	操作结果标签.文本 = "首项=" & 单选列表框1.取项目文本(0)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：在开头插入；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：在开头插入失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	如果 单选列表框1.取项目数() > 0 则
		单选列表框1.置项目选中(0, 取反 单选列表框1.取项目选中(0))
	结束 如果
	操作结果标签.文本 = "首项选中=" & 单选列表框1.取项目选中(0)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换首项选中；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：切换首项选中失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	操作结果标签.文本 = "选中索引=" & 单选列表框1.取选中项目()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取选中项；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：读取选中项失败")
	结束 错误
结束 事件

事件 操作按钮10.被单击()
	单选列表框1.垂直滚动(100)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：向下滚动；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：向下滚动失败")
	结束 错误
结束 事件

事件 操作按钮11.被单击()
	操作结果标签.文本 = "请求焦点=" & 单选列表框1.获取焦点()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：请求焦点；请检查权限、状态和运行日志"
			输出错误("设备测试/单选列表框：请求焦点失败")
	结束 错误
结束 事件

事件 单选列表框1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 单选列表框1.项目被单击(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("项目被单击：回调=" & 回调次数 & "；项目索引=" & 参数1)
结束 事件

事件 单选列表框1.项目被长按(参数1 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("项目被长按：回调=" & 回调次数 & "；项目索引=" & 参数1)
结束 事件

事件 单选列表框1.项目被滚动(参数1 为 整数型, 参数2 为 整数型, 参数3 为 整数型)
	回调次数 = 回调次数 + 1
	记录事件("项目被滚动：回调=" & 回调次数 & "；首个可见项索引=" & 参数1 & 字符(10) & "可见项数=" & 参数2 & "；总项数=" & 参数3)
结束 事件

过程 填充项目()
	单选列表框1.清空项目()
	变量 索引 为 整数型
	循环 索引 = 1 至 20
		单选列表框1.添加项目("项目" & 索引)
	下个
	操作结果标签.文本 = "重置后数量=" & 单选列表框1.取项目数()
结束 过程

过程 记录事件(内容 为 文本型)
	输出信息("单选列表框测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 单选列表框测试 $为 窗口
		标题 = "单选列表框测试"
		$定义 测试说明标签 $为 标签
			文本 = "重置后有 20 项，索引从 0 开始。点击项目核对选中状态、单击、长按及滚动事件；定位只滚动，不改变勾选。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "重建 20 项"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "添加一项"
			$结束 $定义
		$结束 $定义
		$定义 单选列表框1 $为 单选列表框
			宽度 = 长度_匹配父级
			高度 = "420px"
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "修改首项"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "删除首项"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "清空列表"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "定位第二项"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "在开头插入"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "切换首项选中"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "读取选中项"
			$结束 $定义
			$定义 操作按钮10 $为 按钮
				文本 = "向下滚动"
			$结束 $定义
		$结束 $定义
		$定义 操作面板6 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮11 $为 按钮
				文本 = "请求焦点"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
