''' 单帧布局测试。
''' 同一容器内两个按钮叠放，后添加的按钮应在上层。
''' 隐藏上层后点击下层，恢复后继续点击；
''' 核对居中对齐与叠放命中。

事件 单帧布局测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	上层按钮.可视 = 取反 上层按钮.可视
	操作结果标签.文本 = "上层可视=" & 上层按钮.可视

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：隐藏/显示上层；请检查权限、状态和运行日志"
			输出错误("设备测试/单帧布局：隐藏/显示上层失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	上层按钮.对齐 = 对齐_居中
	操作结果标签.文本 = "上层对齐=" & 上层按钮.对齐

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换上层对齐；请检查权限、状态和运行日志"
			输出错误("设备测试/单帧布局：切换上层对齐失败")
	结束 错误
结束 事件

事件 下层按钮.被单击()
	操作结果标签.文本 = "点击下层按钮"
结束 事件

事件 上层按钮.被单击()
	操作结果标签.文本 = "点击上层按钮"
结束 事件

$属性
	$资源 $窗口
	$定义 单帧布局测试 $为 窗口
		标题 = "单帧布局测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "两层控件重叠显示。切换上层可见性和对齐，观察遮挡及点击是否落到正确控件。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "隐藏/显示上层"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "切换上层对齐"
			$结束 $定义
		$结束 $定义
		$定义 布局面板 $为 面板
			布局 = 布局_单帧
			宽度 = 长度_匹配父级
			高度 = "220px"
			背景颜色 = &HFFE0F0FF
			$定义 下层按钮 $为 按钮
				文本 = "下层按钮"
				宽度 = "240px"
				高度 = "160px"
			$结束 $定义
			$定义 上层按钮 $为 按钮
				文本 = "上层按钮"
				宽度 = "160px"
				高度 = "100px"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
