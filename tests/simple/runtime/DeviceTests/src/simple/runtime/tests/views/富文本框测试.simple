''' 富文本框测试。
''' 重置后对同一段文字设置前景、背景、字体、线条、上下标、链接、图片及项目符。
''' 检查视觉样式、选区读回和链接回调；
''' 清除格式不应删除文字。
''' 范围越界需报告错误，之后仍能恢复。

变量 回调次数 为 整数型

事件 富文本框测试.切换完毕()
	如果 富文本框1.文本 = "" 则
		富文本框1.创建风格文本("Simple 中文文字 123456")
	结束 如果
结束 事件

事件 富文本框测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	富文本框1.创建风格文本("Simple 中文文字 123456")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：重置文字；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：重置文字失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	富文本框1.追加风格文本(" 追加文本")

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：追加文字；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：追加文字失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	富文本框1.置风格文本前景色(颜色_红, 0, 6)
	富文本框1.置风格文本背景色(颜色_黄, 7, 11)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：前景/背景；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：前景/背景失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	富文本框1.置风格文本字体大小(24, 0, 6)
	富文本框1.置风格文本字体样式(富文本框.字体样式_粗体, 7, 11)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：字号/粗体；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：字号/粗体失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	富文本框1.置风格文本下划线(0, 6)
	富文本框1.置风格文本删除线(7, 11)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：下划线/删除线；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：下划线/删除线失败")
	结束 错误
结束 事件

事件 操作按钮6.被单击()
	富文本框1.置风格文本上标(12, 14)
	富文本框1.置风格文本下标(14, 16)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：上标/下标；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：上标/下标失败")
	结束 错误
结束 事件

事件 操作按钮7.被单击()
	富文本框1.链接可点击 = 真
	富文本框1.置风格文本超链接("https://example.invalid/device-test", 0, 6)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：设置链接；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：设置链接失败")
	结束 错误
结束 事件

事件 操作按钮8.被单击()
	富文本框1.链接可点击 = 取反 富文本框1.链接可点击

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换链接点击；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：切换链接点击失败")
	结束 错误
结束 事件

事件 操作按钮9.被单击()
	富文本框1.置风格文本图片("simple.png", 0, 1)
	富文本框1.置风格文本图片("simple.png", 32, 24, 1, 2)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：图片两种尺寸；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：图片两种尺寸失败")
	结束 错误
结束 事件

事件 操作按钮10.被单击()
	富文本框1.置风格文本项目符(颜色_蓝, 0, 6)

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：设置项目符；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：设置项目符失败")
	结束 错误
结束 事件

事件 操作按钮11.被单击()
	富文本框1.选中文本(0, 6)
	操作结果标签.文本 = "选区=" & 富文本框1.选区开始 & ".." & 富文本框1.选区结束 _
		& 字符(10) & "内容=" & 富文本框1.取选中文本()

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取选区；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：读取选区失败")
	结束 错误
结束 事件

事件 操作按钮12.被单击()
	富文本框1.清除文本格式(0, 取字符数(富文本框1.文本))
	操作结果标签.文本 = "保留文字=" & 富文本框1.文本

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：清除全部格式；请检查权限、状态和运行日志"
			输出错误("设备测试/富文本框：清除全部格式失败")
	结束 错误
结束 事件

事件 富文本框1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 富文本框1.获得焦点()
	回调次数 = 回调次数 + 1
	记录事件("获得焦点：回调=" & 回调次数)
结束 事件

事件 富文本框1.失去焦点()
	回调次数 = 回调次数 + 1
	记录事件("失去焦点：回调=" & 回调次数)
结束 事件

事件 富文本框1.文本改变(参数1 为 文本型, 传址 参数2 为 逻辑型)
	回调次数 = 回调次数 + 1
	记录事件("文本改变：回调=" & 回调次数 & "；文本=" & 参数1 & "；接受输入=" & 参数2)
结束 事件

事件 富文本框1.超链接被单击(参数1 为 文本型)
	记录事件("链接回调=" & 参数1)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("富文本框测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 富文本框测试 $为 窗口
		标题 = "富文本框测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "在同一段文字上切换颜色、字体、线条、上下标、链接、图片和项目符。核对选区及链接事件；清除格式保留文字。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "重置文字"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "追加文字"
			$结束 $定义
		$结束 $定义
		$定义 富文本框1 $为 富文本框
			宽度 = 长度_匹配父级
			高度 = "200px"
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "前景/背景"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "字号/粗体"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "下划线/删除线"
			$结束 $定义
			$定义 操作按钮6 $为 按钮
				文本 = "上标/下标"
			$结束 $定义
		$结束 $定义
		$定义 操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮7 $为 按钮
				文本 = "设置链接"
			$结束 $定义
			$定义 操作按钮8 $为 按钮
				文本 = "切换链接点击"
			$结束 $定义
		$结束 $定义
		$定义 操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮9 $为 按钮
				文本 = "图片两种尺寸"
			$结束 $定义
			$定义 操作按钮10 $为 按钮
				文本 = "设置项目符"
			$结束 $定义
		$结束 $定义
		$定义 操作面板6 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮11 $为 按钮
				文本 = "读取选区"
			$结束 $定义
			$定义 操作按钮12 $为 按钮
				文本 = "清除全部格式"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
