''' 标签测试窗口。

变量 单击次数 为 整数型
变量 长按次数 为 整数型
变量 按下次数 为 整数型
变量 弹起次数 为 整数型
变量 移动次数 为 整数型
变量 手势次数 为 整数型
变量 字号设定 为 单精度小数型
变量 图标方向 为 整数型
变量 彩色模式 为 逻辑型

事件 标签测试.切换完毕()
	如果 字号设定 = 0 则
		字号设定 = 字体_默认_大小
	结束 如果
	读取当前属性()
结束 事件

事件 标签测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 切换文字按钮.被单击()
	如果 标签1.文本 = "右对齐" 则
		标签1.文本 = "动态文字"
	否则
		标签1.文本 = "右对齐"
	结束 如果
	操作结果标签.文本 = "读回文字：" & 标签1.文本
结束 事件

事件 读取属性按钮.被单击()
	读取当前属性()
结束 事件

事件 标签1.被单击()
	单击次数 = 单击次数 + 1
	刷新事件计数()
结束 事件

事件 标签1.被长按()
	长按次数 = 长按次数 + 1
	刷新事件计数()
结束 事件

事件 标签1.被按下(横坐标 为 整数型, 纵坐标 为 整数型)
	按下次数 = 按下次数 + 1
	触摸标签.文本 = "按下：" & 横坐标 & ", " & 纵坐标
	刷新事件计数()
结束 事件

事件 标签1.被弹起(横坐标 为 整数型, 纵坐标 为 整数型)
	弹起次数 = 弹起次数 + 1
	触摸标签.文本 = "弹起：" & 横坐标 & ", " & 纵坐标
	刷新事件计数()
结束 事件

事件 标签1.触摸移动(上次横坐标 为 整数型, 上次纵坐标 为 整数型, 横坐标 为 整数型, 纵坐标 为 整数型)
	移动次数 = 移动次数 + 1
	触摸标签.文本 = "移动：" & 上次横坐标 & ", " & 上次纵坐标 & " → " & 横坐标 & ", " & 纵坐标
	刷新事件计数()
结束 事件

事件 标签1.触摸手势(方向 为 整数型)
	手势次数 = 手势次数 + 1
	触摸标签.文本 = "触摸手势：" & 方向
	刷新事件计数()
结束 事件

事件 切换粗体按钮.被单击()
	标签1.字体加粗 = 取反 标签1.字体加粗
	读取当前属性()
结束 事件

事件 切换斜体按钮.被单击()
	标签1.字体倾斜 = 取反 标签1.字体倾斜
	读取当前属性()
结束 事件

事件 切换可见按钮.被单击()
	标签1.可视 = 取反 标签1.可视
	读取当前属性()
结束 事件

事件 切换字号按钮.被单击()
	如果 字号设定 = 字体_默认_大小 则
		字号设定 = 20
	否则
		字号设定 = 字体_默认_大小
	结束 如果
	标签1.字体大小 = 字号设定
	读取当前属性()
结束 事件

事件 切换字体按钮.被单击()
	标签1.字体类型 = (标签1.字体类型 + 1) % 4
	读取当前属性()
结束 事件

事件 切换对齐按钮.被单击()
	标签1.内容对齐 = (标签1.内容对齐 + 1) % 3
	读取当前属性()
结束 事件

事件 切换颜色按钮.被单击()
	彩色模式 = 取反 彩色模式
	如果 彩色模式 则
		标签1.文本颜色 = 颜色_蓝
		标签1.背景颜色 = 颜色_黄
	否则
		标签1.文本颜色 = 颜色_黑
		标签1.背景颜色 = 颜色_白
	结束 如果
	读取当前属性()
结束 事件

事件 切换单行按钮.被单击()
	标签1.文本 = "第一行 Simple" & 字符(10) & "第二行：中文与 English"
	标签1.单行模式 = 取反 标签1.单行模式
	读取当前属性()
结束 事件

事件 空文本按钮.被单击()
	如果 标签1.文本 = "" 则
		标签1.文本 = "中文 English 123"
	否则
		标签1.文本 = ""
	结束 如果
	读取当前属性()
结束 事件

事件 切换图标按钮.被单击()
	标签1.置图标填充(8)
	判断 图标方向
		分支 0
			标签1.置左边图标("simple.png", 24)
		分支 1
			标签1.置顶边图标("simple.png", 36, 24)
		分支 2
			标签1.置右边图标("simple.png", 24)
		分支 3
			标签1.置底边图标("simple.png", 36, 24)
	结束 判断
	操作结果标签.文本 = "已设置图标方向=" & 图标方向 & "（左、上、右、下），请检查位置、尺寸和间距"
	图标方向 = (图标方向 + 1) % 4
结束 事件

''' 显示控件实际触发的事件次数；触摸参数单独显示，避免覆盖属性读回结果。
过程 刷新事件计数()
	事件标签.文本 = "单击=" & 单击次数 & "；长按=" & 长按次数 & 字符(10) & "按下=" & 按下次数 & "；弹起=" & 弹起次数 _
		& 字符(10) & "移动=" & 移动次数 & "；手势=" & 手势次数
结束 过程

''' 同时显示设置目标、属性读回和可视状态；外观效果需要在设备上核对。
过程 读取当前属性()
	属性标签.文本 = "文字长度=" & 取字符数(标签1.文本) & "；可视=" & 标签1.可视 _
		& 字符(10) & "单行=" & 标签1.单行模式 & 字符(10) & "切换粗体=" & 标签1.字体加粗 & "；切换斜体=" & 标签1.字体倾斜 _
		& 字符(10) & "字体=" & 标签1.字体类型 & "；对齐=" & 标签1.内容对齐 & 字符(10) & "字号设定=" & 字号设定 _
		& 字符(10) & "字号读回=" & 标签1.字体大小 & "；文字颜色=" & 标签1.文本颜色 & 字符(10) & "背景=" & 标签1.背景颜色
	操作结果标签.文本 = "读回文字：" & 标签1.文本
结束 过程

$属性
	$资源 $窗口
	$定义 标签测试 $为 窗口
		滚动 = 真
		标题 = "标签测试"
		$定义 测试说明标签 $为 标签
			文本 = "第一个标签用于属性切换及单击、长按、拖动和手势测试。核对外观、读回值和事件计数；空文字或隐藏后可恢复。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 标签操作面板 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换文字按钮 $为 按钮
				文本 = "切换文字"
			$结束 $定义
			$定义 读取属性按钮 $为 按钮
				文本 = "读取属性"
			$结束 $定义
		$结束 $定义
		$定义 标签1 $为 标签
			文本 = "右对齐"
			内容对齐 = 对齐_右
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 补充操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换粗体按钮 $为 按钮
				文本 = "切换粗体"
			$结束 $定义
			$定义 切换斜体按钮 $为 按钮
				文本 = "切换斜体"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换字号按钮 $为 按钮
				文本 = "切换字号"
			$结束 $定义
			$定义 切换字体按钮 $为 按钮
				文本 = "切换字体"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换对齐按钮 $为 按钮
				文本 = "切换对齐"
			$结束 $定义
			$定义 切换颜色按钮 $为 按钮
				文本 = "切换颜色"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板4 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换单行按钮 $为 按钮
				文本 = "单行/多行"
			$结束 $定义
			$定义 切换图标按钮 $为 按钮
				文本 = "切换四边图标"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板5 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 空文本按钮 $为 按钮
				文本 = "清空/恢复文字"
			$结束 $定义
			$定义 切换可见按钮 $为 按钮
				文本 = "隐藏/显示"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 属性标签 $为 标签
			文本 = "属性读回：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "事件次数：单击=0；长按=0；按下=0；弹起=0；移动=0；手势=0"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 触摸标签 $为 标签
			文本 = "触摸参数：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 标签2 $为 标签
			文本 = "绿色背景"
			背景颜色 = 颜色_绿
		$结束 $定义
		$定义 标签3 $为 标签
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 标签4 $为 标签
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 标签5 $为 标签
			文本 = "大字号"
			字体大小 = 20
		$结束 $定义
		$定义 标签6 $为 标签
			文本 = "等宽字体：wiwiw"
			字体类型 = 字体类型_等宽
		$结束 $定义
		$定义 标签7 $为 标签
			文本 = "绿色文字"
			文本颜色 = 颜色_绿
		$结束 $定义
	$结束 $定义
$结束 $属性
