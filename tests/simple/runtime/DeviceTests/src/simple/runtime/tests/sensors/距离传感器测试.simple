''' 距离传感器测试。
''' 启动后用物体靠近/离开传感器，核对距离、阈值与三个事件。
''' 首个零读数也应可观察。
''' 切换阈值、检测间隔，停止后不应继续回调；
''' 无硬件时不能把 0 当作有效距离。

变量 回调次数 为 整数型

事件 距离传感器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 距离传感器测试.即将切换()
	距离传感器1.可用 = 假
结束 事件

事件 距离传感器测试.程序被停止()
	距离传感器1.可用 = 假
结束 事件

事件 操作按钮1.被单击()
	距离传感器1.可用 = 真
	操作结果标签.文本 = "监听=" & 距离传感器1.可用

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：启动监听；请检查权限、状态和运行日志"
			输出错误("设备测试/距离传感器：启动监听失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	距离传感器1.可用 = 假
	操作结果标签.文本 = "监听=" & 距离传感器1.可用 & "；回调=" & 回调次数

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：停止监听；请检查权限、状态和运行日志"
			输出错误("设备测试/距离传感器：停止监听失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	距离传感器1.最小距离 = 4 - 距离传感器1.最小距离
	操作结果标签.文本 = "最小距离=" & 距离传感器1.最小距离

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换距离阈值；请检查权限、状态和运行日志"
			输出错误("设备测试/距离传感器：切换距离阈值失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	距离传感器1.检测间隔 = 200000
	操作结果标签.文本 = "切换检测间隔=" & 距离传感器1.检测间隔

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换检测间隔；请检查权限、状态和运行日志"
			输出错误("设备测试/距离传感器：切换检测间隔失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	操作结果标签.文本 = "监听=" & 距离传感器1.可用 & "；距离=" & 距离传感器1.距离 & "；回调=" & 回调次数

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取距离；请检查权限、状态和运行日志"
			输出错误("设备测试/距离传感器：读取距离失败")
	结束 错误
结束 事件

事件 距离传感器1.初始化()
	回调次数 = 回调次数 + 1
	记录事件("初始化：回调=" & 回调次数)
结束 事件

事件 距离传感器1.距离改变(参数1 为 单精度小数型)
	回调次数 = 回调次数 + 1
	记录事件("距离改变：回调=" & 回调次数 & "；距离=" & 参数1)
结束 事件

事件 距离传感器1.物体靠近()
	回调次数 = 回调次数 + 1
	记录事件("物体靠近：回调=" & 回调次数)
结束 事件

事件 距离传感器1.物体离开()
	回调次数 = 回调次数 + 1
	记录事件("物体离开：回调=" & 回调次数)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("距离传感器测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 距离传感器测试 $为 窗口
		标题 = "距离传感器测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "启动后靠近、远离传感器，核对距离及阈值事件。切换阈值和检测间隔，再停止监听；需要距离传感器。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "启动监听"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "停止监听"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "切换距离阈值"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "切换检测间隔"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "读取距离"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 距离传感器1 $为 距离传感器
			可用 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
