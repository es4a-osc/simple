''' 计时器测试窗口。

变量 剩余次数 为 整数型
变量 计时次数 为 整数型
变量 停止时次数 为 整数型
变量 已停止计时 为 逻辑型

事件 计时器测试.切换完毕()
	准备测试()
结束 事件

事件 计时器测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 计时器测试.即将切换()
	停止测试()
结束 事件

事件 计时器测试.程序被停止()
	停止测试()
结束 事件

事件 倒计时按钮.被单击()
	计时器1.启用 = 假
	已停止计时 = 假
	剩余次数 = 5
	计时次数 = 0
	状态标签.文本 = "开始计时，剩余事件=5；间隔=" & 计时器1.间隔
	计时器1.启用 = 真
	准备测试()
结束 事件

事件 取消计时按钮.被单击()
	停止测试()
	准备测试()
结束 事件

事件 读取计时按钮.被单击()
	准备测试()
结束 事件

事件 计时器1.计时()
	计时次数 = 计时次数 + 1
	剩余次数 = 剩余次数 - 1

	如果 剩余次数 <= 0 则
		计时器1.启用 = 假
		停止时次数 = 计时次数
		已停止计时 = 真
		状态标签.文本 = "计时完成：事件=" & 计时次数 & "；已停止=" & 取反 计时器1.启用
	否则
		状态标签.文本 = "剩余事件=" & 剩余次数
	结束 如果
	准备测试()
结束 事件

事件 切换间隔按钮.被单击()
	如果 计时器1.间隔 = 1000 则
		计时器1.间隔 = 500
	否则
		计时器1.间隔 = 1000
	结束 如果
	准备测试()
结束 事件

事件 停止核对按钮.被单击()
	如果 计时器1.启用 则
		状态标签.文本 = "计时器仍在运行，请先停止再核对"
	否则如果 取反 已停止计时 则
		状态标签.文本 = "请先运行计时器再停止，等待超过一个间隔后核对"
	否则
		状态标签.文本 = "停止时事件=" & 停止时次数 & "；当前事件=" & 计时次数 _
			& "；停止后未增加=" & (停止时次数 = 计时次数)
	结束 如果
结束 事件

''' 显示保留的计数和真实启用状态。
过程 准备测试()
	操作结果标签.文本 = "启用=" & 计时器1.启用 & "；间隔=" & 计时器1.间隔 & "；事件=" & 计时次数
结束 过程

''' 离页与进入后台时取消计时，不把中断视为完成。
过程 停止测试()
	如果 计时器1.启用 则
		计时器1.启用 = 假
		停止时次数 = 计时次数
		已停止计时 = 真
		状态标签.文本 = "已停止，剩余=" & 剩余次数 & "；事件=" & 计时次数
	结束 如果
结束 过程

$属性
	$资源 $窗口
	$定义 计时器测试 $为 窗口
		滚动 = 真
		标题 = "计时器测试"
		$定义 测试说明标签 $为 标签
			文本 = "开始后计时 5 次，可切换 500/1000ms 间隔。取消、离页或进入后台后等待，再核对停止后的次数。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 计时操作面板 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 取消计时按钮 $为 按钮
				文本 = "取消计时"
			$结束 $定义
			$定义 读取计时按钮 $为 按钮
				文本 = "读取计时状态"
			$结束 $定义
		$结束 $定义
		$定义 补充操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 切换间隔按钮 $为 按钮
				文本 = "切换计时间隔"
			$结束 $定义
			$定义 停止核对按钮 $为 按钮
				文本 = "核对停止后计数"
			$结束 $定义
		$结束 $定义
		$定义 倒计时按钮 $为 按钮
			文本 = "开始 5 次计时"
		$结束 $定义
		$定义 计时器1 $为 计时器
			启用 = 假
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 状态标签 $为 标签
			文本 = "计时器已停止"
		$结束 $定义
	$结束 $定义
$结束 $属性
