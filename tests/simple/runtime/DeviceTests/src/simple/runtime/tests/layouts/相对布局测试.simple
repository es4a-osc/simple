''' 相对布局测试。
''' 锚点标识为 101，第二按钮初始位于锚点右侧。
''' 切换到下方或父容器居中，核对属性与实际位置；
''' 恢复到右侧后点击事件仍应对应各自按钮。

事件 相对布局测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	子项2.居中于父 = 假
	子项2.删除规则(布局_规则_右)
	子项2.位于底边 = 子项1.标识
	操作结果标签.文本 = "下方锚点=" & 子项2.位于底边

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：放到锚点下方；请检查权限、状态和运行日志"
			输出错误("设备测试/相对布局：放到锚点下方失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	子项2.居中于父 = 假
	子项2.删除规则(布局_规则_底)
	子项2.位于右边 = 子项1.标识
	操作结果标签.文本 = "右侧锚点=" & 子项2.位于右边

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：恢复锚点右侧；请检查权限、状态和运行日志"
			输出错误("设备测试/相对布局：恢复锚点右侧失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	子项2.删除规则(布局_规则_右)
	子项2.删除规则(布局_规则_底)
	子项2.居中于父 = 真
	操作结果标签.文本 = "居中于父=" & 子项2.居中于父

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：父容器居中；请检查权限、状态和运行日志"
			输出错误("设备测试/相对布局：父容器居中失败")
	结束 错误
结束 事件

事件 子项1.被单击()
	操作结果标签.文本 = "锚点被单击"
结束 事件

事件 子项2.被单击()
	操作结果标签.文本 = "相对按钮被单击"
结束 事件

$属性
	$资源 $窗口
	$定义 相对布局测试 $为 窗口
		标题 = "相对布局测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "移动按钮到锚点下方、右侧或父容器中央，观察相对位置并读回布局属性。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "放到锚点下方"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "恢复锚点右侧"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "父容器居中"
			$结束 $定义
		$结束 $定义
		$定义 布局面板 $为 面板
			布局 = 布局_相对
			宽度 = 长度_匹配父级
			高度 = "260px"
			背景颜色 = &HFFE0F0FF
			$定义 子项1 $为 按钮
				文本 = "锚点101"
				标识 = 101
				宽度 = "160px"
				高度 = "80px"
			$结束 $定义
			$定义 子项2 $为 按钮
				文本 = "相对按钮"
				宽度 = "160px"
				高度 = "80px"
				位于右边 = 101
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
