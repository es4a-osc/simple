''' 线性布局测试。
''' 切换水平/垂直方向、对齐、基线和权重。
''' 核对三个按钮的实际排布、尺寸及点击事件；
''' 改变布局后仍可操作。

变量 布局实例 为 线性布局
变量 子项次数 为 整数型

事件 线性布局测试.切换完毕()
	布局实例 = 布局面板.布局
结束 事件

事件 线性布局测试.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件

事件 操作按钮1.被单击()
	布局实例.方向 = 1 - 布局实例.方向
	操作结果标签.文本 = "方向=" & 布局实例.方向

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换方向；请检查权限、状态和运行日志"
			输出错误("设备测试/线性布局：切换方向失败")
	结束 错误
结束 事件

事件 操作按钮2.被单击()
	布局实例.内容对齐 = (布局实例.内容对齐 + 1) % 3
	操作结果标签.文本 = "内容对齐=" & 布局实例.内容对齐

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换对齐；请检查权限、状态和运行日志"
			输出错误("设备测试/线性布局：切换对齐失败")
	结束 错误
结束 事件

事件 操作按钮3.被单击()
	布局实例.基线对齐 = 取反 布局实例.基线对齐
	操作结果标签.文本 = "基线对齐=" & 布局实例.基线对齐

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：切换基线；请检查权限、状态和运行日志"
			输出错误("设备测试/线性布局：切换基线失败")
	结束 错误
结束 事件

事件 操作按钮4.被单击()
	布局实例.方向 = 布局_方向_水平
	布局实例.权重总和 = 3
	子项1.宽度 = 0
	子项2.宽度 = 0
	子项1.权重 = 1
	子项2.权重 = 2
	操作结果标签.文本 = "权重总和=" & 布局实例.权重总和 & "；布局后读回尺寸"

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：设置权重 1:2；请检查权限、状态和运行日志"
			输出错误("设备测试/线性布局：设置权重 1:2失败")
	结束 错误
结束 事件

事件 操作按钮5.被单击()
	操作结果标签.文本 = "宽度=" & 子项1.宽度 & ", " & 子项2.宽度 & "；权重=" & 子项1.权重 & ":" & 子项2.权重

	位于 错误
		分支 否则
			操作结果标签.文本 = "操作失败：读取子项；请检查权限、状态和运行日志"
			输出错误("设备测试/线性布局：读取子项失败")
	结束 错误
结束 事件

事件 子项1.被单击()
	子项次数 = 子项次数 + 1
	记录事件("子项1单击=" & 子项次数)
结束 事件

过程 记录事件(内容 为 文本型)
	输出信息("线性布局测试：" & 内容)
	事件标签.文本 = 内容
结束 过程

$属性
	$资源 $窗口
	$定义 线性布局测试 $为 窗口
		标题 = "线性布局测试"
		滚动 = 真
		$定义 测试说明标签 $为 标签
			文本 = "切换排列方向、对齐和基线，设置 1:2 权重后观察子项尺寸，再读取布局属性。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作面板1 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮1 $为 按钮
				文本 = "切换方向"
			$结束 $定义
			$定义 操作按钮2 $为 按钮
				文本 = "切换对齐"
			$结束 $定义
		$结束 $定义
		$定义 操作面板2 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮3 $为 按钮
				文本 = "切换基线"
			$结束 $定义
			$定义 操作按钮4 $为 按钮
				文本 = "设置权重 1:2"
			$结束 $定义
		$结束 $定义
		$定义 操作面板3 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 操作按钮5 $为 按钮
				文本 = "读取子项"
			$结束 $定义
		$结束 $定义
		$定义 布局面板 $为 面板
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			高度 = "180px"
			背景颜色 = &HFFE0F0FF
			$定义 子项1 $为 按钮
				文本 = "子项1"
			$结束 $定义
			$定义 子项2 $为 按钮
				文本 = "子项2"
			$结束 $定义
			$定义 子项3 $为 按钮
				文本 = "子项3"
			$结束 $定义
		$结束 $定义
		$定义 操作结果标签 $为 标签
			文本 = "操作结果：等待操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 事件标签 $为 标签
			文本 = "最近事件：等待回调"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
