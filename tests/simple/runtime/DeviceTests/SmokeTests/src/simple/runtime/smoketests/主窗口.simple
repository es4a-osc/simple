静态 变量 成_主窗口 为 窗口
变量 成_按下时间 为 长整数型
变量 成_窗口列表 为 哈希表

事件 主窗口.加载()

结束 事件

事件 主窗口.初始化()
	成_主窗口 = 本对象
	成_窗口列表 = 创建 哈希表
	
	' 组件
	变量 局_分组标识 为 整数型
	局_分组标识 = 分组列表框1.添加分组("组件")
	分组列表框1.添加子项(局_分组标识, "计时器")
	分组列表框1.添加子项(局_分组标识, "音频播放器")
	分组列表框1.添加子项(局_分组标识, "消息传递器")
	分组列表框1.添加子项(局_分组标识, "弹出菜单")

	' 布局
	局_分组标识 = 分组列表框1.添加分组("布局")
	分组列表框1.添加子项(局_分组标识, "线性布局")
	分组列表框1.添加子项(局_分组标识, "表格布局")
	分组列表框1.添加子项(局_分组标识, "单帧布局")
	分组列表框1.添加子项(局_分组标识, "相对布局")
	分组列表框1.添加子项(局_分组标识, "绝对布局")
	分组列表框1.添加子项(局_分组标识, "局部布局")
	分组列表框1.添加子项(局_分组标识, "布局对照")

	' 容器组件
	局_分组标识 = 分组列表框1.添加分组("容器组件")
	分组列表框1.添加子项(局_分组标识, "面板")
	分组列表框1.添加子项(局_分组标识, "水平滚动框")
	分组列表框1.添加子项(局_分组标识, "垂直滚动框")

	' 可视组件
	局_分组标识 = 分组列表框1.添加分组("可视组件")
	' 文本组件
	分组列表框1.添加子项(局_分组标识, "标签")
	分组列表框1.添加子项(局_分组标识, "按钮")
	分组列表框1.添加子项(局_分组标识, "单选框")
	分组列表框1.添加子项(局_分组标识, "复选框")
	分组列表框1.添加子项(局_分组标识, "编辑框")
	分组列表框1.添加子项(局_分组标识, "密码编辑框")
	' 图片组件
	分组列表框1.添加子项(局_分组标识, "图片框")
	' 进度组件
	分组列表框1.添加子项(局_分组标识, "进度圈")
	分组列表框1.添加子项(局_分组标识, "水平进度条")
	分组列表框1.添加子项(局_分组标识, "水平滑块条")
	分组列表框1.添加子项(局_分组标识, "垂直滑块条")
	' 其它组件
	分组列表框1.添加子项(局_分组标识, "列表框")
	分组列表框1.添加子项(局_分组标识, "单选列表框")
	分组列表框1.添加子项(局_分组标识, "多选列表框")
	分组列表框1.添加子项(局_分组标识, "下拉列表框")
	' 其它组件
	分组列表框1.添加子项(局_分组标识, "画板")
	分组列表框1.添加子项(局_分组标识, "网页浏览框")
	分组列表框1.添加子项(局_分组标识, "自定义组件")

	' 对象
	局_分组标识 = 分组列表框1.添加分组("对象")
	分组列表框1.添加子项(局_分组标识, "JSON操作")
	分组列表框1.添加子项(局_分组标识, "HTTP请求")
	分组列表框1.添加子项(局_分组标识, "多线程")
	分组列表框1.添加子项(局_分组标识, "后台服务")

	' 功能
	局_分组标识 = 分组列表框1.添加分组("功能")
	分组列表框1.添加子项(局_分组标识, "程序")
	分组列表框1.添加子项(局_分组标识, "RES资源")
	分组列表框1.添加子项(局_分组标识, "对话框")
	分组列表框1.添加子项(局_分组标识, "广播")

	' 其它
	局_分组标识 = 分组列表框1.添加分组("其它")
	分组列表框1.添加子项(局_分组标识, "重载")
	分组列表框1.添加子项(局_分组标识, "跨空间")
	分组列表框1.添加子项(局_分组标识, "其它")
结束 事件

事件 主窗口.切换完毕()
	' 列表框需要焦点，否则无法响应事件
	分组列表框1.获取焦点()
结束 事件

事件 主窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	判断 按键代码
		分支 键码_返回
			如果 取现行时间戳() - 成_按下时间 > 2000 则
				成_按下时间 = 取现行时间戳()
				显示提示框("再按一次退出...")
			否则
				终止()
			结束 如果
	结束 判断
结束 事件

事件 分组列表框1.子项被单击(groupid 为 整数型, childid 为 整数型)
	' 子项标题
	变量 局_子项标题 为 文本型
	局_子项标题 = 分组列表框1.取子项标题(groupid, childid)

	' 取对应窗口
	变量 局_切换窗口 为 变体型
	如果 成_窗口列表.是否包含键(局_子项标题) 则
		' 注意哈希表返回空，可以通过“类型检验 局_切换窗口 是 窗口”来判断是否是窗口对象
		局_切换窗口 = 成_窗口列表.取值(局_子项标题)
	否则
		' 实例化窗口
		判断 局_子项标题
			' 组件
			分支 "计时器"
				局_切换窗口 = 创建 simple.runtime.smoketests.components.测试计时器
			分支 "音频播放器"
				局_切换窗口 = 创建 simple.runtime.smoketests.components.测试音频播放器
			分支 "消息传递器"
				局_切换窗口 = 创建 simple.runtime.smoketests.components.测试消息传递器
			'分支 "弹出菜单"
			'	局_切换窗口 = 创建 测试弹出菜单


			' 布局
			分支 "线性布局"
				局_切换窗口 = 创建 simple.runtime.smoketests.layouts.测试线性布局
			分支 "表格布局"
				局_切换窗口 = 创建 simple.runtime.smoketests.layouts.测试表格布局
			分支 "单帧布局"
				局_切换窗口 = 创建 simple.runtime.smoketests.layouts.测试单帧布局
			分支 "相对布局"
				局_切换窗口 = 创建 simple.runtime.smoketests.layouts.测试相对布局
			分支 "绝对布局"
				局_切换窗口 = 创建 simple.runtime.smoketests.layouts.测试绝对布局
			分支 "局部布局"
				局_切换窗口 = 创建 simple.runtime.smoketests.layouts.测试局部布局
			分支 "布局对照"
				局_切换窗口 = 创建 simple.runtime.smoketests.layouts.布局对照

			' 容器组件
			分支 "面板"
				局_切换窗口 = 创建 simple.runtime.smoketests.containers.测试面板
			分支 "水平滚动框"
				局_切换窗口 = 创建 simple.runtime.smoketests.containers.测试水平滚动框
			分支 "垂直滚动框"
				局_切换窗口 = 创建 simple.runtime.smoketests.containers.测试垂直滚动框

			' 可视组件
			' 文本组件
			分支 "标签"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试标签
			分支 "按钮"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试按钮
			分支 "单选框"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试单选框
			分支 "复选框"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试复选框
			分支 "编辑框"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试编辑框
			分支 "密码编辑框"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试密码编辑框
			' 图片组件
			分支 "图片框"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试图片框
			' 进度组件
			分支 "进度圈"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试进度圈
			分支 "水平进度条"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试水平进度条
			分支 "水平滑块条"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试水平滑块条
			分支 "垂直滑块条"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试垂直滑块条
			' 列表组件
			分支 "列表框"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试列表框
			分支 "单选列表框"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试单选列表框
			分支 "多选列表框"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试多选列表框
			分支 "下拉列表框"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试下拉列表框
			' 其它组件
			分支 "画板"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试画板
			分支 "网页浏览框"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试网页浏览框
			分支 "自定义组件"
				局_切换窗口 = 创建 simple.runtime.smoketests.visuals.测试自定义组件


			' 对象
			分支 "JSON操作"
				局_切换窗口 = 创建 simple.runtime.smoketests.objects.测试JSON操作
			分支 "HTTP请求"
				局_切换窗口 = 创建 simple.runtime.smoketests.objects.测试HTTP请求
			分支 "多线程"
				局_切换窗口 = 创建 simple.runtime.smoketests.objects.测试线程
			分支 "后台服务"
				局_切换窗口 = 创建 simple.runtime.smoketests.objects.测试服务


			' 功能
			分支 "程序"
				局_切换窗口 = 创建 simple.runtime.smoketests.functions.测试程序
			分支 "对话框"
				局_切换窗口 = 创建 simple.runtime.smoketests.functions.测试对话框
			分支 "RES资源"
				局_切换窗口 = 创建  simple.runtime.smoketests.functions.测试RES资源
			分支 "广播"
				局_切换窗口 = 创建 simple.runtime.smoketests.functions.测试广播

			
			' 其它
			分支 "重载"
				局_切换窗口 = 创建 simple.runtime.smoketests.others.测试重载
			分支 "跨空间"
				局_切换窗口 = 创建 simple.test.跨空间窗口
			分支 "其它"
				局_切换窗口 = 创建 simple.runtime.smoketests.others.测试其它
		结束 判断

		如果 局_切换窗口 = 空 则
			显示提示框(局_子项标题 & "，该项尚未注册！")
			退出 事件
		结束 如果

		' 记录实例化的窗口
		成_窗口列表.加入(局_子项标题, 局_切换窗口)
	结束 如果

	' 切换到目标窗口
	切换窗口(局_切换窗口)
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "冒烟测试"
		$定义 分组列表框1 $为 分组列表框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
