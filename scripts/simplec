#!/bin/bash

# ------------------------------------------------------------------------------------------
# Convenience script to invoke the Simple compiler
#
# Before using this script, make sure the following environment variables are defined:
#   JAVA_HOME       root directory of JDK 11
#   ANDROID_HOME    root directory of Android SDK (must contain android-30)
#   SIMPLE_HOME     root directory of Simple distribution (same as directory of this script)
# ------------------------------------------------------------------------------------------

exec "${JAVA_HOME}/bin/java" -classpath "${ANDROID_HOME}/platforms/android-30/tools/lib/d8.jar:${SIMPLE_HOME}/SimpleCompiler.jar:${SIMPLE_HOME}/libs/*" simple.compiler.Main "$@"

