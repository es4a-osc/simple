' 计时器
变量 成_秒数 为 整数型

事件 开始倒计时.被单击()
	成_秒数 = 4
	开始倒计时.启用 = 假
	倒计时状态.文本 = "计时器运行：4"
	计时器1.启用 = 真
结束 事件

事件 计时器1.计时()
	成_秒数 = 成_秒数 - 1
	如果 成_秒数 <= 0 则
		计时器1.启用 = 假
		倒计时状态.文本 = "计时器已停止"
		开始倒计时.启用 = 真
	否则
		倒计时状态.文本 = "计时器运行：" & 成_秒数
	结束 如果
结束 事件

事件 主窗口.程序被销毁()
	计时器1.启用 = 假
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		标题 = "计时器"
		$定义 开始倒计时 $为 按钮
			文本 = "开始 4 秒倒计时"
		$结束 $定义
		$定义 倒计时状态 $为 标签
			文本 = "计时器已停止"
		$结束 $定义
		$定义 计时器1 $为 计时器
			启用 = 假
			间隔 = 1000
		$结束 $定义
	$结束 $定义
$结束 $属性
