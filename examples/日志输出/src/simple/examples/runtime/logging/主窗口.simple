' 日志输出：按四个级别输出日志；实际内容在设备日志中查看。

事件 运行演示.被单击()

	变量 原模块 为 文本型
	原模块 = 取输出模块名()
	置输出模块名("运行库日志示例")
	输出调试("调试消息")
	输出信息("信息消息")
	输出警告("警告消息")
	输出错误("错误消息（示例主动输出）")
	输出调试("运行库日志示例", "显式模块调试")
	输出信息("运行库日志示例", "显式模块信息")
	输出警告("运行库日志示例", "显式模块警告")
	输出错误("运行库日志示例", "显式模块错误（示例主动输出）")
	结果.文本 = "已调用四个级别的两种重载，共 8 次。\n当前模块：" & 取输出模块名() & "\n请按模块名“运行库日志示例”查看设备日志。"
	置输出模块名(原模块)
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "日志输出"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "按四个级别输出日志；实际内容在设备日志中查看。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
