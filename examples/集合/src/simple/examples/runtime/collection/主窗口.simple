' 集合：有序存储、插入、替换、删除和数组转换。

事件 运行演示.被单击()

	变量 列表 为 集合
	列表 = 创建 集合
	列表.加入("第一项")
	列表.加入(42)
	列表.插入(1, "插入项")
	列表.替换(2, "替换项")
	断言真(列表.计数 = 3)
	断言真(列表.项目(1) = "插入项")
	列表.删除(0)
	断言真(列表.计数 = 2)
	变量 内容 为 文本型
	内容 = "自检通过\n集合数量：" & 列表.计数 & "\n首项：" & 列表.项目(0)
	变量 数组 为 变体型()
	数组 = 列表.到数组()
	断言真(取数组成员数(数组) = 2)
	列表.清空()
	断言真(列表.计数 = 0)
	列表.并入数组(数组)
	断言真(列表.计数 = 2)
	结果.文本 = 内容 & "\n清空、从数组恢复通过。"
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "集合"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "有序存储、插入、替换、删除和数组转换。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
