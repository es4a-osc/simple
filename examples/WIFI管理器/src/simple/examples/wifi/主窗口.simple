' 从当前组件接口演示读取、扫描、保存网络、热点及资源清理。
变量 扫描次数 为 整数型
变量 添加次数 为 整数型
变量 热点次数 为 整数型
变量 全部事件次数 为 整数型
变量 已销毁 为 逻辑型
变量 延迟检查 为 文本型
变量 检查前事件次数 为 整数型

事件 主窗口.初始化()
	记录("请先读取信息或测试未授权扫描，再请求定位权限。保存网络时可在系统界面取消。")
结束 事件

事件 网络设置.被单击()
	如果 可以操作() 则
		WIFI1.打开WIFI设置()
		记录("已请求打开系统 Wi-Fi 界面；这不表示 Wi-Fi 状态已改变。")
	结束 如果
结束 事件

事件 刷新信息.被单击()
	记录("Wi-Fi 已开启：" & WIFI1.是否已开启() & "\nSSID：" & WIFI1.取当前SSID() & "\n网络标识：" & WIFI1.取当前网络标识() & "\n内网 IP：" & WIFI1.取内网IP() & "\n网关：" & WIFI1.取网关() & "\n子网掩码：" & WIFI1.取子网掩码() & "\nDNS：" & WIFI1.取DNS1() & " / " & WIFI1.取DNS2() & "\n信号等级（0-4）：" & WIFI1.取当前信号强度() & "\n链路速度（Mbps）：" & WIFI1.取当前连接速度())
	位于 错误
		分支 否则
			记录("读取失败，请检查网络状态和权限。")
	结束 错误
结束 事件

事件 未授权扫描.被单击()
	如果 可以操作() = 假 则
		退出 事件
	结束 如果
	如果 权限请求1.是否授权("android.permission.ACCESS_FINE_LOCATION") 则
		记录("定位权限已授权，不再属于未授权场景。可在应用权限设置中撤销后重试。")
	否则
		记录("未授予定位权限，扫描是否受理：" & WIFI1.开始扫描() & "；应返回假，且不会触发本次扫描事件。")
	结束 如果
结束 事件

事件 扫描按钮.被单击()
	如果 定位可用() = 假 则
		退出 事件
	结束 如果
	变量 首次受理 为 逻辑型
	首次受理 = WIFI1.开始扫描()
	记录("扫描是否受理：" & 首次受理)
	如果 首次受理 则
		记录("立即重复扫描：" & WIFI1.开始扫描() & "；等待中应返回假。")
		记录("等待扫描通知；系统仍可能因扫描频率或设备条件拒绝更新结果。")
	结束 如果
	位于 错误
		分支 否则
			记录("扫描调用异常，不能把已有缓存当成本次扫描成功。")
	结束 错误
结束 事件

事件 WIFI1.扫描完毕(已更新 为 逻辑型)
	扫描次数 = 扫描次数 + 1
	记录事件("扫描完毕，结果已更新：" & 已更新 & "\n当前可读结果：" & WIFI1.获取扫描结果())
结束 事件

事件 WIFI1.网络状态改变(状态 为 整数型)
	记录事件("网络状态：" & 状态 & "（1连接、2连接中、3断开、4断开中、5暂停、6未知）")
结束 事件

事件 WIFI1.开启状态改变(启用 为 逻辑型)
	记录事件("Wi-Fi 开启状态：" & 启用)
结束 事件

事件 WIFI1.密码错误()
	记录事件("系统报告了密码认证错误；未收到此事件不能据此判断密码正确。")
结束 事件

事件 请求保存.被单击()
	请求保存网络(3)
结束 事件

事件 保存开放网络.被单击()
	请求保存网络(1)
结束 事件

过程 请求保存网络(类型 为 整数型)
	如果 可以操作() = 假 则
		退出 过程
	结束 如果
	变量 已受理 为 逻辑型
	已受理 = WIFI1.添加网络(网络名称.文本, 网络密码.文本, 类型)
	记录("保存网络请求是否受理：" & 已受理 & "；受理不表示保存成功。")
	如果 已受理 则
		记录("立即重复请求：" & WIFI1.添加网络(网络名称.文本, 网络密码.文本, 类型) & "；等待中应返回假。需要确认时，可点取消验证取消结果。")
	结束 如果
结束 过程

事件 WIFI1.网络添加结果(名称 为 文本型, 状态 为 整数型)
	添加次数 = 添加次数 + 1
	记录事件("网络添加结果：" & 名称 & "，状态 " & 状态 & "（0成功、1失败、2已存在、-1取消）；状态码不是网络标识。")
结束 事件

事件 创建本地.被单击()
	如果 定位可用() 则
		热点凭据.文本 = "等待系统生成热点连接信息。"
		WIFI1.创建本地热点()
		记录("已请求本地热点，等待成功或失败事件；不提供互联网共享。")
	结束 如果
结束 事件

事件 取消待定.被单击()
	如果 定位可用() = 假 则
		退出 事件
	结束 如果
	记录("请先关闭已有本地热点；本项用于验证创建后立即取消。")
	检查前事件次数 = 热点次数
	WIFI1.创建本地热点()
	记录("立即关闭是否完成：" & WIFI1.关闭热点() & "；尚在创建时为假，迟到资源由组件释放。")
	WIFI1.创建本地热点()
	记录("紧接着再次创建，不应覆盖仍在取消中的系统请求。")
	延迟检查 = "取消热点"
	检查计时器.启用 = 真
结束 事件

事件 创建指定.被单击()
	如果 可以操作() 则
		记录("指定名称热点请求是否受理：" & WIFI1.创建热点(网络名称.文本, 网络密码.文本) & "；需要系统管理权限，受理不表示已经就绪。")
	结束 如果
结束 事件

事件 关闭热点.被单击()
	如果 可以操作() 则
		记录("关闭热点是否完成或受理：" & WIFI1.关闭热点())
		热点凭据.文本 = "本地热点关闭时仅释放本实例资源；其它应用仍可能持有该热点。"
	结束 如果
结束 事件

事件 WIFI1.本地热点创建成功(名称 为 文本型, 密码 为 文本型)
	热点次数 = 热点次数 + 1
	热点凭据.文本 = "本地热点名称：" & 名称 & "\n本地热点密码：" & 密码
	记录事件("本地热点已就绪，实际名称和密码显示在连接信息栏。")
结束 事件

事件 WIFI1.本地热点创建失败(错误码 为 整数型)
	热点次数 = 热点次数 + 1
	热点凭据.文本 = "本地热点未创建成功。"
	记录事件("本地热点失败：" & 错误码 & "（1无信道、2通用错误、3模式冲突、4系统禁止）；普通设备能力或权限限制也可能导致失败。")
结束 事件

事件 锁测试.被单击()
	如果 可以操作() 则
		WIFI1.锁定WIFI()
		WIFI1.锁定WIFI()
		WIFI1.解锁WIFI()
		WIFI1.解锁WIFI()
		记录("重复获取和释放 Wi-Fi 锁已完成；Wi-Fi 锁不能阻止用户关闭 Wi-Fi。")
	结束 如果
结束 事件

事件 销毁按钮.被单击()
	如果 已销毁 则
		记录("组件已销毁；退出后重新打开示例可重新演示。")
		退出 事件
	结束 如果
	检查计时器.启用 = 假
	WIFI1.锁定WIFI()
	检查前事件次数 = 全部事件次数
	已销毁 = 真
	WIFI1.销毁()
	WIFI1.销毁()
	记录("重复销毁已完成。\n销毁后扫描是否受理：" & WIFI1.开始扫描() & "\n销毁后保存是否受理：" & WIFI1.添加网络("ES4A-DESTROYED", "test-pass-1234", 3) & "\n销毁后网络标识：" & WIFI1.取当前网络标识() & "\n应分别为假、假、-1，且不再触发组件事件。")
	热点凭据.文本 = "组件已销毁，退出后重新打开示例可重试。"
	延迟检查 = "销毁"
	检查计时器.启用 = 真
结束 事件

事件 检查计时器.计时()
	检查计时器.启用 = 假
	如果 延迟检查 = "取消热点" 则
		记录("取消后观察窗口内，热点事件增加：" & (热点次数 - 检查前事件次数) & "，应为 0。\n当前关闭是否完成：" & WIFI1.关闭热点())
	否则
		记录("销毁后观察窗口内，组件事件增加：" & (全部事件次数 - 检查前事件次数) & "，应为 0。")
	结束 如果
	延迟检查 = ""
结束 事件

事件 申请权限.被单击()
	如果 权限请求1.请求权限("WIFI示例") 则
		记录("已发起权限请求，请在系统界面选择；返回后再操作扫描或本地热点。")
	否则
		记录("没有发起新的权限请求，请检查当前授权状态。")
	结束 如果
结束 事件

事件 权限请求1.请求结果(权限名称 为 文本型(), 授予结果 为 整数型(), 标记 为 文本型)
	变量 索引 为 整数型
	循环 索引 = 0 至 取数组成员数(权限名称) - 1
		记录(权限名称(索引) & "：" & 权限请求1.是否授权(权限名称(索引)))
	下个
结束 事件

事件 打开权限设置.被单击()
	权限请求1.打开设置()
结束 事件

事件 清空按钮.被单击()
	结果.文本 = "操作记录已清空；事件计数保留。"
结束 事件

函数 可以操作() 为 逻辑型
	可以操作 = 已销毁 = 假
	如果 已销毁 则
		记录("组件已销毁，退出后重新打开示例再操作。")
	结束 如果
结束 函数

函数 定位可用() 为 逻辑型
	定位可用 = 假
	如果 可以操作() 则
		如果 权限请求1.是否授权("android.permission.ACCESS_FINE_LOCATION") 则
			定位可用 = 真
		否则
			记录("请先请求定位权限，并按系统要求开启定位服务。")
		结束 如果
	结束 如果
结束 函数

过程 记录事件(内容 为 文本型)
	全部事件次数 = 全部事件次数 + 1
	记录("事件 " & 全部事件次数 & "：" & 内容)
结束 过程

过程 记录(内容 为 文本型)
	结果.文本 = 内容 & "\n\n" & 结果.文本
	统计.文本 = "扫描通知：" & 扫描次数 & "；添加结果：" & 添加次数 & "；热点结果：" & 热点次数
	日志输出.输出信息("WIFI示例", 内容)
结束 过程

事件 主窗口.程序被销毁()
	检查计时器.启用 = 假
	WIFI1.销毁()
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "WIFI管理器"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "先读取或测试未授权扫描，再请求定位权限。结果最新记录在最上方。系统可能限制扫描和热点；保存网络需用户确认时，可点取消。销毁后请退出重开。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 统计 $为 标签
			文本 = "扫描通知：0；添加结果：0；热点结果：0"
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 220
			单行模式 = 假
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 WIFI1 $为 WIFI管理器
		$结束 $定义
		$定义 检查计时器 $为 计时器
			间隔 = 8000
			启用 = 假
		$结束 $定义
		$定义 刷新信息 $为 按钮
			文本 = "读取当前网络信息"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 未授权扫描 $为 按钮
			文本 = "测试未授权扫描"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 申请权限 $为 按钮
			文本 = "请求定位权限"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 扫描按钮 $为 按钮
			文本 = "扫描附近 Wi-Fi（含重复请求检查）"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 网络设置 $为 按钮
			文本 = "打开系统 Wi-Fi 设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 打开权限设置 $为 按钮
			文本 = "打开应用权限设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 网络说明 $为 标签
			文本 = "网络名称和密码供保存网络或创建指定热点使用。保存开放网络时忽略密码。请勿保存无关网络。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 网络名称 $为 编辑框
			文本 = "ES4A-VERIFY"
			宽度 = 长度_匹配父级
			单行模式 = 真
		$结束 $定义
		$定义 网络密码 $为 编辑框
			文本 = "test-pass-1234"
			宽度 = 长度_匹配父级
			单行模式 = 真
			输入模式 = 输入模式_密码
		$结束 $定义
		$定义 请求保存 $为 按钮
			文本 = "请求保存 WPA2 网络（可在系统界面取消）"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 保存开放网络 $为 按钮
			文本 = "请求保存开放网络（可在系统界面取消）"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 创建本地 $为 按钮
			文本 = "创建本地热点（无互联网共享）"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 关闭热点 $为 按钮
			文本 = "关闭热点"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 取消待定 $为 按钮
			文本 = "测试本地热点创建后立即取消"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 热点凭据 $为 标签
			文本 = "本地热点就绪后在此显示实际名称和密码。需要 Android 8.0 及以上、定位权限和系统要求的定位服务。"
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
		$定义 创建指定 $为 按钮
			文本 = "创建指定名称热点（需系统管理权限）"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 锁测试 $为 按钮
			文本 = "重复获取和释放 Wi-Fi 锁"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 销毁按钮 $为 按钮
			文本 = "重复销毁组件并检查后续请求"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 清空按钮 $为 按钮
			文本 = "清空操作记录"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
