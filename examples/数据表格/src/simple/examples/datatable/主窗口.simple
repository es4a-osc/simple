''' 数据表格：SQLite 结果展示、行列操作、样式和本地图片列。
''' 表格修改只改变界面；重新载入会恢复数据库中的示例记录。

变量 选中行 为 整数型
变量 下一编号 为 整数型
变量 缩略 为 逻辑型
变量 图片模式 为 逻辑型
变量 检查数量 为 整数型

''' 在结果区显示当前规模和操作反馈。
过程 显示状态(说明 为 文本型)
	变量 内容 为 文本型
	内容 = 说明 & "\n数据：" & 表格1.取行数()
	内容 = 内容 & " 行 / " & 表格1.取列数() & " 列"
	结果.文本 = 内容
结束 过程

''' 把演示数据转换为三列，并将编号作为独立行标记。
过程 追加数据(内容 为 文本型, 背景色 为 整数型)
	变量 字段 为 文本型()
	字段 = 分割文本(内容, "|")
	表格1.添加一行(字段, 背景色)
	表格1.置表格行标记(表格1.取行数() - 1, 字段(0))
结束 过程

''' 查询应用私有数据库，只为固定演示数据使用竖线和换行分隔。
过程 载入数据库()
	变量 库 为 SQLite数据库
	库 = 创建 SQLite数据库
	库.打开数据库("data-table-demo.db")
	库.数据库执行("CREATE TABLE IF NOT EXISTS 示例数据 (编号 INTEGER, 名称 TEXT, 数量 INTEGER)")
	库.数据库执行("DELETE FROM 示例数据")
	库.数据库执行("INSERT INTO 示例数据 VALUES (101,'温度传感器',12),(102,'蓝牙模块',8),(103,'串口模块',5)")
	变量 文本结果 为 文本型
	文本结果 = 库.数据库查询("SELECT 编号 || '|' || 名称 || '|' || 数量 FROM 示例数据 ORDER BY 编号", "", "\n")
	库.关闭数据库()

	表格1.清空表格()
	表格1.显示图片 = 假
	图片模式 = 假
	表格1.拉伸列 = 1
	表格1.添加表头(分割文本("编号|名称|数量", "|"))
	变量 记录 为 文本型()
	变量 索引 为 整数型
	记录 = 分割文本(文本结果, "\n")
	循环 索引 = 0 至 取数组成员数(记录) - 1
		如果 记录(索引) <> "" 则
			追加数据(记录(索引), 颜色_白)
		结束 如果
	下个
	选中行 = -1
	下一编号 = 104
	显示状态("已载入 SQLite 查询结果，点击任意数据行选择。")
	位于 错误
		分支 否则
			库.关闭数据库()
			结果.文本 = "载入失败，请确认当前运行库包含数据表格。"
	结束 错误
结束 过程

''' 没有明确选择时，演示按钮操作第一行。
函数 操作行() 为 整数型
	操作行 = 选中行
	如果 选中行 < 0 或 选中行 >= 表格1.取行数() 则 操作行 = 0
结束 函数

事件 主窗口.初始化()
	表格1.拉伸列 = 1
	表格1.最大字长 = 10
	表格1.单元格字体大小 = 14
	载入数据库()
结束 事件

事件 重新载入.被单击()
	载入数据库()
结束 事件

事件 追加一行.被单击()
	如果 图片模式 或 表格1.取列数() > 3 则 载入数据库()
	如果 表格1.取列数() = 0 则 表格1.添加表头(分割文本("编号|名称|数量", "|"))
	追加数据(下一编号 & "|新增设备|1", &HFFF2F8FF)
	下一编号 = 下一编号 + 1
	显示状态("已追加一行，背景与行标记独立保存。")
结束 事件

事件 修改选中.被单击()
	如果 表格1.取行数() = 0 则
		显示状态("请先载入或追加数据。")
		退出 事件
	结束 如果
	变量 行 为 整数型
	行 = 操作行()
	表格1.置单元格内容(行, 1, "已修改的设备")
	表格1.置单元格内容(行, 2, "99")
	表格1.置表格行背景色(行, &HFFE8F5E9)
	显示状态("已修改选中行；重新载入可恢复数据库原值。")
结束 事件

事件 删除选中.被单击()
	如果 表格1.取行数() = 0 则
		显示状态("当前没有可删除的数据行。")
		退出 事件
	结束 如果
	表格1.删除一行(操作行())
	选中行 = -1
	显示状态("已删除一行，后续行索引和标记同步前移。")
结束 事件

事件 切换样式.被单击()
	缩略 = (缩略 = 假)
	表格1.置缩略显示内容(缩略)
	如果 缩略 则
		表格1.表头背景颜色 = &HFF1E5AA8
		表格1.表头字体颜色 = 颜色_白
		表格1.表头字体大小 = 16
		表格1.分割线颜色 = &HFF90A4AE
		表格1.分割线宽度 = 2
	否则
		表格1.表头背景颜色 = &HFFE8EEF7
		表格1.表头字体颜色 = 颜色_黑
		表格1.表头字体大小 = 14
		表格1.分割线颜色 = &HFFD0D7DE
		表格1.分割线宽度 = 1
	结束 如果
	显示状态("已切换已有表格样式，内容与行标记保留。")
结束 事件

事件 图片列.被单击()
	表格1.清空表格()
	表格1.显示图片 = 真
	图片模式 = 真
	表格1.添加表头(分割文本("图示|名称|数量", "|"))
	追加数据("simple.png|资产图片|1", 颜色_白)
	追加数据("simple.png|图片与文本混排|2", &HFFF2F8FF)
	选中行 = -1
	显示状态("第一列显示 APK 内的资产图片，无需存储或网络权限。")
结束 事件

事件 清空数据.被单击()
	表格1.清空表格()
	选中行 = -1
	显示状态("已清空表头和数据；可以重新载入。")
结束 事件

事件 表格1.表格行被单击(行 为 整数型)
	选中行 = 行
	显示状态("选中索引 " & 行 & "，业务标记：" & 表格1.取表格行标记(行))
结束 事件

''' 多列、多行的独立演示，用于体验表格内部的横向和纵向滚动。
事件 宽表滚动.被单击()
	表格1.清空表格()
	表格1.显示图片 = 假
	图片模式 = 假
	表格1.拉伸列 = -1
	表格1.添加表头(分割文本("编号|设备名称|通道一|通道二|通道三|通道四|通道五|末列", "|"))
	变量 索引 为 整数型
	变量 内容 为 文本型
	循环 索引 = 0 至 11
		内容 = 索引 & "|设备详细信息" & 索引
		内容 = 内容 & "|测量数据100|测量数据200|测量数据300" & _
			"|测量数据400|测量数据500|末列值" & 索引
		表格1.添加一行(分割文本(内容, "|"))
		表格1.置表格行标记(索引, "宽表-" & 索引)
	下个
	选中行 = -1
	显示状态("已载入宽表：在表格内左右或上下滑动。")
结束 事件

''' 用设备端断言核对公开 API，并在结束后恢复可操作示例。
过程 检查(条件 为 逻辑型)
	断言真(条件)
	检查数量 = 检查数量 + 1
结束 过程

函数 越界被拒绝() 为 逻辑型
	变量 内容 为 文本型
	内容 = 表格1.取单元格内容(-1, 0)
	位于 错误
		分支 索引超出界限错误
			越界被拒绝 = 真
	结束 错误
结束 函数

事件 运行自检.被单击()
	检查数量 = 0
	载入数据库()
	检查(表格1.取行数() = 3)
	检查(表格1.取列数() = 3)
	检查(表格1.取单元格内容(0, 1) = "温度传感器")
	表格1.添加一行(分割文本("200|重载追加|4", "|"))
	检查(表格1.取行数() = 4)
	表格1.置表格行标记(3, "业务+|*|+标记")
	表格1.删除一行(0)
	检查(表格1.取表格行标记(2) = "业务+|*|+标记")
	表格1.置单元格内容(0, 1, "已修改")
	检查(表格1.取单元格内容(0, 1) = "已修改")
	表格1.置表格行背景色(0, &HFFE8F5E9)
	表格1.表头字体大小 = 16
	检查(表格1.表头字体大小 = 16)
	表格1.单元格字体大小 = 15
	检查(表格1.单元格字体大小 = 15)
	检查(表格1.取表格行标记(2) = "业务+|*|+标记")
	检查(越界被拒绝())
	表格1.清空表格()
	检查(表格1.取行数() = 0)
	检查(表格1.取列数() = 0)
	表格1.显示图片 = 真
	表格1.添加表头(分割文本("图示|名称|数量", "|"))
	追加数据("simple.png|图片验证|1", 颜色_白)
	检查(表格1.显示图片)
	检查(表格1.取单元格内容(0, 0) = "simple.png")
	表格1.置单元格内容(0, 0, "simple.png")
	检查(表格1.取行数() = 1)
	表格1.单元格字体大小 = 14
	表格1.表头字体大小 = 14
	载入数据库()
	显示状态("自检通过：" & 检查数量 & " 项；已恢复数据库示例。")
	位于 错误
		分支 否则
			结果.文本 = "自检失败，当前检查数量：" & 检查数量
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "数据表格"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 说明 $为 标签
			文本 = "点击数据行选择，再修改或删除；界面修改不写回数据库。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作栏1 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 重新载入 $为 按钮
				文本 = "重新载入"
				高度 = "48dp"
			$结束 $定义
			$定义 追加一行 $为 按钮
				文本 = "追加一行"
				高度 = "48dp"
			$结束 $定义
			$定义 修改选中 $为 按钮
				文本 = "修改选中"
				高度 = "48dp"
			$结束 $定义
		$结束 $定义
		$定义 操作栏2 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 删除选中 $为 按钮
				文本 = "删除选中"
				高度 = "48dp"
			$结束 $定义
			$定义 切换样式 $为 按钮
				文本 = "切换样式"
				高度 = "48dp"
			$结束 $定义
			$定义 图片列 $为 按钮
				文本 = "图片列"
				高度 = "48dp"
			$结束 $定义
		$结束 $定义
		$定义 操作栏3 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 清空数据 $为 按钮
				文本 = "清空表格"
				高度 = "48dp"
			$结束 $定义
			$定义 运行自检 $为 按钮
				文本 = "运行自检"
				高度 = "48dp"
			$结束 $定义
			$定义 宽表滚动 $为 按钮
				文本 = "宽表滚动"
				高度 = "48dp"
			$结束 $定义
		$结束 $定义
		$定义 表格1 $为 数据表格
			宽度 = 长度_匹配父级
			高度 = "260dp"
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			文本 = "准备载入数据。"
		$结束 $定义
	$结束 $定义
$结束 $属性
