' 进制转换：整数的二进制与十六进制表示和解析，区别于字节编码。

事件 运行演示.被单击()

	断言真(整数到二进制(10) = "1010")
	断言真(二进制到长整数("1010") = 10)
	断言真(十六进制到长整数("FF") = 255)
	断言真(十六进制到长整数("0xFF") = 0)
	结果.文本 = "自检通过\n10 → 二进制：" & 整数到二进制(10) & "\n42 → 十六进制：" & 十六进制(42) & "\n1010 → 数值：" & 二进制到长整数("1010") & "\nFF → 数值：" & 十六进制到长整数("FF") & "\n带 0x 前缀的输入按接口约定返回 0。"
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "进制转换"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "整数的二进制与十六进制表示和解析，区别于字节编码。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
