' XML生成器：构建文档，再通过解析回读验证输出。
变量 成_解析器 为 XML解析器
变量 成_生成器 为 XML生成器
变量 成_补充字符 为 文本型
事件 主窗口.初始化()
	成_解析器 = 创建 XML解析器
	成_生成器 = 创建 XML生成器
	' 运行时还原补充字符，避免把表情直接写入编译器的字符串常量。
	成_补充字符 = UCS2解析("\\ud83d\\ude0a")
结束 事件

事件 文档演示.被单击()
	变量 内容 为 文本型
	生成示例文档("UTF-8")
	成_解析器.解析文本(成_生成器.导出文本())
	校验文档(成_解析器)
	结果.文本 = "生成并解析通过：" & "\n" & 成_生成器.导出文本()
	位于 错误
		分支 否则
			内容 = "演示失败："
			内容 = 内容 & 成_生成器.取错误信息()
			内容 = 内容 & 成_解析器.取错误信息()
			结果.文本 = 内容
	结束 错误
结束 事件

' 同时演示命名空间、属性转义、空节点和混合文本。
过程 生成示例文档(编码 为 文本型)
	成_生成器.开始文档(编码)
	成_生成器.设置命名空间("例", "urn:es4a:xml")
	成_生成器.开始节点("urn:es4a:xml", "根")
	成_生成器.设置属性("id", "1001")
	成_生成器.设置属性("urn:es4a:xml", "标记", "甲 & \"乙\"")
	成_生成器.设置内容("前")

	成_生成器.开始节点("空")
	成_生成器.结束节点("空")

	成_生成器.开始节点("urn:es4a:xml", "项")
	成_生成器.设置内容("中文<&>\"" & 成_补充字符)
	成_生成器.结束节点("urn:es4a:xml", "项")
	成_生成器.设置内容("后")
	成_生成器.结束节点("urn:es4a:xml", "根")
	成_生成器.结束文档()
结束 过程

过程 校验文档(解析器 为 XML解析器)
	断言真(解析器.取节点类型() = XML解析器.节点_文档开始)
	变量 开始数量 为 整数型
	变量 结束数量 为 整数型
	变量 文本数量 为 整数型
	变量 合并内容 为 文本型
	合并内容 = ""

	判断循环 解析器.读取下一个() <> XML解析器.节点_文档结束
		判断 解析器.取节点类型()
			分支 XML解析器.节点_开始
				开始数量 = 开始数量 + 1
				断言真(解析器.取行号() >= 1)
				断言真(解析器.取列号() >= 0)
				断言真(解析器.取节点内容() = "")
				如果 解析器.取节点深度() = 1 则
					断言真(解析器.取节点名称() = "根")
					断言真(解析器.取前缀() = "例")
					断言真(解析器.取命名空间() = "urn:es4a:xml")
					断言真(解析器.取属性个数() = 2)
					断言真(解析器.取指定属性内容("id") = "1001")
					断言真(解析器.取指定属性内容("urn:es4a:xml", "标记") = "甲 & \"乙\"")
					断言真(解析器.取指定属性内容("不存在") = "")
					检查根属性(解析器)
				否则
					断言真(解析器.取节点深度() = 2)
					如果 解析器.取节点名称() = "空" 则
						断言真(解析器.取命名空间() = "")
					结束 如果
				结束 如果
				' 重复读取没有消费掉当前开始节点。
				断言真(解析器.取节点类型() = XML解析器.节点_开始)
			分支 XML解析器.节点_结束
				结束数量 = 结束数量 + 1
				断言真(解析器.取属性个数() = 0)
			分支 XML解析器.节点_文本
				文本数量 = 文本数量 + 1
				合并内容 = 合并内容 & 解析器.取节点内容()
		结束 判断
	结束 判断循环

	断言真(开始数量 = 3)
	断言真(结束数量 = 3)
	断言真(文本数量 = 3)
	断言真(合并内容 = "前中文<&>\"" & 成_补充字符 & "后")
	断言真(解析器.取节点深度() = 0)
	断言真(解析器.读取下一个() = XML解析器.节点_文档结束)
结束 过程

过程 检查根属性(解析器 为 XML解析器)
	变量 索引 为 整数型
	变量 名称 为 文本型
	判断循环 索引 < 解析器.取属性个数()
		名称 = 解析器.取属性名称(索引)
		如果 名称 = "id" 则
			断言真(解析器.取属性内容(索引) = "1001")
			断言真(解析器.取属性前缀(索引) = "")
			断言真(解析器.取属性命名空间(索引) = "")
		否则
			断言真(名称 = "标记")
			断言真(解析器.取属性内容(索引) = "甲 & \"乙\"")
			断言真(解析器.取属性前缀(索引) = "例")
			断言真(解析器.取属性命名空间(索引) = "urn:es4a:xml")
		结束 如果
		索引 = 索引 + 1
	结束 判断循环
结束 过程

事件 边界自检.被单击()
	变量 编码 为 文本型(3)
	编码(0) = "UTF-8"
	编码(1) = "UTF-16"
	编码(2) = "GB18030"
	变量 索引 为 整数型
	变量 数据 为 字节型()
	变量 内容 为 文本型
	内容 = ""

	判断循环 索引 < 3
		生成示例文档(编码(索引))
		数据 = 成_生成器.导出字节集()
		成_解析器.解析字节集(数据)
		校验文档(成_解析器)
		成_解析器.解析字节集(数据, 编码(索引))
		校验文档(成_解析器)
		内容 = 内容 & 编码(索引) & " 自动识别和指定编码通过\n"
		索引 = 索引 + 1
	结束 判断循环

	' 验证多个对象互不覆盖，以及空元素、文本与 CDATA 的读取。
	检查对象隔离()
	检查命名空间()
	内容 = 内容 & "对象隔离、文本、CDATA、空节点与默认命名空间通过\n"
	索引 = 4
	判断循环 索引 <= 16
		断言真(预期失败(索引))
		内容 = 内容 & "错误分支 " & 索引 & " 通过\n"
		索引 = 索引 + 1
	结束 判断循环

	生成示例文档("UTF-8")
	成_解析器.解析文本(成_生成器.导出文本())
	校验文档(成_解析器)
	断言真(成_解析器.取错误信息() = "")
	断言真(成_生成器.取错误信息() = "")
	结果.文本 = "全部自检通过\n" & 内容 & "错误后重新生成与解析通过"
	位于 错误
		分支 否则
			内容 = "自检失败，当前位置=" & 索引 & "\n" & 内容
			内容 = 内容 & 成_生成器.取错误信息()
			内容 = 内容 & "\n" & 成_解析器.取错误信息()
			结果.文本 = 内容
	结束 错误
结束 事件

过程 检查对象隔离()
	变量 另一解析器 为 XML解析器
	变量 另一生成器 为 XML生成器
	另一解析器 = 创建 XML解析器
	另一生成器 = 创建 XML生成器
	另一生成器.开始文档()
	另一生成器.开始节点("另一个")
	另一生成器.结束节点("另一个")
	另一生成器.结束文档()
	另一解析器.解析文本(另一生成器.导出文本())
	断言真(另一解析器.读取下一个() = XML解析器.节点_开始)

	生成示例文档("UTF-8")
	成_解析器.解析字节集(成_生成器.导出字节集())
	校验文档(成_解析器)
	断言真(另一解析器.取节点名称() = "另一个")
	断言真(另一解析器.读取下一个() = XML解析器.节点_结束)
	断言真(另一生成器.导出文本() <> 成_生成器.导出文本())
结束 过程

' 默认命名空间不作用于普通属性，无命名空间子节点须正确退出默认命名空间。
过程 检查命名空间()
	成_生成器.开始文档()
	成_生成器.设置命名空间("", "urn:默认")
	成_生成器.开始节点("urn:默认", "根")
	成_生成器.设置属性("id", "普通")
	成_生成器.设置属性("urn:属性", "id", "限定")
	成_生成器.设置属性("http://www.w3.org/XML/1998/namespace", "lang", "zh-CN")
	成_生成器.开始节点("空")
	成_生成器.结束节点("空")
	成_生成器.开始节点("urn:子", "子")
	成_生成器.结束节点("urn:子", "子")
	成_生成器.结束节点("urn:默认", "根")
	成_生成器.结束文档()

	成_解析器.解析文本(成_生成器.导出文本())
	断言真(成_解析器.读取下一个() = XML解析器.节点_开始)
	断言真(成_解析器.取前缀() = "")
	断言真(成_解析器.取命名空间() = "urn:默认")
	断言真(成_解析器.取属性个数() = 3)
	断言真(成_解析器.取指定属性内容("id") = "普通")
	断言真(成_解析器.取指定属性内容("urn:属性", "id") = "限定")
	断言真(成_解析器.取指定属性内容("http://www.w3.org/XML/1998/namespace", "lang") = "zh-CN")
	断言真(成_解析器.读取下一个() = XML解析器.节点_开始)
	断言真(成_解析器.取节点名称() = "空")
	断言真(成_解析器.取命名空间() = "")
	断言真(成_解析器.读取下一个() = XML解析器.节点_结束)
	断言真(成_解析器.读取下一个() = XML解析器.节点_开始)
	断言真(成_解析器.取前缀() <> "")
	断言真(成_解析器.取命名空间() = "urn:子")
	断言真(成_解析器.读取下一个() = XML解析器.节点_结束)
	断言真(成_解析器.读取下一个() = XML解析器.节点_结束)
	断言真(成_解析器.读取下一个() = XML解析器.节点_文档结束)
结束 过程

函数 预期失败(编号 为 整数型) 为 逻辑型
	变量 忽略整数 为 整数型
	变量 忽略文本 为 文本型
	成_生成器.重置()
	成_解析器.重置()
	判断 编号
		分支 4
			忽略文本 = 成_生成器.导出文本()
		分支 5
			成_生成器.开始文档()
			成_生成器.开始节点("根")
			成_生成器.结束文档()
		分支 6
			成_生成器.开始文档()
			成_生成器.开始节点("根")
			成_生成器.结束节点("错误")
		分支 7
			成_生成器.开始文档()
			成_生成器.开始节点("根")
			成_生成器.设置属性("id", "1")
			成_生成器.设置属性("id", "2")
		分支 8
			成_生成器.开始文档()
			成_生成器.开始节点("根")
			成_生成器.结束节点("根")
			成_生成器.开始节点("另一根")
		分支 9
			成_生成器.开始文档()
			成_生成器.开始节点("1错误")
		分支 10
			成_生成器.开始文档("ES4A-不存在编码")
		分支 11
			成_生成器.开始文档()
			成_生成器.设置内容("根节点外部文本")
		分支 12
			成_生成器.开始文档()
			忽略文本 = 成_生成器.导出文本()
		分支 13
			成_生成器.开始文档("US-ASCII")
			成_生成器.开始节点("root")
			成_生成器.设置内容("中文")
		分支 14
			成_生成器.开始文档()
			成_生成器.开始节点("根")
			成_生成器.结束节点("根")
			成_生成器.结束文档()
			成_生成器.开始节点("结束后写入")
		分支 15
			成_生成器.开始文档()
			成_生成器.设置命名空间("xmlns", "urn:无效")
		分支 16
			成_生成器.开始文档()
			成_生成器.开始节点("根")
			成_生成器.设置内容("内容")
			成_生成器.设置属性("迟到", "属性")
	结束 判断
	预期失败 = 假
	位于 错误
		分支 XML错误
			预期失败 = 成_解析器.取错误信息() <> "" 或 成_生成器.取错误信息() <> ""
		分支 否则
			预期失败 = 假
	结束 错误
结束 函数
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XML生成器"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 说明 $为 标签
			文本 = "生成命名空间、属性和混合文本，回读校验并验证生成错误。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 文档演示 $为 按钮
			文本 = "生成与解析示例"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 边界自检 $为 按钮
			文本 = "边界与错误自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 520
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
