' 数值运算：三角函数、角度弧度、开方、随机数和舍入。

事件 运行演示.被单击()

	断言真(求平方根(81) = 9)
	断言真(取绝对值(-7) = 7)
	断言真(求立方根(-8) = -2)
	断言真(求斜边(3, 4) = 5)
	变量 正弦角度 为 双精度小数型
	变量 余弦角度 为 双精度小数型
	正弦角度 = 弧度转角度(simple.runtime.数值运算.求反正弦(0.5))
	余弦角度 = 弧度转角度(求反余弦(0.5))
	断言真(取绝对值(正弦角度 - 30) < 0.000000001)
	断言真(取绝对值(余弦角度 - 60) < 0.000000001)
	变量 随机值 为 双精度小数型
	变量 骰子 为 整数型
	随机值 = 取随机数()
	骰子 = 取随机数(1, 6)
	断言真(随机值 >= 0 且 随机值 < 1)
	断言真(骰子 >= 1 且 骰子 <= 6)
	断言真(取随机数(-2, -2) = -2)
	断言真(四舍五入(1.005, 2) = 1.01)
	断言真(四舍五入(-145, -1) = -150)
	结果.文本 = "自检通过\n反正弦角度：" & 正弦角度 & "\n反余弦角度：" & 余弦角度 & "\n90 度对应弧度：" & 角度转弧度(90) & "\n随机数 [0,1)：" & 随机值 & "\n骰子 [1,6]：" & 骰子 & "\n1.005 保留两位：" & 四舍五入(1.005, 2) & "\n-145 舍入十位：" & 四舍五入(-145, -1)
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "数值运算"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "三角函数、角度弧度、开方、随机数和舍入。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
