变量 位置事件数 为 整数型
变量 地址事件数 为 整数型
变量 已销毁 为 逻辑型
变量 检查前事件数 为 整数型

事件 主窗口.初始化()
	位置传感器1.启用 = 假
	刷新状态()
	记录("先检查未授权启用，再申请精确或大致位置权限。无定位结果时，地址请求应被拒绝。")
结束 事件

事件 查询状态.被单击()
	刷新状态()
	记录("是否已有有效坐标：" & 位置传感器1.是否可用 & "；这不表示硬件或定位开关状态。")
结束 事件

事件 申请定位权限.被单击()
	变量 权限名称 为 文本型(2)
	权限名称(0) = "android.permission.ACCESS_FINE_LOCATION"
	权限名称(1) = "android.permission.ACCESS_COARSE_LOCATION"
	如果 权限请求1.请求权限(权限名称, "定位") = 假 则 记录("未发起新的权限请求。")
结束 事件

事件 申请大致权限.被单击()
	变量 权限名称 为 文本型(1)
	权限名称(0) = "android.permission.ACCESS_COARSE_LOCATION"
	权限请求1.请求权限(权限名称, "定位")
结束 事件

事件 权限请求1.请求结果(权限名称 为 文本型(), 授予结果 为 整数型(), 请求标记 为 文本型)
	如果 请求标记 <> "定位" 则 退出 事件
	记录("精确权限：" & 权限请求1.是否授权("android.permission.ACCESS_FINE_LOCATION") & "；大致权限：" & 权限请求1.是否授权("android.permission.ACCESS_COARSE_LOCATION"))
	刷新状态()
结束 事件

事件 启用按钮.被单击()
	位置传感器1.启用 = 真
	记录("已请求启用，是否真正开始以状态事件为准。")
结束 事件

事件 停用按钮.被单击()
	位置传感器1.启用 = 假
	检查前事件数 = 位置事件数 + 地址事件数
	检查计时器.启用 = 真
	刷新状态()
	记录("已停用，保留最近位置；观察期间不应再收到位置事件。")
结束 事件

事件 查询地址.被单击()
	变量 受理 为 逻辑型
	受理 = 位置传感器1.请求地址()
	如果 受理 则
		记录("地址查询已受理，界面可以继续操作。再次请求：" & 位置传感器1.请求地址() & "；应为假。")
	否则
		记录("地址查询未受理：" & 位置传感器1.错误信息)
	结束 如果
结束 事件

事件 权限设置.被单击()
	权限请求1.打开设置()
结束 事件

事件 销毁按钮.被单击()
	已销毁 = 真
	位置传感器1.销毁()
	位置传感器1.销毁()
	位置传感器1.启用 = 真
	检查前事件数 = 位置事件数 + 地址事件数
	检查计时器.启用 = 真
	记录("重复销毁完成。启用：" & 位置传感器1.启用 & "；正在定位：" & 位置传感器1.正在定位 & "；地址请求：" & 位置传感器1.请求地址() & "；应均为假。")
	刷新状态()
结束 事件

事件 检查计时器.计时()
	检查计时器.启用 = 假
	记录("观察窗口内新增结果事件：" & (位置事件数 + 地址事件数 - 检查前事件数) & "。销毁后应为 0；停用不取消已受理的地址查询。")
结束 事件

事件 位置传感器1.位置改变(纬度 为 双精度小数型, 经度 为 双精度小数型, 海拔 为 双精度小数型)
	位置事件数 = 位置事件数 + 1
	刷新状态()
	记录("位置事件 " & 位置事件数 & "：纬度=" & 纬度 & "，经度=" & 经度 & "，海拔=" & 海拔 & "；具备海拔=" & 位置传感器1.具备海拔 & "；具备精度=" & 位置传感器1.具备精度 & "，精度米数=" & 位置传感器1.精度)
结束 事件

事件 位置传感器1.定位状态改变(正在定位 为 逻辑型, 说明 为 文本型)
	记录("定位状态：" & 正在定位 & "；" & 说明)
	刷新状态()
结束 事件

事件 位置传感器1.地址查询完毕(纬度 为 双精度小数型, 经度 为 双精度小数型, 地址 为 文本型)
	地址事件数 = 地址事件数 + 1
	记录("地址查询完成，查询坐标：" & 纬度 & "，" & 经度 & "；地址：" & 地址)
	刷新状态()
结束 事件

事件 位置传感器1.操作失败(操作 为 文本型, 说明 为 文本型)
	记录("操作失败：" & 操作 & "；" & 说明)
	刷新状态()
结束 事件

过程 刷新状态()
	状态显示.文本 = "启用：" & 位置传感器1.启用 & "；正在定位：" & 位置传感器1.正在定位 & "；已有位置：" & 位置传感器1.是否可用
	纬度显示.文本 = "纬度：" & 位置传感器1.纬度
	经度显示.文本 = "经度：" & 位置传感器1.经度
	海拔显示.文本 = "海拔（米）：" & 位置传感器1.海拔 & "；有效：" & 位置传感器1.具备海拔
	精度显示.文本 = "精度（米）：" & 位置传感器1.精度 & "；有效：" & 位置传感器1.具备精度
	地址显示.文本 = "已查询地址：" & 位置传感器1.当前地址
结束 过程

过程 记录(内容 为 文本型)
	结果.文本 = 内容 & "\n\n" & 结果.文本
	日志输出.输出信息("位置示例", 内容)
结束 过程

事件 主窗口.程序被销毁()
	检查计时器.启用 = 假
	位置传感器1.销毁()
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		标题 = "位置传感器"
		$定义 位置传感器1 $为 位置传感器
			启用 = 假
		$结束 $定义
		滚动 = 真
		$定义 检查计时器 $为 计时器
			间隔 = 8000
			启用 = 假
		$结束 $定义
		$定义 操作说明 $为 标签
			文本 = "仅在前台定位。精确权限可使用 GPS 和网络，大致权限使用网络；实际结果由设备服务提供。停用保留最近结果，地址需单独查询。"
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
		$定义 状态显示 $为 标签
			文本 = "等待操作"
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
		$定义 纬度显示 $为 标签
			文本 = "纬度：等待定位"
		$结束 $定义
		$定义 经度显示 $为 标签
			文本 = "经度：等待定位"
		$结束 $定义
		$定义 海拔显示 $为 标签
			文本 = "海拔（米）：等待定位"
		$结束 $定义
		$定义 精度显示 $为 标签
			文本 = "精度（米）：等待定位"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 地址显示 $为 标签
			文本 = "地址：等待定位"
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 220
			单行模式 = 假
		$结束 $定义
		$定义 查询状态 $为 按钮
			文本 = "查询当前状态"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 申请定位权限 $为 按钮
			文本 = "申请精确位置权限"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 申请大致权限 $为 按钮
			文本 = "申请大致位置权限"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 启用按钮 $为 按钮
			文本 = "启用定位"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 停用按钮 $为 按钮
			文本 = "停用定位并观察"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 查询地址 $为 按钮
			文本 = "异步查询地址并检查重复请求"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限设置 $为 按钮
			文本 = "打开应用权限设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 销毁按钮 $为 按钮
			文本 = "重复销毁并检查后续请求"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
