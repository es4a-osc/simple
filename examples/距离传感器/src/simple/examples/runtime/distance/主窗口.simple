' 距离传感器：接近距离以 cm 为单位。
事件 距离1.距离改变(距离 为 单精度小数型)
	距离显示.文本 = "接近距离：" & 距离 & " cm"
结束 事件

事件 距离1.物体靠近()
	状态显示.文本 = "物体靠近阈值内。"
结束 事件

事件 距离1.物体离开()
	状态显示.文本 = "物体位于阈值外。"
结束 事件

事件 切换监听.被单击()
	距离1.可用 = 距离1.可用 = 假
	结果.文本 = "距离监听：" & 距离1.可用
结束 事件

事件 主窗口.初始化()
	结果.文本 = "距离监听启用：" & 距离1.可用 & "\n靠近阈值（cm）：" & 距离1.最小距离
结束 事件

事件 主窗口.程序被销毁()
	距离1.可用 = 假
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "距离传感器"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "接近距离以 cm 为单位，可切换监听并观察靠近与离开事件。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 距离1 $为 距离传感器
			最小距离 = 1
		$结束 $定义
		$定义 距离显示 $为 标签
			文本 = "接近距离：等待读数"
		$结束 $定义
		$定义 状态显示 $为 标签
			文本 = "请轻轻遮挡、移开传感器"
		$结束 $定义
		$定义 切换监听 $为 按钮
			文本 = "启用／暂停距离监听"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
