变量 事件次数 为 整数型
变量 观察前次数 为 整数型
变量 观察动作 为 文本型

事件 方向传感器1.方向改变(yaw 为 单精度小数型, pitch 为 单精度小数型, roll 为 单精度小数型)
	事件次数 = 事件次数 + 1
	标签1.文本 = "偏航角：" & yaw
	标签2.文本 = "俯仰角：" & pitch
	标签3.文本 = "翻滚角：" & roll
	显示状态()
结束 事件

事件 主窗口.程序被销毁()
	观察计时器.启用 = 假
	方向传感器1.销毁()
结束 事件

事件 查询状态.被单击()
	显示状态()
结束 事件

事件 启用按钮.被单击()
	观察计时器.启用 = 假
	方向传感器1.启用 = 真
	显示状态()
结束 事件

事件 停用按钮.被单击()
	观察前次数 = 事件次数
	观察动作 = "停用"
	方向传感器1.启用 = 假
	观察计时器.启用 = 真
	显示状态()
结束 事件

事件 重启按钮.被单击()
	观察计时器.启用 = 假
	方向传感器1.启用 = 假
	方向传感器1.启用 = 真
	显示状态()
结束 事件

事件 销毁按钮.被单击()
	观察前次数 = 事件次数
	观察动作 = "销毁"
	方向传感器1.销毁()
	方向传感器1.销毁()
	方向传感器1.启用 = 真
	观察计时器.启用 = 真
	显示状态()
结束 事件

事件 观察计时器.计时()
	观察计时器.启用 = 假
	消息.文本 = 观察动作 & "后新增方向事件：" & (事件次数 - 观察前次数) & "；应为 0。销毁后重开示例恢复组件。"
结束 事件

事件 方向传感器1.监听状态改变(监听中 为 逻辑型, 说明 为 文本型)
	消息.文本 = "监听：" & 监听中 & "；" & 说明
	日志输出.输出信息("方向示例", 消息.文本)
	显示状态()
结束 事件

过程 显示状态()
	状态.文本 = "可用：" & 方向传感器1.可用 & "；启用：" & 方向传感器1.启用 & "；监听：" & 方向传感器1.正在监听 & "；已有方向：" & 方向传感器1.已有方向
	统计.文本 = "方向事件：" & 事件次数 & "；倾斜角：" & 方向传感器1.倾斜角 & "；倾斜程度：" & 方向传感器1.Magnitude & "\n错误：" & 方向传感器1.错误信息
结束 过程
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		布局 = 1
		布局.方向 = 1
		标题 = "方向传感器"
		$定义 方向传感器1 $为 方向传感器
		$结束 $定义
		$定义 标签1 $为 标签
			文本 = "偏航角：等待有效数据"
		$结束 $定义
		$定义 标签2 $为 标签
			文本 = "俯仰角：等待有效数据"
		$结束 $定义
		$定义 标签3 $为 标签
			文本 = "翻滚角：等待有效数据"
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "前台接收磁北方向。停用和后台会注销；无硬件或无效样本不会伪造方向。坐标固定于设备自然方向，磁场干扰会影响结果。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "等待状态通知。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 查询状态 $为 按钮
			文本 = "查询状态"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 启用按钮 $为 按钮
			文本 = "启用方向监听"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 停用按钮 $为 按钮
			文本 = "停用并观察"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 重启按钮 $为 按钮
			文本 = "停用后立即重启"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 销毁按钮 $为 按钮
			文本 = "重复销毁并观察"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 统计 $为 标签
			文本 = "尚未取得有效方向。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 消息 $为 标签
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 观察计时器 $为 计时器
			启用 = 假
			间隔 = 3000
		$结束 $定义
	$结束 $定义
$结束 $属性
