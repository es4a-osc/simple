' 对象操作 · 程序
变量 成_成员值 为 长整数型

事件 主窗口.初始化()
	成_成员值 = 取现行时间戳()
结束 事件

事件 按钮3.被单击()
	显示提示框(simple.runtime.对象操作.取对象名(本对象))
结束 事件

事件 按钮4.被单击()
	显示提示框(simple.runtime.对象操作.取对象类名(本对象))
结束 事件

事件 按钮5.被单击()
	显示提示框(simple.runtime.对象操作.取对象哈希码(本对象))
结束 事件

事件 按钮7.被单击()
	' 1个成员对应1个参数
	变量 局_传递参数 为 变体型(1)
	局_传递参数(0) = "yyyy-MM-dd HH:mm:ss"
	显示提示框(simple.runtime.对象操作.调用方法(本对象, "取北京时间", 局_传递参数))
结束 事件

事件 按钮8.被单击()
	显示提示框(simple.runtime.对象操作.取成员值(本对象, "成_成员值"))
结束 事件

事件 按钮9.被单击()
	simple.runtime.对象操作.置成员值(本对象, "成_成员值", 取现行时间戳())
结束 事件

函数 取北京时间(时间格式 为 文本型) 为 文本型
	取北京时间 = 格式化时间(取时区时间(时区_上海), 时间格式)
结束 函数

事件 创建验证.被单击()
	变量 实例 为 对象
	实例 = simple.runtime.对象操作.创建对象("java.util.ArrayList")
	如果 实例 = 空 则
		创建结果.文本 = "正常创建失败"
	否则
		创建结果.文本 = "类型：" & 取对象类名(实例) & "，初始数量：" & 调用方法(实例, "size")
	结束 如果
	创建结果.文本 = 创建结果.文本 & "\n不存在类返回空：" & (simple.runtime.对象操作.创建对象("missing.Object") = 空)
	创建结果.文本 = 创建结果.文本 & "\n缺少无参构造返回空：" & (simple.runtime.对象操作.创建对象("java.lang.Integer") = 空)
	创建结果.文本 = 创建结果.文本 & "\n私有构造返回空：" & (simple.runtime.对象操作.创建对象("simple.runtime.其它操作") = 空)
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		布局 = 布局_线性
		标题 = "对象操作"
		滚动 = 真
		$定义 创建验证 $为 按钮
			文本 = "创建对象验证"
		$结束 $定义
		$定义 创建结果 $为 标签
			文本 = "点击验证反射创建与失败返回值。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 按钮3 $为 按钮
			文本 = "取对象名"
		$结束 $定义
		$定义 按钮4 $为 按钮
			文本 = "取对象类名"
		$结束 $定义
		$定义 按钮5 $为 按钮
			文本 = "取对象哈希码"
		$结束 $定义
