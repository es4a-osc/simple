' 本地页面不依赖外部脚本；先注册可信接口，再加载页面。
变量 日志行数 为 整数型

事件 主窗口.初始化()
	网页浏览框1.注册接口("register_js")
	网页浏览框1.加载("file:///android_asset/index.html")
结束 事件

事件 按钮1.被单击()
	记录("脚本受理：" & 网页浏览框1.调用接口("setUserName('Simple')"))
结束 事件

事件 按钮2.被单击()
	记录("脚本受理：" & 网页浏览框1.调用接口("sum2Java(1,2)", 真))
结束 事件

事件 主页按钮.被单击()
	网页浏览框1.加载("file:///android_asset/index.html")
结束 事件

事件 后退按钮.被单击()
	如果 网页浏览框1.可否后退() 则
		网页浏览框1.后退()
	结束 如果
结束 事件

事件 前进按钮.被单击()
	如果 网页浏览框1.可否前进() 则
		网页浏览框1.前进()
	结束 如果
结束 事件

事件 错误按钮.被单击()
	网页浏览框1.加载("file:///android_asset/missing-main.html")
结束 事件

事件 移除按钮.被单击()
	记录("移除接口：" & 网页浏览框1.移除接口("register_js"))
结束 事件

事件 注册按钮.被单击()
	网页浏览框1.注册接口("register_js")
	网页浏览框1.加载("file:///android_asset/index.html")
	记录("已注册并重新加载。")
结束 事件

事件 销毁按钮.被单击()
	网页浏览框1.销毁()
	记录("已销毁：" & 网页浏览框1.已销毁 & "；再次操作请重新打开示例。")
结束 事件

事件 网页浏览框1.即将跳转(网址 为 文本型, 传址 屏蔽 为 逻辑型)
	如果 拦截链接.选中 且 网址 = "https://example.invalid/blocked" 则
		屏蔽 = 真
	结束 如果
	记录("导航：" & 网址 & "；屏蔽=" & 屏蔽)
结束 事件

事件 网页浏览框1.开始载入(网址 为 文本型)
	记录("开始：" & 网址)
结束 事件

事件 网页浏览框1.载入完毕(网址 为 文本型)
	记录("完成：" & 网址)
结束 事件

事件 网页浏览框1.载入失败(错误码 为 整数型, 网址 为 文本型)
	记录("失败：" & 错误码 & "；" & 网址 & "；" & 网页浏览框1.错误信息)
结束 事件

事件 网页浏览框1.HTTP错误(状态码 为 整数型, 网址 为 文本型)
	记录("HTTP：" & 状态码 & "；" & 网址)
结束 事件

事件 网页浏览框1.接口调用(名称 为 文本型, 参数 为 文本型)
	记录("JS→Simple：" & 名称 & "；" & 参数)
结束 事件

事件 网页浏览框1.接口返回(脚本 为 文本型, 结果 为 文本型)
	记录("JSON结果：" & 结果)
结束 事件

事件 网页浏览框1.弹出警告框(网址 为 文本型, 消息 为 文本型, 传址 屏蔽 为 逻辑型)
	屏蔽 = 接管对话框.选中
结束 事件

事件 网页浏览框1.弹出确认框(网址 为 文本型, 消息 为 文本型, 传址 方式 为 整数型)
	如果 接管对话框.选中 则
		方式 = 网页浏览框1.处理方式_确认
	结束 如果
结束 事件

事件 网页浏览框1.弹出输入框(网址 为 文本型, 消息 为 文本型, 传址 内容 为 文本型, 传址 方式 为 整数型)
	如果 接管对话框.选中 则
		内容 = "Simple返回"
		方式 = 网页浏览框1.处理方式_确认
	结束 如果
结束 事件

过程 记录(内容 为 文本型)
	如果 日志行数 >= 30 则
		编辑框1.文本 = ""
		日志行数 = 0
	结束 如果
	编辑框1.加入文本(内容 & "\n")
	日志行数 = 日志行数 + 1
结束 过程
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		滚动 = 真
		布局.方向 = 布局_方向_垂直
		布局 = 布局_线性
		标题 = "网页浏览框"
		$定义 标签1 $为 标签
			文本 = "网页、脚本、跳转与销毁离线验证"
		$结束 $定义
		$定义 按钮1 $为 按钮
			文本 = "修改网页用户名"
		$结束 $定义
		$定义 标签2 $为 标签
			文本 = "结果为 JSON 文本；未接管的脚本对话框使用系统界面。"
		$结束 $定义
		$定义 按钮2 $为 按钮
			文本 = "计算 1+2（返回 3）"
		$结束 $定义
		$定义 编辑框1 $为 编辑框
			字体大小 = 12
			宽度 = 长度_匹配父级
			高度 = "100dp"
		$结束 $定义
		$定义 导航操作 $为 面板
			宽度 = 长度_匹配父级
			布局.方向 = 布局_方向_水平
			$定义 主页按钮 $为 按钮
				文本 = "主页"
			$结束 $定义
			$定义 后退按钮 $为 按钮
				文本 = "后退"
			$结束 $定义
			$定义 前进按钮 $为 按钮
				文本 = "前进"
			$结束 $定义
			$定义 错误按钮 $为 按钮
				文本 = "主页面失败"
			$结束 $定义
		$结束 $定义
		$定义 接口操作 $为 面板
			宽度 = 长度_匹配父级
			布局.方向 = 布局_方向_水平
			$定义 移除按钮 $为 按钮
				文本 = "移除接口"
			$结束 $定义
			$定义 注册按钮 $为 按钮
				文本 = "重新注册"
			$结束 $定义
			$定义 销毁按钮 $为 按钮
				文本 = "销毁浏览框"
			$结束 $定义
		$结束 $定义
		$定义 处理选项 $为 面板
			宽度 = 长度_匹配父级
			布局.方向 = 布局_方向_水平
			$定义 拦截链接 $为 复选框
				文本 = "拦截指定网址"
				选中 = 真
			$结束 $定义
			$定义 接管对话框 $为 复选框
				文本 = "接管脚本对话框"
				选中 = 假
			$结束 $定义
		$结束 $定义
		$定义 网页浏览框1 $为 网页浏览框
			宽度 = 长度_匹配父级
			高度 = "320dp"
			支持缩放 = 假
			地址 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
