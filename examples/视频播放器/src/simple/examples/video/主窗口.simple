' 播放随项目打包的短片，暂停、继续、定位和查询状态。
事件 主窗口.初始化()
	视频1.置控制条状态(真)
结束 事件

事件 播放按钮.被单击()
	视频1.播放视频("android.resource://" & 取包名() & "/" & R.raw_demo)
	结果.文本 = "已提交本地资源播放请求。以真实画面和播放状态判断是否成功。"
结束 事件

事件 暂停按钮.被单击()
	视频1.暂停播放()
结束 事件

事件 继续按钮.被单击()
	视频1.继续播放()
结束 事件

事件 停止按钮.被单击()
	视频1.停止播放()
结束 事件

事件 查询按钮.被单击()
	结果.文本 = "正在播放：" & 视频1.取播放状态() & "\n当前位置（毫秒）：" & 视频1.取播放位置() & "\n时长（毫秒，未就绪可为 -1）：" & 视频1.取视频时长() & "\n缓冲：" & 视频1.取缓冲进度() & "%"
结束 事件

事件 重播按钮.被单击()
	视频1.置播放位置(0)
	视频1.继续播放()
结束 事件

事件 视频1.播放完毕()
	结果.文本 = "视频播放完毕。可重新播放本地资源。"
结束 事件

事件 主窗口.程序被停止()
	视频1.暂停播放()
结束 事件

事件 主窗口.程序被销毁()
	视频1.停止播放()
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "视频播放器"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "播放随项目打包的短片，暂停、继续、定位和查询状态。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 视频1 $为 视频播放器
			宽度 = 长度_匹配父级
			高度 = 220
		$结束 $定义
		$定义 播放按钮 $为 按钮
			文本 = "打开并播放内置短片"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 暂停按钮 $为 按钮
			文本 = "暂停"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 继续按钮 $为 按钮
			文本 = "继续"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 重播按钮 $为 按钮
			文本 = "定位到开头并继续"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 停止按钮 $为 按钮
			文本 = "停止"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 查询按钮 $为 按钮
			文本 = "查询实际状态"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
