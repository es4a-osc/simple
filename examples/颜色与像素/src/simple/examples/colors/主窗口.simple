' ARGB 颜色、通道分解与 DIP、像素转换。

事件 运行演示.被单击()
	变量 颜色 为 整数型
	颜色 = 取颜色(颜色输入.文本)
	色块.背景颜色 = 颜色

	结果.文本 = "透明度：" & 取透明度(颜色) & "\n红色：" & 取红色(颜色) & "\n绿色：" & 取绿色(颜色) & "\n蓝色：" & 取蓝色(颜色) & "\n48 DIP 对应物理像素：" & 到绝对像素(48) & "\n48 物理像素对应 DIP：" & 到相对像素(48)

	' 六位 RGB 自动补齐不透明通道；八位 ARGB 保留显式透明度。
	断言真(取颜色("#336699") = 取颜色("#FF336699"))
	断言真(到颜色(51, 102, 153) = 取颜色("#FF336699"))
	断言真(取透明度(取颜色("#336699")) = 255)
	断言真(取透明度(取颜色("#80336699")) = 128)
	断言真(取透明度(取颜色("#00336699")) = 0)
	断言真(到颜色(取透明度(颜色), 取红色(颜色), 取绿色(颜色), 取蓝色(颜色)) = 颜色)
	结果.加入文本("\n六位 RGB、八位 ARGB 与颜色通道往返自检通过。")
	位于 错误
		分支 否则
			结果.文本 = "请输入 #RRGGBB 或 #AARRGGBB 格式，例如 #336699 或 #80336699。"
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "颜色与像素"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "ARGB 颜色、通道分解与 DIP、像素转换。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 颜色输入 $为 编辑框
			文本 = "#FF336699"
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "解析颜色与换算尺寸"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 色块 $为 标签
			文本 = "颜色预览"
			高度 = 80
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_白
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
