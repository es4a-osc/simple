' 系统通讯录查询及临时测试数据自检；只按本例保存的原始联系人编号清理。
变量 测试联系人一 为 文本型
变量 测试联系人二 为 文本型
变量 测试分组 为 文本型

事件 主窗口.初始化()
	测试联系人一 = ""
	测试联系人二 = ""
	测试分组 = ""
结束 事件

事件 申请权限.被单击()
	如果 权限请求1.请求权限("通讯录示例") 则
		结果.文本 = "请在系统提示中选择是否允许访问通讯录。"
	否则
		结果.文本 = "未发起权限请求，请检查当前授权或打开应用权限设置。"
	结束 如果
结束 事件

事件 权限请求1.请求结果(权限列表 为 文本型(), 授权结果 为 整数型(), 请求标记 为 文本型)
	结果.文本 = "读取权限：" & 权限请求1.是否授权("android.permission.READ_CONTACTS") & "\n写入权限：" & 权限请求1.是否授权("android.permission.WRITE_CONTACTS")
结束 事件

事件 打开权限设置.被单击()
	权限请求1.打开设置()
结束 事件

事件 同步读取.被单击()
	变量 联系人列表 为 集合
	联系人列表 = 通讯录1.取联系人()
	如果 通讯录1.最近错误 <> "" 则
		结果.文本 = "读取失败：" & 通讯录1.最近错误
		退出 事件
	结束 如果
	结果.文本 = "同步读取成功，号码记录数：" & 联系人列表.计数
	' 每项为文本数组：[原始联系人编号、姓名、电话号码、聚合联系人编号]。
	' 本例只显示计数，避免把设备已有联系人的姓名和号码写入测试报告。
结束 事件

事件 异步读取.被单击()
	如果 通讯录1.异步取联系人() 则
		断言假(通讯录1.异步取联系人("重复请求"))
		结果.文本 = "异步请求已接受；重复请求已拒绝。等待完成事件。"
	否则
		结果.文本 = "异步请求被拒绝：" & 通讯录1.最近错误
	结束 如果
结束 事件

事件 通讯录1.取联系人完毕(联系人列表 为 集合, 请求标记 为 文本型, 错误信息 为 文本型)
	如果 错误信息 <> "" 则
		结果.文本 = "异步读取失败：" & 错误信息 & "\n请求标记：" & 请求标记
	否则
		结果.文本 = "异步读取成功，号码记录数：" & 联系人列表.计数 & "\n请求标记：" & 请求标记 & "\n读取中：" & 通讯录1.读取中
	结束 如果
结束 事件

函数 包含编号(联系人列表 为 集合, 原始编号 为 文本型) 为 逻辑型
	变量 索引 为 整数型
	变量 项目 为 文本型()
	循环 索引 = 0 至 联系人列表.计数 - 1
		项目 = 联系人列表.项目(索引)
		如果 项目(0) = 原始编号 则
			包含编号 = 真
			退出 函数
		结束 如果
	下个
结束 函数

函数 清理临时数据() 为 逻辑型
	变量 成功 为 逻辑型
	成功 = 真
	如果 测试分组 <> "" 则
		如果 通讯录1.删除联系人分组(测试分组) 则
			测试分组 = ""
		否则
			成功 = 假
		结束 如果
	结束 如果
	如果 测试联系人一 <> "" 则
		如果 通讯录1.删除联系人(测试联系人一) 则
			测试联系人一 = ""
		否则
			成功 = 假
		结束 如果
	结束 如果
	如果 测试联系人二 <> "" 则
		如果 通讯录1.删除联系人(测试联系人二) 则
			测试联系人二 = ""
		否则
			成功 = 假
		结束 如果
	结束 如果
	清理临时数据 = 成功
结束 函数

事件 运行自检.被单击()
	如果 确认自检.选中 = 假 则
		结果.文本 = "请先勾选确认。尚未创建或删除任何联系人。"
		退出 事件
	结束 如果
	如果 权限请求1.是否授权("android.permission.READ_CONTACTS") = 假 或 权限请求1.是否授权("android.permission.WRITE_CONTACTS") = 假 则
		结果.文本 = "自检需要读取及写入权限，请先申请。"
		退出 事件
	结束 如果
	如果 测试联系人一 <> "" 或 测试联系人二 <> "" 或 测试分组 <> "" 则
		结果.文本 = "仍有本例测试数据，请先点击清理测试数据。"
		退出 事件
	结束 如果
	变量 名称 为 文本型
	变量 报告 为 文本型
	名称 = "ES4A测试_" & 取现行时间戳()
	断言真(通讯录1.添加联系人("", "000") = "")
	断言真(通讯录1.最近错误 <> "")
	断言假(通讯录1.删除联系人("非法编号"))
	测试联系人一 = 通讯录1.添加联系人(名称, "00000000001")
	断言真(测试联系人一 <> "")
	测试联系人二 = 通讯录1.添加联系人(名称, "00000000002")
	断言真(测试联系人二 <> "")
	断言真(测试联系人一 <> 测试联系人二)
	断言真(包含编号(通讯录1.取联系人(), 测试联系人一))
	断言真(包含编号(通讯录1.取联系人(), 测试联系人二))
	报告 = "添加、读取、空参数和非法编号检查通过。"
	断言真(通讯录1.新建联系人分组("", "", "") = "")
	断言真(通讯录1.新建联系人分组(名称, "账号缺类型", "") = "")
	测试分组 = 通讯录1.新建联系人分组(名称, "", "")
	如果 测试分组 = "" 则
		报告 = 报告 & "\n本地分组创建失败：" & 通讯录1.最近错误
	否则
		断言真(包含编号(通讯录1.取联系人分组(), 测试分组))
		断言真(通讯录1.添加分组联系人(测试分组, 测试联系人一))
		断言真(通讯录1.添加分组联系人(测试分组, 测试联系人一))
		变量 分组联系人 为 集合
		分组联系人 = 通讯录1.取分组联系人(测试分组)
		断言真(分组联系人.计数 = 1)
		断言真(通讯录1.移除分组联系人(测试分组, 测试联系人一))
		分组联系人 = 通讯录1.取分组联系人(测试分组)
		断言真(分组联系人.计数 = 0)
		断言真(通讯录1.添加分组联系人(测试分组, 测试联系人一))
		断言真(通讯录1.删除联系人分组(测试分组))
		断言假(包含编号(通讯录1.取联系人分组(), 测试分组))
		测试分组 = ""
		断言真(包含编号(通讯录1.取联系人(), 测试联系人一))
		报告 = 报告 & "\n分组创建、重复添加、读取、移除及删除保留联系人检查通过。"
	结束 如果
	断言真(通讯录1.删除联系人(测试联系人一))
	变量 已删除编号 为 文本型
	已删除编号 = 测试联系人一
	测试联系人一 = ""
	断言假(包含编号(通讯录1.取联系人(), 已删除编号))
	断言真(包含编号(通讯录1.取联系人(), 测试联系人二))
	报告 = 报告 & "\n按编号删除检查通过，同名的第二条联系人保留。"
	断言真(清理临时数据())
	结果.文本 = 报告 & "\n测试数据已清理。"
	位于 错误
		分支 否则
			报告 = 报告 & "\n自检失败：" & 通讯录1.最近错误
			如果 清理临时数据() 则
				结果.文本 = 报告 & "\n测试数据已清理。"
			否则
				结果.文本 = 报告 & "\n清理未完成，请保持本窗口并重试清理。"
			结束 如果
	结束 错误
结束 事件

事件 清理测试数据.被单击()
	如果 清理临时数据() 则
		结果.文本 = "测试数据已清理。"
	否则
		结果.文本 = "清理未完成：" & 通讯录1.最近错误
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "通讯录"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "读取系统通讯录。勾选后可创建两条同名临时联系人并验证、清理。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 通讯录1 $为 通讯录
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 申请权限 $为 按钮
			文本 = "申请通讯录权限"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 打开权限设置 $为 按钮
			文本 = "打开应用权限设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 同步读取 $为 按钮
			文本 = "同步读取联系人"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 异步读取 $为 按钮
			文本 = "异步读取及重复请求检查"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 确认自检 $为 复选框
			文本 = "确认创建并清理本例临时测试数据"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行自检 $为 按钮
			文本 = "运行联系人与分组自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 清理测试数据 $为 按钮
			文本 = "清理测试数据"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			单行模式 = 假
			高度 = 260
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
