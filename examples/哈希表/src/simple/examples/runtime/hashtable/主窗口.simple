' 哈希表：按键存取、覆盖键、无序迭代及删除。

事件 运行演示.被单击()

	变量 映射 为 哈希表
	映射 = 创建 哈希表
	映射.加入("语言", "Simple")
	映射.加入("数量", 2)
	映射.加入("语言", "中文 Simple")
	断言真(映射.计数 = 2)
	断言真(映射.是否包含键("语言"))
	断言真(映射.取值("语言") = "中文 Simple")
	变量 内容 为 文本型
	内容 = "自检通过；迭代顺序不固定。"
	映射.迭代初始()
	判断循环 映射.迭代下个()
		内容 = 内容 & "\n" & 映射.迭代取键() & " = " & 映射.迭代取值()
	结束 判断循环
	映射.删除("数量")
	断言假(映射.是否包含键("数量"))
	映射.清除()
	断言真(映射.计数 = 0)
	结果.文本 = 内容 & "\n覆盖、删除和清空通过。"
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "哈希表"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "按键存取、覆盖键、无序迭代及删除。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
