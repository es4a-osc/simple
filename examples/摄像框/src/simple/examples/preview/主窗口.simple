				字体大小 = 14
				权重 = 1
			$结束 $定义
			$定义 关闭按钮 $为 按钮
				文本 = "关闭摄像头"
				宽度 = 0
				高度 = "44dp"
				字体大小 = 14
				权重 = 1
			$结束 $定义
