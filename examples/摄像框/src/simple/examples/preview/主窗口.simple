				字体大小 = 14
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 操作行4 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 开灯按钮 $为 按钮
				文本 = "开启持续照明"
				宽度 = 0
