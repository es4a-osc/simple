' 录音器：麦克风录制与音频回放。
变量 成_录音器 为 录音器
变量 成_录音中 为 逻辑型

事件 主窗口.初始化()
	录音路径.文本 = "/data/data/" & 取包名() & "/files/example-recording.3gp"
结束 事件

事件 开始按钮.被单击()
	如果 成_录音中 则 退出 事件
	如果 权限请求1.是否授权("android.permission.RECORD_AUDIO") = 假 则
		结果.文本 = "请先授予录音权限。"
		退出 事件
	结束 如果
	成_录音器 = 创建 录音器
	成_录音器.置录音源(1)
	成_录音器.开始录音(录音路径.文本)
	成_录音中 = 真
	结果.文本 = "录音方法已返回，请录制至少数秒再停止。"
	位于 错误
		分支 否则
			成_录音中 = 假
			结果.文本 = "录音启动失败，请检查权限、路径和麦克风占用。"
	结束 错误
结束 事件

事件 停止按钮.被单击()
	如果 成_录音中 = 假 则 退出 事件
	成_录音器.停止录音()
	成_录音中 = 假
	结果.文本 = "录音停止，尝试播放核对内容。"
	位于 错误
		分支 否则
			成_录音中 = 假
			结果.文本 = "停止录音失败，过短的录音或设备异常可能导致无有效文件。"
	结束 错误
结束 事件

事件 播放按钮.被单击()
	如果 成_录音中 则 退出 事件
	如果 音频1.打开(录音路径.文本) = 假 则 结果.文本 = "无法打开录音文件。"
结束 事件

事件 音频1.播放就绪()
	音频1.播放()
结束 事件

事件 主窗口.程序被停止()
	如果 成_录音中 则
		成_录音器.停止录音()
		成_录音中 = 假
	结束 如果
	位于 错误
		分支 否则
			成_录音中 = 假
	结束 错误
结束 事件

事件 申请权限.被单击()
	如果 权限请求1.请求权限("示例") 则
		结果.文本 = "已发起权限请求，请在系统界面选择；返回后再点击具体操作。"
	否则
		结果.文本 = "没有发起权限请求。请检查已授权状态或进入应用设置。"
	结束 如果
结束 事件

事件 权限请求1.请求结果(权限名称 为 文本型(), 授予结果 为 整数型(), 标记 为 文本型)
	结果.文本 = "权限请求结束，不代表全部已授权。\n"
	变量 索引 为 整数型
	循环 索引 = 0 至 取数组成员数(权限名称) - 1
		结果.加入文本(权限名称(索引) & "：" & 权限请求1.是否授权(权限名称(索引)) & "\n")
	下个
结束 事件

事件 打开权限设置.被单击()
	权限请求1.打开设置()
结束 事件

事件 主窗口.程序被销毁()
	音频1.停止()
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "录音器"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "麦克风录音与回放。先授权，录制数秒后再停止；文件保存在当前应用私有目录。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 申请权限 $为 按钮
			文本 = "请求本例已声明的权限"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 打开权限设置 $为 按钮
			文本 = "打开本应用权限设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 音频1 $为 音频播放器
		$结束 $定义
		$定义 录音路径 $为 编辑框
			文本 = ""
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 开始按钮 $为 按钮
			文本 = "开始录音（覆盖本例录音文件）"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 停止按钮 $为 按钮
			文本 = "停止录音"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 播放按钮 $为 按钮
			文本 = "播放录音"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
