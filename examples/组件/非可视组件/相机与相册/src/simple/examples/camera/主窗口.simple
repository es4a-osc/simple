' 调用系统相机、选择照片、预览结果及读取旋转信息。
事件 主窗口.初始化()
	输出路径.文本 = "/data/data/" & 取包名() & "/files/example-photo.jpg"
结束 事件

事件 拍照按钮.被单击()
	如果 权限请求1.是否授权("android.permission.CAMERA") = 假 则
		结果.文本 = "请先授予相机权限；旧系统还需相应共享存储权限。"
		退出 事件
	结束 如果
	相机1.开始拍照(输出路径.文本)
	结果.文本 = "已请求系统相机，完成后等待拍摄完毕事件。"
	位于 错误
		分支 否则
			结果.文本 = "无法启动拍摄，请检查路径、权限和系统相机应用。"
	结束 错误
结束 事件

事件 相册按钮.被单击()
	结果.文本 = "等待在系统相册中选择照片。"
	相机1.浏览相册()
	位于 错误
		分支 否则
			结果.文本 = "无法启动系统图片选择器。"
	结束 错误
结束 事件

事件 相机1.拍摄完毕()
	显示照片(输出路径.文本)
结束 事件

事件 相机1.浏览完毕(路径 为 文本型)
	显示照片(路径)
结束 事件

过程 显示照片(路径 为 文本型)
	照片.图片 = 路径
	变量 旋转角度 为 整数型
	旋转角度 = 相机1.取照片旋转角度(路径)
	结果.文本 = "照片路径：" & 路径 & "\n旋转角度：" & 旋转角度
结束 过程

事件 主窗口.程序被销毁()
	相机1.关闭闪光灯()
	相机1.销毁()
结束 事件

事件 申请权限.被单击()
	如果 权限请求1.请求权限("示例") 则
		结果.文本 = "已发起权限请求，请在系统界面选择；返回后再点击具体操作。"
	否则
		结果.文本 = "没有发起权限请求。请检查已授权状态或进入应用设置。"
	结束 如果
结束 事件

事件 权限请求1.请求结果(权限名称 为 文本型(), 授予结果 为 整数型(), 标记 为 文本型)
	结果.文本 = "权限请求结束，不代表全部已授权。\n"
	变量 索引 为 整数型
	循环 索引 = 0 至 取数组成员数(权限名称) - 1
		结果.加入文本(权限名称(索引) & "：" & 权限请求1.是否授权(权限名称(索引)) & "\n")
	下个
结束 事件

事件 打开权限设置.被单击()
	权限请求1.打开设置()
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "相机与相册"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "调用系统相机、选择照片、预览结果及读取旋转信息。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 申请权限 $为 按钮
			文本 = "请求本例已声明的权限"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 打开权限设置 $为 按钮
			文本 = "打开本应用权限设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 相机1 $为 相机
		$结束 $定义
		$定义 输出路径 $为 编辑框
			文本 = ""
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 拍照按钮 $为 按钮
			文本 = "调用系统相机拍照"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 相册按钮 $为 按钮
			文本 = "使用系统相册选择照片"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 照片 $为 图片框
			高度 = 220
			宽度 = 长度_匹配父级
			显示方式 = simple.runtime.components.图片组件.显示方式_居中缩放
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
