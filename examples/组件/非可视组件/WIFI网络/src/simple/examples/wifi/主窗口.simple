' 读取当前 Wi-Fi 信息，申请定位权限后扫描附近网络。
事件 网络设置.被单击()
	WIFI1.打开WIFI设置()
结束 事件

事件 刷新信息.被单击()
	结果.文本 = "Wi-Fi 已开启：" & WIFI1.是否已开启() & "\nSSID：" & WIFI1.取当前SSID() & "\n内网 IP：" & WIFI1.取内网IP() & "\n网关：" & WIFI1.取网关() & "\nDNS：" & WIFI1.取DNS1() & " / " & WIFI1.取DNS2() & "\n信号等级（0-4）：" & WIFI1.取当前信号强度()
	位于 错误
		分支 否则
			结果.文本 = "读取被系统或权限限制，请检查网络设置。"
	结束 错误
结束 事件

事件 扫描按钮.被单击()
	如果 权限请求1.是否授权("android.permission.ACCESS_FINE_LOCATION") = 假 则
		结果.文本 = "请先请求定位权限，并按系统要求开启定位服务。"
		退出 事件
	结束 如果
	如果 WIFI1.开始扫描() 则
		结果.文本 = "扫描请求已接受，等待扫描完毕事件。"
	否则
		结果.文本 = "扫描请求被拒绝，可能是扫描频率、网络状态或权限限制。"
	结束 如果
	位于 错误
		分支 否则
			结果.文本 = "扫描调用失败，不将缓存结果当成本次扫描成功。"
	结束 错误
结束 事件

事件 WIFI1.扫描完毕()
	结果.文本 = "扫描结果：\n" & WIFI1.获取扫描结果()
结束 事件

事件 WIFI1.网络状态改变(状态 为 整数型)
	结果.加入文本("\n网络状态代码：" & 状态)
结束 事件

事件 WIFI1.开启状态改变(启用 为 逻辑型)
	结果.加入文本("\nWi-Fi 状态：" & 启用)
结束 事件

事件 主窗口.程序被销毁()
	WIFI1.销毁()
结束 事件

事件 申请权限.被单击()
	如果 权限请求1.请求权限("示例") 则
		结果.文本 = "已发起权限请求，请在系统界面选择；返回后再点击具体操作。"
	否则
		结果.文本 = "没有发起权限请求。请检查已授权状态或进入应用设置。"
	结束 如果
结束 事件

事件 权限请求1.请求结果(权限名称 为 文本型(), 授予结果 为 整数型(), 标记 为 文本型)
	结果.文本 = "权限请求结束，不代表全部已授权。\n"
	变量 索引 为 整数型
	循环 索引 = 0 至 取数组成员数(权限名称) - 1
		结果.加入文本(权限名称(索引) & "：" & 权限请求1.是否授权(权限名称(索引)) & "\n")
	下个
结束 事件

事件 打开权限设置.被单击()
	权限请求1.打开设置()
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "WIFI网络"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "读取当前 Wi-Fi 信息，申请定位权限后扫描附近网络。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 申请权限 $为 按钮
			文本 = "请求本例已声明的权限"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 打开权限设置 $为 按钮
			文本 = "打开本应用权限设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 WIFI1 $为 WIFI管理器
		$结束 $定义
		$定义 网络设置 $为 按钮
			文本 = "打开系统 Wi-Fi 设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 刷新信息 $为 按钮
			文本 = "读取当前网络信息"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 扫描按钮 $为 按钮
			文本 = "请求扫描附近 Wi-Fi"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
