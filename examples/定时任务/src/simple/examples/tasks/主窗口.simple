''' 单次／重复服务、启动应用与任务取消分别演示，不把系统调度当作保活。
常量 服务编号 为 整数型 = 101, 启动编号 为 整数型 = 102
静态 变量 反馈窗口 为 窗口

事件 主窗口.初始化()
	反馈窗口 = 本对象
	显示累计记录()
结束 事件

事件 单次服务.被单击()
	如果 参数内容.文本 = "" 则
		定时任务1.设置服务任务(服务编号, 取包名() & ".任务服务", 首次延迟())
	否则
		定时任务1.设置服务任务(服务编号, 取包名() & ".任务服务", _
			首次延迟(), 参数内容.文本)
	结束 如果
	追加日志("已提交单次服务任务，编号 101。系统可能延迟执行。")

	位于 错误
		分支 否则
			追加日志("设置失败，请检查延迟输入及服务声明。")
	结束 错误
结束 事件

事件 循环服务.被单击()
	变量 间隔 为 长整数型
	间隔 = 到长整数(间隔秒.文本) * 1000
	如果 间隔 <= 0 则
		追加日志("重复间隔需要大于 0 秒。")
		退出 事件
	结束 如果
	定时任务1.设置服务任务(服务编号, 取包名() & ".任务服务", _
		首次延迟(), 间隔, 参数内容.文本)
	追加日志("已覆盖为循环服务任务，编号 101；实际间隔可能被系统延长。")

	位于 错误
		分支 否则
			追加日志("设置失败，请检查延迟与间隔输入。")
	结束 错误
结束 事件

事件 启动应用.被单击()
	如果 参数内容.文本 = "" 则
		定时任务1.设置启动任务(启动编号, 首次延迟())
	否则
		定时任务1.设置启动任务(启动编号, 首次延迟(), 参数内容.文本)
	结束 如果
	追加日志("已提交单次启动任务，编号 102。后台弹出界面可能被系统阻止。")

	位于 错误
		分支 否则
			追加日志("设置启动任务失败，请检查延迟输入。")
	结束 错误
结束 事件

事件 取消服务.被单击()
	定时任务1.取消服务任务(服务编号, 取包名() & ".任务服务")
	追加日志("已取消服务任务 101，可重复取消。")
结束 事件

事件 取消启动.被单击()
	定时任务1.取消启动任务(启动编号)
	追加日志("已取消启动任务 102，可重复取消。")
结束 事件

''' 系统派发到主 Activity 后，在这里读取与服务相同的附加值。
事件 主窗口.程序被启动(启动意图 为 意图)
	如果 "simple.runtime.TIMER_TASK" = 启动意图.取动作() 则
		追加日志("应用被任务启动：编号=" & 启动意图.取附加("任务编号") & _
			"，参数=" & 启动意图.取附加("参数"))
	结束 如果
结束 事件

''' 服务通过投递消息回到主线程，不在服务线程直接操作界面。
事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	显示累计记录()
结束 事件

事件 刷新记录.被单击()
	显示累计记录()
结束 事件

''' 清空演示结果只影响计数，不取消任务；取消按钮需要显式操作。
事件 清空记录.被单击()
	清空累计记录()
	任务日志.文本 = "已清空服务记录。\n"
	显示累计记录()
结束 事件

事件 主窗口.程序被销毁()
	' 任务交给系统保管，窗口销毁只释放界面引用，不取消任务。
	反馈窗口 = 空
结束 事件

函数 首次延迟() 为 长整数型
	变量 秒数 为 长整数型
	秒数 = 到长整数(延迟秒.文本)
	断言真(秒数 >= 0 且 秒数 <= 86400)
	首次延迟 = 秒数 * 1000
结束 函数

过程 追加日志(内容 为 文本型)
	任务日志.文本 = 任务日志.文本 & 内容 & "\n"
结束 过程

''' 服务把结果写入私有 JSON 文件，窗口重建后仍能读取。
过程 显示累计记录()
	变量 记录 为 JSON值
	如果 取反 文件是否存在("task-result.json") 则
		清空累计记录()
	结束 如果
	记录 = 创建 JSON值
	断言真(记录.解析对象(读入文本文件("task-result.json", "UTF-8")))
	统计.文本 = "服务累计执行：" & 到文本(记录.取整数("次数"))
	追加日志("最后记录：" & 记录.取文本("最后记录"))
结束 过程

过程 清空累计记录()
	变量 记录 为 JSON值
	记录 = 创建 JSON值
	记录.创建对象()
	记录.置整数("次数", 0)
	记录.置文本("最后记录", "")
	断言真(写出文本文件("task-result.json", 记录.到文本(0), "UTF-8"))
结束 过程
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "定时任务"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 定时任务1 $为 定时任务
		$结束 $定义
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "系统非精确调度，可能延迟。服务任务和启动任务独立编号；请在离开示例前显式取消循环任务。"
			字体大小 = 14
		$结束 $定义
		$定义 延迟说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "首次延迟（秒，0～86400）"
			字体大小 = 14
		$结束 $定义
		$定义 延迟秒 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "5"
			单行模式 = 真
		$结束 $定义
		$定义 间隔说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "重复间隔（秒，建议不少于 60）"
			字体大小 = 14
		$结束 $定义
		$定义 间隔秒 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "60"
			单行模式 = 真
		$结束 $定义
		$定义 参数内容 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "来自定时任务"
			单行模式 = 真
		$结束 $定义
		$定义 单次服务 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "设置单次服务任务"
		$结束 $定义
		$定义 循环服务 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "设置循环服务任务"
		$结束 $定义
		$定义 启动应用 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "设置启动应用任务"
		$结束 $定义
		$定义 取消服务 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "取消服务任务"
		$结束 $定义
		$定义 取消启动 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "取消启动任务"
		$结束 $定义
		$定义 刷新记录 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "刷新累计记录"
		$结束 $定义
		$定义 清空记录 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "清空服务记录"
		$结束 $定义
		$定义 统计 $为 标签
			宽度 = 长度_匹配父级
			文本 = "服务累计执行：0"
		$结束 $定义
		$定义 任务日志 $为 标签
			宽度 = 长度_匹配父级
			文本 = "操作记录："
		$结束 $定义
	$结束 $定义
$结束 $属性
