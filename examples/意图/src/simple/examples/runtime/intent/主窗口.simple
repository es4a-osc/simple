' 意图：构造动作、限制包名，往返读取基本类型附加值。

事件 运行演示.被单击()

	变量 请求 为 意图
	请求 = 创建 意图
	请求.置动作("simple.examples.intent.DEMO")
	请求.置包名(取包名())
	请求.置附加("文本", "你好，Simple")
	请求.置附加("编号", 42)
	请求.置附加("启用", 真)
	断言真(请求.取动作() = "simple.examples.intent.DEMO")
	断言真(请求.取包名() = 取包名())
	断言真(请求.取附加("编号") = 42)
	断言真(请求.取附加("启用") = 真)
	结果.文本 = "自检通过\n动作：" & 请求.取动作() & "\n包名：" & 请求.取包名() & "\n文本：" & 请求.取附加("文本") & "\n编号：" & 请求.取附加("编号")
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "意图"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "构造动作、限制包名，往返读取基本类型附加值。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
