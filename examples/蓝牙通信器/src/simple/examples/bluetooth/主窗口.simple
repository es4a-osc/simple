' 经典蓝牙配对列表、搜索、聊天监听与字节收发。
变量 成_已连接 为 逻辑型

事件 开启蓝牙.被单击()
	如果 蓝牙1.是否存在() = 假 则
		结果.文本 = "本机没有蓝牙适配器。"
		退出 事件
	结束 如果
	蓝牙1.开启蓝牙()
结束 事件

事件 列出配对.被单击()
	变量 设备 为 集合
	设备 = 蓝牙1.取已配对设备()
	变量 索引 为 整数型
	变量 行 为 文本型()
	结果.文本 = "已配对设备："
	如果 设备.计数 = 0 则
		结果.文本 = "没有已配对设备，请先在系统设置中完成配对。"
		退出 事件
	结束 如果
	循环 索引 = 0 至 设备.计数 - 1
		行 = 设备.项目(索引)
		结果.加入文本("\n" & 行(0) & " " & 行(1))
	下个
	位于 错误
		分支 否则
			结果.文本 = "读取设备失败，请检查蓝牙状态与权限。"
	结束 错误
结束 事件

事件 搜索按钮.被单击()
	如果 权限请求1.是否授权("android.permission.ACCESS_FINE_LOCATION") = 假 则
		结果.文本 = "请先请求定位权限；部分系统还要求开启定位服务。"
		退出 事件
	结束 如果
	蓝牙1.搜索设备()
	结果.文本 = "已请求搜索，发现的设备会追加到此处。"
	位于 错误
		分支 否则
			结果.文本 = "搜索未能启动，请检查系统限制。"
	结束 错误
结束 事件

事件 停止搜索.被单击()
	蓝牙1.停止搜索()
结束 事件

事件 聊天监听.被单击()
	蓝牙1.置工作模式(1)
	结果.文本 = "已请求聊天模式监听；另一台运行本例的设备使用相同 UUID 主动连接。"
	位于 错误
		分支 否则
			结果.文本 = "监听请求失败。"
	结束 错误
结束 事件

事件 连接按钮.被单击()
	蓝牙1.连接设备(地址输入.文本)
	位于 错误
		分支 否则
			结果.文本 = "地址格式、蓝牙状态或权限有误。"
	结束 错误
结束 事件

事件 发送按钮.被单击()
	如果 成_已连接 = 假 则 退出 事件
	变量 数据 为 字节型(3)
	数据(0) = 72
	数据(1) = 105
	数据(2) = 10
	蓝牙1.发送数据(数据)
结束 事件

事件 断开按钮.被单击()
	蓝牙1.断开连接()
结束 事件

事件 蓝牙1.蓝牙设置完毕(设置结果 为 整数型)
	结果.加入文本("\n蓝牙设置结果：" & 设置结果)
结束 事件

事件 蓝牙1.发现设备(名称 为 文本型, 地址 为 文本型, 已配对 为 逻辑型)
	结果.加入文本("\n" & 名称 & " " & 地址 & " 已配对=" & 已配对)
结束 事件

事件 蓝牙1.连接完毕(成功 为 逻辑型, 名称 为 文本型, 地址 为 文本型, 模式 为 整数型)
	成_已连接 = 成功
	结果.加入文本("\n连接结果：" & 成功 & " " & 名称 & " " & 地址 & " 模式=" & 模式)
结束 事件

事件 蓝牙1.收到数据(数据 为 字节型(), 名称 为 文本型, 地址 为 文本型)
	结果.加入文本("\n收到 " & 取数组成员数(数据) & " 字节，来自 " & 地址)
结束 事件

事件 蓝牙1.发送完毕(数据 为 字节型(), 名称 为 文本型, 地址 为 文本型)
	结果.加入文本("\n发送回调：" & 取数组成员数(数据) & " 字节，不代表对端业务已处理。")
结束 事件

事件 蓝牙1.连接断开()
	成_已连接 = 假
	结果.加入文本("\n连接断开。")
结束 事件

事件 主窗口.程序被销毁()
	蓝牙1.销毁()
结束 事件

事件 申请权限.被单击()
	如果 权限请求1.请求权限("示例") 则
		结果.文本 = "已发起权限请求，请在系统界面选择；返回后再点击具体操作。"
	否则
		结果.文本 = "没有发起权限请求。请检查已授权状态或进入应用设置。"
	结束 如果
结束 事件

事件 权限请求1.请求结果(权限名称 为 文本型(), 授予结果 为 整数型(), 标记 为 文本型)
	结果.文本 = "权限请求结束，不代表全部已授权。\n"
	变量 索引 为 整数型
	循环 索引 = 0 至 取数组成员数(权限名称) - 1
		结果.加入文本(权限名称(索引) & "：" & 权限请求1.是否授权(权限名称(索引)) & "\n")
	下个
结束 事件

事件 打开权限设置.被单击()
	权限请求1.打开设置()
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "蓝牙通信器"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "经典蓝牙配对列表、搜索、聊天监听与字节收发。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 申请权限 $为 按钮
			文本 = "请求本例已声明的权限"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 打开权限设置 $为 按钮
			文本 = "打开本应用权限设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 蓝牙1 $为 蓝牙通信器
		$结束 $定义
		$定义 开启蓝牙 $为 按钮
			文本 = "请求开启蓝牙"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 列出配对 $为 按钮
			文本 = "列出已配对设备"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 搜索按钮 $为 按钮
			文本 = "搜索附近设备"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 停止搜索 $为 按钮
			文本 = "停止搜索"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 聊天监听 $为 按钮
			文本 = "聊天模式：启动监听"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 地址输入 $为 编辑框
			文本 = "00:00:00:00:00:00"
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 连接按钮 $为 按钮
			文本 = "连接填写的 MAC 地址"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 发送按钮 $为 按钮
			文本 = "连接成功后发送 Hi 换行"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 断开按钮 $为 按钮
			文本 = "断开连接"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
