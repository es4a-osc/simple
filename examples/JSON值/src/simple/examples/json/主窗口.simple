' 先用离线响应学习 JSON，再选择是否请求 TCPLab 的实时响应。
' DNS 样本中的记录值仅用于说明结构，不代表域名当前解析结果。
事件 主窗口.初始化()
	载入IP数据()
结束 事件

事件 载入IP样本.被单击()
	载入IP数据()
结束 事件

过程 载入IP数据()
	JSON输入.文本 = 格式化JSON文本("{\"code\":200,\"msg\":\"ok\",\"data\":{\"target\":\"8.8.8.8\",\"ip\":\"8.8.8.8\",\"version\":4,\"addresses\":[],\"source\":\"geolite2\",\"isDomestic\":false,\"country\":\"US\",\"countryName\":\"美国\",\"province\":\"\",\"city\":\"\",\"isp\":\"\"}}", 2)
	操作结果.文本 = "已载入离线 IP 响应。可取属性名、读取嵌套数据或修改内容。"
结束 过程

事件 载入DNS样本.被单击()
	JSON输入.文本 = 格式化JSON文本("{\"code\":200,\"msg\":\"ok\",\"data\":{\"name\":\"example.com\",\"type\":\"A\",\"server\":{\"key\":\"cloudflare\",\"label\":\"Cloudflare\",\"ip\":\"1.1.1.1\"},\"elapsed\":10,\"rcode\":0,\"records\":[{\"name\":\"example.com\",\"type\":\"A\",\"ttl\":300,\"value\":\"192.0.2.1\"}]}}", 2)
	操作结果.文本 = "已载入离线 DNS 响应。records 是对象数组。"
结束 事件

事件 在线查询IP.被单击()
	在线查询IP.启用 = 假
	操作结果.文本 = "正在查询 8.8.8.8..."
	启动线程(本对象, "查询IP数据")
结束 事件

过程 查询IP数据()
	变量 请求 为 HTTP请求
	请求 = 创建 HTTP请求
	如果 请求.打开("https://tcp.lc/api/v2/ip/8.8.8.8?lang=zh") = 假 则
		投递消息("失败", "无法打开接口地址。")
		退出 过程
	结束 如果
	请求.连接超时 = 5000
	请求.读入超时 = 10000
	如果 请求.发送() = 假 则
		投递消息("失败", "请求失败，请检查网络；也可继续使用离线样本。")
		退出 过程
	结束 如果
	如果 请求.响应代码 <> 200 则
		投递消息("失败", "HTTP 状态：" & 请求.响应代码)
	否则
		投递消息("响应", 请求.响应文本)
	结束 如果

	位于 错误
		分支 否则
			投递消息("失败", "查询发生异常，可继续使用离线样本。")
	结束 错误
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	在线查询IP.启用 = 真
	如果 消息标记 = "响应" 则
		JSON输入.文本 = 附加参数
		读取当前数据()
	否则
		操作结果.文本 = 附加参数
	结束 如果
结束 事件

事件 读取属性名.被单击()
	变量 内容 为 JSON值
	内容 = 读取输入()
	如果 内容 = 空 则 退出 事件
	操作结果.文本 = "根属性：" & 连接数组文本(内容.取所有属性名(), ", ")
结束 事件

事件 读取数值.被单击()
	读取当前数据()
结束 事件

过程 读取当前数据()
	变量 内容 为 JSON值
	内容 = 读取输入()
	如果 内容 = 空 则 退出 过程
	操作结果.文本 = "业务状态：" & 内容.取整数("code") & "，消息：" & 内容.取文本("msg")
	如果 内容.取整数("code") <> 200 则 退出 过程
	如果 内容.是否为对象("data") = 假 则
		操作结果.加入文本("\n响应缺少 data 对象。")
		退出 过程
	结束 如果

	变量 数据 为 JSON值
	数据 = 内容.取对象("data")
	如果 数据.是否为数组("records") 则
		变量 记录 为 JSON值
		记录 = 数据.取数组("records")
		操作结果.加入文本("\n域名：" & 数据.取文本("name") & "，记录数：" & 记录.计数)
		变量 索引 为 整数型
		循环 索引 = 0 至 记录.计数 - 1
			变量 项目 为 JSON值
			项目 = 记录.取对象(索引)
			操作结果.加入文本("\n" & 项目.取文本("type") & " " & 项目.取文本("value") & "，TTL=" & 项目.取整数("ttl"))
		下个
	否则
		操作结果.加入文本("\nIP：" & 数据.取文本("ip") & "\n国家：" & 数据.取文本("countryName"))
		操作结果.加入文本("\nIP 版本：" & 数据.取整数("version") & "\n国内网络：" & 数据.取逻辑("isDomestic"))
	结束 如果
	如果 内容.是否存在("可选值") 则 操作结果.加入文本("\n可选值是否为 null：" & 内容.是否为空("可选值"))
结束 过程

事件 修改内容.被单击()
	变量 内容 为 JSON值
	内容 = 读取输入()
	如果 内容 = 空 则 退出 事件

	' 为响应增加自己的字段，不覆盖接口的业务状态和数据。
	内容.置文本("备注", "已在 Simple 中编辑")
	内容.置逻辑("已阅读", 真)
	内容.置空("可选值")
	变量 标签 为 JSON值
	标签 = 创建 JSON值
	标签.创建数组()
	标签.加入文本("JSON")
	标签.加入整数(2)
	内容.置数组("示例标签", 标签)
	JSON输入.文本 = 内容.到文本()
	操作结果.文本 = JSON输入.文本
结束 事件

' 所有编辑操作都先检查输入，避免损坏 JSON 后继续取值。
函数 读取输入() 为 JSON值
	变量 内容 为 JSON值
	内容 = 创建 JSON值
	如果 内容.解析对象(JSON输入.文本) 则
		读取输入 = 内容
	否则
		读取输入 = 空
		操作结果.文本 = "请输入有效的 JSON 对象；可点击上方按钮恢复样本。"
	结束 如果
结束 函数
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		布局 = 布局_线性
		标题 = "JSON值"
		$定义 样本操作 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 载入IP样本 $为 按钮
				文本 = "IP 样本"
			$结束 $定义
			$定义 载入DNS样本 $为 按钮
				文本 = "DNS 样本"
			$结束 $定义
			$定义 在线查询IP $为 按钮
				文本 = "在线查询 IP"
			$结束 $定义
		$结束 $定义
		$定义 JSON输入 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			提示文本 = "JSON文本"
		$结束 $定义
		$定义 面板1 $为 面板
			布局.方向 = 布局_方向_水平
			$定义 读取属性名 $为 按钮
				文本 = "取属性名"
			$结束 $定义
			$定义 读取数值 $为 按钮
				文本 = "取值"
			$结束 $定义
			$定义 修改内容 $为 按钮
				文本 = "置值"
			$结束 $定义
		$结束 $定义
		$定义 操作结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 0
			权重 = 1
			提示文本 = "操作结果"
		$结束 $定义
	$结束 $定义
$结束 $属性
