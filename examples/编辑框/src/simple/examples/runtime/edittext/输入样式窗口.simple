事件 编辑框1.获得焦点()
	编辑框1.文本 = "获得焦点"
结束 事件

事件 编辑框1.失去焦点()
	编辑框1.文本 = "失去焦点"
结束 事件

事件 编辑框2.文本改变(text 为 文本型, 传址 accept 为 逻辑型)
	编辑框2.文本颜色 = &HFF00FF00

	变量 i 为 整数型
	i = text
	' TODO 无效，待解决
	accept = 真

	位于 错误
		分支 转换错误
			accept = 假
	结束 错误
结束 事件

事件 输入样式窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		切换窗口(主窗口.窗口实例)
	结束 如果
结束 事件
$属性
	$资源 $窗口
	$定义 输入样式窗口 $为 窗口
		布局 = 1
		布局.方向 = 1
		滚动 = 真
		标题 = "编辑框 · 输入样式"
		$定义 编辑框1 $为 编辑框
			文本 = "焦点测试"
		$结束 $定义
		$定义 编辑框2 $为 编辑框
			文本 = "123"
			文本颜色 = &HFFFF0000
		$结束 $定义
		$定义 编辑框3 $为 编辑框
			文本 = "文本右边"
			内容对齐 = 2
			宽度 = -2
		$结束 $定义
		$定义 编辑框4 $为 编辑框
			文本 = "绿色背景"
			背景颜色 = &HFF00FF00
		$结束 $定义
		$定义 编辑框5 $为 编辑框
			文本 = "禁用"
			启用 = 假
		$结束 $定义
		$定义 编辑框6 $为 编辑框
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 编辑框7 $为 编辑框
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 编辑框8 $为 编辑框
			文本 = "大文本"
			字体大小 = 20
		$结束 $定义
		$定义 编辑框9 $为 编辑框
			文本 = "等宽字体文本：wiwiw"
			字体类型 = 3
		$结束 $定义
		$定义 编辑框10 $为 编辑框
			文本 = "绿色文本"
			文本颜色 = &HFF00FF00
		$结束 $定义
	$结束 $定义
$结束 $属性
