' 资产操作：查询 assets 目录；不能仅凭此接口准确区分空目录。

事件 运行演示.被单击()

	断言真(资产是否存在(""))
	断言真(资产是否为目录(""))
	断言假(资产是否为目录("说明.txt"))
	结果.文本 = "自检通过\n根目录存在：" & 资产是否存在("") & "\n根目录判定：" & 资产是否为目录("") & "\n普通文件判定为目录：" & 资产是否为目录("说明.txt")
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "资产操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "查询 assets 目录；不能仅凭此接口准确区分空目录。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
