' 主动复制和读取纯文本，不在启动或后台自动读取剪贴板。
事件 复制按钮.被单击()
	置剪贴板文本(输入文本.文本)
	结果.文本 = "已复制输入文本。点击读取按钮核对内容。"
结束 事件

事件 读取按钮.被单击()
	变量 内容 为 文本型
	内容 = 取剪贴板文本()
	结果.文本 = "读取长度：" & 取字符数(内容) & "\n内容：[" & 内容 & "]" & _
		"\n空结果也可能是非文本内容或系统限制读取。"
结束 事件

事件 检查按钮.被单击()
	如果 剪贴板是否有文本() 则
		结果.文本 = "当前第一项有可读取的非空文本。"
	否则
		结果.文本 = "当前没有可读取的非空文本；也可能是系统限制读取。"
	结束 如果
结束 事件

事件 空文本按钮.被单击()
	置剪贴板文本("")
	结果.文本 = "已写入空文本项目。这不等同于清除系统剪贴板。"
结束 事件

' 由用户明确点击后验证；会覆盖剪贴板，最后保留一个空文本项目。
事件 自检按钮.被单击()
	变量 项目 为 文本型(5)
	变量 索引 为 整数型
	项目(0) = "你好，Simple剪贴板！"
	项目(1) = "第一行\n第二行"
	项目(2) = "  前后空白  "
	项目(3) = "Simple" & UCS2解析("\\ud83d\\ude42")
	项目(4) = ""

	循环 索引 = 0 至 4
		置剪贴板文本(项目(索引))
		断言真(取剪贴板文本() = 项目(索引))
		断言真(剪贴板是否有文本() = (取字符数(项目(索引)) > 0))
	下个

	结果.文本 = "自检通过：5组文本，10项断言。\n覆盖中文、换行、空白、表情和空文本。"
	位于 错误
		分支 否则
			结果.文本 = "自检未通过：请确认应用具有输入焦点且系统允许读取剪贴板。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "剪贴板操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "复制、读取和判断纯文本。只在点击按钮时访问剪贴板；请勿输入敏感信息。"
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
		$定义 输入文本 $为 编辑框
			文本 = "你好，Simple剪贴板！"
			单行模式 = 假
			高度 = 100
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 复制按钮 $为 按钮
			文本 = "复制输入文本"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 读取按钮 $为 按钮
			文本 = "读取剪贴板文本"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 检查按钮 $为 按钮
			文本 = "判断是否有文本"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 空文本按钮 $为 按钮
			文本 = "写入空文本"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 自检按钮 $为 按钮
			文本 = "验证五组文本（覆盖剪贴板）"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 标签
			文本 = "等待操作。应用启动时不会读取剪贴板。"
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
	$结束 $定义
$结束 $属性
