' 数组操作：数组成员数、追加、插入、删除、过滤、连接和排序。

事件 运行演示.被单击()

	变量 数组 为 整数型(3)
	数组(0) = 3
	数组(1) = 1
	数组(2) = 2
	数组 = 数组排序(数组)
	断言真(取数组成员数(数组) = 3)
	断言真(数组(0) = 1)
	断言真(数组(2) = 3)
	数组 = 加入数组成员(数组, 4)
	数组 = 插入数组成员(数组, 0, 0)
	数组 = 删除数组成员(数组, 1)
	断言真(取数组成员数(数组) = 4)
	断言真(数组(0) = 0)
	结果.文本 = "自检通过\n排序后增删的数组：0、2、3、4。原数组与新数组长度按调用结果核对。"
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件

' 增删返回同类型新数组；排序直接修改数组并返回原数组。
事件 数组扩展演示.被单击()
	变量 原数组 为 整数型(2)
	变量 新数组 为 整数型()
	变量 文本数组 为 文本型()
	原数组(0) = 3
	原数组(1) = 1
	新数组 = 加入数组成员(原数组, 2)
	断言真(取数组成员数(原数组) = 2)
	断言真(取数组成员数(新数组) = 3)
	新数组 = 插入数组成员(新数组, 0, 0)
	断言真(新数组(0) = 0)
	新数组 = 删除数组成员(新数组, 1)
	新数组 = 数组排序(新数组)
	断言真(取数组成员数(新数组) = 3)
	断言真(新数组(0) = 0)
	断言真(新数组(1) = 1)
	断言真(新数组(2) = 2)

	文本数组 = simple.runtime.文本操作.分割文本("b|a|b|", "|")
	断言真(取数组成员数(文本数组) = 4)
	断言真(文本数组(3) = "")
	文本数组 = 过滤数组文本(文本数组, "b", 真)
	断言真(取数组成员数(文本数组) = 1)
	文本数组 = 分割文本("b|10|2|a", "|")
	文本数组 = 文本数组排序(文本数组)
	断言真(连接数组文本(文本数组, ",") = "10,2,a,b")
	结果.文本 = "数组扩展自检通过。\n原数组仍为 3、1。\n新数组经过追加、插入、删除和排序：0、1、2。\n文本排序：" & 连接数组文本(文本数组, ",") & "\n已验证分割保留末尾空项，过滤仍按既有规则去重。"
	位于 错误
		分支 否则
			结果.文本 = "数组扩展自检失败，请检查成员类型、索引及运行库版本。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "数组操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "数组成员数、追加、插入、删除、过滤、连接和排序。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 数组扩展演示 $为 按钮
			文本 = "数组扩展自检"
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
