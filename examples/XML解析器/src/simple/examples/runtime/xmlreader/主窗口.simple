' XML解析器：读取节点、属性、命名空间、编码和错误信息。
变量 成_解析器 为 XML解析器
变量 成_补充字符 为 文本型

事件 主窗口.初始化()
	成_解析器 = 创建 XML解析器
	成_补充字符 = UCS2解析("\\ud83d\\ude0a")
结束 事件

函数 样本文本() 为 文本型
	样本文本 = "<例:根 xmlns:例=\"urn:es4a:xml\" id=\"1001\" 例:标记=\"甲 &amp; &quot;乙&quot;\">前<空/><例:项>中文&lt;&amp;&gt;&quot;" & 成_补充字符 & "</例:项>后</例:根>"
结束 函数

事件 文档演示.被单击()
	成_解析器.解析文本(样本文本())
	校验文档(成_解析器)
	结果.文本 = "解析自检通过\n中文、补充字符、属性、命名空间、空节点和混合文本均已读取。"
	位于 错误
		分支 否则
			结果.文本 = "解析失败：" & 成_解析器.取错误信息()
	结束 错误
结束 事件

事件 边界自检.被单击()
	变量 编码 为 文本型(3)
	编码(0) = "UTF-8"
	编码(1) = "UTF-16"
	编码(2) = "GB18030"
	变量 索引 为 整数型
	变量 数据 为 字节型()
	变量 内容 为 文本型
	内容 = ""
	循环 索引 = 0 至 2
		数据 = 文本到字节("<?xml version=\"1.0\" encoding=\"" & 编码(索引) & "\"?>" & 样本文本(), 编码(索引))
		成_解析器.解析字节集(数据)
		校验文档(成_解析器)
		成_解析器.解析字节集(数据, 编码(索引))
		校验文档(成_解析器)
		内容 = 内容 & 编码(索引) & " 自动识别与指定编码通过\n"
	下个
	检查文本输入()
	循环 索引 = 1 至 3
		断言真(拒绝错误输入(索引))
	下个
	成_解析器.解析文本(样本文本())
	校验文档(成_解析器)
	断言真(成_解析器.取错误信息() = "")
	结果.文本 = "全部解析自检通过\n" & 内容 & "CDATA、错误输入和错误后恢复通过。"
	位于 错误
		分支 否则
			结果.文本 = "解析边界自检失败：" & 成_解析器.取错误信息()
	结束 错误
结束 事件

函数 拒绝错误输入(编号 为 整数型) 为 逻辑型
	变量 忽略 为 整数型
	变量 忽略文本 为 文本型
	成_解析器.重置()
	判断 编号
		分支 1
			成_解析器.解析文本("<根><子></根>")
			判断循环 成_解析器.读取下一个() <> XML解析器.节点_文档结束
			结束 判断循环
		分支 2
			忽略 = 成_解析器.取节点类型()
		分支 3
			成_解析器.解析文本("<根 id=\"1\"/>")
			忽略 = 成_解析器.读取下一个()
			忽略文本 = 成_解析器.取属性名称(1)
	结束 判断
	拒绝错误输入 = 假
	位于 错误
		分支 XML错误
			拒绝错误输入 = 成_解析器.取错误信息() <> ""
	结束 错误
结束 函数

过程 校验文档(解析器 为 XML解析器)
	断言真(解析器.取节点类型() = XML解析器.节点_文档开始)
	变量 开始数量 为 整数型
	变量 结束数量 为 整数型
	变量 文本数量 为 整数型
	变量 合并内容 为 文本型
	合并内容 = ""

	判断循环 解析器.读取下一个() <> XML解析器.节点_文档结束
		判断 解析器.取节点类型()
			分支 XML解析器.节点_开始
				开始数量 = 开始数量 + 1
				断言真(解析器.取行号() >= 1)
				断言真(解析器.取列号() >= 0)
				断言真(解析器.取节点内容() = "")
				如果 解析器.取节点深度() = 1 则
					断言真(解析器.取节点名称() = "根")
					断言真(解析器.取前缀() = "例")
					断言真(解析器.取命名空间() = "urn:es4a:xml")
					断言真(解析器.取属性个数() = 2)
					断言真(解析器.取指定属性内容("id") = "1001")
					断言真(解析器.取指定属性内容("urn:es4a:xml", "标记") = "甲 & \"乙\"")
					断言真(解析器.取指定属性内容("不存在") = "")
					检查根属性(解析器)
				否则
					断言真(解析器.取节点深度() = 2)
					如果 解析器.取节点名称() = "空" 则
						断言真(解析器.取命名空间() = "")
					结束 如果
				结束 如果
				' 重复读取没有消费掉当前开始节点。
				断言真(解析器.取节点类型() = XML解析器.节点_开始)
			分支 XML解析器.节点_结束
				结束数量 = 结束数量 + 1
				断言真(解析器.取属性个数() = 0)
			分支 XML解析器.节点_文本
				文本数量 = 文本数量 + 1
				合并内容 = 合并内容 & 解析器.取节点内容()
		结束 判断
	结束 判断循环

	断言真(开始数量 = 3)
	断言真(结束数量 = 3)
	断言真(文本数量 = 3)
	断言真(合并内容 = "前中文<&>\"" & 成_补充字符 & "后")
	断言真(解析器.取节点深度() = 0)
	断言真(解析器.读取下一个() = XML解析器.节点_文档结束)
结束 过程

过程 检查根属性(解析器 为 XML解析器)
	变量 索引 为 整数型
	变量 名称 为 文本型
	判断循环 索引 < 解析器.取属性个数()
		名称 = 解析器.取属性名称(索引)
		如果 名称 = "id" 则
			断言真(解析器.取属性内容(索引) = "1001")
			断言真(解析器.取属性前缀(索引) = "")
			断言真(解析器.取属性命名空间(索引) = "")
		否则
			断言真(名称 = "标记")
			断言真(解析器.取属性内容(索引) = "甲 & \"乙\"")
			断言真(解析器.取属性前缀(索引) = "例")
			断言真(解析器.取属性命名空间(索引) = "urn:es4a:xml")
		结束 如果
		索引 = 索引 + 1
	结束 判断循环
结束 过程

过程 检查文本输入()
	成_解析器.解析文本("<根>甲<![CDATA[<&>]]>乙<空/></根>")
	变量 内容 为 文本型
	变量 开始数量 为 整数型
	内容 = ""
	判断循环 成_解析器.读取下一个() <> XML解析器.节点_文档结束
		如果 成_解析器.取节点类型() = XML解析器.节点_文本 则
			内容 = 内容 & 成_解析器.取节点内容()
		否则如果 成_解析器.取节点类型() = XML解析器.节点_开始 则
			开始数量 = 开始数量 + 1
		结束 如果
	结束 判断循环
	断言真(开始数量 = 2)
	断言真(内容 = "甲<&>乙")
结束 过程
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "XML解析器"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 说明 $为 标签
			文本 = "读取节点、属性、命名空间与编码，验证解析错误及恢复。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 文档演示 $为 按钮
			文本 = "解析文档示例"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 边界自检 $为 按钮
			文本 = "边界与错误自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 520
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
