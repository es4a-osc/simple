' 格式化、时间戳、时区、日期增减及固定时长间隔。

事件 运行演示.被单击()
	' 月份编号沿用 0–11；日期对象保留自身时区。
	变量 时间 为 日期时间型
	时间 = 文本到时间("2026-10-16 12:30:45", "yyyy-MM-dd HH:mm:ss", 时区_上海)
	断言真(取年(时间) = 2026)
	断言真(取月份(时间) = 月份_十月)

	变量 时间戳 为 长整数型
	时间戳 = 到时间戳(时间)
	断言真(到时间戳(时间戳到时间(时间戳)) = 时间戳)

	' 省略时区时按设备默认时区解析，显式时区重载仍可用。
	变量 本地时间 为 日期时间型
	本地时间 = 文本到时间("2026-10-16 12:30:45", "yyyy-MM-dd HH:mm:ss")
	断言真(取时间时区(本地时间) = 取时区())

	变量 内容 为 文本型
	内容 = "自检通过\n上海：" & 格式化时间(时间, "yyyy-MM-dd HH:mm:ss Z")

	' 增减时间修改原对象；间隔方向为结束减去开始。
	变量 开始时间 为 日期时间型
	开始时间 = 时间戳到时间(时间戳)
	增减时间(时间, 日期_天, 7)
	断言真(取日(时间) = 23)
	断言真(取时间间隔(开始时间, 时间, 日期_星期) = 1)
	断言真(取时间间隔(时间, 开始时间, 日期_天) = -7)
	内容 = 内容 & "\n增加一星期：" & 格式化时间(时间, "yyyy-MM-dd HH:mm:ss")
	内容 = 内容 & "\n星期间隔：" & 取时间间隔(开始时间, 时间, 日期_星期)

	' 切换显示时区不改变时间点，上海到 UTC 不手工加减时间戳。
	时间戳 = 到时间戳(时间)
	置时间时区(时间, "UTC")
	断言真(到时间戳(时间) = 时间戳)
	断言真(格式化时间(时间, "yyyy-MM-dd HH:mm:ss") = "2026-10-23 04:30:45")
	内容 = 内容 & "\n同一时刻 UTC：" & 格式化时间(时间, "yyyy-MM-dd HH:mm:ss Z")

	' 文本便捷接口按设备时区显示，十位秒与十三位毫秒可表示同一时刻。
	断言真(时间戳到时间文本("1609459200") = 时间戳到时间文本("1609459200000"))
	断言真(时间戳到时间文本("") = "")
	内容 = 内容 & "\n当前日期：" & 取现行日期文本()
	内容 = 内容 & "\n当前时间：" & 取现行时间文本()
	内容 = 内容 & "\n时间戳文本：" & 时间戳到时间文本("1609459200000")
	结果.文本 = 内容

	位于 错误
		分支 否则
			结果.文本 = "日期时间自检失败。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "日期时间操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "格式化、时间戳、时区和日期增减。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示与自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
