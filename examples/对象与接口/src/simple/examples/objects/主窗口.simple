' 对象与接口 · 其它

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	如果 附加参数 = 空 则
		消息日志.加入文本("消息标记：" & 消息标记 & " 附加参数=空\n")
	否则
		消息日志.加入文本("消息标记：" & 消息标记 & " 附加参数：" & 附加参数 & "\n")
	结束 如果
结束 事件

事件 创建对象.被单击()
	变量 实例 为 示例对象
	实例 = 创建 示例对象
	消息日志.加入文本(实例.生成问候("示例用户") & "\n")
	显示提示框("接口常量=" & 示例接口.默认编号)
结束 事件

事件 显示变量.被单击()
	' 同一声明中可定义不同类型的变量。
	变量 a 为 整数型, b 为 文本型
	a = 100
	b = "我是中文"
	显示提示框(a & b)
结束 事件

事件 查看类型.被单击()
	' 可以向上转型
	变量 对象引用 为 对象
	对象引用 = "我是文本"

	显示提示框("对象类型=" & 取对象类名(对象引用))
结束 事件

事件 发送消息按钮.被单击()
	投递消息("窗口消息", "这条消息由反馈消息事件接收。")
结束 事件

事件 清空日志.被单击()
	消息日志.文本 = ""
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "对象与接口"
		布局 = 布局_线性
		标题 = "对象与接口"
		$定义 创建对象 $为 按钮
			文本 = "创建接口实现对象"
		$结束 $定义
		$定义 显示变量 $为 按钮
			文本 = "变量与文本"
		$结束 $定义
		$定义 查看类型 $为 按钮
			文本 = "对象引用"
		$结束 $定义
		$定义 发送消息按钮 $为 按钮
			文本 = "投递窗口消息"
		$结束 $定义
		$定义 清空日志 $为 按钮
			文本 = "清空日志"
		$结束 $定义
		$定义 消息日志 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
