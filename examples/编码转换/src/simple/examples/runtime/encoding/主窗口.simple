' 编码转换：UCS2、URL、Base64、字符集和十六进制字节编码。
' 每个 UTF-16 代码单元固定输出四位，覆盖低位字符、中文和表情。
事件 Unicode演示.被单击()
	变量 原文 为 文本型
	变量 编码文本 为 文本型
	原文 = "A中ࠀ" & UCS2解析("\\ud83d\\ude00") & "\n"
	编码文本 = UCS2编码(原文)
	断言真(UCS2解析(编码文本) = 原文)
	断言真(UCS2编码("A") = "\\u0041")
	断言真(UCS2编码("ࠀ") = "\\u0800")
	断言真(UCS2解析("\\u4E2D") = "中")
	断言真(UCS2编码(UCS2解析("\\ud83d\\ude00")) = "\\ud83d\\ude00")
	结果.文本 = "UCS2 自检通过。\n原文：" & 原文 & "\n编码：" & 编码文本 & "\n还原：" & UCS2解析(编码文本)
	位于 错误
		分支 否则
			结果.文本 = "UCS2 自检失败，请检查转换调用与运行库版本。"
	结束 错误
结束 事件

' 只编码参数值；空格与原有加号在往返后必须保持区别。
事件 URL演示.被单击()
	变量 原文 为 文本型
	变量 编码文本 为 文本型
	原文 = "中文 +/%&="
	编码文本 = URL编码(原文)
	断言真(编码文本 = "%E4%B8%AD%E6%96%87+%2B%2F%25%26%3D")
	断言真(URL解码(编码文本) = 原文)
	断言真(URL解码(URL编码(原文, "GBK"), "GBK") = 原文)
	结果.文本 = "URL 自检通过。\n原文：" & 原文 & "\nUTF-8：" & 编码文本 & "\nGBK：" & URL编码(原文, "GBK") & "\n还原：" & URL解码(编码文本)
	位于 错误
		分支 否则
			结果.文本 = "URL 自检失败，请检查参数和字符集。"
	结束 错误
结束 事件

' Base64 输入输出是字节；文本先明确字符集，再进行转换。
事件 BASE64演示.被单击()
	变量 编码文本 为 文本型
	变量 数据 为 字节型()
	变量 还原数据 为 字节型()
	变量 索引 为 整数型
	数据 = 文本到字节("你好，Simple！")
	编码文本 = Base64编码(数据)
	还原数据 = Base64解码(编码文本)
	断言真(取数组成员数(还原数据) = 取数组成员数(数据))
	循环 索引 = 0 至 取数组成员数(数据) - 1
		断言真(还原数据(索引) = 数据(索引))
	下个
	断言真(Base64编码(文本到字节("f")) = "Zg==")
	断言真(字节到文本(Base64解码(" Zg==\n")) = "f")
	断言真(字节到文本(Base64解码("Zg")) = "f")
	结果.文本 = "Base64 自检通过。\n原文：你好，Simple！\n编码：" & 编码文本 & "\n还原：" & 字节到文本(还原数据) & "\n已验证填充、换行和省略填充。"
	位于 错误
		分支 否则
			结果.文本 = "Base64 自检失败，请检查字节数据与运行库版本。"
	结束 错误
结束 事件

' 同一段中文在不同字符集下的字节不同，解码时使用相同字符集。
事件 字符集演示.被单击()
	变量 UTF8数据 为 字节型()
	变量 GBK数据 为 字节型()
	UTF8数据 = 文本到字节("中文")
	GBK数据 = 文本到字节("中文", "GBK")
	断言真(取数组成员数(UTF8数据) = 6)
	断言真(取数组成员数(GBK数据) = 4)
	断言真(字节到文本(UTF8数据) = "中文")
	断言真(字节到文本(GBK数据, "GBK") = "中文")
	结果.文本 = "字符集自检通过。\n原文：中文\nUTF-8 字节数：" & 取数组成员数(UTF8数据) & "\nGBK 字节数：" & 取数组成员数(GBK数据) & "\nGBK 还原：" & 字节到文本(GBK数据, "GBK")
	位于 错误
		分支 否则
			结果.文本 = "字符集自检失败，请检查编码名称。"
	结束 错误
结束 事件

' 各分支必须抛出可捕获错误；正常返回表示输入检查没有生效。
函数 拒绝无效输入(项目 为 整数型) 为 逻辑型
	变量 文本结果 为 文本型
	变量 字节结果 为 字节型()
	判断 项目
		分支 0
			文本结果 = UCS2解析("\\")
		分支 1
			文本结果 = UCS2解析("\\u12")
		分支 2
			文本结果 = UCS2解析("\\uGGGG")
		分支 3
			文本结果 = URL解码("%G0")
		分支 4
			字节结果 = 文本到字节("中文", "ES4A-INVALID-CHARSET")
		分支 5
			字节结果 = Base64解码("Zg===")
	结束 判断
	拒绝无效输入 = 假
	位于 错误
		分支 否则
			拒绝无效输入 = 真
	结束 错误
结束 函数

事件 异常演示.被单击()
	变量 索引 为 整数型
	循环 索引 = 0 至 5
		断言真(拒绝无效输入(索引))
	下个

	' 空内容是正常结果，与无效输入抛出错误区分。
	断言真(UCS2编码("") = "")
	断言真(UCS2解析("") = "")
	断言真(URL编码("") = "")
	断言真(URL解码("") = "")
	断言真(取数组成员数(文本到字节("")) = 0)
	断言真(取数组成员数(Base64解码("")) = 0)
	断言真(Base64编码(文本到字节("")) = "")
	断言真(字节到文本(文本到字节("")) = "")
	结果.文本 = "错误处理自检通过。\n已捕获 6 类无效输入：末尾转义、不完整转义、错误十六进制、错误 URL 转义、无效字符集、错误 Base64 填充。\n各编码的空内容返回空结果。"
	位于 错误
		分支 否则
			结果.文本 = "错误处理自检失败：无效输入未被拒绝或空内容转换异常。"
	结束 错误
结束 事件

事件 十六进制演示.被单击()
	变量 数据 为 字节型()
	数据 = 十六进制到字节集(输入十六进制.文本)
	断言真(字节集到十六进制(十六进制到字节集("00ff")) = "00FF")
	断言真(字节集到十六进制(十六进制到字节集("12ABC")) = "12AB")
	结果.文本 = "编码自检通过\n规范化文本：" & 字节集到十六进制(数据) & "\n字节数：" & 取字节集长度(数据) & "\n奇数末位被忽略，非法字符按接口的宽松规则转换。"
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "编码转换"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "UCS2、URL、Base64、字符集及十六进制字节编码。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 Unicode演示 $为 按钮
			文本 = "UCS2 转义与还原"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 URL演示 $为 按钮
			文本 = "URL 参数编码与解码"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 BASE64演示 $为 按钮
			文本 = "Base64 字节编码与解码"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 字符集演示 $为 按钮
			文本 = "UTF-8 与 GBK 字节转换"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 异常演示 $为 按钮
			文本 = "无效输入与空内容自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
		$定义 输入十六进制 $为 编辑框
			文本 = "00FF12"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 十六进制演示 $为 按钮
			文本 = "十六进制字节编码"
		$结束 $定义
	$结束 $定义
$结束 $属性
