' 从前台窗口发送服务意图，串行处理和取消均可脱离网络验证。
静态 变量 反馈窗口 为 窗口

事件 主窗口.初始化()
	反馈窗口 = 本对象
	服务日志.文本 = "窗口主线程=" & 取线程标识() & "\n"
结束 事件

事件 串行自检.被单击()
	变量 编号 为 整数型
	循环 编号 = 1 至 3
		发送自检("串行自检", 到文本(编号))
	下个
结束 事件

事件 取消自检.被单击()
	发送自检("可取消自检", "正在执行")
	发送自检("串行自检", "等待执行")
结束 事件

过程 发送自检(操作 为 文本型, 编号 为 文本型)
	变量 任务 为 意图
	任务 = 创建 意图
	任务.置动作(取包名() & ".任务服务")
	任务.置包名(取包名())
	任务.置附加("操作", 操作)
	任务.置附加("编号", 编号)
	服务日志.加入文本("启动请求受理：" & 启动服务(任务) & "；编号=" & 编号 & "\n")
结束 过程

事件 停止服务按钮.被单击()
	变量 任务 为 意图
	任务 = 创建 意图
	任务.置动作(取包名() & ".任务服务")
	任务.置包名(取包名())
	服务日志.加入文本("停止服务返回：" & 停止服务(任务) & "；排队任务取消，当前任务需要响应中断。\n")
结束 事件

事件 清空日志.被单击()
	服务日志.文本 = "窗口主线程=" & 取线程标识() & "\n"
结束 事件

事件 查询本机IP.被单击()
	发送查询("我的 IP", "")
结束 事件

事件 查询目标IP.被单击()
	变量 目标 为 文本型
	目标 = 目标IP.文本
	删首尾空(目标)
	如果 目标 = "" 则
		服务日志.加入文本("请输入目标 IP 或主机名。\n")
		退出 事件
	结束 如果
	发送查询("指定 IP", 目标)
结束 事件

' 动作名对应服务单元限定名；启动返回真仅表示系统受理，不表示处理完成。
过程 发送查询(操作 为 文本型, 目标 为 文本型)
	变量 任务 为 意图
	任务 = 创建 意图
	任务.置动作(取包名() & ".任务服务")
	任务.置包名(取包名())
	任务.置附加("操作", 操作)
	任务.置附加("目标", 目标)
	服务日志.加入文本("启动请求受理：" & 启动服务(任务) & "；操作=" & 操作 & "\n")
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	服务日志.加入文本(消息标记 & "：" & 附加参数 & "\n")
结束 事件

事件 主窗口.程序被销毁()
	反馈窗口 = 空
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		布局 = 布局_线性
		标题 = "服务"
		$定义 说明 $为 标签
			文本 = "先运行离线串行自检；处理线程与窗口主线程不同。普通服务受后台限制，不保证进程保活。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 串行自检 $为 按钮
			文本 = "串行自检（3 个任务）"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 取消自检 $为 按钮
			文本 = "开始可取消任务"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 停止服务按钮 $为 按钮
			文本 = "停止服务"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 清空日志 $为 按钮
			文本 = "清空日志"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 查询本机IP $为 按钮
			文本 = "通过服务查询我的 IP"
			高度 = "44dp"
		$结束 $定义
		$定义 面板1 $为 面板
			布局.方向 = 布局_方向_水平
			$定义 查询目标IP $为 按钮
				文本 = "查询指定 IP"
			$结束 $定义
			$定义 目标IP $为 编辑框
				宽度 = "180dp"
				提示文本 = "IP 或主机名"
				文本 = "8.8.8.8"
				单行模式 = 真
			$结束 $定义
		$结束 $定义
		$定义 服务日志 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = "300dp"
			字体大小 = 12
		$结束 $定义
		布局.方向 = 布局_方向_垂直
		滚动 = 真
	$结束 $定义
$结束 $属性
