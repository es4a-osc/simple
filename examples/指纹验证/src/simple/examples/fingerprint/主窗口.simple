' 应用保持前台时监听已录入指纹；验证提示由示例提供。
变量 事件次数 为 整数型
变量 取消后重启 为 逻辑型
变量 取消后销毁 为 逻辑型
变量 观察前事件数 为 整数型

事件 主窗口.初始化()
	显示状态()
结束 事件

事件 查询按钮.被单击()
	显示状态()
结束 事件

事件 开始按钮.被单击()
	观察计时器.启用 = 假
	开始一次()
结束 事件

事件 重复按钮.被单击()
	观察计时器.启用 = 假
	如果 指纹1.开始验证() 则
		记录("首次请求已受理。再次开始：" & 指纹1.开始验证() & "；应为假，原请求继续。")
	否则
		记录("首次请求未受理：" & 指纹1.错误信息 & "；不执行重复请求检查。")
	结束 如果
	显示状态()
结束 事件

事件 取消按钮.被单击()
	变量 原事件数 为 整数型
	原事件数 = 事件次数
	变量 原状态 为 逻辑型
	原状态 = 指纹1.正在验证
	指纹1.取消验证()
	如果 原状态 = 假 则
		记录("空闲取消新增事件数：" & (事件次数 - 原事件数) & "；应为 0。")
	结束 如果
	显示状态()
结束 事件

事件 重启按钮.被单击()
	观察计时器.启用 = 假
	如果 指纹1.开始验证() 则
		取消后重启 = 真
		指纹1.取消验证()
	否则
		记录("无法开始取消后重启检查：" & 指纹1.错误信息)
	结束 如果
	显示状态()
结束 事件

事件 重入按钮.被单击()
	观察计时器.启用 = 假
	如果 指纹1.开始验证() 则
		取消后销毁 = 真
		指纹1.取消验证()
	否则
		记录("无法开始取消事件内销毁检查：" & 指纹1.错误信息)
	结束 如果
	显示状态()
结束 事件

事件 设置按钮.被单击()
	如果 指纹1.打开设置() = 假 则
		记录("无法打开设置：" & 指纹1.错误信息)
	结束 如果
结束 事件

事件 销毁按钮.被单击()
	取消后重启 = 假
	取消后销毁 = 假
	观察前事件数 = 事件次数
	指纹1.销毁()
	指纹1.销毁()
	记录("重复销毁。开始验证：" & 指纹1.开始验证() & "；打开设置：" & 指纹1.打开设置() & "；应均为假。")
	指纹1.取消验证()
	观察计时器.启用 = 真
	显示状态()
结束 事件

事件 观察计时器.计时()
	观察计时器.启用 = 假
	记录("销毁后观察窗口内新增事件：" & (事件次数 - 观察前事件数) & "；应为 0。重开示例可恢复组件。")
结束 事件

事件 指纹1.验证成功()
	记录事件("验证成功。")
结束 事件

事件 指纹1.验证未通过()
	记录事件("指纹未匹配，可以继续尝试。")
结束 事件

事件 指纹1.验证提示(代码 为 整数型, 信息 为 文本型)
	记录事件("提示 " & 代码 & "：" & 信息)
结束 事件

事件 指纹1.验证取消()
	记录事件("验证已取消。")
	如果 取消后重启 则
		取消后重启 = 假
		记录("在取消事件内重新开始：" & 指纹1.开始验证() & "。旧回调不应结束新请求。")
	结束 如果
	如果 取消后销毁 则
		取消后销毁 = 假
		指纹1.销毁()
		记录("已在取消事件内销毁组件。")
	结束 如果
	显示状态()
结束 事件

事件 指纹1.验证错误(代码 为 整数型, 信息 为 文本型)
	记录事件("错误 " & 代码 & "：" & 信息)
结束 事件

过程 开始一次()
	如果 指纹1.开始验证() 则
		记录("验证已开始，请触摸指纹传感器。")
	否则
		记录("未开始：" & 指纹1.错误信息)
	结束 如果
	显示状态()
结束 过程

过程 记录事件(内容 为 文本型)
	事件次数 = 事件次数 + 1
	记录("事件 " & 事件次数 & "：" & 内容)
	显示状态()
结束 过程

过程 记录(内容 为 文本型)
	结果.文本 = 内容 & "\n\n" & 结果.文本
	日志输出.输出信息("指纹示例", 内容)
结束 过程

过程 显示状态()
	变量 状态文本 为 文本型
	判断 指纹1.取可用状态()
		分支 指纹1.状态_可用
			状态文本 = "可用，请点击开始验证。"
		分支 指纹1.状态_系统不支持
			状态文本 = "此系统不支持指纹验证，需要 Android 6.0 或以上。"
		分支 指纹1.状态_无指纹硬件
			状态文本 = "设备没有可用的指纹硬件。"
		分支 指纹1.状态_未设置锁屏
			状态文本 = "请先打开系统安全设置，设置安全锁屏。"
		分支 指纹1.状态_未录入指纹
			状态文本 = "请先在系统安全设置中录入指纹。"
		分支 指纹1.状态_权限不足
			状态文本 = "应用缺少 USE_FINGERPRINT 权限。"
		分支 指纹1.状态_已销毁
			状态文本 = "组件已销毁。"
		分支 否则
			状态文本 = "指纹服务暂不可用。"
	结束 判断
	状态.文本 = 状态文本 & "\n正在验证：" & 指纹1.正在验证
结束 过程

事件 主窗口.程序被销毁()
	观察计时器.启用 = 假
	指纹1.销毁()
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "指纹验证"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 指纹1 $为 指纹验证
		$结束 $定义
		$定义 观察计时器 $为 计时器
			启用 = 假
			间隔 = 8000
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "使用设备已录入的指纹。请在系统安全设置中准备锁屏和指纹，再开始验证。未匹配时可以继续尝试；离开应用会取消验证。"
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
		$定义 状态 $为 标签
			文本 = "正在检查设备条件。"
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
		$定义 查询按钮 $为 按钮
			文本 = "查询可用状态"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 开始按钮 $为 按钮
			文本 = "开始验证"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 重复按钮 $为 按钮
			文本 = "连续开始两次"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 取消按钮 $为 按钮
			文本 = "取消验证"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 重启按钮 $为 按钮
			文本 = "取消后在事件内重新开始"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 重入按钮 $为 按钮
			文本 = "取消事件内销毁组件"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 设置按钮 $为 按钮
			文本 = "打开安全设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 销毁按钮 $为 按钮
			文本 = "重复销毁并观察迟到事件"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 标签
			文本 = "验证结果："
			宽度 = 长度_匹配父级
			文本颜色 = 颜色_黑
		$结束 $定义
	$结束 $定义
$结束 $属性
