' 类型与进制转换、数值字节序、十六进制字节编码及固定结果自检。

事件 运行演示.被单击()
	断言真(到整数("42") = 42)
	断言真(字符(65) = "A")
	断言真(代码("A") = 65)
	断言真(求平方根(81) = 9)
	断言真(取绝对值(-7) = 7)

	' 反三角函数返回弧度；显示角度时再转换。
	变量 正弦角度 为 双精度小数型
	变量 余弦角度 为 双精度小数型
	正弦角度 = 弧度转角度(simple.runtime.数值运算.求反正弦(0.5))
	余弦角度 = 弧度转角度(求反余弦(0.5))
	断言真(取绝对值(正弦角度 - 30) < 0.000000001)
	断言真(取绝对值(余弦角度 - 60) < 0.000000001)
	断言真(求立方根(-8) = -2)
	断言真(求斜边(3, 4) = 5)

	' 金额使用十进制文本处理，固定两位，不经过普通浮点转换。
	断言真(simple.runtime.文本操作.格式化金额("12.3") = "12.30")
	断言真(格式化金额("1.005") = "1.01")
	断言真(格式化金额("-1.005") = "-1.01")
	断言真(格式化金额("9007199254740993.005") = "9007199254740993.01")

	变量 随机值 为 双精度小数型
	随机值 = 取随机数()
	断言真(随机值 >= 0 且 随机值 < 1)

	' 带范围的随机数包含上下限，四舍五入返回数值。
	变量 骰子 为 整数型
	骰子 = 取随机数(1, 6)
	断言真(骰子 >= 1 且 骰子 <= 6)
	断言真(取随机数(-2, -2) = -2)
	断言真(四舍五入(1.005, 2) = 1.01)
	断言真(四舍五入(-145, -1) = -150)

	变量 编码 为 文本型
	编码 = UCS2编码("中文")
	断言真(UCS2解析(编码) = "中文")

	变量 数据 为 字节型(3)
	数据(0) = 97
	数据(1) = 98
	数据(2) = 99
	变量 摘要 为 文本型
	摘要 = 取MD5值(数据)
	断言真(摘要 = "900150983CD24FB0D6963F7D28E17F72")

	' 进制转换负责数值表示与解析；数据转换负责数值字节序。
	断言真(simple.runtime.进制转换.十六进制到长整数("FF") = 255)
	断言真(整数到二进制(10) = "1010")
	断言真(二进制到长整数("1010") = 10)
	断言真(十六进制到长整数("0xFF") = 0)
	断言真(字节集到十六进制(整数到字节集(305419896)) = "78563412")
	断言真(字节集到整数(十六进制到字节集("78563412")) = 305419896)
	断言真(字节集到十六进制(长整数到字节集(1)) = "0000000000000001")
	断言真(字节集到长整数(十六进制到字节集("0000000000000001")) = 1)
	断言真(字节集到十六进制(双精度小数到字节集(1)) = "3FF0000000000000")
	断言真(字节集到双精度小数(十六进制到字节集("3FF0000000000000")) = 1)

	变量 单字节 为 字节型
	单字节 = -1
	断言真(取字节无符号值(单字节) = 255)
	断言真(字节集到十六进制(十六进制到字节集("00ff")) = "00FF")
	断言真(字节集到十六进制(十六进制到字节集("12ABC")) = "12AB")
	断言真(字节集到十六进制(十六进制到字节集("GG")) = "00")
	断言真(字节集到整数(十六进制到字节集("01")) = 0)

	' 格式化输出随系统区域变化，示例展示结果，不按固定分隔符断言。
	结果.文本 = "自检通过：转换与数学接口；数值格式化结果见下方。" & _
		"\n反正弦 0.5 的角度：" & 正弦角度 & _
		"\n反余弦 0.5 的角度：" & 余弦角度 & _
		"\n-8 的立方根：" & 求立方根(-8) & _
		"\n直角边 3、4 的斜边：" & 求斜边(3, 4) & _
		"\n金额 12.3：" & 格式化金额("12.3") & _
		"\n金额 1.005：" & 格式化金额("1.005") & _
		"\n补零 42（0000）：" & simple.runtime.文本操作.格式化数值("0000", 42) & _
		"\n分组 1234.5（#,##0.00）：" & 格式化数值("#,##0.00", 1234.5) & _
		"\n百分比 0.1251（0%）：" & 格式化数值("0%", 0.1251) & _
		"\n科学计数 12300（0.00E0）：" & 格式化数值("0.00E0", 12300) & _
		"\n中点舍入 2.5 / 3.5（0）：" & 格式化数值("0", 2.5) & " / " & 格式化数值("0", 3.5) & _
		"\n42 的十六进制：" & 十六进制(42) & _
		"\n90 度弧度：" & 角度转弧度(90) & _
		"\n随机数 [0,1)：" & 随机值 & _
		"\n骰子 [1,6]：" & 骰子 & _
		"\n1.005 保留两位：" & 四舍五入(1.005, 2) & _
		"\n-145 舍入到十位：" & 四舍五入(-145, -1) & _
		"\nUCS2：" & 编码 & "\nabc 的 MD5：" & 摘要
	位于 错误
		分支 否则
			结果.文本 = "转换或运算自检失败。"
	结束 错误
结束 事件

''' 从同一数值文本分别演示整数小端、长整数大端和双精度小数大端。
事件 数值转换.被单击()
	变量 整数值 为 整数型
	变量 长整数值 为 长整数型
	变量 小数值 为 双精度小数型
	整数值 = 到整数(输入数值.文本)
	长整数值 = 到长整数(输入数值.文本)
	小数值 = 到双精度小数(输入数值.文本)

	' 显示字节本身，不把十六进制文本当成字符编码。
	结果.文本 = "整数二进制：" & 整数到二进制(整数值) & "\n整数小端：" & 字节集到十六进制(整数到字节集(整数值)) & "\n长整数大端：" & 字节集到十六进制(长整数到字节集(长整数值)) & "\n双精度大端：" & 字节集到十六进制(双精度小数到字节集(小数值)) & "\n整数还原：" & 字节集到整数(整数到字节集(整数值)) & "\n长整数还原：" & 字节集到长整数(长整数到字节集(长整数值)) & "\n小数还原：" & 字节集到双精度小数(双精度小数到字节集(小数值))

	位于 错误
		分支 否则
			结果.文本 = "数值转换失败。"
	结束 错误
结束 事件

''' 十六进制数值解析与字节解码分别展示，避免混同二者的字节序和宽松规则。
事件 十六进制转换.被单击()
	变量 数据 为 字节型()
	数据 = 十六进制到字节集(输入十六进制.文本)

	结果.文本 = "作为十六进制数值：" & 十六进制到长整数(输入十六进制.文本) & "\n作为字节集：" & 字节集到十六进制(数据) & "\n字节数：" & 取字节集长度(数据) & "\n按整数小端还原：" & 字节集到整数(数据) & "\n按长整数大端还原：" & 字节集到长整数(数据) & "\n不足 4 或 8 字节时，相应数值转换返回 0。"

	如果 取字节集长度(数据) > 0 则
		结果.加入文本("\n首字节无符号值：" & 取字节无符号值(数据(0)))
	结束 如果

	结果.加入文本("\n解码沿用宽松规则：奇数末位忽略，非法字符仍映射，不用于格式校验。")
	位于 错误
		分支 否则
			结果.文本 = "十六进制转换失败。"
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "转换与运算"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "类型与进制、数值字节序、十六进制字节编码及固定结果自检。整数为小端，长整数和双精度小数为大端。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示与自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 输入数值 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "305419896"
			提示文本 = "十进制数值；普通类型转换失败返回 0"
			单行模式 = 真
		$结束 $定义
		$定义 数值转换 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "数值转字节集与还原"
		$结束 $定义
		$定义 输入十六进制 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "78563412"
			提示文本 = "十六进制文本，不含前缀或分隔符"
			单行模式 = 真
		$结束 $定义
		$定义 十六进制转换 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "十六进制数值与字节解码"
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 360
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
