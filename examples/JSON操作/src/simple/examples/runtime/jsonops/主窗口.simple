' JSON操作：函数创建 JSON 对象、数组、空值，以及解析和格式化文本。

事件 运行演示.被单击()

	变量 内容 为 JSON值
	变量 项目 为 JSON值
	变量 空值 为 JSON值
	内容 = 创建JSON对象()
	项目 = 创建JSON数组()
	空值 = 创建JSON空()
	内容.置文本("语言", "Simple")
	项目.加入整数(1)
	项目.加入整数(2)
	内容.置数组("项目", 项目)
	' 空值不提供对象或数组文本，用成员数验证创建结果。
	断言真(空值.计数 = 0)
	变量 文本 为 文本型
	文本 = 内容.到文本()
	内容 = 解析JSON文本(文本)
	断言真(内容.取文本("语言") = "Simple")
	结果.文本 = "自检通过\n默认格式化：\n" & 格式化JSON文本(文本) & "\n四空格缩进：\n" & 格式化JSON文本(文本, 4) & "\n空值已创建，成员数：" & 空值.计数
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "JSON操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "函数创建 JSON 对象、数组、空值，以及解析和格式化文本。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
