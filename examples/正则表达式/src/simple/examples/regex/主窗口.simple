' 编译表达式、查找分组、位置、替换与分割。
事件 运行演示.被单击()
	变量 表达式 为 正则表达式
	表达式 = 创建 正则表达式
	表达式.编译("([A-Za-z]+)=([0-9]+)")
	变量 待匹配文本 为 文本型
	待匹配文本 = "apple=12, pear=7"
	表达式.匹配(待匹配文本)
	变量 内容 为 文本型
	变量 数量 为 整数型
	' 批量查找返回完整匹配数组，仍可继续使用逐项匹配。
	变量 全部匹配 为 文本型()
	全部匹配 = 表达式.取全部匹配(待匹配文本)
	断言真(取数组成员数(全部匹配) = 2)
	内容 = "全部匹配：" & 连接数组文本(全部匹配, " / ")

	判断循环 表达式.匹配下一个()
		断言真(表达式.取子匹配数() = 2)
		内容 = 内容 & "\n" & 表达式.取子匹配文本(1) & " -> " & 表达式.取子匹配文本(2) & "，范围 [" & 表达式.取开始位置() & "," & 表达式.取结束位置() & ")"
		数量 = 数量 + 1
	结束 判断循环
	断言真(数量 = 2)

	表达式.匹配(待匹配文本)
	内容 = 内容 & "\n替换：" & 表达式.替换("$1=已隐藏")
	表达式.编译("[,;]+", 0)
	变量 项目 为 文本型()
	项目 = 表达式.分割("甲,乙;丙")
	断言真(取数组成员数(项目) = 3)

	结果.文本 = "自检通过" & 内容 & "\n分割：" & 连接数组文本(项目, " / ")
	位于 错误
		分支 否则
			结果.文本 = "正则自检失败；必须先编译，再匹配，找到匹配后才能读取分组。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "正则表达式"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "编译表达式、查找分组、位置、替换与分割。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示与自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
