' 查看应用信息、保存和重新读取设置，输出运行日志。
事件 主窗口.初始化()
	刷新信息()
结束 事件

事件 保存按钮.被单击()
	保存设置("examples.message", 设置内容.文本)
	输出信息("运行库示例", "已保存 examples.message 设置。")
	刷新信息()
结束 事件

事件 读取按钮.被单击()
	设置内容.文本 = 到文本(读取设置("examples.message"))
	刷新信息()
结束 事件

过程 刷新信息()
	结果.文本 = "应用：" & 取应用名() & "\n包名：" & 取包名() & "\n版本：" & 取版本名() & " / " & 取版本号() & "\n已保存的值：" & 读取设置("examples.message") & "\n设备时间：" & 格式化时间(取现行时间(), "yyyy-MM-dd HH:mm:ss")
结束 过程

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "应用设置"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "查看应用信息、保存和重新读取设置，输出运行日志。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 设置内容 $为 编辑框
			文本 = "你好，Simple"
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 保存按钮 $为 按钮
			文本 = "保存本例设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 读取按钮 $为 按钮
			文本 = "重新读取设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
