' 资源操作 · RES资源
事件 主窗口.初始化()
	' 为演示和注释，将相关图片属性放到这设置
	' 来自系统：android.R.drawable.sym_def_app_icon
	图片框1.图片 = 17301651
	' 来自项目：assets\android.png
	图片框2.图片 = "android.png"
	' 来自项目：res\drawable\es4a.png
	图片框3.图片 = R.drawable_es4a
	' 来自项目：res\drawable\icon.png
	图片框4.图片 = "@drawable/icon"
	' 来自项目：res\drawable\login.9.png 九宫图片
	标签1.背景图片 = "@drawable/login"
	' 来自项目：res\drawable\wait.xml 指定背景样式，实现圆角矩形
	标签2.背景图片 = "@drawable/wait"
	' 来自项目：res\drawable\selctor_btn.xml 指定背景样式，实现按钮正常和按下效果
	按钮1.背景图片 = "@drawable/selctor_btn"
结束 事件

事件 资源信息.被单击()
	变量 标识 为 整数型
	标识 = 到资源标识("@drawable/es4a")
	断言真(标识 = 取资源标识("es4a", "drawable"))
	断言真(资源是否存在(标识))
	资源结果.文本 = "资源类型：" & 取资源类型(标识) & "\n资源名称：" & 取资源名称(标识)
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		$定义 资源信息 $为 按钮
			文本 = "读取资源信息"
		$结束 $定义
		$定义 资源结果 $为 标签
			文本 = "点击查看资源标识、类型与名称。"
			宽度 = 长度_匹配父级
		$结束 $定义
		布局 = 布局_线性
		标题 = "资源操作"
		布局.内容对齐 = 对齐_水平居中
		滚动 = 真
		$定义 图片框1 $为 图片框
			宽度 = 长度_适应内容
			高度 = 长度_适应内容
			顶边距 = "10dp"
		$结束 $定义
		$定义 图片框2 $为 图片框
			宽度 = "48dp"
			高度 = "64dp"
			顶边距 = "10dp"
		$结束 $定义
		$定义 图片框3 $为 图片框
			宽度 = 长度_适应内容
			高度 = 长度_适应内容
			顶边距 = "10dp"
		$结束 $定义
		$定义 图片框4 $为 图片框
			宽度 = "72dp"
			高度 = "72dp"
			顶边距 = "10dp"
		$结束 $定义
		$定义 标签1 $为 标签
			宽度 = "80dp"
			高度 = "40dp"
			顶边距 = "10dp"
			内容对齐 = 对齐_居中
			文本 = "标签1"
			文本颜色 = 颜色_白
		$结束 $定义
		$定义 标签2 $为 标签
			宽度 = "80dp"
			高度 = "40dp"
			顶边距 = "10dp"
			内容对齐 = 对齐_居中
			文本 = "标签2"
			文本颜色 = 颜色_白
		$结束 $定义
		$定义 按钮1 $为 按钮
			顶边距 = "10dp"
			宽度 = "80dp"
			高度 = "40dp"
			文本 = "按钮1"
			文本颜色 = 颜色_白
		$结束 $定义
	$结束 $定义
$结束 $属性
