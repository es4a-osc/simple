' 对照 MD5 摘要及 RC4、DES、Authcode 的既有加解密格式。

事件 RC4演示.被单击()
	如果 输入密钥.文本 = "" 则
		结果.文本 = "RC4 密钥不能为空。"
		退出 事件
	结束 如果

	变量 密文 为 文本型
	密文 = RC4加密(输入文本.文本, 输入密钥.文本)
	显示结果("RC4（GBK／十六进制）", 密文, RC4解密(密文, 输入密钥.文本))
结束 事件

事件 DES演示.被单击()
	如果 取文本字节数(DES密钥.文本, "GBK") <> 8 则
		结果.文本 = "DES 密钥按 GBK 编码后必须是 8 字节。"
		退出 事件
	结束 如果

	变量 密文 为 文本型
	密文 = DES加密(输入文本.文本, DES密钥.文本)
	显示结果("DES（固定 IV／GBK）", 密文, DES解密(密文, DES密钥.文本))
结束 事件

事件 Authcode演示.被单击()
	变量 密文 为 文本型
	密文 = Authcode加密(输入文本.文本, 输入密钥.文本)
	显示结果("Authcode（UTF-8／随机前缀）", 密文, Authcode解密(密文, 输入密钥.文本))
结束 事件

''' 展示原接口的字节集格式差异，使用固定向量避免混淆字符集。
事件 字节格式演示.被单击()
	变量 编码密文 为 字节型()
	编码密文 = RC4加密2(文本到字节("Plaintext"), "Key")

	变量 原始密文 为 字节型(9)
	原始密文(0) = -69
	原始密文(1) = -13
	原始密文(2) = 22
	原始密文(3) = -24
	原始密文(4) = -39
	原始密文(5) = 64
	原始密文(6) = -81
	原始密文(7) = 10
	原始密文(8) = -45

	结果.文本 = "固定明文：Plaintext；密钥：Key\nRC4加密2 返回的是十六进制字符的 ASCII 字节：\n" & 字节到文本(编码密文) & "\n返回长度：" & 取字节集长度(编码密文) & "\nRC4解密2 接收原始密文字节：\n" & 字节到文本(RC4解密2(原始密文, "Key")) & "\n不能把上述 18 字节的编码密文直接传给 RC4解密2。"
结束 事件

''' 以固定向量和既有密文核对格式，不只检查各自的往返。
事件 运行自检.被单击()
	断言真(取MD5值(文本到字节("abc")) = "900150983CD24FB0D6963F7D28E17F72")
	断言真(RC4加密("Plaintext", "Key") = "BBF316E8D940AF0AD3")
	断言真(RC4解密("BBF316E8D940AF0AD3", "Key") = "Plaintext")
	断言真(RC4加密("中文", "secret") = "3BE61CD8")
	断言真(字节到文本(RC4加密2(文本到字节("Plaintext"), "Key")) = "BBF316E8D940AF0AD3")

	断言真(DES加密("abc", "12345678") = "U+H0s6Ybcig=")
	断言真(DES解密("E9SrmGhEaTQ=", "12345678") = "中文")
	断言真(DES加密("abc", "short") = "")

	变量 密文 为 文本型
	密文 = Authcode加密("中文加密测试", "secret")
	断言真(密文 <> "")
	断言真(Authcode解密(密文, "secret") = "中文加密测试")
	断言真(Authcode解密("44ueDg231UQZwCuvK7mQhVaqK2Od7lZO94UrhihxQYrBiz0=", "secret") = "中文")
	断言真(Authcode解密("", "secret") = "2")
	断言真(Authcode解密("abcdA", "secret") = "")

	结果.文本 = "自检通过：MD5 固定摘要、RC4 固定向量与字节输出格式、DES 固定密文、Authcode 中文往返与既有密文。"
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对当前编译和安装的运行库版本。"
	结束 错误
结束 事件

''' 以实际明文比对标识结果，不能仅依据 Authcode 返回“2”判断失败。
过程 显示结果(算法 为 文本型, 密文 为 文本型, 明文 为 文本型)
	结果.文本 = 算法 & "\n密文：\n" & 密文 & "\n解密结果：\n" & 明文 & "\n与输入一致：" & (明文 = 输入文本.文本)
	如果 密文 = "" 则
		结果.加入文本("\n没有生成密文，请检查参数。")
	结束 如果
结束 过程
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "加密操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 说明 $为 标签
			文本 = "演示既有加密格式；RC4／DES 使用 GBK，Authcode 使用 UTF-8。Base64 属于编码转换。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 输入文本 $为 编辑框
			文本 = "中文"
			提示文本 = "待加密文本"
			宽度 = 长度_匹配父级
			单行模式 = 真
		$结束 $定义
		$定义 输入密钥 $为 编辑框
			文本 = "secret"
			提示文本 = "RC4／Authcode 文本密钥"
			宽度 = 长度_匹配父级
			单行模式 = 真
		$结束 $定义
		$定义 DES密钥 $为 编辑框
			文本 = "12345678"
			提示文本 = "DES 密钥：GBK 编码后 8 字节"
			宽度 = 长度_匹配父级
			单行模式 = 真
		$结束 $定义
		$定义 RC4演示 $为 按钮
			文本 = "RC4 文本加解密"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 DES演示 $为 按钮
			文本 = "DES 文本加解密"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 Authcode演示 $为 按钮
			文本 = "Authcode 文本加解密"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 字节格式演示 $为 按钮
			文本 = "RC4 字节集格式（固定向量）"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行自检 $为 按钮
			文本 = "运行固定向量与格式自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 300
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
