' 音效编号用于播放和卸载；播放编号用于暂停、继续和停止。
变量 成_音效一 为 整数型
变量 成_音效二 为 整数型
变量 成_播放一 为 整数型
变量 成_播放二 为 整数型
变量 成_错误音效 为 整数型
变量 成_成功次数 为 整数型
变量 成_就绪一 为 逻辑型
变量 成_就绪二 为 逻辑型
变量 成_已初始化 为 逻辑型

事件 主窗口.初始化()
	更新界面()
结束 事件

' 重新初始化会释放上一轮资源，旧编号不能保留使用。
事件 初始化载入.被单击()
	初始化并载入()
结束 事件

事件 快速重建.被单击()
	初始化并载入()
	初始化并载入()
	写日志("快速重建：只应收到最终一轮的两次成功事件。")
结束 事件

过程 初始化并载入()
	音效播放器1.初始化播放器(2)
	清空编号()
	成_已初始化 = 真

	成_音效一 = 音效播放器1.载入音效("tone-a.wav")
	成_音效二 = 音效播放器1.载入音效("tone-b.wav")
	写日志("已提交载入，音效编号：" & 成_音效一 & "、" & 成_音效二)
	更新界面()
结束 过程

事件 音效播放器1.载入完毕(音效编号 为 整数型)
	如果 音效编号 = 成_音效一 则 成_就绪一 = 真
	如果 音效编号 = 成_音效二 则 成_就绪二 = 真
	成_成功次数 = 成_成功次数 + 1
	写日志("载入成功：" & 音效编号 & "；本轮成功事件数：" & 成_成功次数)
	如果 成_成功次数 > 2 则 写日志("失败：出现多余的载入成功事件。")
	更新界面()
结束 事件

事件 音效播放器1.载入失败(音效编号 为 整数型, 失败状态 为 整数型)
	如果 音效编号 = 成_音效一 则 成_就绪一 = 假
	如果 音效编号 = 成_音效二 则 成_就绪二 = 假
	如果 音效编号 = 成_错误音效 则
		写日志("预期的异步载入失败：" & 音效编号 & "；状态：" & 失败状态)
	否则
		写日志("载入失败：" & 音效编号 & "；状态：" & 失败状态)
	结束 如果
	更新界面()
结束 事件

' 单参数重载只播放一次，返回的编号不能覆盖音效编号。
事件 单次播放.被单击()
	成_播放一 = 音效播放器1.播放音效(成_音效一)
	写日志("单次播放：音效=" & 成_音效一 & "，播放=" & 成_播放一)
	更新界面()
结束 事件

事件 双路循环.被单击()
	停止当前播放()
	成_播放一 = 音效播放器1.播放音效(成_音效一, -1)
	成_播放二 = 音效播放器1.播放音效(成_音效二, -1)
	写日志("双路循环播放编号：" & 成_播放一 & "、" & 成_播放二)
	更新界面()
结束 事件

事件 暂停音效.被单击()
	如果 成_播放一 > 0 则 音效播放器1.暂停播放(成_播放一)
	如果 成_播放二 > 0 则 音效播放器1.暂停播放(成_播放二)
	写日志("已提交暂停：" & 成_播放一 & "、" & 成_播放二)
结束 事件

事件 继续音效.被单击()
	如果 成_播放一 > 0 则 音效播放器1.继续播放(成_播放一)
	如果 成_播放二 > 0 则 音效播放器1.继续播放(成_播放二)
	写日志("已提交继续：" & 成_播放一 & "、" & 成_播放二)
结束 事件

事件 停止音效.被单击()
	停止当前播放()
	写日志("已停止当前播放；音效仍保留，可以再次播放。")
	更新界面()
结束 事件

过程 停止当前播放()
	如果 成_播放一 > 0 则 音效播放器1.停止播放(成_播放一)
	如果 成_播放二 > 0 则 音效播放器1.停止播放(成_播放二)
	成_播放一 = 0
	成_播放二 = 0
结束 过程

事件 卸载音效.被单击()
	如果 成_播放一 > 0 则 音效播放器1.停止播放(成_播放一)
	成_播放一 = 0
	变量 原编号 为 整数型
	原编号 = 成_音效一
	如果 音效播放器1.卸载音效(原编号) 则
		成_音效一 = 0
		成_就绪一 = 假
		断言真(音效播放器1.播放音效(原编号) = 0)
		写日志("已卸载音效一，旧音效编号不能再播放；音效二保持不变。")
	否则
		写日志("卸载未成功，请检查音效编号。")
	结束 如果
	更新界面()
结束 事件

事件 释放音效.被单击()
	音效播放器1.释放播放器()
	音效播放器1.释放播放器()
	清空编号()
	写日志("已释放两次；可再次初始化，旧编号全部失效。")
	更新界面()
结束 事件

' 同步打开失败与异步解码失败通过不同入口观察。
事件 失败检查.被单击()
	断言真(音效播放器1.载入音效("missing-sound.wav") = -1)
	断言真(音效播放器1.播放音效(0) = 0)
	断言假(音效播放器1.卸载音效(0))
	断言真(拒绝无效循环())
	成_错误音效 = 音效播放器1.载入音效("invalid.wav")
	写日志("同步边界自检通过；损坏音频载入编号：" & 成_错误音效)
	如果 成_错误音效 > 0 则
		写日志("等待损坏音频的异步失败事件。")
	否则
		写日志("系统已同步拒绝损坏音频。")
	结束 如果
结束 事件

函数 拒绝无效循环() 为 逻辑型
	变量 忽略 为 整数型
	忽略 = 音效播放器1.播放音效(成_音效一, -2)
	拒绝无效循环 = 假
	位于 错误
		分支 否则
			拒绝无效循环 = 真
	结束 错误
结束 函数

过程 清空编号()
	成_音效一 = 0
	成_音效二 = 0
	成_播放一 = 0
	成_播放二 = 0
	成_错误音效 = 0
	成_成功次数 = 0
	成_就绪一 = 假
	成_就绪二 = 假
	成_已初始化 = 假
结束 过程

过程 更新界面()
	单次播放.启用 = 成_就绪一
	双路循环.启用 = 成_就绪一 且 成_就绪二
	卸载音效.启用 = 成_就绪一
	失败检查.启用 = 成_已初始化
	暂停音效.启用 = 成_播放一 > 0 或 成_播放二 > 0
	继续音效.启用 = 暂停音效.启用
	停止音效.启用 = 暂停音效.启用
	状态.文本 = "音效编号：" & 成_音效一 & "、" & 成_音效二 & _
		"；成功事件数：" & 成_成功次数 & "\n播放编号：" & 成_播放一 & "、" & 成_播放二
结束 过程

过程 写日志(内容 为 文本型)
	日志.加入文本(内容 & "\n")
结束 过程
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "音效播放器"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 音效播放器1 $为 音效播放器
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "先初始化并等待载入成功。音效编号用于播放；播放编号用于暂停、继续、停止。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 状态 $为 标签
			宽度 = 长度_匹配父级
			文本 = "尚未初始化。"
		$结束 $定义
		$定义 控制行1 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 初始化载入 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "初始化并载入"
			$结束 $定义
			$定义 快速重建 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "快速重建检查"
			$结束 $定义
		$结束 $定义
		$定义 控制行2 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 单次播放 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "单次播放音效一"
			$结束 $定义
			$定义 双路循环 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "双音效循环播放"
			$结束 $定义
		$结束 $定义
		$定义 控制行3 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 暂停音效 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "暂停两个播放流"
			$结束 $定义
			$定义 继续音效 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "继续两个播放流"
			$结束 $定义
		$结束 $定义
		$定义 控制行4 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 停止音效 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "停止两个播放流"
			$结束 $定义
			$定义 卸载音效 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "卸载音效一"
			$结束 $定义
		$结束 $定义
		$定义 控制行5 $为 面板
			宽度 = 长度_匹配父级
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 释放音效 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "释放播放器"
			$结束 $定义
			$定义 失败检查 $为 按钮
				宽度 = 0
				权重 = 1
				文本 = "检查加载失败"
			$结束 $定义
		$结束 $定义
		$定义 日志 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 180
			单行模式 = 假
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
