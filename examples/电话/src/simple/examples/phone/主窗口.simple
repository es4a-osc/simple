' 电话功能按需申请权限，直接呼叫和删除记录均由用户明确确认。
事件 主窗口.初始化()
	操作选择.添加项目("设备能力与默认SIM状态")
	操作选择.添加项目("指定卡槽SIM状态")
	操作选择.添加项目("打开系统拨号界面")
	操作选择.添加项目("查询通话状态")
	操作选择.添加项目("开始监听通话状态")
	操作选择.添加项目("停止监听通话状态")
	操作选择.添加项目("读取本机号码")
	操作选择.添加项目("振动或停止振动")
	操作选择.添加项目("读取最近通话记录")
	操作选择.添加项目("按编号删除一条通话记录")
	操作选择.添加项目("释放电话组件（重启恢复）")
	操作选择.添加项目("退出示例")
	操作选择.现行选中项 = 0
结束 事件

' 只申请当前功能需要的一个权限，避免一次请求所有敏感权限。
过程 请求单项权限(权限名称 为 文本型)
	变量 权限列表 为 文本型(1)
	权限列表(0) = 权限名称
	如果 权限请求1.是否授权(权限名称) 则
		结果.文本 = "权限已授予：" & 权限名称
	否则
		如果 权限请求1.请求权限(权限列表, "电话示例") 则
			结果.文本 = "请在系统界面选择；返回后手动执行操作。"
		否则
			结果.文本 = "未发起权限请求，请检查系统版本及应用权限设置。"
		结束 如果
	结束 如果
结束 过程

事件 申请操作权限.被单击()
	判断 操作选择.现行选中项
		分支 3, 4
			请求单项权限("android.permission.READ_PHONE_STATE")
		分支 6
			请求单项权限("android.permission.READ_PHONE_NUMBERS")
		分支 8
			请求单项权限("android.permission.READ_CALL_LOG")
		分支 9
			请求单项权限("android.permission.WRITE_CALL_LOG")
		分支 否则
			结果.文本 = "所选操作无需申请危险权限。振动权限由系统安装时授予。"
	结束 判断
结束 事件

事件 执行操作.被单击()
	变量 记录列表 为 集合
	变量 记录 为 文本型()
	变量 索引 为 整数型
	变量 本机号码 为 文本型

	判断 操作选择.现行选中项
		分支 0
			结果.文本 = "电话可用：" & 电话1.可用
			如果 电话1.可用 则
				结果.加入文本("\n默认SIM状态：" & 电话1.取SIM卡状态())
			结束 如果
		分支 1
			结果.文本 = "卡槽SIM状态：" & 电话1.取SIM卡状态(操作参数.文本)
		分支 2
			电话1.启动拨号界面(电话号码.文本)
			结果.文本 = "已打开系统拨号界面，由用户确认拨打。"
		分支 3
			结果.文本 = "通话状态：" & 电话1.通话状态 & "（0空闲，1响铃，2摘机）"
		分支 4
			电话1.开始监听()
			电话1.开始监听()
			结果.文本 = "监听中：" & 电话1.监听中 & "。已重复调用，等待状态事件。"
		分支 5
			电话1.停止监听()
			电话1.停止监听()
			结果.文本 = "监听中：" & 电话1.监听中 & "。重复停止不重复注销。"
		分支 6
			本机号码 = 电话1.取本机号码()
			如果 本机号码 = "" 则
				结果.文本 = "系统未提供本机号码，空值不代表组件错误。"
			否则
				结果.文本 = "本机号码：" & 本机号码
			结束 如果
		分支 7
			电话1.振动(操作参数.文本)
			结果.文本 = "振动请求已提交，毫秒数：" & 操作参数.文本 & "（0为停止）。请观察设备实际反馈。"
		分支 8
			记录列表 = 电话1.取通话记录()
			结果.文本 = "通话记录数：" & 记录列表.计数 & "（最多100条）。\n"
			' 每项为文本数组：[编号、号码、缓存联系人名、类型、时间戳毫秒、时长秒]。
			循环 索引 = 0 至 记录列表.计数 - 1
				记录 = 记录列表.项目(索引)
				结果.加入文本("编号=" & 记录(0) & "，号码=" & 记录(1) & "，姓名=" & 记录(2) & "，类型=" & 记录(3) & "，时间戳=" & 记录(4) & "，时长秒=" & 记录(5) & "\n")
			下个
		分支 9
			如果 确认删除.选中 = 假 或 操作参数.文本 = "" 则
				结果.文本 = "请先查询记录，将目标编号填入参数并勾选删除确认。"
				退出 事件
			结束 如果
			结果.文本 = "确实删除记录：" & 电话1.删除通话记录(操作参数.文本)
			确认删除.选中 = 假
		分支 10
			电话1.销毁()
			电话1.销毁()
			结果.文本 = "组件已释放，监听中：" & 电话1.监听中 & "。再次使用请退出并重启示例。"
		分支 11
			终止()
	结束 判断

	位于 错误
		分支 否则
			结果.文本 = "操作失败：请检查参数、设备能力和当前实际授权。通话记录权限受系统及安装来源限制。"
	结束 错误
结束 事件

事件 电话1.通话状态改变(状态 为 整数型, 来电号码 为 文本型)
	' 首次监听也会返回当前状态；摘机不表示对方已接听，号码可能为空。
	结果.加入文本("\n通话状态事件：" & 状态 & "（0空闲，1响铃，2摘机），号码=" & 来电号码)
结束 事件

事件 申请权限.被单击()
	请求单项权限("android.permission.CALL_PHONE")
结束 事件

事件 拨打按钮.被单击()
	变量 号码 为 文本型
	号码 = 电话号码.文本
	删首尾空(号码)
	如果 号码 = "" 或 确认拨打.选中 = 假 则
		结果.文本 = "请填写自己的测试号码，并勾选确认。示例没有预置电话号码。"
		退出 事件
	结束 如果
	如果 权限请求1.是否授权("android.permission.CALL_PHONE") = 假 则
		结果.文本 = "请先授予呼叫权限。"
		退出 事件
	结束 如果
	电话1.呼叫(号码)
	结果.文本 = "已向系统发起呼叫请求，不表示电话已接通。"
	位于 错误
		分支 否则
			结果.文本 = "无法发起呼叫，请检查号码、权限和设备电话能力。"
	结束 错误
结束 事件

事件 权限请求1.请求结果(权限名称 为 文本型(), 授予结果 为 整数型(), 标记 为 文本型)
	结果.文本 = "权限请求结束，不代表全部已授权。\n"
	变量 索引 为 整数型
	循环 索引 = 0 至 取数组成员数(权限名称) - 1
		结果.加入文本(权限名称(索引) & "：" & 权限请求1.是否授权(权限名称(索引)) & "\n")
	下个
结束 事件

事件 打开权限设置.被单击()
	权限请求1.打开设置()
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "电话"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "按功能申请权限。通话状态不表示对方已接听；记录删除需填写编号并确认。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 200
			单行模式 = 假
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
		$定义 操作选择 $为 下拉列表框
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 操作参数 $为 编辑框
			文本 = "200"
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 参数说明 $为 标签
			文本 = "参数：卡槽索引（从0开始）/振动毫秒（0停止）/记录编号。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 申请操作权限 $为 按钮
			文本 = "申请所选操作权限"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 执行操作 $为 按钮
			文本 = "执行所选操作"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 确认删除 $为 复选框
			文本 = "确认删除参数中指定的一条通话记录（不可恢复）"
		$结束 $定义
		$定义 申请权限 $为 按钮
			文本 = "申请直接呼叫权限"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 打开权限设置 $为 按钮
			文本 = "打开本应用权限设置"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 电话1 $为 电话
		$结束 $定义
		$定义 电话号码 $为 编辑框
			文本 = ""
			单行模式 = 真
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 确认拨打 $为 复选框
			文本 = "确认拨打我填写的号码（可能产生通话费用）"
		$结束 $定义
		$定义 拨打按钮 $为 按钮
			文本 = "发起系统电话呼叫"
			宽度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
