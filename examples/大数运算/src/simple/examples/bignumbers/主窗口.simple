' 大数始终以文本传入，先转为普通浮点数再转回文本无法恢复精度。

事件 主窗口.初始化()
	运算选择.添加项目("加法")
	运算选择.添加项目("减法")
	运算选择.添加项目("乘法")
	运算选择.添加项目("除法")
	运算选择.添加项目("比较")
	运算选择.添加项目("求余")
	运算选择.添加项目("科学计数展开")
	运算选择.现行选中项 = 0

	位数选择.添加项目("小数位数：-2（舍入到百位）")
	位数选择.添加项目("小数位数：0（整数）")
	位数选择.添加项目("小数位数：2")
	位数选择.添加项目("小数位数：6")
	位数选择.现行选中项 = 2
结束 事件

''' 运算只接收输入框的文本，位数仅用于除法。
事件 计算.被单击()
	变量 数值一 为 文本型
	变量 数值二 为 文本型
	数值一 = 输入一.文本
	数值二 = 输入二.文本

	' 现有错误转换不能接住 Java 算术异常，除法与求余先检查零除数。
	如果 运算选择.现行选中项 = 3 或 运算选择.现行选中项 = 5 则
		如果 大数比较(数值二, "0") = 0 则
			结果.文本 = "运算失败：除数不能为零。"
			退出 事件
		结束 如果
	结束 如果

	变量 小数位数 为 整数型
	判断 位数选择.现行选中项
		分支 0
			小数位数 = -2
		分支 1
			小数位数 = 0
		分支 2
			小数位数 = 2
		分支 否则
			小数位数 = 6
	结束 判断

	' 比较返回整数，其余接口直接返回普通十进制文本。
	判断 运算选择.现行选中项
		分支 0
			结果.文本 = 大数相加(数值一, 数值二)
		分支 1
			结果.文本 = 大数相减(数值一, 数值二)
		分支 2
			结果.文本 = 大数相乘(数值一, 数值二)
		分支 3
			结果.文本 = 大数相除(数值一, 数值二, 小数位数)
		分支 4
			结果.文本 = "比较结果：" & 大数比较(数值一, 数值二) & "\n-1：小于；0：相等；1：大于"
		分支 5
			结果.文本 = 大数求余(数值一, 数值二)
		分支 否则
			结果.文本 = simple.runtime.文本操作.科学转普通计数(数值一)
	结束 判断

	位于 错误
		分支 否则
			结果.文本 = "运算失败：请输入有效数值文本，除法和求余的除数不能为零；输入不自动去除空白。"
	结束 错误
结束 事件

''' 用固定预期结果核对精度、舍入、文本格式及错误分支。
事件 运行自检.被单击()
	' 精确小数、超出浮点精确范围的整数及末尾零。
	断言真(大数相加("0.1", "0.2") = "0.3")
	断言真(大数相加("9007199254740993", "1") = "9007199254740994")
	断言真(大数相加("1.20", "2.3") = "3.50")
	断言真(大数相减("0.20", "0.3") = "-0.10")
	断言真(大数相乘("1.20", "2.0") = "2.400")

	' 正负中间值均向远离零方向舍入，负位数按百位舍入。
	断言真(大数相除("1", "3", 6) = "0.333333")
	断言真(大数相除("1.005", "1", 2) = "1.01")
	断言真(大数相除("-1.005", "1", 2) = "-1.01")
	断言真(大数相除("1250", "1", -2) = "1300")

	' 比较忽略末尾零，余数保留被除数符号。
	断言真(大数比较("1.0", "1.00") = 0)
	断言真(大数比较("9007199254740992", "9007199254740993") = -1)
	断言真(大数求余("-5", "3") = "-2")
	断言真(科学转普通计数("1.23E+5") = "123000")
	断言真(科学转普通计数("1E-3") = "0.001")

	断言真(拒绝非法文本())
	断言真(大数比较("0.00", "0") = 0)
	结果.文本 = "自检通过：16 项，覆盖 6 个大数运算接口及 1 个文本展开接口、精确小数、大整数、末尾零、正负舍入、负小数位、比较、负余数、科学计数、非法文本和零除数识别。"

	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对当前编译和安装的运行库版本。"
	结束 错误
结束 事件

''' 非法文本应进入错误处理，不能默默当成零。
函数 拒绝非法文本() 为 逻辑型
	变量 忽略结果 为 文本型
	忽略结果 = 科学转普通计数("abc")
	拒绝非法文本 = 假

	位于 错误
		分支 否则
			拒绝非法文本 = 真
	结束 错误
结束 函数
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "大数运算"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "数值以文本输入，支持小数和科学计数；科学计数展开只使用数值一。小数位数仅用于除法。"
			字体大小 = 14
		$结束 $定义
		$定义 输入一 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "9007199254740993"
			提示文本 = "数值一"
			单行模式 = 真
		$结束 $定义
		$定义 输入二 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "1"
			提示文本 = "数值二"
			单行模式 = 真
		$结束 $定义
		$定义 运算选择 $为 下拉列表框
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 位数选择 $为 下拉列表框
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 计算 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "计算"
		$结束 $定义
		$定义 运行自检 $为 按钮
			宽度 = 长度_匹配父级
			文本 = "运行固定结果自检"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			文本 = "等待操作。"
			高度 = 220
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
