''' 富文本框：内容可以直接编辑，选中后可设置或清除格式。
''' 所有区间采用 UTF-16 索引 [开始, 结束)，结束位置不包含。

变量 起点 为 整数型
变量 终点 为 整数型
变量 检查数量 为 整数型
变量 改变次数 为 整数型

''' 只替换内容时会清除旧格式；追加和插入保留已有区间格式。
过程 重置内容()
	编辑区.链接可点击 = 假
	编辑区.创建风格文本("富文本可编辑\n选中这里，再点加粗、红色或下划线。\n也可以直接输入文字。")
	编辑区.隐藏输入法()
	结果.文本 = "长按文字选择，或点击“选中开头”；样式作用于当前选区。"
结束 过程

事件 主窗口.初始化()
	重置内容()
结束 事件

事件 重置.被单击()
	重置内容()
结束 事件

''' 完整示范每种格式，图片来自本项目资产，不需要网络或存储权限。
过程 显示样式()
	编辑区.链接可点击 = 假
	编辑区.创建风格文本("富文本可编辑\n粗体 斜体 大字号\n红字 高亮 下划线 删除线\n上标2 下标2\n点击此链接\n项目一\n项目二\n图片：#")
	编辑区.置风格文本字体大小(22, 0, 6)
	编辑区.置风格文本字体样式(富文本框.字体样式_粗体, 7, 9)
	编辑区.置风格文本字体样式(富文本框.字体样式_斜体, 10, 12)
	编辑区.置风格文本字体大小(24, 13, 16)
	编辑区.置风格文本前景色(&HFFD32F2F, 17, 19)
	编辑区.置风格文本背景色(&HFFFFEB3B, 20, 22)
	编辑区.置风格文本下划线(23, 26)
	编辑区.置风格文本删除线(27, 30)
	编辑区.置风格文本上标(33, 34)
	编辑区.置风格文本下标(37, 38)
	编辑区.置风格文本超链接("demo://help", 39, 44)
	编辑区.置风格文本项目符(&HFF1565C0, 45, 52)
	编辑区.置风格文本图片("simple.png", 24, 24, 56, 57)
	编辑区.隐藏输入法()
	结果.文本 = "样式已就地生效。启用链接后点击蓝色文字；关闭链接可继续定位编辑。"
结束 过程

事件 样式演示.被单击()
	显示样式()
结束 事件

事件 选中开头.被单击()
	编辑区.选中文本(0, 取最小值(6, 取字符数(编辑区.文本)))
	结果.文本 = "选中：" & 编辑区.取选中文本()
结束 事件

''' 工具栏按钮不会重置内容；没有选区时提示用户先选择。
函数 读取选区() 为 逻辑型
	起点 = 取最小值(编辑区.选区开始, 编辑区.选区结束)
	终点 = 取最大值(编辑区.选区开始, 编辑区.选区结束)
	如果 起点 < 0 或 起点 = 终点 则
		结果.文本 = "请先长按选择文字，或点击“选中开头”。"
	否则
		读取选区 = 真
	结束 如果
结束 函数

事件 加粗.被单击()
	如果 读取选区() 则
		编辑区.置风格文本字体样式(富文本框.字体样式_粗体, 起点, 终点)
		结果.文本 = "已将选区设为粗体。"
	结束 如果
结束 事件

事件 红色.被单击()
	如果 读取选区() 则
		编辑区.置风格文本前景色(&HFFD32F2F, 起点, 终点)
		结果.文本 = "已将选区设为红色，区间外颜色保留。"
	结束 如果
结束 事件

事件 下划线.被单击()
	如果 读取选区() 则
		编辑区.置风格文本下划线(起点, 终点)
		结果.文本 = "已为选区添加下划线。"
	结束 如果
结束 事件

事件 清除格式.被单击()
	如果 读取选区() 则
		编辑区.清除文本格式(起点, 终点)
		结果.文本 = "已清除选区文字格式和链接；图片及区间外格式保留。"
	结束 如果
结束 事件

事件 链接模式.被单击()
	编辑区.链接可点击 = (编辑区.链接可点击 = 假)
	如果 编辑区.链接可点击 则
		结果.文本 = "链接点击已启用，请在样式演示中点击“点击此链接”。"
	否则
		结果.文本 = "链接点击已关闭，文字可正常选择编辑。"
	结束 如果
结束 事件

事件 编辑区.超链接被单击(网址 为 文本型)
	结果.文本 = "收到链接事件：" & 网址 & "\n由本应用处理，没有自动打开其它应用。"
结束 事件

事件 读取选择.被单击()
	结果.文本 = "选区 [" & 编辑区.选区开始 & ", " & 编辑区.选区结束 & ")：" & 编辑区.取选中文本()
结束 事件

事件 追加文字.被单击()
	编辑区.追加风格文本("\n追加的文字")
	结果.文本 = "追加完成，原有格式保留。"
结束 事件

事件 删除选择.被单击()
	如果 读取选区() 则
		编辑区.删除文本(起点, 终点)
		结果.文本 = "已删除选中文字，后续文字及格式随内容移动。"
	结束 如果
结束 事件

事件 编辑区.文本改变(内容 为 文本型, 传址 接受 为 逻辑型)
	接受 = 真
	改变次数 = 改变次数 + 1
结束 事件

''' 自检只核对可观察的文本、选区、事件与异常，格式外观请操作上方示例核对。
过程 检查(条件 为 逻辑型)
	断言真(条件)
	检查数量 = 检查数量 + 1
结束 过程

函数 越界被拒绝() 为 逻辑型
	编辑区.置风格文本下划线(-1, 1)
	位于 错误
		分支 索引超出界限错误
			越界被拒绝 = 真
	结束 错误
结束 函数

函数 图片缺失被拒绝() 为 逻辑型
	编辑区.置风格文本图片("missing-richtext.png", 0, 1)
	位于 错误
		分支 文件未存在错误
			图片缺失被拒绝 = 真
	结束 错误
结束 函数

事件 运行自检.被单击()
	检查数量 = 0
	改变次数 = 0
	编辑区.创建风格文本("abcdef")
	检查(编辑区.文本 = "abcdef")
	检查(改变次数 > 0)
	编辑区.选中文本(1, 4)
	检查(编辑区.选区开始 = 1)
	检查(编辑区.选区结束 = 4)
	检查(编辑区.取选中文本() = "bcd")
	编辑区.置风格文本前景色(&HFFD32F2F, 0, 6)
	编辑区.置风格文本前景色(&HFF1565C0, 2, 4)
	编辑区.清除文本格式(3, 4)
	检查(编辑区.文本 = "abcdef")
	编辑区.追加风格文本("ghi")
	检查(编辑区.文本 = "abcdefghi")
	编辑区.插入文本(1, "X")
	检查(编辑区.文本 = "aXbcdefghi")
	编辑区.删除文本(1, 2)
	检查(编辑区.文本 = "abcdefghi")
	检查(越界被拒绝())
	检查(编辑区.文本 = "abcdefghi")
	检查(图片缺失被拒绝())
	检查(编辑区.文本 = "abcdefghi")
	编辑区.置风格文本图片("simple.png", 0, 1)
	编辑区.置风格文本图片("simple.png", 32, 32, 1, 2)
	检查(编辑区.文本 = "abcdefghi")
	编辑区.清除文本格式(0, 9)
	检查(编辑区.文本 = "abcdefghi")
	编辑区.链接可点击 = 真
	检查(编辑区.链接可点击)
	编辑区.链接可点击 = 假
	检查(编辑区.链接可点击 = 假)
	编辑区.创建风格文本("A" & UCS2解析("\\ud83d\\ude00") & "B")
	编辑区.选中文本(1, 3)
	检查(编辑区.取选中文本() = UCS2解析("\\ud83d\\ude00"))
	编辑区.选中文本(0, 0)
	检查(编辑区.取选中文本() = "")
	编辑区.清除文本格式(0, 0)
	检查(编辑区.文本 = "A" & UCS2解析("\\ud83d\\ude00") & "B")
	显示样式()
	结果.文本 = "设备自检通过：" & 检查数量 & " 项。\n可继续选择、编辑和点击链接。"
	位于 错误
		分支 否则
			结果.文本 = "自检未通过，已完成 " & 检查数量 & " 项。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "富文本框"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		$定义 说明 $为 标签
			宽度 = 长度_匹配父级
			文本 = "可直接输入文字。长按选择后设置格式；样式演示包含链接和图片。"
			字体大小 = 14
		$结束 $定义
		$定义 编辑区 $为 simple.runtime.components.富文本框
			宽度 = 长度_匹配父级
			高度 = "280dp"
			字体大小 = 18
			单行模式 = 假
			内容对齐 = 对齐_左
			链接可点击 = 假
		$结束 $定义
		$定义 内容工具 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 重置 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "重置"
			$结束 $定义
			$定义 样式演示 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "样式演示"
			$结束 $定义
			$定义 选中开头 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "选中开头"
			$结束 $定义
		$结束 $定义
		$定义 文字工具 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 加粗 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "加粗"
			$结束 $定义
			$定义 红色 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "红色"
			$结束 $定义
			$定义 下划线 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "下划线"
			$结束 $定义
		$结束 $定义
		$定义 格式工具 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 清除格式 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "清除格式"
			$结束 $定义
			$定义 链接模式 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "链接开关"
			$结束 $定义
			$定义 读取选择 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "读取选区"
			$结束 $定义
		$结束 $定义
		$定义 编辑工具 $为 面板
			宽度 = 长度_匹配父级
			高度 = 长度_适应内容
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			$定义 追加文字 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "追加"
			$结束 $定义
			$定义 删除选择 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "删除选区"
			$结束 $定义
			$定义 运行自检 $为 按钮
				宽度 = 0
				权重 = 1
				高度 = "48dp"
				字体大小 = 13
				文本 = "运行自检"
			$结束 $定义
		$结束 $定义
		$定义 结果 $为 标签
			宽度 = 长度_匹配父级
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
