''' 演示 SQLite数据库 普通对象的独立连接与同步数据库操作。
''' 后台执行设备自检，并在成功与失败分支显式关闭连接。

变量 忙碌 为 逻辑型
变量 检查数量 为 整数型
变量 当前检查 为 文本型

''' 检查一项预期结果，并累计本轮通过数量。
过程 检查(条件 为 逻辑型, 说明 为 文本型)
	当前检查 = 说明
	断言真(条件)
	检查数量 = 检查数量 + 1
结束 过程

''' 验证指定失败操作能够由数据库错误分支捕获。
函数 期望错误(库 为 SQLite数据库, 操作 为 整数型) 为 逻辑型
	变量 数量 为 长整数型
	判断 操作
		分支 1
			数量 = 库.取记录数("用户")
		分支 2
			库.数据库执行("THIS IS NOT SQL")
		分支 3
			当前检查 = 库.范围查询("用户", -1, 1, "|", "\n")
		分支 4
			库.删除记录("用户", "")
		分支 5
			库.打开数据库("/")
		分支 6
			库.打开数据库("../outside.db")
		分支 7
			当前检查 = 库.数据库查询("SELECT * FROM 不存在的表", "|", "\n")
	结束 判断
	位于 错误
		分支 数据库错误
			期望错误 = 真
	结束 错误
结束 函数

''' 在两个独立数据库上验证连接隔离、查询格式及错误处理。
函数 执行自检(库 为 SQLite数据库, 辅库 为 SQLite数据库) 为 文本型
	变量 新建 为 逻辑型
	新建 = 库.创建数据库("es4a-sqlite-demo.db")
	检查(库.创建数据库("es4a-sqlite-demo.db") = 假, "已有数据库不覆盖")
	检查(期望错误(库, 1), "创建文件不自动打开实例连接")
	库.打开数据库("es4a-sqlite-demo.db")
	如果 库.数据表是否存在("用户") 则 库.删除数据表("用户")
	如果 库.数据表是否存在("A_first") 则 库.删除数据表("A_first")
	如果 库.数据表是否存在("引\"号") 则 库.删除数据表("引\"号")
	库.创建数据表("用户", "编号 integer primary key, 姓名 text")
	库.创建数据表("A_first", "值 text")
	检查(库.取记录数("用户") = 0, "空表计数")
	检查(库.查询最大值("用户", "编号") = 0, "空表最大值")
	检查(库.数据表是否存在("用户"), "表存在")
	检查(库.字段是否存在("用户", "编号"), "字段存在")
	检查(库.字段是否存在("用户", "缺少字段") = 假, "字段不存在")
	检查(库.字段是否存在("不存在的表", "编号") = 假, "表不存在时字段不存在")
	库.插入记录("用户", "1,'张三'")
	库.插入记录("用户", "2,'李四'")
	库.数据库执行("INSERT INTO 用户 VALUES (3,NULL)")
	库.数据库执行("DELETE FROM 用户 WHERE 编号=3")
	检查(库.取记录数("用户") = 2, "插入和 SQL 执行")
	检查(库.查询最大值("用户", "编号") = 2, "最大值")
	检查(库.条件查询("用户", "编号=2", "|", "\n") = "2|李四|\n", "条件查询及末尾分隔符")
	检查(库.范围查询("用户", 0, 1, "|", "\n") = "1|张三|\n", "范围从 0 开始")
	检查(库.范围查询("用户", 1, 1, "|", "\n") = "2|李四|\n", "范围偏移")
	检查(库.范围查询("用户", 0, 0, "|", "\n") = "", "范围条数为 0")
	检查(库.数据库查询("SELECT NULL", "|", "\n") = "null|\n", "SQL NULL 文本兼容")
	检查(库.条件查询("用户", "编号=999", "|", "\n") = "", "空查询结果")
	变量 表名 为 文本型()
	变量 索引 为 整数型
	表名 = 库.取所有数据表()
	检查(表名(0) = "A_first", "表列表不漏首表")
	循环 索引 = 0 至 取数组成员数(表名) - 1
		检查(表名(索引) <> "", "表列表无空占位项")
	下个
	库.创建数据表("引\"号", "值 text")
	库.插入记录("引\"号", "'引用正确'")
	检查(库.条件查询("引\"号", "1=1", "|", "\n") = "引用正确|\n", "引号表名按字面处理")
	库.修改记录("用户", "姓名='李四''改'", "编号=2")
	检查(库.条件查询("用户", "编号=2", "|", "\n") = "2|李四'改|\n", "修改和 SQL 引号")
	库.删除记录("用户", "编号=1")
	检查(库.取记录数("用户") = 1, "删除记录")
	辅库.打开数据库("es4a-sqlite-other.db")
	如果 辅库.数据表是否存在("用户") 则 辅库.删除数据表("用户")
	辅库.创建数据表("用户", "编号 integer, 姓名 text")
	辅库.插入记录("用户", "9,'另一数据库'")
	检查(辅库.查询最大值("用户", "编号") = 9, "第二实例独立连接")
	检查(库.查询最大值("用户", "编号") = 2, "第一实例未串库")
	检查(期望错误(库, 2), "错误 SQL 抛出数据库错误")
	检查(期望错误(库, 3), "负数偏移拒绝")
	检查(期望错误(库, 4), "空删除条件拒绝")
	检查(期望错误(库, 5), "新库打开失败报告错误")
	检查(库.取记录数("用户") = 1, "打开失败保留旧连接")
	检查(期望错误(库, 6), "相对路径越界拒绝")
	检查(期望错误(库, 7), "查询失败不冒充空结果")
	库.关闭数据库()
	检查(辅库.取记录数("用户") = 1, "关闭一个实例不影响另一个")
	库.打开数据库("es4a-sqlite-demo.db")
	检查(库.取记录数("用户") = 1, "关闭重开数据保留")
	库.打开数据库("es4a-sqlite-other.db")
	检查(库.查询最大值("用户", "编号") = 9, "同实例切换数据库")
	库.打开数据库("es4a-sqlite-demo.db")
	检查(库.查询最大值("用户", "编号") = 2, "切换后原库数据保留")
	库.删除数据表("引\"号")
	检查(库.数据表是否存在("引\"号") = 假, "删除数据表")
	变量 内容 为 文本型
	内容 = "主库：" & 库.数据库查询("SELECT * FROM 用户 ORDER BY 编号", "|", "\n") & "第二库：" & 辅库.数据库查询("SELECT * FROM 用户", "|", "\n")
	库.关闭数据库()
	库.关闭数据库()
	检查(期望错误(库, 1), "重复关闭安全且连接已释放")
	执行自检 = "自检通过：" & 检查数量 & " 项\n" & 内容 & "连接均将在过程结束前关闭。"
结束 函数

''' 在后台运行数据库自检，关闭两个连接后向窗口投递结果。
过程 后台自检()
	变量 库 为 SQLite数据库
	变量 辅库 为 SQLite数据库
	库 = 创建 SQLite数据库
	辅库 = 创建 SQLite数据库
	检查数量 = 0
	当前检查 = "打开数据库"
	变量 内容 为 文本型
	内容 = 执行自检(库, 辅库)
	库.关闭数据库()
	辅库.关闭数据库()
	投递消息(1, 内容)
	位于 错误
		分支 否则
			库.关闭数据库()
			辅库.关闭数据库()
			内容 = "自检失败：" & 当前检查
			内容 = 内容 & "；已完成 "
			内容 = 内容 & 检查数量
			内容 = 内容 & " 项。"
			投递消息(1, 内容)
	结束 错误
结束 过程

''' 启动数据库自检；当前任务完成前拒绝重复启动。
事件 运行演示.被单击()
	如果 忙碌 则 退出 事件
	忙碌 = 真
	结果.文本 = "正在后台执行数据库操作。"
	启动线程(本对象, "后台自检")
	位于 错误
		分支 否则
			忙碌 = 假
			结果.文本 = "无法启动数据库自检。"
	结束 错误
结束 事件

''' 显示后台自检结果，并恢复下一次操作。
事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	忙碌 = 假
	结果.文本 = 附加参数
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "SQLite数据库"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "SQLite 普通对象：后台执行、双数据库隔离、增删改查与错误自检。"
			宽度 = 长度_匹配父级
			单行模式 = 假
			文本颜色 = 颜色_黑
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示与自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 标签
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			单行模式 = 假
			文本颜色 = 颜色_黑
		$结束 $定义
	$结束 $定义
$结束 $属性
