' 其它操作：生成 GUID，读取当前单元短名和限定名。

事件 运行演示.被单击()

	变量 标识 为 文本型
	标识 = 生成GUID()
	断言真(取字符数(标识) = 36)
	结果.文本 = "GUID：" & 标识 & "\n单元名：" & 取单元名() & "\n单元类名：" & 取单元类名()
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "其它操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "生成 GUID，读取当前单元短名和限定名。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
