' 有序集合、按键取值、覆盖键和无序迭代。
事件 运行演示.被单击()
	变量 列表 为 集合
	列表 = 创建 集合
	列表.加入("第一项")
	列表.加入(42)
	列表.插入(1, "插入项")
	列表.替换(2, "替换项")
	断言真(列表.计数 = 3)
	断言真(列表.项目(1) = "插入项")
	列表.删除(0)
	断言真(列表.计数 = 2)
	变量 映射 为 哈希表
	映射 = 创建 哈希表
	映射.加入("语言", "Simple")
	映射.加入("数量", 列表.计数)
	映射.加入("语言", "中文 Simple")
	断言真(映射.计数 = 2)
	断言真(映射.是否包含键("语言"))
	断言真(映射.取值("语言") = "中文 Simple")
	变量 内容 为 文本型
	内容 = "自检通过\n集合数量：" & 列表.计数
	映射.迭代初始()
	判断循环 映射.迭代下个()
		内容 = 内容 & "\n" & 映射.迭代取键() & " = " & 映射.迭代取值()
	结束 判断循环
	映射.删除("数量")
	断言假(映射.是否包含键("数量"))
	结果.文本 = 内容 & "\n哈希表迭代顺序不固定。"
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请检查集合操作顺序。"
	结束 错误
结束 事件

$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "集合与哈希表"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "有序集合、按键取值、覆盖键和无序迭代。"
			文本颜色 = 颜色_黑
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示与自检"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 结果 $为 编辑框
			文本 = "等待操作。"
			宽度 = 长度_匹配父级
			高度 = 260
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
