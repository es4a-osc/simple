' 文本操作：文本查找、修剪、替换、提取与数值格式化。

事件 运行演示.被单击()

	变量 内容 为 文本型
	内容 = "  Simple,Android,Simple  "
	删首尾空(内容)
	断言真(寻找文本(内容, "Android") = 7)
	断言真(倒找文本(内容, "Simple") = 15)
	断言真(取文本中间(内容, 15) = "Simple")
	子文本替换(内容, "Simple", "ES4A", 0, 1)
	变量 大写 为 文本型
	大写 = 内容
	到大写(大写)
	断言真(取字符数("中文") = 2)
	断言真(取文本字节数("中文") = 6)
	断言真(取文本字节数("中文", "GBK") = 4)
	结果.文本 = "自检通过\n修剪与替换：" & 内容 & "\n大写：" & 大写 & "\n第二段：" & 取文本中间(内容, 5, 7)
	位于 错误
		分支 否则
			结果.文本 = "自检失败，请核对输入与运行条件。"
	结束 错误
结束 事件

' 明确区分 UTF-16 长度、编码字节数和字面替换。
事件 文本扩展演示.被单击()
	变量 内容 为 文本型
	变量 提取结果 为 文本型()
	断言真(取字符数("中文") = 2)
	断言真(取文本字节数("中文") = 6)
	断言真(取文本字节数("中文", "GBK") = 4)
	内容 = "   "
	删尾空(内容)
	断言真(内容 = "")

	内容 = "a.a.a"
	子文本替换(内容, ".", "$1\\x", 0, 2)
	断言真(内容 = "a$1\\xa$1\\xa")
	内容 = "aa"
	子文本替换(内容, "a", "aa", 0, 2)
	断言真(内容 = "aaaa")
	替换文本区间(内容, 1, 2, "XY")
	断言真(内容 = "aXYa")

	提取结果 = 取全部标记间文本("<p>甲\n乙</p><p></p><p>丙</p>", "<p>", "</p>")
	断言真(取数组成员数(提取结果) = 3)
	断言真(提取结果(0) = "甲\n乙")
	断言真(提取结果(1) = "")
	断言真(取标记间文本("前[内容]后", "[", "]") = "内容")
	结果.文本 = "文本扩展自检通过。\n中文：2 个 UTF-16 单元，UTF-8 为 6 字节，GBK 为 4 字节。\n全空格修剪、字面替换和按区间替换均通过。\n替换结果：" & 内容 & "\n提取：" & 连接数组文本(提取结果, " / ")
	位于 错误
		分支 否则
			结果.文本 = "文本扩展自检失败，请检查参数及运行库版本。"
	结束 错误
结束 事件

事件 格式化演示.被单击()
	断言真(格式化金额("12.3") = "12.30")
	断言真(格式化金额("1.005") = "1.01")
	断言真(格式化金额("-1.005") = "-1.01")
	断言真(格式化金额("9007199254740993.005") = "9007199254740993.01")
	结果.文本 = "自检通过\n金额 12.3：" & 格式化金额("12.3") & "\n金额 1.005：" & 格式化金额("1.005") & "\n补零 42：" & 格式化数值("0000", 42) & "\n分组：" & 格式化数值("#,##0.00", 1234.5) & "\n百分比：" & 格式化数值("0%", 0.1251) & "\n科学计数：" & 格式化数值("0.00E0", 12300) & "\n中点舍入：" & 格式化数值("0", 2.5) & " / " & 格式化数值("0", 3.5)
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "文本操作"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "文本查找、修剪、替换、提取与数值格式化。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 文本扩展演示 $为 按钮
			文本 = "文本扩展自检"
		$结束 $定义
		$定义 格式化演示 $为 按钮
			文本 = "数值与金额格式化"
		$结束 $定义
		$定义 运行演示 $为 按钮
			文本 = "运行演示"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 320
			字体大小 = 14
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
