事件 邮箱输入窗口.初始化()
	刷新权限()
	结果.文本 = "先尝试手动输入，再申请通讯录权限。输入姓名或邮箱片段后选择候选；以下保留文字样式示例。"
结束 事件

事件 申请通讯录权限.被单击()
	变量 权限列表 为 文本型(1)
	权限列表(0) = "android.permission.READ_CONTACTS"
	如果 权限请求1.请求权限(权限列表, "邮箱") = 假 则 结果.文本 = "未发起新请求，请检查权限状态。"
结束 事件

事件 权限请求1.请求结果(权限列表 为 文本型(), 授予结果 为 整数型(), 标记 为 文本型)
	刷新权限()
	结果.文本 = "权限请求已返回，请点击邮箱输入框查看建议；拒绝时仍可手动输入。"
结束 事件

事件 邮箱选择器1.获得焦点()
	结果.文本 = "获得焦点，当前文本：" & 邮箱选择器1.文本
结束 事件

事件 邮箱选择器1.失去焦点()
	结果.文本 = "失去焦点，文本仍保留：" & 邮箱选择器1.文本
结束 事件

事件 邮箱选择器1.选择完毕(姓名 为 文本型, 地址 为 文本型)
	结果.文本 = "选择完成：姓名=" & 姓名 & "\n邮箱=" & 地址 & "\n文本=" & 邮箱选择器1.文本
结束 事件

事件 邮箱选择器1.操作失败(原因 为 文本型)
	结果.文本 = "建议查询失败：" & 原因 & "\n当前文本：" & 邮箱选择器1.文本
结束 事件

事件 填入前缀.被单击()
	邮箱选择器1.文本 = "es4a.mail."
	结果.文本 = "已填入测试前缀，请点击邮箱框查看匹配；没有相应联系人时没有候选。"
结束 事件

事件 清空输入.被单击()
	邮箱选择器1.文本 = ""
	结果.文本 = "已清空文本，旧候选不应继续显示。"
结束 事件

事件 读取文本.被单击()
	刷新权限()
	结果.文本 = "当前文本：" & 邮箱选择器1.文本 & "\n启用：" & 邮箱选择器1.启用 & "；单行：" & 邮箱选择器1.单行模式 & "\n错误：" & 邮箱选择器1.错误信息
结束 事件

事件 切换启用.被单击()
	邮箱选择器1.启用 = 邮箱选择器1.启用 = 假
	结果.文本 = "启用：" & 邮箱选择器1.启用 & "；文本保留：" & 邮箱选择器1.文本
结束 事件

事件 销毁组件.被单击()
	邮箱选择器1.销毁()
	邮箱选择器1.启用 = 真
	结果.文本 = "组件已销毁，重新启用后仍应为假：" & 邮箱选择器1.启用 & "\n返回后重开本示例可创建新组件。"
结束 事件

事件 返回菜单.被单击()
	关闭示例()
结束 事件

事件 邮箱输入窗口.按下某键(按键代码 为 整数型, 传址 取消事件 为 逻辑型)
	如果 按键代码 = 键码_返回 则
		取消事件 = 真
		关闭示例()
	结束 如果
结束 事件

过程 刷新权限()
	权限状态.文本 = "读取联系人权限：" & 权限请求1.是否授权("android.permission.READ_CONTACTS")
结束 过程

过程 关闭示例()
	邮箱选择器1.销毁()
	邮箱选择器2.销毁()
	邮箱选择器3.销毁()
	邮箱选择器4.销毁()
	邮箱选择器5.销毁()
	邮箱选择器6.销毁()
	邮箱选择器7.销毁()
	邮箱选择器8.销毁()
	邮箱选择器9.销毁()
	切换窗口(主窗口.窗口实例)
结束 过程
$属性
	$资源 $窗口
	$定义 邮箱输入窗口 $为 窗口
		布局 = 1
		布局.方向 = 1
		滚动 = 真
		标题 = "邮箱选择器 · 邮箱输入"
		$定义 说明 $为 标签
			文本 = "输入邮箱或姓名片段，授权后从本机通讯录补全。拒绝权限仍可手动输入。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限状态 $为 标签
			文本 = ""
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 申请通讯录权限 $为 按钮
			文本 = "申请通讯录权限"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 邮箱选择器1 $为 邮箱选择器
			文本 = ""
			宽度 = 长度_匹配父级
			高度 = "48dp"
		$结束 $定义
		$定义 填入前缀 $为 按钮
			文本 = "填入测试前缀"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 清空输入 $为 按钮
			文本 = "清空输入"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 读取文本 $为 按钮
			文本 = "读取当前文本和状态"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 切换启用 $为 按钮
			文本 = "切换启用状态"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 销毁组件 $为 按钮
			文本 = "销毁邮箱组件"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 返回菜单 $为 按钮
			文本 = "返回示例菜单"
			宽度 = 长度_匹配父级
			高度 = "44dp"
		$结束 $定义
		$定义 结果 $为 标签
			文本 = ""
			宽度 = 长度_匹配父级
			字体大小 = 12
		$结束 $定义
		$定义 邮箱选择器2 $为 邮箱选择器
			文本 = "文本右侧"
			内容对齐 = 2
			宽度 = -2
		$结束 $定义
		$定义 邮箱选择器3 $为 邮箱选择器
			文本 = "绿色背景"
			背景颜色 = &HFF00FF00
		$结束 $定义
		$定义 邮箱选择器4 $为 邮箱选择器
			文本 = "禁用"
			启用 = 假
		$结束 $定义
		$定义 邮箱选择器5 $为 邮箱选择器
			文本 = "粗体"
			字体加粗 = 真
		$结束 $定义
		$定义 邮箱选择器6 $为 邮箱选择器
			文本 = "斜体"
			字体倾斜 = 真
		$结束 $定义
		$定义 邮箱选择器7 $为 邮箱选择器
			文本 = "大文本"
			字体大小 = 20
		$结束 $定义
		$定义 邮箱选择器8 $为 邮箱选择器
			文本 = "等宽字体文本：wiwiw"
			字体类型 = 3
		$结束 $定义
		$定义 邮箱选择器9 $为 邮箱选择器
			文本 = "绿色文本"
			文本颜色 = &HFF00FF00
		$结束 $定义
		$定义 权限请求1 $为 权限请求
		$结束 $定义
	$结束 $定义
$结束 $属性
