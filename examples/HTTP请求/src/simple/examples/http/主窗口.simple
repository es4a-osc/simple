' TCPLab API：GET 查询 IP，POST JSON 查询 DNS。
' 接口文档：https://tcp.lc/zh/page/api
变量 成_请求中 为 逻辑型

事件 查询本机IP.被单击()
	开始请求("我的 IP", "")
结束 事件

事件 查询目标IP.被单击()
	开始请求("指定 IP", 目标IP.文本)
结束 事件

事件 查询DNS.被单击()
	开始请求("DNS", 域名输入.文本)
结束 事件

过程 开始请求(操作 为 文本型, 输入 为 文本型)
	如果 成_请求中 则 退出 过程
	删首尾空(输入)
	如果 操作 <> "我的 IP" 且 输入 = "" 则
		响应结果.文本 = "请输入查询目标。"
		退出 过程
	结束 如果

	变量 参数 为 变体型(2)
	参数(0) = 操作
	参数(1) = 输入
	成_请求中 = 真
	更新操作()
	响应结果.文本 = "正在查询：" & 操作 & "..."
	启动线程(本对象, "执行请求", 参数)
结束 过程

' 不在工作线程访问编辑框，输入值已在启动时保存到任务参数。
过程 执行请求(操作 为 变体型, 输入 为 变体型)
	变量 结果 为 文本型
	判断 操作
		分支 "我的 IP"
			结果 = 请求接口("https://tcp.lc/api/v2/myip?lang=zh", "")
		分支 "指定 IP"
			结果 = 请求接口("https://tcp.lc/api/v2/ip/" & 输入 & "?lang=zh", "")
		分支 "DNS"
			变量 提交内容 为 JSON值
			提交内容 = 创建 JSON值
			提交内容.创建对象()
			提交内容.置文本("name", 输入)
			提交内容.置文本("type", "A")
			结果 = 请求接口("https://tcp.lc/api/v2/dns/query", 提交内容.到文本(0))
	结束 判断
	投递消息(操作, 结果)

	位于 错误
		分支 否则
			投递消息(操作, "请求发生异常，请检查网络和输入内容。")
	结束 错误
结束 过程

事件 主窗口.反馈消息(消息标记 为 变体型, 附加参数 为 变体型)
	成_请求中 = 假
	更新操作()
	响应结果.文本 = 消息标记 & "：\n" & 附加参数
结束 事件

过程 更新操作()
	查询本机IP.启用 = 成_请求中 = 假
	查询目标IP.启用 = 成_请求中 = 假
	查询DNS.启用 = 成_请求中 = 假
结束 过程

' 传输成功与业务成功分开判断；业务错误也可能返回 HTTP 200。
静态 函数 请求接口(网址 为 文本型, 提交JSON 为 文本型) 为 文本型
	变量 请求 为 HTTP请求
	请求 = 创建 HTTP请求
	如果 请求.打开(网址) = 假 则
		请求接口 = "无法打开请求地址：" & 网址
		退出 函数
	结束 如果
	请求.连接超时 = 5000
	请求.读入超时 = 10000
	请求.允许缓存 = 假

	如果 提交JSON <> "" 则
		请求.请求方式 = "POST"
		如果 请求.置请求头("Content-Type", "application/json; charset=UTF-8") = 假 则
			请求接口 = "设置 JSON 请求头失败。"
			退出 函数
		结束 如果
		如果 请求.置提交文本(提交JSON) = 假 则
			请求接口 = "设置 JSON 请求体失败。"
			退出 函数
		结束 如果
	结束 如果

	如果 请求.发送() = 假 则
		请求接口 = "请求失败，请检查网络、地址及当前运行库的 HTTP 支持。"
		退出 函数
	结束 如果
	变量 状态码 为 整数型
	状态码 = 请求.响应代码
	如果 状态码 <> 200 则
		请求接口 = "HTTP 状态：" & 状态码 & "\n" & 请求.响应文本
		退出 函数
	结束 如果

	变量 响应 为 JSON值
	响应 = 创建 JSON值
	如果 响应.解析对象(请求.响应文本) = 假 则
		请求接口 = "HTTP 200，但响应不是有效的 JSON 对象。\n" & 请求.响应文本
		退出 函数
	结束 如果
	如果 响应.是否存在("code") = 假 则
		请求接口 = "响应缺少业务状态 code。\n" & 响应.到文本(2)
		退出 函数
	结束 如果
	如果 响应.取整数("code") <> 200 则
		请求接口 = "HTTP 200；业务失败：" & 响应.取文本("msg") & "\n" & 响应.到文本(2)
	否则
		请求接口 = "HTTP 200；业务成功。\n" & 响应.到文本(2)
	结束 如果
结束 函数
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		布局 = 布局_线性
		标题 = "HTTP请求"
		$定义 操作说明 $为 标签
			文本 = "后台请求：GET 查询 IP，POST JSON 查询 DNS"
			文本颜色 = 颜色_黑
		$结束 $定义
		$定义 查询本机IP $为 按钮
			文本 = "查询我的 IP"
		$结束 $定义
		$定义 IP说明 $为 标签
			文本 = "填写待查询的 IP 或主机名："
		$结束 $定义
		$定义 目标IP $为 编辑框
			文本 = "8.8.8.8"
			单行模式 = 真
			宽度 = 长度_匹配父级
			提示文本 = "IPv4、IPv6 或主机名"
		$结束 $定义
		$定义 域名输入 $为 编辑框
			文本 = "example.com"
			单行模式 = 真
			宽度 = 长度_匹配父级
			提示文本 = "DNS 查询域名，如 example.com"
		$结束 $定义
		$定义 面板1 $为 面板
			布局.方向 = 布局_方向_水平
			$定义 查询目标IP $为 按钮
				文本 = "查询指定 IP"
			$结束 $定义
			$定义 查询DNS $为 按钮
				文本 = "查询 DNS（POST JSON）"
			$结束 $定义
		$结束 $定义
		$定义 结果说明 $为 标签
			文本 = "响应结果："
		$结束 $定义
		$定义 响应结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 长度_匹配父级
		$结束 $定义
	$结束 $定义
$结束 $属性
