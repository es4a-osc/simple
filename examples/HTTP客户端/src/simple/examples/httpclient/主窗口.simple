' 本例使用本机测试服务，HTTP 传输和文件读取均在组件后台线程执行。
变量 自检阶段 为 整数型
变量 取消后校验 为 逻辑型
变量 销毁回调数 为 整数型

事件 主窗口.初始化()
	如果 写出文本文件("httpclient.txt", "ES4A HTTP客户端文件测试：中文附件。") = 假 则
		写日志("无法准备本地文件。")
	结束 如果
结束 事件

事件 基础自检.被单击()
	如果 HTTP客户端1.正在请求 则 退出 事件
	自检阶段 = 1
	开始("GET", "/get")
	如果 HTTP客户端1.发送请求(服务地址.文本 & "/get") 则
		写日志("错误：忙碌时重复请求被受理。")
		自检阶段 = 0
	否则
		写日志("忙碌拒绝正常，原请求继续执行。")
	结束 如果
结束 事件

事件 上传本地文件.被单击()
	如果 HTTP客户端1.正在请求 则 退出 事件
	变量 字段 为 哈希表
	字段 = 创建 哈希表
	字段.加入("memo", "附加中文字段")
	HTTP客户端1.置提交文件表单("attachment", "httpclient.txt", 字段)
	开始("POST", "/upload")
结束 事件

事件 选择并上传.被单击()
	如果 HTTP客户端1.正在请求 则 退出 事件
	文件选择器1.选择文件("text/plain")
结束 事件

事件 文件选择器1.文件选择完毕(文件列表 为 文本型())
	如果 取数组成员数(文件列表) = 0 则 退出 事件
	HTTP客户端1.置提交文件表单("attachment", 文件列表(0))
	写日志("文件地址：" & 文件列表(0))
	开始("POST", "/upload")
结束 事件

事件 文件选择器1.取消选择()
	写日志("已取消选择文件。")
结束 事件

事件 文件选择器1.选择失败(信息 为 文本型)
	写日志("文件选择失败：" & 信息)
结束 事件

事件 慢请求.被单击()
	自检阶段 = 0
	开始("GET", "/slow")
结束 事件

事件 取消.被单击()
	如果 HTTP客户端1.取消请求() 则
		取消后校验 = 真
		写日志("已受理取消，等待取消事件。")
	否则
		写日志("当前没有可取消的请求。")
	结束 如果
结束 事件

事件 销毁检查.被单击()
	如果 HTTP客户端2.发送请求(服务地址.文本 & "/slow") 则
		HTTP客户端2.销毁()
		销毁检查.启用 = 假
		写日志("已销毁第二个组件；它的终止回调应为 0 次。")
	结束 如果
结束 事件

事件 HTTP客户端1.发送进度(已发送 为 长整数型, 总长度 为 长整数型)
	进度.文本 = "发送：" & 已发送 & " / " & 总长度
结束 事件

事件 HTTP客户端1.接收进度(已接收 为 长整数型, 总长度 为 长整数型)
	进度.文本 = "接收：" & 已接收 & " / " & 总长度
结束 事件

事件 HTTP客户端1.请求完成(状态码 为 整数型)
	写日志("HTTP " & 状态码 & "，忙碌=" & HTTP客户端1.正在请求)
	如果 HTTP客户端1.正在请求 则
		写日志("错误：终止事件中仍处于忙碌状态。")
		退出 事件
	结束 如果
	判断 自检阶段
		分支 1
			如果 状态码 <> 200 则 退出 事件
			变量 内容 为 JSON值
			内容 = 创建 JSON值
			内容.创建对象()
			内容.置文本("message", "HTTP客户端中文")
			HTTP客户端1.置提交文本(内容.到文本(0), "application/json")
			自检阶段 = 2
			开始("POST", "/echo")
		分支 2
			如果 状态码 <> 200 则 退出 事件
			写日志(HTTP客户端1.响应文本)
			自检阶段 = 3
			开始("GET", "/created")
		分支 3
			如果 状态码 <> 201 或 HTTP客户端1.响应文本 = "" 则 退出 事件
			自检阶段 = 4
			开始("GET", "/empty")
		分支 4
			如果 状态码 <> 204 或 HTTP客户端1.响应文本 <> "" 则 退出 事件
			自检阶段 = 5
			开始("GET", "/missing")
		分支 5
			如果 状态码 <> 404 则 退出 事件
			自检阶段 = 6
			开始("GET", "/redirect")
		分支 6
			如果 状态码 <> 302 则 退出 事件
			HTTP客户端1.响应大小上限 = 100
			自检阶段 = 7
			开始("GET", "/large")
		分支 否则
			写日志(HTTP客户端1.响应文本)
			如果 取消后校验 则
				取消后校验 = 假
				写日志("取消后新请求完成，旧任务未覆盖结果。")
			结束 如果
	结束 判断
结束 事件

事件 HTTP客户端1.请求失败(信息 为 文本型)
	写日志("请求失败：" & 信息)
	判断 自检阶段
		分支 7
			HTTP客户端1.响应大小上限 = 8388608
			HTTP客户端1.读入超时 = 300
			自检阶段 = 8
			开始("GET", "/slow")
		分支 8
			HTTP客户端1.读入超时 = 30000
			自检阶段 = 0
			写日志("基础自检通过：GET、JSON、201、204、404、302、忙碌拒绝、事件重入、响应上限、读取超时。")
		分支 否则
			自检阶段 = 0
	结束 判断
结束 事件

事件 HTTP客户端1.请求取消()
	自检阶段 = 0
	写日志("收到取消事件，忙碌=" & HTTP客户端1.正在请求)
	如果 取消后校验 则 开始("GET", "/get")
结束 事件

事件 HTTP客户端2.请求完成(状态码 为 整数型)
	销毁回调数 = 销毁回调数 + 1
	写日志("错误：销毁后收到完成事件，次数=" & 销毁回调数)
结束 事件

事件 HTTP客户端2.请求失败(信息 为 文本型)
	销毁回调数 = 销毁回调数 + 1
	写日志("错误：销毁后收到失败事件，次数=" & 销毁回调数)
结束 事件

事件 HTTP客户端2.请求取消()
	销毁回调数 = 销毁回调数 + 1
	写日志("错误：销毁后收到取消事件，次数=" & 销毁回调数)
结束 事件

过程 开始(方式 为 文本型, 路径 为 文本型)
	如果 HTTP客户端1.发送请求(方式, 服务地址.文本 & 路径) 则
		写日志(方式 & " " & 路径)
	否则
		自检阶段 = 0
		写日志("请求未受理：" & HTTP客户端1.错误信息)
	结束 如果
结束 过程

过程 写日志(内容 为 文本型)
	日志.加入文本(内容 & "\n")
结束 过程
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "HTTP客户端"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 HTTP客户端1 $为 HTTP客户端
		$结束 $定义
		$定义 HTTP客户端2 $为 HTTP客户端
		$结束 $定义
		$定义 文件选择器1 $为 文件选择器
		$结束 $定义
		$定义 说明 $为 标签
			文本 = "先运行本机测试服务并映射端口。请求由组件在后台执行。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 服务地址 $为 编辑框
			文本 = "http://127.0.0.1:18766"
			宽度 = 长度_匹配父级
			单行模式 = 真
		$结束 $定义
		$定义 操作行1 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 基础自检 $为 按钮
				文本 = "GET / JSON 自检"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 上传本地文件 $为 按钮
				文本 = "上传本地文件"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 操作行2 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 选择并上传 $为 按钮
				文本 = "选择文件并上传"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 慢请求 $为 按钮
				文本 = "启动慢请求"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 操作行3 $为 面板
			布局 = 布局_线性
			布局.方向 = 布局_方向_水平
			宽度 = 长度_匹配父级
			$定义 取消 $为 按钮
				文本 = "取消请求"
				宽度 = 0
				权重 = 1
			$结束 $定义
			$定义 销毁检查 $为 按钮
				文本 = "销毁检查"
				宽度 = 0
				权重 = 1
			$结束 $定义
		$结束 $定义
		$定义 进度 $为 标签
			文本 = "等待请求。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 日志 $为 编辑框
			文本 = ""
			宽度 = 长度_匹配父级
			高度 = 420
			单行模式 = 假
		$结束 $定义
	$结束 $定义
$结束 $属性
