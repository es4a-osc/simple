' 权限请求：本例声明麦克风权限以演示请求流程，不进行录音。
变量 权限载体 为 录音器

事件 主窗口.初始化()
	' 仅引用录音器的权限声明，不开始录音。
	权限载体 = 创建 录音器
	刷新状态()
结束 事件

事件 查看状态.被单击()
	刷新状态()
结束 事件

过程 刷新状态()
	结果.文本 = "麦克风已授权：" & 权限1.是否授权("android.permission.RECORD_AUDIO") & "\n需要说明理由：" & 权限1.需要理由("android.permission.RECORD_AUDIO")
	变量 列表 为 文本型()
	列表 = 权限1.取所有权限()
	如果 列表 <> 空 则 结果.加入文本("\n清单权限：" & 连接数组文本(列表, ", "))
	列表 = 权限1.取所需权限()
	如果 列表 <> 空 则 结果.加入文本("\n未授权权限：" & 连接数组文本(列表, ", "))
结束 过程

事件 请求授权.被单击()
	变量 列表 为 文本型(1)
	列表(0) = "android.permission.RECORD_AUDIO"
	结果.文本 = "请求已发起：" & 权限1.请求权限(列表, "麦克风")
结束 事件

事件 权限1.请求结果(权限名称 为 文本型(), 授予结果 为 整数型(), 标记 为 文本型)
	刷新状态()
	结果.加入文本("\n请求结果已返回，标记：" & 标记)
结束 事件

事件 打开设置.被单击()
	权限1.打开设置()
结束 事件
$属性
	$资源 $窗口
	$定义 主窗口 $为 窗口
		标题 = "权限请求"
		布局 = 布局_线性
		布局.方向 = 布局_方向_垂直
		滚动 = 真
		$定义 操作说明 $为 标签
			文本 = "仅演示麦克风权限的状态、请求与结果回调，不录音。"
			宽度 = 长度_匹配父级
		$结束 $定义
		$定义 权限1 $为 权限请求
		$结束 $定义
		$定义 查看状态 $为 按钮
			文本 = "查看权限状态"
		$结束 $定义
		$定义 请求授权 $为 按钮
			文本 = "请求麦克风权限"
		$结束 $定义
		$定义 打开设置 $为 按钮
			文本 = "打开应用权限设置"
		$结束 $定义
		$定义 结果 $为 编辑框
			宽度 = 长度_匹配父级
			高度 = 260
			文本 = ""
		$结束 $定义
	$结束 $定义
$结束 $属性
